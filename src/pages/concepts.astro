---
// INTERNAL DRAFT — 10 competing homepage redesign concepts, for side-by-side comparison only.
// Not linked from real nav, noindex, and deliberately self-contained: no imports from
// ../layouts, ../components or ../styles, so nothing here can leak into or depend on the
// real site. Facts (general German learning: Grammatik, Alltagsdeutsch, Sprechpraxis;
// audience = general German learners preparing for everyday life and exams like Goethe/telc)
// are identical across all 10 — only layout, palette, type and voice vary. No stats, prices
// or testimonials are invented.
---
<!doctype html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Homepage-Konzepte (internes Vergleichsdraft)</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;900&family=Fraunces:opsz,wght@9..144,300;9..144,500;9..144,600&family=Archivo+Black&family=Space+Grotesk:wght@400;500;700&family=Baloo+2:wght@500;600;800&family=Cormorant+Garamond:wght@300;400;600&family=Roboto+Slab:wght@400;600;700&family=Abril+Fatface&family=Sora:wght@400;600;800&family=Caveat:wght@500;600;700&display=swap"
    rel="stylesheet"
  />
  <style>
    /* ========== SHARED BASE (switcher chrome + resets only — no site styles reused) ========== */
    *, *::before, *::after { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; }
    body { background: #f4f4f4; }
    img { max-width: 100%; display: block; }
    a { text-decoration: none; }
    button { font: inherit; }

    .switcher {
      position: sticky; top: 0; z-index: 1000;
      background: #111318; border-bottom: 1px solid #2a2e37;
      padding: 10px 16px; display: flex; gap: 8px; flex-wrap: wrap; align-items: center;
      font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
    }
    .switcher-title { color: #8a8f9c; font-size: .72rem; margin-right: 10px; white-space: nowrap; line-height: 1.3; max-width: 220px; }
    .switcher-tabs { display: flex; gap: 6px; flex-wrap: wrap; }
    .switcher button {
      background: #1c1f27; color: #c7cbd4; border: 1px solid #30343f;
      padding: 7px 13px; border-radius: 999px; font-size: .76rem; cursor: pointer; white-space: nowrap;
    }
    .switcher button:hover { border-color: #4a4f5c; }
    .switcher button.active { background: #fff; color: #111; font-weight: 700; border-color: #fff; }

    .annot {
      background: #16181d; color: #b7bcc7; font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
      font-size: .82rem; line-height: 1.5; padding: 12px 20px;
    }
    .annot b { color: #fff; }

    .concept-panel { display: none; }
    .concept-panel.active { display: block; }

    .ph-tag {
      position: absolute; bottom: 8px; right: 8px; font-size: .62rem; letter-spacing: .04em;
      padding: 3px 8px; border-radius: 4px; background: rgba(0,0,0,.6); color: #fff;
      font-family: system-ui, sans-serif; text-transform: uppercase; pointer-events: none;
    }
    .img-wrap { position: relative; }

    /* ========== 1. SWISS GRID / CLINICAL MINIMALIST ========== */
    #concept-1 { background: #ffffff; color: #12181f; font-family: 'Inter', sans-serif; }
    #concept-1 .nav { display: flex; align-items: center; justify-content: space-between; padding: 22px 6vw; border-bottom: 1px solid #e4e7ea; }
    #concept-1 .logo { font-weight: 900; letter-spacing: -.02em; font-size: 1.15rem; }
    #concept-1 .navlinks { display: flex; gap: 32px; font-size: .85rem; color: #4a5560; }
    #concept-1 .cta { background: #0f7a6d; color: #fff; padding: 11px 22px; font-weight: 600; font-size: .85rem; }
    #concept-1 .hero { display: grid; grid-template-columns: 1.1fr .9fr; gap: 0; align-items: stretch; border-bottom: 1px solid #e4e7ea; }
    #concept-1 .hero-copy { padding: 8vh 6vw; display: flex; flex-direction: column; justify-content: center; }
    #concept-1 .eyebrow { font-family: 'Inter', monospace; font-size: .72rem; letter-spacing: .12em; text-transform: uppercase; color: #0f7a6d; font-weight: 700; margin-bottom: 18px; }
    #concept-1 h1 { font-size: clamp(2.1rem, 4.2vw, 3.4rem); line-height: 1.08; letter-spacing: -.02em; margin: 0 0 20px; font-weight: 900; }
    #concept-1 .sub { font-size: 1.05rem; color: #4a5560; line-height: 1.6; max-width: 46ch; margin: 0 0 28px; }
    #concept-1 .hero-img { position: relative; background: #0f7a6d; overflow: hidden; min-height: 420px; }
    #concept-1 .hero-img img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.05); mix-blend-mode: luminosity; }
    #concept-1 .pillars { display: grid; grid-template-columns: repeat(3, 1fr); }
    #concept-1 .pillar { padding: 6vh 4vw; border-right: 1px solid #e4e7ea; }
    #concept-1 .pillar:last-child { border-right: none; }
    #concept-1 .pillar .num { font-family: monospace; font-size: .78rem; color: #9aa2ab; margin-bottom: 14px; display: block; }
    #concept-1 .pillar h3 { font-size: 1.15rem; margin: 0 0 10px; font-weight: 700; }
    #concept-1 .pillar p { color: #4a5560; font-size: .92rem; line-height: 1.6; margin: 0; }
    #concept-1 footer { padding: 18px 6vw; border-top: 1px solid #e4e7ea; font-size: .78rem; color: #9aa2ab; }
    @media (max-width: 760px) { #concept-1 .hero, #concept-1 .pillars { grid-template-columns: 1fr; } #concept-1 .pillar { border-right: none; border-bottom: 1px solid #e4e7ea; } }

    /* ========== 2. EDITORIAL STORY / WARM HUMAN ========== */
    #concept-2 { background: #faf3ea; color: #2b2018; font-family: Georgia, 'Times New Roman', serif; }
    #concept-2 .nav { text-align: center; padding: 28px 6vw 20px; }
    #concept-2 .logo { font-family: 'Fraunces', serif; font-size: 1.3rem; font-weight: 600; }
    #concept-2 .hero { max-width: 640px; margin: 0 auto; text-align: center; padding: 4vh 6vw 6vh; }
    #concept-2 .kicker { font-style: italic; color: #c1602f; font-size: .95rem; margin-bottom: 14px; }
    #concept-2 h1 { font-family: 'Fraunces', serif; font-weight: 600; font-size: clamp(2rem, 4.6vw, 3.1rem); line-height: 1.15; margin: 0 0 22px; }
    #concept-2 .sub { font-size: 1.15rem; line-height: 1.75; color: #4a3c2e; margin: 0 0 26px; }
    #concept-2 .cta-link { display: inline-block; border-bottom: 2px solid #c1602f; font-weight: 700; padding-bottom: 2px; }
    #concept-2 .hero-photo { max-width: 980px; margin: 0 auto; padding: 0 6vw; }
    #concept-2 .hero-photo img { width: 100%; border-radius: 4px; filter: sepia(.18) saturate(1.05); }
    #concept-2 .story { max-width: 900px; margin: 8vh auto; padding: 0 6vw; display: flex; flex-direction: column; gap: 7vh; }
    #concept-2 .row { display: grid; grid-template-columns: 1fr 1.2fr; gap: 5vw; align-items: center; }
    #concept-2 .row.rev { grid-template-columns: 1.2fr 1fr; }
    #concept-2 .row.rev .txt { order: 2; }
    #concept-2 .row .ph-box { background: #efe2d1; aspect-ratio: 4/3; display: flex; align-items: center; justify-content: center; color: #a8926f; font-size: .8rem; border-radius: 4px; position: relative; overflow: hidden; }
    #concept-2 .row .ph-box img { width: 100%; height: 100%; object-fit: cover; filter: sepia(.25); }
    #concept-2 .chapter { font-style: italic; color: #c1602f; font-size: .85rem; margin-bottom: 8px; }
    #concept-2 .row h3 { font-family: 'Fraunces', serif; font-size: 1.5rem; margin: 0 0 10px; }
    #concept-2 .row p { line-height: 1.7; color: #4a3c2e; margin: 0; }
    #concept-2 .closing { text-align: center; padding: 8vh 6vw; background: #f0e3d2; }
    #concept-2 .closing p { font-family: 'Fraunces', serif; font-size: clamp(1.4rem, 3vw, 2rem); max-width: 720px; margin: 0 auto 24px; line-height: 1.4; }
    @media (max-width: 760px) { #concept-2 .row, #concept-2 .row.rev { grid-template-columns: 1fr; } #concept-2 .row.rev .txt { order: 0; } }

    /* ========== 3. BRUTALIST ========== */
    #concept-3 { background: #000; color: #fff; font-family: 'Archivo Black', Arial, sans-serif; }
    #concept-3 .nav { display: flex; justify-content: space-between; align-items: center; padding: 20px 5vw; border-bottom: 4px solid #fff; }
    #concept-3 .logo { font-size: 1.2rem; }
    #concept-3 .cta { background: #e8ff00; color: #000; padding: 12px 22px; font-family: 'Archivo Black', sans-serif; font-size: .85rem; }
    #concept-3 .hero { position: relative; padding: 6vh 5vw 8vh; overflow: hidden; }
    #concept-3 h1 { font-size: clamp(2.6rem, 8vw, 5.2rem); line-height: .95; margin: 0 0 30px; text-transform: uppercase; }
    #concept-3 h1 span { background: #e8ff00; color: #000; padding: 0 8px; display: inline-block; }
    #concept-3 .sub-box { background: #fff; color: #000; display: inline-block; padding: 14px 20px; font-family: Arial, sans-serif; font-weight: 700; font-size: 1rem; transform: rotate(-1deg); margin-bottom: 30px; box-shadow: 8px 8px 0 #e8ff00; }
    #concept-3 .hero-img { max-width: 420px; margin-top: 20px; transform: rotate(2deg); border: 6px solid #fff; box-shadow: 12px 12px 0 #ff2d2d; overflow: hidden; }
    #concept-3 .hero-img img { filter: grayscale(1) contrast(1.3); }
    #concept-3 .big-cta { display: block; background: #e8ff00; color: #000; text-align: center; padding: 18px; font-size: 1.1rem; margin-top: 30px; max-width: 340px; border: 4px solid #000; }
    #concept-3 .pillars { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 4px solid #fff; }
    #concept-3 .pillar { padding: 6vh 4vw; position: relative; overflow: hidden; border-right: 4px solid #fff; }
    #concept-3 .pillar:nth-child(2) { background: #e8ff00; color: #000; }
    #concept-3 .pillar:nth-child(3) { background: #ff2d2d; color: #000; border-right: none; }
    #concept-3 .pillar .bignum { position: absolute; top: -.4em; right: -.1em; font-size: 7rem; opacity: .15; line-height: 1; }
    #concept-3 .pillar h3 { font-size: 1.3rem; margin: 0 0 12px; text-transform: uppercase; position: relative; }
    #concept-3 .pillar p { font-family: Arial, sans-serif; font-weight: 700; font-size: .95rem; line-height: 1.5; margin: 0; position: relative; }
    @media (max-width: 760px) { #concept-3 .pillars { grid-template-columns: 1fr; } #concept-3 .pillar { border-right: none; border-bottom: 4px solid #fff; } }

    /* ========== 4. DARK TECH / SAAS ========== */
    #concept-4 {
      background: #0b0f19; color: #e8ecf3; font-family: 'Space Grotesk', sans-serif; position: relative; overflow: hidden;
    }
    #concept-4 .mesh { position: absolute; inset: 0; z-index: 0; pointer-events: none;
      background:
        radial-gradient(600px 400px at 15% 10%, rgba(34,211,238,.22), transparent 60%),
        radial-gradient(500px 400px at 85% 30%, rgba(167,139,250,.22), transparent 60%),
        radial-gradient(700px 500px at 50% 90%, rgba(34,211,238,.12), transparent 60%);
      filter: blur(10px);
    }
    #concept-4 .stage { position: relative; z-index: 1; }
    #concept-4 .nav { display: flex; justify-content: space-between; align-items: center; padding: 20px 6vw; backdrop-filter: blur(6px); border-bottom: 1px solid rgba(255,255,255,.08); }
    #concept-4 .logo { font-weight: 700; }
    #concept-4 .navlinks { display: flex; gap: 26px; font-size: .85rem; color: #a7afc0; }
    #concept-4 .cta-pill { background: linear-gradient(90deg, #22d3ee, #a78bfa); color: #06121a; font-weight: 700; padding: 10px 20px; border-radius: 999px; font-size: .85rem; }
    #concept-4 .hero { text-align: center; padding: 9vh 6vw 5vh; max-width: 780px; margin: 0 auto; }
    #concept-4 .eyebrow { font-size: .75rem; letter-spacing: .12em; text-transform: uppercase; color: #22d3ee; margin-bottom: 16px; }
    #concept-4 h1 { font-size: clamp(2.1rem, 4.6vw, 3.3rem); line-height: 1.12; margin: 0 0 20px; font-weight: 700; background: linear-gradient(90deg, #fff, #b9c2d6); -webkit-background-clip: text; background-clip: text; color: transparent; }
    #concept-4 .sub { color: #a7afc0; font-size: 1.05rem; line-height: 1.6; margin: 0 0 30px; }
    #concept-4 .glass { background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.12); backdrop-filter: blur(14px); border-radius: 16px; }
    #concept-4 .cta-pill.lg { display: inline-block; padding: 13px 28px; font-size: .95rem; }
    #concept-4 .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; max-width: 1000px; margin: 4vh auto 10vh; padding: 0 6vw; }
    #concept-4 .card { padding: 30px 24px; }
    #concept-4 .chip { width: 40px; height: 40px; border-radius: 10px; background: linear-gradient(135deg, #22d3ee, #a78bfa); margin-bottom: 18px; }
    #concept-4 .card h3 { font-size: 1.05rem; margin: 0 0 10px; }
    #concept-4 .card p { color: #a7afc0; font-size: .9rem; line-height: 1.6; margin: 0; }
    @media (max-width: 760px) { #concept-4 .grid { grid-template-columns: 1fr; } }

    /* ========== 5. PLAYFUL ========== */
    #concept-5 { background: #fff6d8; color: #2c2410; font-family: 'Baloo 2', system-ui, sans-serif; }
    #concept-5 .nav { display: flex; justify-content: space-between; align-items: center; padding: 18px 5vw; }
    #concept-5 .logo { background: #3ecf8e; color: #fff; padding: 8px 16px; border-radius: 999px; font-weight: 800; font-size: 1rem; }
    #concept-5 .cta-pill { background: #ff6f61; color: #fff; padding: 12px 24px; border-radius: 999px; font-weight: 700; box-shadow: 4px 4px 0 #2c2410; }
    #concept-5 .hero { text-align: center; padding: 4vh 6vw 3vh; position: relative; }
    #concept-5 h1 { font-size: clamp(2.1rem, 5vw, 3.2rem); line-height: 1.15; font-weight: 800; margin: 0 0 18px; }
    #concept-5 h1 .w1 { color: #ff6f61; } #concept-5 h1 .w2 { color: #3fb6ff; } #concept-5 h1 .w3 { color: #3ecf8e; }
    #concept-5 .sub { font-size: 1.1rem; max-width: 52ch; margin: 0 auto 26px; line-height: 1.5; }
    #concept-5 .blob-wrap { position: relative; max-width: 360px; margin: 30px auto 0; }
    #concept-5 .blob { width: 100%; aspect-ratio: 1; clip-path: path('M300,150C300,220,240,300,150,300C60,300,0,220,0,150C0,70,70,0,150,0C230,0,300,70,300,150Z'); overflow: hidden; background: #3fb6ff; }
    #concept-5 .blob img { width: 100%; height: 100%; object-fit: cover; }
    #concept-5 .sticker { position: absolute; background: #fff; border-radius: 999px; padding: 10px 14px; font-size: 1.4rem; box-shadow: 3px 3px 0 #2c2410; }
    #concept-5 .s1 { top: -10px; left: -20px; transform: rotate(-8deg); }
    #concept-5 .s2 { bottom: 10px; right: -24px; transform: rotate(10deg); }
    #concept-5 .path { display: flex; justify-content: center; align-items: flex-start; gap: 0; max-width: 900px; margin: 8vh auto; padding: 0 6vw; position: relative; }
    #concept-5 .node { flex: 1; text-align: center; position: relative; padding: 0 12px; }
    #concept-5 .node::after { content: ''; position: absolute; top: 34px; left: 50%; width: 100%; height: 3px; background-image: linear-gradient(90deg, #2c2410 40%, transparent 40%); background-size: 12px 3px; z-index: 0; }
    #concept-5 .node:last-child::after { display: none; }
    #concept-5 .circle { width: 68px; height: 68px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.7rem; margin: 0 auto 14px; position: relative; z-index: 1; box-shadow: 3px 3px 0 #2c2410; }
    #concept-5 .node:nth-child(1) .circle { background: #ffd166; } #concept-5 .node:nth-child(2) .circle { background: #3fb6ff; } #concept-5 .node:nth-child(3) .circle { background: #3ecf8e; }
    #concept-5 .node h3 { font-size: 1.05rem; margin: 0 0 6px; }
    #concept-5 .node p { font-family: system-ui, sans-serif; font-size: .85rem; line-height: 1.5; margin: 0; color: #4a4020; }
    #concept-5 .banner { max-width: 900px; margin: 2vh auto 8vh; padding: 5vh 6vw; background: #3ecf8e; border-radius: 28px; text-align: center; color: #fff; margin-left: 6vw; margin-right: 6vw; }
    #concept-5 .banner h3 { font-size: 1.6rem; margin: 0 0 18px; }
    #concept-5 .banner .cta-pill { background: #fff; color: #2c2410; }
    @media (max-width: 760px) { #concept-5 .path { flex-direction: column; gap: 30px; } #concept-5 .node::after { display: none; } }

    /* ========== 6. LUXURY / PREMIUM ========== */
    #concept-6 { background: #0a0a0a; color: #f5f1e8; font-family: 'Cormorant Garamond', serif; }
    #concept-6 .nav { text-align: center; padding: 26px 6vw 10px; }
    #concept-6 .logo { letter-spacing: .22em; text-transform: uppercase; font-size: .95rem; font-weight: 600; }
    #concept-6 .hairline { width: 60px; height: 1px; background: #c9a86a; margin: 14px auto 0; }
    #concept-6 .hero { position: relative; min-height: 78vh; display: flex; align-items: center; justify-content: center; text-align: center; }
    #concept-6 .hero-bg { position: absolute; inset: 0; z-index: 0; }
    #concept-6 .hero-bg img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) brightness(.55); }
    #concept-6 .hero-bg::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(10,10,10,.4), rgba(10,10,10,.85)); }
    #concept-6 .hero-copy { position: relative; z-index: 1; max-width: 720px; padding: 0 6vw; }
    #concept-6 h1 { font-weight: 300; font-size: clamp(2.4rem, 5vw, 4rem); line-height: 1.2; margin: 0 0 22px; }
    #concept-6 .sub { letter-spacing: .05em; font-size: 1.15rem; color: #cfc7b5; margin: 0 0 34px; line-height: 1.6; }
    #concept-6 .cta-outline { display: inline-block; border: 1px solid #c9a86a; color: #f5f1e8; padding: 13px 34px; letter-spacing: .12em; text-transform: uppercase; font-size: .78rem; }
    #concept-6 .list { max-width: 780px; margin: 9vh auto; padding: 0 6vw; }
    #concept-6 .item { display: grid; grid-template-columns: 90px 1fr; gap: 30px; padding: 32px 0; border-bottom: 1px solid rgba(201,168,106,.25); align-items: center; }
    #concept-6 .item:last-child { border-bottom: none; }
    #concept-6 .roman { font-size: 2.2rem; color: #c9a86a; font-weight: 300; }
    #concept-6 .item h3 { font-size: 1.4rem; margin: 0 0 8px; font-weight: 500; }
    #concept-6 .item p { color: #cfc7b5; font-size: 1rem; line-height: 1.6; margin: 0; }
    #concept-6 .closing { text-align: center; padding: 8vh 6vw 10vh; }
    #concept-6 .closing p { font-size: 1.3rem; margin: 0 0 26px; color: #cfc7b5; }
    @media (max-width: 760px) { #concept-6 .item { grid-template-columns: 1fr; text-align: center; } }

    /* ========== 7. GOVERNMENT / OFFICIAL TRUST ========== */
    #concept-7 { background: #eef1f4; color: #1c2733; font-family: Arial, Helvetica, sans-serif; }
    #concept-7 .topstrip { background: #1b3a5c; color: #dbe4ec; font-size: .74rem; padding: 6px 6vw; }
    #concept-7 .nav { display: flex; justify-content: space-between; align-items: center; padding: 16px 6vw; background: #fff; border-bottom: 3px solid #1b3a5c; }
    #concept-7 .logo { font-family: 'Roboto Slab', serif; font-weight: 700; font-size: 1.05rem; color: #1b3a5c; }
    #concept-7 .navlinks { display: flex; gap: 22px; font-size: .82rem; }
    #concept-7 .navlinks a { color: #1c2733; border-bottom: 1px solid transparent; }
    #concept-7 .navlinks a:hover { border-color: #1b3a5c; }
    #concept-7 .portal { max-width: 760px; margin: 5vh auto; padding: 0 6vw; }
    #concept-7 .card { background: #fff; border: 1px solid #c7d0d8; border-radius: 3px; padding: 5vh 5vw; }
    #concept-7 .doc-icon { width: 34px; height: 34px; border: 2px solid #1b3a5c; border-radius: 3px; margin-bottom: 18px; position: relative; }
    #concept-7 .doc-icon::before, #concept-7 .doc-icon::after { content: ''; position: absolute; left: 6px; right: 6px; height: 2px; background: #1b3a5c; }
    #concept-7 .doc-icon::before { top: 10px; } #concept-7 .doc-icon::after { top: 18px; }
    #concept-7 h1 { font-family: 'Roboto Slab', serif; font-size: clamp(1.5rem, 3vw, 2.1rem); line-height: 1.3; margin: 0 0 14px; color: #12202e; }
    #concept-7 .sub { font-size: .98rem; line-height: 1.65; color: #3a4854; margin: 0 0 26px; }
    #concept-7 .cta-official { display: inline-block; background: #1b3a5c; color: #fff; padding: 11px 22px; font-size: .85rem; font-weight: 700; border: 1px solid #12293f; border-radius: 2px; }
    #concept-7 .overview { max-width: 760px; margin: 0 auto 6vh; padding: 0 6vw; }
    #concept-7 .overview-box { background: #fff; border: 1px solid #c7d0d8; border-radius: 3px; padding: 4vh 5vw; }
    #concept-7 .overview-box h2 { font-family: 'Roboto Slab', serif; font-size: 1.1rem; margin: 0 0 20px; color: #1b3a5c; text-transform: uppercase; letter-spacing: .03em; }
    #concept-7 .check-row { display: flex; gap: 14px; padding: 14px 0; border-bottom: 1px solid #e2e7eb; }
    #concept-7 .check-row:last-child { border-bottom: none; }
    #concept-7 .check { width: 22px; height: 22px; flex: none; border: 2px solid #2e7d4f; border-radius: 3px; display: flex; align-items: center; justify-content: center; color: #2e7d4f; font-weight: 700; font-size: .85rem; }
    #concept-7 .check-row h4 { margin: 0 0 4px; font-size: .95rem; }
    #concept-7 .check-row p { margin: 0; font-size: .85rem; color: #3a4854; line-height: 1.5; }
