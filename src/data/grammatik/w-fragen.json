    "exampleHtml": "<span class=\"vp-verb\">Wo</span> <span class=\"vp-prep\">wohnen</span> Sie? — <span class=\"vp-verb\">Wie</span> <span class=\"vp-prep\">heißt</span> dein Sohn?",
    "qa": [
      { "html": "<strong>Position 1</strong> gehört dem Fragewort, <strong>Position 2</strong> immer dem konjugierten Verb.", "tag": "Verb = 2" },
      { "html": "Das <strong>Subjekt</strong> steht direkt rechts vom Verb: <em>Wann essen Ilse und Heiko?</em>", "tag": "Position 3" },
      { "html": "<strong>Wer / wen / wem</strong> fragen nach Personen und verändern sich nach Kasus — <em>Wer kommt? Wen siehst du? Wem gehört das?</em>", "tag": "Personen" },
      { "html": "Nach einer Präposition bleibt die Präposition am Fragewort kleben: <em>Mit wem? Von wem? Für wen?</em>", "tag": "Präposition" }
    ],
    "noteHtml": "Zwei Fragewörter werden gern verwechselt: <strong>wo</strong> fragt nach dem Ort (<em>Wo bist du? — Im Wohnzimmer.</em>), <strong>wohin</strong> nach der Richtung (<em>Wohin gehst du? — Ins Kino.</em>) und <strong>woher</strong> nach der Herkunft (<em>Woher kommst du? — Aus Passau.</em>).",
