      { id: "sprechen", label: "Sprechen: Bildbeschreibung", icon: "mic", href: "/uebungen/sprechen", level: "A2/B1", levelSource: "abgeleitet", eyebrow: "Übung · B1", lead: "Bildbeschreibung mit echten DTZ-Prüferfragen und 90-Sekunden-Timer — dieselbe Aufgabenform wie im Prüfungsteil Sprechen.", tasks: sprechen.length, done: 0, minutes: 15, practice: "speak" },
      { id: "lesen", label: "Lesen & Schreiben", icon: "pencil", href: "/uebungen/lesen-schreiben", level: "A2/B1", levelSource: "abgeleitet", eyebrow: "Übung · B1", lead: `DTZ-Leseverstehen-Simulation mit ${readingQuestionCount} Aufgaben in vier Teilen, dazu Schreibaufgaben.`, tasks: readingQuestionCount, done: 0, minutes: 25, practice: "choice" },
      { id: "kultur", label: "Kulturwissen", icon: "map-pin", href: "/uebungen/kultur", level: "B1", levelSource: "abgeleitet", eyebrow: "Übung · B1", lead: "Diskussionsthemen aus echten Unterrichtsgesprächen — mit Pro- und Kontra-Argumenten zum Nachsprechen.", tasks: kultur.topics.length, done: 0, minutes: 10, practice: "read" },
    ],
  },
];

// Everything below is derived — no percentage is typed by hand.
const sum = (ns: number[]) => ns.reduce((a, b) => a + b, 0);
const stats = (s: Section) => {
  const counted = s.items.filter((i) => typeof i.tasks === "number");
  const tasks = sum(counted.map((i) => i.tasks!));
  const done = sum(counted.map((i) => i.done ?? 0));
  return { tasks, done, minutes: sum(s.items.map((i) => i.minutes ?? 0)), pct: tasks ? Math.round((done / tasks) * 100) : null };
};
const sectionStats = Object.fromEntries(sections.map((s) => [s.id, stats(s)]));
const itemPct = (i: Item) => (i.tasks ? Math.round(((i.done ?? 0) / i.tasks) * 100) : null);
const sectionOf = Object.fromEntries(sections.flatMap((s) => s.items.map((i) => [i.id, s])));
const courseStats = sectionStats.weg;

const ladder = ["a1", "a2", "b1", "b2"].map((id) => {
  const s = sections.find((x) => x.id === id)!;
  const p = sectionStats[id].pct ?? 0;
  return { id, label: s.badge, state: p === 100 ? "done" : p > 0 ? "current" : "todo" };
});

/**
 * The module the group's main button leads to: the first one in curriculum order that
 * still has work in it, falling back to the first practisable entry and then to the
 * first entry at all — a group of pure reference pages still needs a target.
 *
 * On the server every `done` is 0, so this always picks the group's opening module; the
 * client repaints it against real progress on first paint.
 */
const nextOf = (s: Section): Item =>
  s.items.find((i) => i.practice && i.tasks && (i.done ?? 0) < i.tasks)
  ?? s.items.find((i) => i.practice)
  ?? s.items[0];

/** "Fang an mit" on an untouched group, "Weiter mit" once something has been answered. */
const nextKicker = (s: Section) =>
  s.items.some((i) => (i.done ?? 0) > 0) ? "Weiter mit" : "Fang an mit";

// Handed to the client: one flat item table, the sections, and what the course
// strip and the portions are counted from. No exercise content — nothing is
// practised on the map.
const clientData = {
  items: Object.fromEntries(sections.flatMap((s) => s.items.map((i) => [i.id, {
    label: i.label, eyebrow: i.eyebrow, lead: i.lead, href: i.href,
    level: i.level, levelSource: i.levelSource,
    tasks: i.tasks ?? null, done: i.done ?? 0, minutes: i.minutes ?? null,
    practice: i.practice ?? null, derived: i.derived ?? null,
    section: sectionOf[i.id].id, sectionLabel: sectionOf[i.id].label,
  }]))),
  sections: Object.fromEntries(sections.map((s) => [s.id, { label: s.label, badge: s.badge, items: s.items.map((i) => i.id) }])),
  // Which coarse skill bucket each kind of exercise reports into, so /uebungen's
  // existing per-skill stats keep working alongside the per-topic numbers.
  skillOf: Object.fromEntries(sections.flatMap((s) => s.items.map((i) => [i.id,
    i.practice === "cards" ? "wortschatz"
    : i.practice === "audio" ? "hoeren"
    : i.practice === "speak" ? "sprechen"
    : i.practice === "choice" || i.practice === "read" ? "lesen"
    : i.practice === "dtz" || i.practice === "bausteine" ? "pruefungen"
    : "grammatik"]))),
  picker: allGrammarItems.map((i) => ({ id: i.id, label: i.label, level: i.level, tasks: i.tasks })),
  // The grammar module's portions, in order. `parts` is a window over a topic's
  // ordered slots, so a portion's progress is what that topic has done inside it.
  portions,
};


const RING = 2 * Math.PI * 42;

interface Props {
  /** Which navigation variants to render. One = no toggle, that layout only. */
  variants?: ("a" | "b" | "c")[];
  /** Study mode: the test banner and the A/B/C toggle. Off for the real page. */
  study?: boolean;
}
const { variants = ["b"], study = false } = Astro.props;
const showVariant = (id: string) => variants.includes(id as any);
const defaultVariant = variants[0];

---
  <div class:list={["nv", study && "nv--study"]}>
