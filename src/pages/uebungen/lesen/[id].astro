---
// One Lesetext: the text, then the questions.
//
// The text stays on screen while the quiz runs — unlike a Hörtext, where hiding the
// transcript is the whole exercise. Reading comprehension is not a memory test: in the DTZ
// the sheet lies in front of you, and an exercise that takes it away is testing something
// the exam never asks for.
import Layout from "../../../layouts/Layout.astro";
import SiteNav from "../../../components/SiteNav.astro";
import Icon from "../../../components/Icon.astro";
import TextWithTranslation from "../../../components/TextWithTranslation.astro";
import VocabList from "../../../components/VocabList.astro";
import uebersetzungen from "../../../data/uebersetzungen/lesen.json";
import { lesen, neighbours, LESEN_ICON } from "../../../lib/fertigkeiten.js";
import "../../../styles/practice.css";
import "../../../styles/skills.css";

export function getStaticPaths() {
  return lesen.texts.map((text) => ({
    params: { id: text.id },
    props: { text, ...neighbours(lesen.texts, text) },
  }));
}

const { text, prev, next } = Astro.props;
const { types } = lesen;

// The translation and the word list, where one exists for this text. The German text and
// its **…** headings are rendered by TextWithTranslation.
const help = (uebersetzungen.entries as Record<string, any>)[text.id] ?? null;
---
<Layout
  title={`${text.title} – Leseverstehen ${text.level} – DeutschAcademy`}
  description={text.blurb}
>
  <SiteNav active="fertigkeiten" />
  <main class="practice-main">
    <a href="/uebungen/lesen" class="vp-back-link" data-i18n="lesen.back">← Alle Lesetexte</a>

    <article>
      <header class="sk-head">
        <span class="sk-card-ic"><Icon name={LESEN_ICON[text.type] ?? "book-open"} size={22} /></span>
        <div>
          <p class="eyebrow" data-i18n={`type.lesen.${text.type}`}>{types[text.type]}</p>
          <h1>{text.title}</h1>
        </div>
        <span class="sk-badge">{text.level}</span>
      </header>

      <p class="sk-blurb"><span data-i18n={`lesen.${text.id}.blurb`}>{text.blurb}</span> · <span data-i18n="skills.minutes" data-i18n-vars={JSON.stringify({ m: text.minutes })}>ca. {text.minutes} Minuten</span></p>

      <section class="sk-block">
        <h2 data-i18n="lesen.h2.text">Text</h2>
        {/* Before the text, folded: the words are there for whoever needs them first. */}
        {help?.vocab && <VocabList vocab={help.vocab} reviewed={help.reviewed} />}
        <TextWithTranslation text={text.text ?? ""} paragraphs={help?.paragraphs} reviewed={help?.reviewed} />
      </section>

      <section class="sk-block">
        <h2 data-i18n="lesen.h2.questions">Fragen zum Text</h2>
        <p class="sk-blurb" data-i18n="skills.quizIntro" data-i18n-vars={JSON.stringify({ n: text.questions?.length ?? 0 })}>{text.questions?.length ?? 0} Fragen. Antworte per Klick — die Erklärung steht danach dabei.</p>
        <div class="quiz-card" id="sk-quiz"></div>
      </section>

      <nav class="sk-prevnext">
        {prev ? <a href={`/uebungen/lesen/${prev.id}`}>← {prev.title}</a> : <span />}
        {next ? <a href={`/uebungen/lesen/${next.id}`}>{next.title} →</a> : <span />}
      </nav>
    </article>
  </main>

  <script type="application/json" id="sk-quiz-data" set:html={JSON.stringify(text.questions ?? [])}></script>
  <script>
    import { mountQuiz } from "../../../lib/quiz.js";
    import { recordAttempt } from "../../../lib/progress.js";

    const questions = JSON.parse(document.getElementById("sk-quiz-data").textContent);
    mountQuiz(document.getElementById("sk-quiz"), questions, {
      mode: "choice",
      // Not shuffled: the questions follow the text from top to bottom, and a learner who
      // is asked about paragraph four first has to read the whole thing twice.
      shuffle: false,
      showWrongCount: true,
      onAnswer: (ok) => recordAttempt({ skill: "lesen", correct: ok }),
    });
  </script>
</Layout>
