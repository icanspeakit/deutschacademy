      { id: "testdaf", label: "TestDaF", icon: "graduation-cap", href: "/pruefungen/testdaf", level: "B2–C1", levelSource: "data", eyebrow: "Prüfung", lead: "TestDaF setzt B2–C1 voraus — hier die Themen dieser Stufen.", meta: "B2–C1", practice: "picker" },

      /* DTZ skill practice, moved here out of Stufe B1. These are exam formats —
         Bildbeschreibung with real examiner questions, the Leseverstehen simulation,
