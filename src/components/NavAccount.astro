---
// The avatar button and its menu, in the nav's right-hand cluster.
//
// "Profil" used to be a text item in the content nav, between Landeskunde and the CTA.
// It is not content — it is about the learner rather than the material — and sitting in
// the same row as four subjects made the row read as eight equal choices. An avatar in
// the utility cluster says "you" without spending a word on it.
//
// What is left in the menu is the theme toggle. The menu used to carry two destinations
// as well, "Dashboard" and "Mein Fortschritt" — two names for one promise — which became
// one when the pages merged, and a menu holding a single destination is just a click in
// front of it. That link is now its own button in the cluster (SiteNav.astro).
//
// A display preference is the one thing that genuinely belongs here rather than beside
// it: it is a setting, not a place, so it has no page to be a link to, and putting it in
// the navbar would sit a colour scheme at the same altitude as the whole content tree.
//
// There is no account system yet, so the avatar is a monogram rather than a photo. No
// "Einstellungen" row: /einstellungen does not exist. Add rows when the pages do.
import ThemeToggle from "./ThemeToggle.astro";
import "../styles/site-nav.css";

// No links left. This held "Dashboard" and "Mein Fortschritt", then just the latter once
// the two pages merged — and a menu whose whole content is one destination is a click in
// front of that destination for no reason. Fortschritt is now its own button in the
// cluster (SiteNav.astro). What stays here is the display preference, which is a setting
// rather than a place: it has no page of its own to be a link to, and it belongs under
// "you" rather than in the content row. Add rows back when there is an account to hold.
---
<div class="lp-acct" data-acct>
  <button
    class="lp-acct-btn"
    type="button"
    aria-haspopup="true"
    aria-expanded="false"
    aria-controls="lp-acct-menu"
    aria-label="Konto"
    data-i18n-attr="aria-label:nav.account"
    data-acct-btn
  >
    {/* A monogram, not a photo: there is nobody signed in to have one, and a generic
        silhouette reads as a broken image. */}
    <span class="lp-acct-mono" aria-hidden="true">DA</span>
  </button>

  <div class="lp-acct-menu" id="lp-acct-menu" role="menu" aria-label="Konto" data-acct-menu hidden>
    {/* Not a menuitem: it is a control that stays put, and activating it should not
        close the menu the way following a link does. */}
    <div class="lp-acct-pref">
      <span data-i18n="nav.account.theme">Dunkelmodus</span>
      <ThemeToggle />
    </div>
  </div>
</div>

<script>
  /* The avatar menu -----------------------------------------------------------
     Click-driven rather than hover: unlike the subject menus this one is not a place
     anyone browses, and a menu that opens because the pointer passed the corner of the
     screen on its way to the scrollbar is a menu that opens by accident. */
  const root = document.querySelector<HTMLElement>("[data-acct]");
  const btn = root?.querySelector<HTMLButtonElement>("[data-acct-btn]");
  const menu = root?.querySelector<HTMLElement>("[data-acct-menu]");

  if (root && btn && menu) {
    const items = () => Array.from(menu.querySelectorAll<HTMLAnchorElement>("a[href]"));
    const isOpen = () => btn.getAttribute("aria-expanded") === "true";

    const open = (focusFirst = false) => {
      menu.removeAttribute("hidden");
      btn.setAttribute("aria-expanded", "true");
      root.classList.add("is-open");
      if (focusFirst) items()[0]?.focus();
    };
    const close = (refocus = false) => {
      menu.setAttribute("hidden", "");
      btn.setAttribute("aria-expanded", "false");
      root.classList.remove("is-open");
      if (refocus) btn.focus();
    };

    btn.addEventListener("click", () => (isOpen() ? close() : open()));
    btn.addEventListener("keydown", (e) => {
      if (e.key === "ArrowDown" || e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        open(true);
      } else if (e.key === "Escape") {
        close(true);
      }
    });

    menu.addEventListener("keydown", (e) => {
      if (e.key === "Escape") { e.preventDefault(); close(true); return; }
      if (e.key !== "ArrowDown" && e.key !== "ArrowUp") return;
      const list = items();
      if (!list.length) return;
      e.preventDefault();
      const i = list.indexOf(document.activeElement as HTMLAnchorElement);
      const next = e.key === "ArrowDown"
        ? (i + 1) % list.length
        : (i - 1 + list.length) % list.length;
      list[next].focus();
    });

    // Leaving by Tab closes it; clicking outside does too. The theme toggle lives
    // inside, so a click on it must not count as outside.
    root.addEventListener("focusout", (e) => {
      if (!root.contains(e.relatedTarget as Node)) close();
    });
    document.addEventListener("click", (e) => {
      if (!root.contains(e.target as Node)) close();
    });
  }
</script>
