---
// One Landeskunde topic: what the rule is, where it varies, how to say it, and a quiz.
//
// The blocks are all optional — a topic renders whichever of facts / prosCons / table /
// phrases it actually carries, so a new topic can be added to kultur.json without
// touching this file, and none of them has its shape hardcoded the way the old single
// page hardcoded a broadcaster table.
//
// Everything that explains — intro, question, facts, table — also comes in the learner's
// language (src/data/uebersetzungen/kultur.json), under the German block it belongs to.
// "So sagt man das" and the quiz stay German only: those are the part to learn.
import Layout from "../../../layouts/Layout.astro";
import SiteNav from "../../../components/SiteNav.astro";
import Icon from "../../../components/Icon.astro";
import GrammarHelp from "../../../components/GrammarHelp.astro";
import GrammarHelpText from "../../../components/GrammarHelpText.astro";
import kultur from "../../../data/kultur.json";
import kulturHelp from "../../../data/uebersetzungen/kultur.json";
import { field, item, list, table } from "../../../lib/helpContent.js";
import "../../../styles/practice.css";
import "../../../styles/kultur.css";

export function getStaticPaths() {
  return kultur.topics.map((topic, i) => ({
    params: { id: topic.id },
    props: {
      topic,
      prev: kultur.topics[i - 1] ?? null,
      next: kultur.topics[i + 1] ?? null,
    },
  }));
}

const { topic, prev, next } = Astro.props;
const sourcedInClass = topic.sourcing === "unterricht";
const tx = (kulturHelp.entries as Record<string, any>)[topic.id] ?? null;
// prosCons is stored per language as one object; the blocks below want one side of it.
// Keys for the scaffolding that comes out of kultur.json rather than out of this file: the
// eyebrow (a category name) and the link labels under a topic. Slugged from the German so
// a new topic needs no key list here — a label with no key yet just stays German.
const slug = (s: string) => s.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
const pc = (key: string) => tx?.prosCons ? Object.fromEntries(Object.entries(tx.prosCons).map(([k, v]: [string, any]) => [k, v[key]])) : null;
---
<Layout
  title={`${topic.title} – Landeskunde – DeutschAcademy`}
  description={topic.intro.slice(0, 160)}
>
  <SiteNav active="landeskunde" />
  <main class="practice-main" id="ku-page" data-gx="off">
    <a href="/uebungen/kultur" class="vp-back-link" data-i18n="kultur.back">← Alle Themen</a>

    <article class="ku-topic">
      <header class="ku-topic-head">
        <span class="ku-card-ic"><Icon name={topic.icon} size={22} /></span>
        <div>
          <p class="eyebrow" data-i18n={`kultur.eyebrow.${slug(topic.eyebrow)}`}>{topic.eyebrow}</p>
          <h1>{topic.title}</h1>
        </div>
        <span class="ku-badge">{topic.level}</span>
      </header>
      {tx && <GrammarHelp level={topic.level} root="ku-page" reviewed={kulturHelp.reviewed} />}

      <p class="ku-intro">{topic.intro}</p>
      <GrammarHelpText text={field(tx?.intro)} />
      <p class="ku-question">{topic.question}</p>
      <GrammarHelpText text={field(tx?.question)} />

      {topic.facts && (
        <section class="ku-block">
          <h2 data-i18n="kultur.h2.facts">Das Wichtigste</h2>
          <ul class="ku-facts">{topic.facts.map((f: string, i: number) => <li>{f}<GrammarHelpText text={item(tx?.facts, i)} /></li>)}</ul>
        </section>
      )}

      {topic.prosCons && (
        <section class="ku-block">
          <h2 data-i18n="kultur.h2.prosCons">Dafür und dagegen</h2>
          <div class="ku-proscons">
            <div>
              <h3>{topic.prosCons.prosLabel}</h3>
              <GrammarHelpText text={field(pc("prosLabel"))} />
              <ul>{topic.prosCons.pros.map((i: string, n: number) => <li>{i}<GrammarHelpText text={item(pc("pros"), n)} /></li>)}</ul>
            </div>
            <div>
              <h3>{topic.prosCons.consLabel}</h3>
              <GrammarHelpText text={field(pc("consLabel"))} />
              <ul>{topic.prosCons.cons.map((i: string, n: number) => <li>{i}<GrammarHelpText text={item(pc("cons"), n)} /></li>)}</ul>
            </div>
          </div>
        </section>
      )}

      {topic.context && <p class="ku-context">{topic.context}</p>}
      {topic.context && <GrammarHelpText text={field(tx?.context)} />}

      {topic.table && (
        <section class="ku-block">
          <h2>{topic.table.label}</h2>
          <div class="ku-tablewrap">
            <table class="ku-table">
              <thead><tr>{topic.table.columns.map((c: string) => <th>{c}</th>)}</tr></thead>
              <tbody>
                {topic.table.rows.map((row: string[]) => (
                  <tr>{row.map((cell) => <td>{cell}</td>)}</tr>
                ))}
              </tbody>
            </table>
          </div>
          <GrammarHelpText text={table(tx?.table)} />
        </section>
      )}

      {topic.phrases && (
        <section class="ku-block">
          <h2 data-i18n="kultur.h2.phrases">So sagt man das</h2>
          <ul class="ku-phrases">{topic.phrases.map((p: string) => <li>{p}</li>)}</ul>
        </section>
      )}

      <p class={`ku-source ${sourcedInClass ? "is-lesson" : ""}`}>
        {sourcedInClass
          ? <span data-i18n="kultur.source.lesson">Aus dem Unterricht:</span>
          : <span data-i18n="kultur.source.fact">Sachwissen:</span>}{" "}{topic.sourceNote}
      </p>
      <GrammarHelpText text={field(tx?.sourceNote)} />

      {topic.links && (
        <div class="ku-links">
          {topic.links.map((l: { label: string; href: string }) => (
            <a class="quiz-btn" href={l.href}><span data-i18n={`kultur.linkLabel.${slug(l.label)}`}>{l.label}</span> →</a>
          ))}
        </div>
      )}
    </article>

    <section class="ku-block ku-quizblock">
      <h2 data-i18n="kultur.h2.quiz">Quiz zu diesem Thema</h2>
      <p class="ku-quiz-intro" data-i18n="skills.quizIntro" data-i18n-vars={JSON.stringify({ n: topic.quiz.length })}>{topic.quiz.length} Fragen. Antworte per Klick — die Erklärung steht danach dabei.</p>
      <div class="quiz-card" id="ku-quiz"></div>
      <p class="ku-quiz-more">
        <a href="/uebungen/kultur/quiz" data-i18n="kultur.quiz.allLink">Quiz über alle Themen →</a>
      </p>
    </section>

    <nav class="ku-prevnext">
      {prev ? <a href={`/uebungen/kultur/${prev.id}`}>← {prev.title}</a> : <span />}
      {next ? <a href={`/uebungen/kultur/${next.id}`}>{next.title} →</a> : <span />}
    </nav>
  </main>

  <script type="application/json" id="ku-quiz-data" set:html={JSON.stringify(topic.quiz)}></script>
  <script type="module">
    import { mountQuiz } from "../../../lib/quiz.js";
    import { recordAttempt } from "../../../lib/progress.js";

    const questions = JSON.parse(document.getElementById("ku-quiz-data").textContent);
    mountQuiz(document.getElementById("ku-quiz"), questions, {
      mode: "choice",
      showWrongCount: true,
      onAnswer: (ok) => recordAttempt({ skill: "kultur", correct: ok }),
    });
  </script>
</Layout>
