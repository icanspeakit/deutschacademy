---
import "../styles/global.css";

interface Props {
  title?: string;
}

const { title = "Deutsch Academy – Da für Dich!" } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
