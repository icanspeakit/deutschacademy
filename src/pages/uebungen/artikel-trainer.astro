---
import Layout from "../../layouts/Layout.astro";
import SiteNav from "../../components/SiteNav.astro";
import ArtikelPicker from "../../components/ArtikelPicker.astro";
import LeichtToggle from "../../components/LeichtToggle.astro";
import "../../styles/akkusativ.css";
// The split layout the grammar topics and the Wortschatz trainer use: rule column beside
// the work on a desktop, one button on a phone. See src/lib/ruleColumn.js.
import "../../styles/verben-praepositionen.css";
import "../../styles/rule-intro.css";
import { nouns } from "../../lib/lexicon.js";

// One session is SESSION_SIZE questions drawn from the chosen level — the pool is now
// ~860 nouns (was 31 hand-listed ones), far too many for a single sitting.
const SESSION_SIZE = 25;

function explainArtikel(word, gender) {
  const lower = word.toLowerCase();
  if (word === "Mann" || word === "Arzt") return `„${word}“ bezeichnet eine männliche Person – solche Wörter sind maskulin.`;
  if (word === "Frau") return `„${word}“ bezeichnet eine weibliche Person – solche Wörter sind feminin.`;
  if (word === "Kind") return `„Kind“ ist ein Sonderfall: Es bezieht sich auf Jungen und Mädchen, ist aber grammatisch neutrum.`;
  if (word === "Kollege") return `„Kollege“ endet zwar auf -e, bezeichnet aber eine männliche Person – solche Personenbezeichnungen bleiben maskulin.`;
  if (lower.endsWith("in")) return `Die Endung -in kennzeichnet die weibliche Form (z. B. Ärztin, Kollegin) – solche Wörter sind feminin.`;
  if (lower.endsWith("chen") || lower.endsWith("lein")) return `Verkleinerungsformen auf -chen oder -lein sind immer neutrum.`;
  if (lower.endsWith("e")) return `Viele zweisilbige Wörter auf -e sind feminin (z. B. Tasche, Sonne, Katze).`;
  if (lower.endsWith("er")) return `Viele Wörter auf -er – Werkzeuge, Geräte und männliche Personenbezeichnungen – sind maskulin.`;
  if (lower.endsWith("el")) return `Viele Wörter auf -el sind maskulin (z. B. Schlüssel, Apfel).`;
  return `Für „${word}“ gibt es keine feste Regel – der Artikel wird mit dem Wort zusammen gelernt.`;
}

/* The same explanations in Leichte Sprache — see src/lib/leichteSprache.js.
 *
 * Every one of the sentences above is harder than the question it explains: "Verkleinerungs-
 * formen", "Personenbezeichnungen", "kennzeichnet die weibliche Form" are B2 vocabulary in
 * front of an A1 task, read by the learner who just got it wrong. These say the same thing
 * in short main clauses, one statement each, with the grammatical term either dropped or
 * restated in plain words right after it.
 *
 * Written by hand beside the originals on purpose: nothing here is generated, so a case
 * without an easy version keeps its normal text instead of an unchecked simplification. */
function explainArtikelLeicht(word, gender) {
  const lower = word.toLowerCase();
  if (word === "Mann" || word === "Arzt") return `Ein ${word} ist ein Mann. Wörter für Männer haben „der“.`;
  if (word === "Frau") return `Eine Frau ist kein Mann. Wörter für Frauen haben „die“.`;
  if (word === "Kind") return `Ein Kind kann ein Junge sein. Oder ein Mädchen. Trotzdem sagt man immer „das Kind“.`;
  if (word === "Kollege") return `„Kollege“ endet auf -e. Aber ein Kollege ist ein Mann. Darum sagt man „der Kollege“.`;
  if (lower.endsWith("in")) return `Das Wort endet auf -in. Das ist die Form für eine Frau. Solche Wörter haben „die“.`;
  if (lower.endsWith("chen") || lower.endsWith("lein")) return `Das Wort endet auf -chen oder -lein. Das heißt: Es ist etwas Kleines. Solche Wörter haben immer „das“.`;
  if (lower.endsWith("e")) return `Das Wort endet auf -e. Sehr viele kurze Wörter auf -e haben „die“. Zum Beispiel: die Tasche, die Sonne.`;
  if (lower.endsWith("er")) return `Das Wort endet auf -er. Sehr viele Wörter auf -er haben „der“. Zum Beispiel: der Computer.`;
  if (lower.endsWith("el")) return `Das Wort endet auf -el. Sehr viele Wörter auf -el haben „der“. Zum Beispiel: der Schlüssel.`;
  return `Für „${word}“ gibt es keine Regel. Lerne das Wort immer zusammen mit „${gender}“.`;
}

// `id` is the lexicon's stable slug, not an array index, so a learner's progress for
// "haus" survives every future addition to the pool.
// A1–B2: the lexicon carries gendered nouns at every one of them (386 / 478 / 762 /
// 951), and the old two-level filter put three quarters of them out of reach.
const pool = nouns({ level: ["A1", "A2", "B1", "B2"], has: "gender" }).map((n) => ({
  id: n.id,
  level: n.level,
  prompt: `___ ${n.lemma}?`,
  options: ["der", "die", "das"],
  answer: n.gender,
  explain: explainArtikel(n.lemma, n.gender),
  explainLeicht: explainArtikelLeicht(n.lemma, n.gender),
  change: `${n.gender} ${n.lemma}`,
}));

const AP_LEVELS = ["A1", "A2", "B1", "B2"];
const levelCounts = Object.fromEntries(AP_LEVELS.map((l) => [l, pool.filter((q) => q.level === l).length]));
const total = Math.min(SESSION_SIZE, pool.length);
---
<Layout title="Artikel-Trainer – DeutschAcademy">
  {/* .akk stays the outer scope: every --akk-* token the exercise and the rule card read
      is defined on it. It is no longer .akk--page, because .vp-page owns the page now. */}
  <div class="akk">
    <SiteNav active="grammatik" />

    <!-- Rendered collapsed, then opened by the script if this learner asked for it —
         the same contract the grammar topics use, so there is no re-layout on load. -->
    <!-- vp-page--rule-left: the Regel sits on the left here, the side the Wortschatz
         trainer and the Stufen rail already use, so the fold-away tab is where a learner
         has learnt to look for it rather than on the opposite edge. -->
    <main class="vp-page vp-page--split vp-page--rule-left vp-page--sheet" id="vp-page" data-rule="hidden" data-anim="off">
      <a href="/uebungen/grammatik" class="vp-back-link" data-i18n="header.back">← Zurück zur Übersicht</a>

      <div class="vp-workspace">
        <aside class="vp-col vp-col--rule" id="vp-rule">
          {/* The Wortschatz side column's shape, with this trainer's own contents: a rail
              of levels A1–B2 beside a panel of Runden, plus the Regel as one more rail
              entry. See ArtikelPicker.astro. The hero moved out of here with it — a column
              that is navigation should open with the navigation. */}
          <div class="vp-card vp-rule-card" id="vp-rule-card">
            <ArtikelPicker counts={levelCounts} session={SESSION_SIZE} current="A1" />
          </div>

          <button
            type="button"
            class="vp-rule-peek"
            id="vp-rule-peek"
            data-show="Stufe wählen"
            data-hide="Stufen ausblenden"
            aria-controls="vp-rule-card"
          >Stufe wählen</button>
        </aside>

        <div class="vp-sheet-scrim" data-sheet-close aria-hidden="true"></div>

        <section class="vp-col vp-col--ex">
          <div class="vp-ex-toolbar">
            <h2 class="vp-section-title" data-i18n="nav.exercises">Übungen</h2>
            <button
              type="button"
              class="vp-rule-toggle"
              id="vp-rule-toggle"
              data-show="Stufen einblenden"
              data-hide="Stufen ausblenden"
            >Stufen einblenden</button>
          </div>

          <div class="vp-card">
          <div class="akk-mode-row">
            <div class="akk-mode" role="group" aria-label="Übungsmodus" data-i18n-attr="aria-label:akk.mode.ariaLabel">
              <span class="akk-mode-label" data-i18n="akk.mode.label">Modus</span>
              <button class="akk-mode-btn active" data-mode="fokus" type="button" data-i18n="akk.mode.fokus">Fokus-Modus</button>
              <span class="akk-mode-sep">·</span>
              <button class="akk-mode-btn" data-mode="test" type="button" data-i18n="akk.mode.test">Testmodus</button>
            </div>
            {/* Niveau moved to the rail beside the work — four levels with their sizes
                do not fit an inline row. "Neue Runde" stays: it is about this sitting. */}
            <div class="akk-mode" role="group" aria-label="Runde">
              <button class="akk-level-btn akk-level-reload" id="akk-new-round" type="button">Neue Runde</button>
            </div>
            <LeichtToggle />
          </div>
          <div id="akk-exercise-root"></div>
          </div>

          <footer class="akk-footer">
            <div class="akk-session-ring">
              <svg viewBox="0 0 56 56">
                <circle class="akk-ring-track" cx="28" cy="28" r="24" />
                <circle class="akk-ring-fill" id="akk-ring-fill" cx="28" cy="28" r="24" stroke-dasharray="150.8" stroke-dashoffset="150.8" />
              </svg>
              <span class="akk-ring-num" id="akk-ring-num">0%</span>
            </div>
            <div class="akk-session-text">
              <span class="akk-session-label" data-i18n="akk.session.label">Diese Sitzung</span>
              <p class="akk-session-stats" id="akk-session-stats">0 von {total} beantwortet · 0 richtig · 0 Hinweise</p>
            </div>
            <span class="akk-session-badge" data-i18n="akk.session.badge">lokal · ohne Konto</span>
          </footer>
        </section>
      </div>

      <!-- The tab the folded column leaves behind. Outside .vp-col--rule on purpose: that
           column goes inert when it collapses (see ruleColumn.js), and a control inside it
           would go inert with it — the one control whose whole job is to bring it back. -->
      <button
        type="button"
        class="vp-rule-pivot"
        id="vp-rule-pivot"
        aria-controls="vp-rule-card"
        aria-expanded="true"
        title="Stufen einblenden"
      >
        <span class="vp-rule-pivot-chevron" aria-hidden="true"></span>
        <span class="vp-rule-pivot-label">Stufen</span>
      </button>
    </main>
  </div>

  <script type="application/json" id="akk-data" set:html={JSON.stringify(pool)}></script>
  <script type="application/json" id="akk-session-size" set:html={JSON.stringify(SESSION_SIZE)}></script>
  <script type="module">
    import { mountPracticeWorkspace } from "../../lib/practiceWorkspace.js";
    import { mountRuleColumn } from "../../lib/ruleColumn.js";
    import { mountLeichteSprache } from "../../lib/leichteSprache.js";
    import { recordAttempt } from "../../lib/progress.js";
    import { getLang, loadDict, onLangChange } from "../../lib/i18n.js";

    let dict = {};
    function tr(key, vars) {
      const str = dict[key];
      if (str == null) return key;
      if (!vars) return str;
      return str.replace(/\{(\w+)\}/g, (m, k) => (k in vars ? String(vars[k]) : m));
    }

    const pool = JSON.parse(document.getElementById("akk-data").textContent);
    const SESSION_SIZE = JSON.parse(document.getElementById("akk-session-size").textContent);
    const exerciseRoot = document.getElementById("akk-exercise-root");

    // Fisher-Yates: every round is a fresh random draw from the selected level, so the
    // same 25 nouns don't come up in the same order every visit.
    function drawSession(level) {
      const filtered = level === "alle" ? pool : pool.filter((q) => q.level === level);
      const shuffled = filtered.slice();
      for (let i = shuffled.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
      }
      return shuffled.slice(0, SESSION_SIZE);
    }

    const ringFill = document.getElementById("akk-ring-fill");
    const ringNum = document.getElementById("akk-ring-num");
    const statsText = document.getElementById("akk-session-stats");
    const RING_CIRCUMFERENCE = 150.8;

    let lastStats = { answered: 0, correct: 0, hints: 0, total: Math.min(SESSION_SIZE, pool.length) };
    function renderStats() {
      const { answered, correct, hints, total } = lastStats;
      const pct = total ? Math.round((correct / total) * 100) : 0;
      ringFill.style.strokeDashoffset = String(RING_CIRCUMFERENCE * (1 - pct / 100));
      ringNum.textContent = `${pct}%`;
      statsText.textContent = tr("akk.session.stats", { answered, total, correct, hints });
    }
    function onSessionUpdate(stats) {
      lastStats = stats;
      renderStats();
    }

    async function bootI18n() {
      dict = await loadDict(getLang());
      renderStats();
    }
    onLangChange((code, newDict) => {
      dict = newDict;
      renderStats();
    });
    bootI18n();

    // Changing level or starting a new round remounts the workspace — it builds all its
    // state from the question array it is given, so a fresh mount is the clean reset.
    //
    // The nav's Niveaus menu links straight here per level (?niveau=A2), so the opening
    // level is read from the URL. Anything unrecognised falls back to A1 rather than
    // starting an empty session.
    // The rail owns the level now. "alle" is the whole pool, not a fifth level — see the
    // note in ArtikelPicker.astro. ?niveau= still opens a level directly, which is what the
    // nav's per-level links point at.
    const LEVEL_KEYS = ["A1", "A2", "B1", "B2", "alle"];
    const wanted = (new URLSearchParams(location.search).get("niveau") || "").trim();
    const asKey = /^alle?$/i.test(wanted) ? "alle" : wanted.toUpperCase();
    let level = LEVEL_KEYS.includes(asKey) ? asKey : "A1";
    let mode = "fokus";
    let practice = null;

    function startSession() {
      exerciseRoot.innerHTML = "";
      practice = mountPracticeWorkspace(exerciseRoot, drawSession(level), {
        onSessionUpdate,
        onAnswer: (ok, id) => recordAttempt({ skill: "grammatik", correct: ok, id, trackVocab: true }),
      });
      practice.setMode(mode);
    }

    /* The rail and the panel, wired the way the Lernset column is: a rail button swaps
       which pane is shown, a Runde row starts a session. A round is a fresh shuffled draw
       from the level rather than a fixed slice of it, so every row starts the same kind of
       thing — the number says how many sittings the level is, not which nouns. */
    const railBtns = Array.from(document.querySelectorAll(".ap-nvb [data-rail]"));
    const panes = Array.from(document.querySelectorAll(".ap-nvb [data-pane]"));

    function showPane(key) {
      panes.forEach((p) => { p.hidden = p.dataset.pane !== key; });
      railBtns.forEach((b) => {
        const on = b.dataset.rail === key;
        b.classList.toggle("active", on);
        b.setAttribute("aria-selected", String(on));
      });
    }

    function setLevel(next, { restart = true } = {}) {
      level = next;
      showPane(next);
      if (restart) startSession();
      markRound(0);
    }

    function markRound(i) {
      document.querySelectorAll(".ap-round").forEach((r) => {
        r.classList.toggle("active", r.dataset.roundLevel === level && Number(r.dataset.round) === i);
      });
    }

    railBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const key = btn.dataset.rail;
        // The Regel is a pane, not a level: showing it must not throw away the session
        // the learner is in the middle of.
        if (key === "regel") { showPane("regel"); return; }
        setLevel(key);
      });
    });

    document.querySelectorAll(".ap-round").forEach((row) => {
      row.addEventListener("click", () => {
        const lv = row.dataset.roundLevel;
        if (lv !== level) setLevel(lv, { restart: false });
        startSession();
        markRound(Number(row.dataset.round));
      });
    });

    // The workspace rebuilds its DOM on every answer, so the switch watches for what
    // arrives rather than painting once — see the MutationObserver note in leichteSprache.js.
    mountLeichteSprache(document.getElementById("vp-page"));

    showPane(level);
    startSession();
    markRound(0);

    document.getElementById("akk-new-round").addEventListener("click", () => { startSession(); markRound(0); });

    // The rule column's behaviour — collapse state per learner, what "collapsed" means at
    // each width, the one-time tour — is the same module the grammar topics and the exam
    // pages use. Its own storage key, so this page's preference is its own.
    mountRuleColumn(document.getElementById("vp-page"), {
      storageKey: "da-artikel-rule",
      seenKey: "da-artikel-rule-peek",
      // Below 1001px the Regel is a bottom sheet rather than an accordion, as the
      // Wortschatz picker is. The table is five rows tall: expanded in place it pushed the
      // exercise a screen down and took its own "einklappen" button with it.
      sheet: true,
    });

    document.querySelectorAll(".akk-mode-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        document.querySelectorAll(".akk-mode-btn").forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");
        mode = btn.dataset.mode;
        practice.setMode(mode);
      });
    });
  </script>
</Layout>
