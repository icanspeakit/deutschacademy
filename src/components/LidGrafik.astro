---
// One picture per "Leben in Deutschland" topic, drawn here as inline SVG in the site's
// colours — no photos, so nothing to license and nothing to download. Each one shows the
// topic's structure, not decoration: the three powers as pillars, the four election
// principles, the timeline, the social insurances. Labels are short and the same in both
// language levels. Used under the facts in all three layouts of fakten.astro, followed in
// "In einfachem Deutsch" by the topic's few key words (LidWoerter below).
interface Props {
  id: string;
  words?: { de: string; easy: string }[];
}
const { id, words = [] } = Astro.props;
const uid = `lg-${id}-${Math.random().toString(36).slice(2, 7)}`;
---
<figure class="lg" data-topic={id}>
  {id === "demokratie" && (
    <svg viewBox="0 0 560 250" role="img" aria-labelledby={`${uid}-t`}>
      <title id={`${uid}-t`}>Gewaltenteilung: Legislative, Exekutive und Judikative, gewählt vom Volk</title>
      {/* roof: the Grundgesetz over all three */}
      <path d="M40 70 L280 18 L520 70 Z" class="lg-fill-soft lg-stroke" />
      <text x="280" y="58" class="lg-t lg-t-b" text-anchor="middle">Grundgesetz</text>
      {[
        { x: 44, t: "Gesetze machen", s: "Bundestag · Bundesrat", w: "Legislative" },
        { x: 210, t: "Regieren", s: "Regierung · Kanzler/in", w: "Exekutive" },
        { x: 376, t: "Recht sprechen", s: "Gerichte · Richter", w: "Judikative" },
      ].map((p) => (
        <g>
          <rect x={p.x} y="82" width="140" height="104" rx="8" class="lg-fill lg-stroke" />
          <text x={p.x + 70} y="116" class="lg-t lg-t-b" text-anchor="middle">{p.t}</text>
          <text x={p.x + 70} y="138" class="lg-t lg-t-s" text-anchor="middle">{p.s}</text>
          <text x={p.x + 70} y="168" class="lg-t lg-t-m" text-anchor="middle">{p.w}</text>
        </g>
      ))}
      <rect x="40" y="194" width="480" height="12" rx="3" class="lg-fill-soft lg-stroke" />
      {/* the people, who choose */}
      {[0, 1, 2, 3, 4, 5, 6].map((i) => (
        <g transform={`translate(${196 + i * 28} 224)`} class="lg-person">
          <circle r="6" cy="-4" /><path d="M-9 14 Q0 2 9 14 Z" />
        </g>
      ))}
      <text x="160" y="232" class="lg-t lg-t-s" text-anchor="end">Das Volk wählt</text>
    </svg>
  )}

  {id === "wahlen" && (
    <svg viewBox="0 0 560 210" role="img" aria-labelledby={`${uid}-t`}>
      <title id={`${uid}-t`}>Wahlen sind frei, geheim, gleich und allgemein</title>
      {[
        { t: "frei", s: "Du entscheidest.", icon: "free" },
        { t: "geheim", s: "Niemand sieht es.", icon: "secret" },
        { t: "gleich", s: "Jede Stimme zählt.", icon: "equal" },
        { t: "allgemein", s: "Ab 18 Jahren.", icon: "all" },
      ].map((p, i) => {
        const x = 12 + i * 137;
        return (
          <g>
            <rect x={x} y="12" width="125" height="150" rx="12" class="lg-fill lg-stroke" />
            <g transform={`translate(${x + 62} 62)`} class="lg-icon">
              {p.icon === "free" && <><rect x="-20" y="-14" width="40" height="30" rx="4" /><path d="M-10 -2 l7 7 13 -14" class="lg-ok" /></>}
              {p.icon === "secret" && <><rect x="-22" y="-16" width="44" height="34" rx="4" /><path d="M-8 -16 v-6 a8 8 0 0 1 16 0 v6" /><circle r="4" cy="2" /></>}
              {p.icon === "equal" && <><path d="M-22 -6 h44 M-22 8 h44" /></>}
              {p.icon === "all" && <><circle r="7" cx="-14" cy="-6" /><circle r="7" cy="-10" /><circle r="7" cx="14" cy="-6" /><path d="M-26 18 q12 -14 24 0 M-10 16 q10 -16 20 0 M2 18 q12 -14 24 0" /></>}
            </g>
            <text x={x + 62} y="118" class="lg-t lg-t-b" text-anchor="middle">{p.t}</text>
            <text x={x + 62} y="140" class="lg-t lg-t-s" text-anchor="middle">{p.s}</text>
          </g>
        );
      })}
      <text x="280" y="192" class="lg-t lg-t-s" text-anchor="middle">Bund: alle 4 Jahre · Land: je nach Bundesland (Bayern 5) · Stadt: Kommunalwahl</text>
    </svg>
  )}

  {id === "grundrechte" && (
    <svg viewBox="0 0 560 220" role="img" aria-labelledby={`${uid}-t`}>
      <title id={`${uid}-t`}>Das Grundgesetz schützt Würde, Meinung, Versammlung, Religion und Gleichheit</title>
      <g transform="translate(20 20)">
        <rect width="110" height="150" rx="6" class="lg-fill-strong" />
        <rect x="8" y="0" width="4" height="150" class="lg-fill-soft" />
        <text x="60" y="66" class="lg-t lg-t-inv lg-t-b" text-anchor="middle">GRUND-</text>
        <text x="60" y="86" class="lg-t lg-t-inv lg-t-b" text-anchor="middle">GESETZ</text>
        <text x="60" y="116" class="lg-t lg-t-inv lg-t-s" text-anchor="middle">Art. 1: Würde</text>
      </g>
      {[
        { t: "Meinung", icon: "speech" },
        { t: "Versammlung", icon: "group" },
        { t: "Religion", icon: "faith" },
        { t: "Gleichheit", icon: "scale" },
      ].map((p, i) => {
        const x = 150 + (i % 2) * 200, y = 20 + Math.floor(i / 2) * 80;
        return (
          <g>
            <rect x={x} y={y} width="188" height="68" rx="10" class="lg-fill lg-stroke" />
            <g transform={`translate(${x + 36} ${y + 34})`} class="lg-icon">
              {p.icon === "speech" && <path d="M-16 -12 h32 a4 4 0 0 1 4 4 v14 a4 4 0 0 1 -4 4 h-18 l-8 8 v-8 h-6 a4 4 0 0 1 -4 -4 v-14 a4 4 0 0 1 4 -4 z" />}
              {p.icon === "group" && <><circle r="5" cx="-10" cy="-6" /><circle r="5" cx="10" cy="-6" /><path d="M-20 12 q10 -14 20 0 M0 12 q10 -14 20 0" /></>}
              {p.icon === "faith" && <><path d="M0 -16 v32 M-10 -6 h20" /></>}
              {p.icon === "scale" && <><path d="M0 -16 v30 M-14 -10 h28 M-14 -10 l-7 12 h14 z M14 -10 l-7 12 h14 z" /></>}
            </g>
            <text x={x + 68} y={y + 40} class="lg-t lg-t-b">{p.t}</text>
          </g>
        );
      })}
      <text x="150" y="200" class="lg-t lg-t-s">Pflichten: Gesetze befolgen · Steuern zahlen · Schule für Kinder</text>
    </svg>
  )}

  {id === "geschichte" && (
    <svg viewBox="0 0 560 190" role="img" aria-labelledby={`${uid}-t`}>
      <title id={`${uid}-t`}>Zeitleiste der deutschen Geschichte von 1919 bis 1990</title>
      <line x1="20" y1="96" x2="540" y2="96" class="lg-line" />
      {[
        { y: "1919", t: "Weimarer", t2: "Republik", x: 30, tone: "ok" },
        { y: "1933", t: "Hitler,", t2: "Diktatur", x: 110, tone: "bad" },
        { y: "1939", t: "2. Welt-", t2: "krieg", x: 180, tone: "bad" },
        { y: "1945", t: "Kriegs-", t2: "ende", x: 250, tone: "mid" },
        { y: "1949", t: "BRD", t2: "und DDR", x: 320, tone: "mid" },
        { y: "1961", t: "Mauer", t2: "in Berlin", x: 390, tone: "bad" },
        { y: "1989", t: "Mauer", t2: "fällt", x: 460, tone: "ok" },
        { y: "1990", t: "3. Okt.:", t2: "Einheit", x: 525, tone: "ok" },
      ].map((e, i) => (
        <g>
          <circle cx={e.x} cy="96" r="8" class={`lg-dot lg-dot--${e.tone}`} />
          <text x={e.x} y={i % 2 ? 136 : 70} class="lg-t lg-t-b" text-anchor="middle">{e.y}</text>
          <text x={e.x} y={i % 2 ? 154 : 40} class="lg-t lg-t-s" text-anchor="middle">{e.t}</text>
          <text x={e.x} y={i % 2 ? 170 : 54} class="lg-t lg-t-s" text-anchor="middle">{e.t2}</text>
        </g>
      ))}
    </svg>
  )}

  {id === "arbeit" && (
    <svg viewBox="0 0 560 250" role="img" aria-labelledby={`${uid}-t`}>
      <title id={`${uid}-t`}>Arbeit: 8 Stunden am Tag, 40 in der Woche, mindestens 20 Urlaubstage, und vier Sozialversicherungen</title>
      {[
        { n: "8", t: "Stunden", s: "pro Tag" },
        { n: "40", t: "Stunden", s: "pro Woche" },
        { n: "20", t: "Tage Urlaub", s: "mindestens" },
      ].map((p, i) => (
        <g>
          <rect x={12 + i * 180} y="10" width="170" height="80" rx="12" class="lg-fill lg-stroke" />
          <text x={52 + i * 180} y="64" class="lg-t lg-num" text-anchor="middle">{p.n}</text>
          <text x={90 + i * 180} y="46" class="lg-t lg-t-b">{p.t}</text>
          <text x={90 + i * 180} y="66" class="lg-t lg-t-s">{p.s}</text>
        </g>
      ))}
      <text x="280" y="120" class="lg-t lg-t-m" text-anchor="middle">Der Sozialstaat hilft — mit vier Versicherungen</text>
      {[
        { t: "Kranken-", s: "Arzt, Medikamente", icon: "cross" },
        { t: "Arbeitslosen-", s: "Geld ohne Job", icon: "case" },
        { t: "Renten-", s: "Geld im Alter", icon: "clock" },
        { t: "Pflege-", s: "Hilfe im Alltag", icon: "hand" },
      ].map((p, i) => {
        const x = 12 + i * 137;
        return (
          <g>
            <rect x={x} y="134" width="125" height="108" rx="10" class="lg-fill-soft lg-stroke" />
            <g transform={`translate(${x + 26} 160)`} class="lg-icon lg-icon-sm">
              {p.icon === "cross" && <path d="M-4 -12 h8 v8 h8 v8 h-8 v8 h-8 v-8 h-8 v-8 h8 z" />}
              {p.icon === "case" && <><rect x="-12" y="-6" width="24" height="16" rx="2" /><path d="M-5 -6 v-4 h10 v4" /></>}
              {p.icon === "clock" && <><circle r="12" /><path d="M0 -7 v7 l5 4" /></>}
              {p.icon === "hand" && <path d="M-12 6 q6 -10 14 -6 l8 -8 q3 -3 5 0 l-9 12 q-4 6 -12 6 z" />}
            </g>
            <text x={x + 12} y="194" class="lg-t lg-t-b">{p.t}</text>
            <text x={x + 12} y="211" class="lg-t lg-t-s">versicherung</text>
            <text x={x + 12} y="230" class="lg-t lg-t-s lg-t-muted">{p.s}</text>
          </g>
        );
      })}
    </svg>
  )}

  {id === "familie" && (
    <svg viewBox="0 0 560 200" role="img" aria-labelledby={`${uid}-t`}>
      <title id={`${uid}-t`}>Familie: Schulpflicht, keine Gewalt, keine Kinderarbeit, Ehe für alle, Eltern sorgen für ihre Kinder</title>
      <g transform="translate(70 100)" class="lg-person lg-person-lg">
        <circle r="14" cx="-30" cy="-38" /><path d="M-52 20 Q-30 -20 -8 20 Z" />
        <circle r="14" cx="30" cy="-38" /><path d="M8 20 Q30 -20 52 20 Z" />
        <circle r="9" cy="-8" /><path d="M-14 36 Q0 8 14 36 Z" />
      </g>
      {[
        { t: "Schulpflicht", icon: "school" },
        { t: "Keine Gewalt", icon: "noHit" },
        { t: "Keine Kinderarbeit", icon: "noWork" },
        { t: "Ehe für alle", icon: "rings" },
      ].map((p, i) => {
        const x = 150 + (i % 2) * 204, y = 16 + Math.floor(i / 2) * 84;
        return (
          <g>
            <rect x={x} y={y} width="198" height="70" rx="10" class="lg-fill lg-stroke" />
            <g transform={`translate(${x + 32} ${y + 35})`} class="lg-icon">
              {p.icon === "school" && <><path d="M-18 -4 L0 -14 L18 -4 L0 6 Z" /><path d="M-10 0 v10 q10 6 20 0 v-10" /></>}
              {p.icon === "noHit" && <><circle r="15" /><path d="M-10 10 L10 -10" /></>}
              {p.icon === "noWork" && <><circle r="15" /><path d="M-6 -4 h12 v10 h-12 z M-3 -4 v-3 h6 v3" /><path d="M-10 10 L10 -10" /></>}
              {p.icon === "rings" && <><circle r="9" cx="-6" /><circle r="9" cx="6" /></>}
            </g>
            <text x={x + 58} y={y + 41} class="lg-t lg-t-b">{p.t}</text>
          </g>
        );
      })}
    </svg>
  )}

  {words.length > 0 && (
    <div class="lg-words fk-easy">
      <p class="lg-words-h">Wichtige Wörter</p>
      <dl>
        {words.map((w) => (<div><dt>{w.de}</dt><dd>{w.easy}</dd></div>))}
      </dl>
    </div>
  )}
</figure>

<style is:global>
  .lg { margin: 18px 0 6px; }
  .lg svg { display: block; width: 100%; height: auto; max-width: 620px; margin: 0 auto; }
  /* On a phone a 560-wide drawing scaled to 330px puts its labels at 7px. It keeps a
     readable width instead and scrolls sideways inside the figure. */
  @media (max-width: 600px) {
    .lg { overflow-x: auto; -webkit-overflow-scrolling: touch; margin-inline: -4px; padding-bottom: 6px; }
    .lg svg { min-width: 500px; }
    .lg-words { min-width: 0; position: sticky; left: 0; }
  }
  .lg .lg-fill { fill: var(--surface-card); }
  .lg .lg-fill-soft { fill: color-mix(in srgb, var(--brand-blue) 10%, var(--surface-card)); }
  .lg .lg-fill-strong { fill: var(--brand-blue); }
  .lg .lg-stroke { stroke: color-mix(in srgb, var(--brand-blue) 45%, var(--border)); stroke-width: 1.5; }
  .lg .lg-line { stroke: var(--border-strong); stroke-width: 3; stroke-linecap: round; }
  .lg .lg-t { fill: var(--ink); font-family: var(--font-body); font-size: 13px; }
  .lg .lg-t-b { font-weight: 700; font-size: 14px; }
  .lg .lg-t-s { fill: var(--muted); font-size: 11.5px; }
  .lg .lg-t-m { fill: var(--brand-blue-dark, var(--brand-blue)); font-weight: 700; font-size: 12px; letter-spacing: .04em; }
  .lg .lg-t-muted { fill: var(--muted-soft, var(--muted)); }
  .lg .lg-t-inv { fill: #fff; }
  .lg .lg-num { fill: var(--brand-blue); font-size: 34px; font-weight: 700; }
  .lg .lg-icon { fill: none; stroke: var(--brand-blue); stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }
  .lg .lg-icon .lg-ok { stroke: var(--success, #047857); }
  .lg .lg-person { fill: color-mix(in srgb, var(--brand-blue) 55%, var(--surface-card)); }
  .lg .lg-dot { stroke: var(--surface-card); stroke-width: 3; }
  .lg .lg-dot--ok { fill: var(--success, #047857); }
  .lg .lg-dot--bad { fill: var(--danger, #c1462f); }
  .lg .lg-dot--mid { fill: var(--muted); }

  /* The key words, only in "In einfachem Deutsch" (.fk-easy — fakten-layouts.css). */
  .lg-words { margin: 18px auto 0; max-width: 620px; padding: 14px 16px; border-radius: 12px; background: color-mix(in srgb, var(--brand-blue) 7%, var(--surface-card)); border: 1px solid color-mix(in srgb, var(--brand-blue) 25%, var(--border)); }
  .lg-words-h { margin: 0 0 8px; font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--brand-blue-dark, var(--brand-blue)); }
  .lg-words dl { margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 8px 18px; }
  .lg-words dt { font-weight: 700; color: var(--ink); }
  .lg-words dd { margin: 0; color: var(--muted); font-size: .95rem; }
</style>
