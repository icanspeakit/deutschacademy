---
// The der/die/das trainer: a rail of levels A1–B2 and the Häufigkeit order beside a
// Fokus/Testmodus workspace over every gendered noun in the lexicon, with the spoken
// answer, Langsam and the back button. A level's pane offers "Weiter üben" and packs by
// topic and rule; sessions are built from the learner's own per-noun history
// (src/lib/artikelVerlauf.js), not from numbered rounds.
//
// It lives on /uebungen/grammatik/artikel as that topic's Üben view — the lesson (Sehen,
// Hören, Sprechen) stays around it, and this is what "Schreiben" hands over to. It used
// to be a page of its own at /uebungen/artikel-trainer, which now redirects here; the two
// had drifted into different exercises for the same topic.
//
// Renders the page's .vp-workspace and the rule pivot, so the host must be a
// .vp-page.vp-page--split with id="vp-page", and must not mount its own rule column.
import ArtikelPicker from "./ArtikelPicker.astro";
import LeichtToggle from "./LeichtToggle.astro";
import "../styles/akkusativ.css";
// The split layout the grammar topics and the Wortschatz trainer use: rule column beside
// the work on a desktop, one button on a phone. See src/lib/ruleColumn.js.
import "../styles/verben-praepositionen.css";
import "../styles/rule-intro.css";
import { buildArtikelPacks, PACK_CONFIG } from "../lib/artikelPacks.js";
import { nouns } from "../lib/lexicon.js";
// Corpus counts for the ranked nouns, written by scripts/artikel-haeufigkeit.mjs.
import haeufigkeit from "../data/artikel-haeufigkeit.json";

// One session is SESSION_SIZE questions drawn from the chosen level — the pool is now
// ~860 nouns (was 31 hand-listed ones), far too many for a single sitting.
const SESSION_SIZE = 25;

function explainArtikel(word, gender) {
  const lower = word.toLowerCase();
  if (word === "Mann" || word === "Arzt") return `„${word}“ bezeichnet eine männliche Person – solche Wörter sind maskulin.`;
  if (word === "Frau") return `„${word}“ bezeichnet eine weibliche Person – solche Wörter sind feminin.`;
  if (word === "Kind") return `„Kind“ ist ein Sonderfall: Es bezieht sich auf Jungen und Mädchen, ist aber grammatisch neutrum.`;
  if (word === "Kollege") return `„Kollege“ endet zwar auf -e, bezeichnet aber eine männliche Person – solche Personenbezeichnungen bleiben maskulin.`;
  if (lower.endsWith("in")) return `Die Endung -in kennzeichnet die weibliche Form (z. B. Ärztin, Kollegin) – solche Wörter sind feminin.`;
  if (lower.endsWith("chen") || lower.endsWith("lein")) return `Verkleinerungsformen auf -chen oder -lein sind immer neutrum.`;
  if (lower.endsWith("e")) return `Viele zweisilbige Wörter auf -e sind feminin (z. B. Tasche, Sonne, Katze).`;
  if (lower.endsWith("er")) return `Viele Wörter auf -er – Werkzeuge, Geräte und männliche Personenbezeichnungen – sind maskulin.`;
  if (lower.endsWith("el")) return `Viele Wörter auf -el sind maskulin (z. B. Schlüssel, Apfel).`;
  return `Für „${word}“ gibt es keine feste Regel – der Artikel wird mit dem Wort zusammen gelernt.`;
}

/* The same explanations in Leichte Sprache — see src/lib/leichteSprache.js.
 *
 * Every one of the sentences above is harder than the question it explains: "Verkleinerungs-
 * formen", "Personenbezeichnungen", "kennzeichnet die weibliche Form" are B2 vocabulary in
 * front of an A1 task, read by the learner who just got it wrong. These say the same thing
 * in short main clauses, one statement each, with the grammatical term either dropped or
 * restated in plain words right after it.
 *
 * Written by hand beside the originals on purpose: nothing here is generated, so a case
 * without an easy version keeps its normal text instead of an unchecked simplification. */
function explainArtikelLeicht(word, gender) {
  const lower = word.toLowerCase();
  if (word === "Mann" || word === "Arzt") return `Ein ${word} ist ein Mann. Wörter für Männer haben „der“.`;
  if (word === "Frau") return `Eine Frau ist kein Mann. Wörter für Frauen haben „die“.`;
  if (word === "Kind") return `Ein Kind kann ein Junge sein. Oder ein Mädchen. Trotzdem sagt man immer „das Kind“.`;
  if (word === "Kollege") return `„Kollege“ endet auf -e. Aber ein Kollege ist ein Mann. Darum sagt man „der Kollege“.`;
  if (lower.endsWith("in")) return `Das Wort endet auf -in. Das ist die Form für eine Frau. Solche Wörter haben „die“.`;
  if (lower.endsWith("chen") || lower.endsWith("lein")) return `Das Wort endet auf -chen oder -lein. Das heißt: Es ist etwas Kleines. Solche Wörter haben immer „das“.`;
  if (lower.endsWith("e")) return `Das Wort endet auf -e. Sehr viele kurze Wörter auf -e haben „die“. Zum Beispiel: die Tasche, die Sonne.`;
  if (lower.endsWith("er")) return `Das Wort endet auf -er. Sehr viele Wörter auf -er haben „der“. Zum Beispiel: der Computer.`;
  if (lower.endsWith("el")) return `Das Wort endet auf -el. Sehr viele Wörter auf -el haben „der“. Zum Beispiel: der Schlüssel.`;
  return `Für „${word}“ gibt es keine Regel. Lerne das Wort immer zusammen mit „${gender}“.`;
}

// `id` is the lexicon's stable slug, not an array index, so a learner's progress for
// "haus" survives every future addition to the pool.
// A1–B2: the lexicon carries gendered nouns at every one of them (386 / 478 / 762 /
// 951), and the old two-level filter put three quarters of them out of reach.
const lexNouns = nouns({ level: ["A1", "A2", "B1", "B2"], has: "gender" });

// "Nach Häufigkeit": the nouns that have a corpus count, most frequent first. `freqPos` is
// the place in that order (1 = most frequent), which is what a round slices on.
const ranked = lexNouns
  .filter((n) => n.rank != null && haeufigkeit[n.id])
  .sort((a, b) => a.rank - b.rank);
const freqPos = new Map(ranked.map((n, i) => [n.id, i + 1]));
const freqTotal = ranked.reduce((sum, n) => sum + haeufigkeit[n.id], 0);

const pool = lexNouns.map((n) => ({
  id: n.id,
  level: n.level,
  freqPos: freqPos.get(n.id) ?? null,
  // For the "Wie oft hört man das?" chart. `freq` is null for the nouns the corpus list
  // does not reach — the rarities.
  lemma: n.lemma,
  freq: freqPos.has(n.id) ? haeufigkeit[n.id] : null,
  prompt: `___ ${n.lemma}?`,
  options: ["der", "die", "das"],
  answer: n.gender,
  explain: explainArtikel(n.lemma, n.gender),
  explainLeicht: explainArtikelLeicht(n.lemma, n.gender),
  change: `${n.gender} ${n.lemma}`,
  // "der Tisch", spoken — only for nouns that have a file (see generate-wortschatz-audio
  // --nouns). Played once the answer is settled, never before: it says the article.
  ...(n.audio ? { audioSrc: `/audio/wortschatz/${n.audio}.mp3` } : {}),
}));

const AP_LEVELS = ["A1", "A2", "B1", "B2"];
const levelCounts = Object.fromEntries(AP_LEVELS.map((l) => [l, pool.filter((q) => q.level === l).length]));

// One round per weekday: five a week, which puts the 1621 ranked nouns at 65 rounds, or
// three months. Cover is cumulative, so each row says where the learner stands after it.
const PER_WEEK = 5;
let seen = 0;
const freqRounds = [];
for (let i = 0; i < ranked.length; i += SESSION_SIZE) {
  const slice = ranked.slice(i, i + SESSION_SIZE);
  seen += slice.reduce((sum, n) => sum + haeufigkeit[n.id], 0);
  freqRounds.push({
    index: freqRounds.length + 1,
    from: i + 1,
    to: i + slice.length,
    // Floored, so the last round is the only one that says 100 %.
    cover: Math.floor((seen / freqTotal) * 100),
    preview: slice.slice(0, 3).map((n) => `${n.gender} ${n.lemma}`).join(", ") + " …",
  });
}
const freq = { words: ranked.length, unranked: lexNouns.length - ranked.length, perWeek: PER_WEEK, rounds: freqRounds };

// Topic and rule packs per level — see src/lib/artikelPacks.js for how nouns are assigned
// and src/data/artikel-packs.json for the packs themselves.
const { byLevel: packs, exceptions } = buildArtikelPacks(lexNouns);
// What a rule-pack session says after a wrong answer: the rule, or for an exception, why
// it is one. Keyed by noun id; the client picks the one for the pack being played.
const exceptionText = Object.fromEntries(exceptions.map((e) => [e.id, {
  explain: `„${e.lemma}“ sieht aus wie „${PACK_CONFIG.rules.find((r) => r.id === e.rule)?.name}“ (${e.why}) — hat aber „${e.gender}“. Eine Ausnahme.`,
  explainLeicht: `„${e.lemma}“ passt nicht zur Regel. Man sagt „${e.gender} ${e.lemma}“.`,
}]));
const clientPacks = Object.fromEntries(AP_LEVELS.map((l) => [l, {
  topics: packs[l].topics.map(({ id, name, ids }) => ({ id, name, ids })),
  rules: packs[l].rules.map(({ id, name, rule, ruleLeicht, ids }) => ({ id, name, rule, ruleLeicht, ids })),
}]));

// The curve under the frequency chart, thinned: every point would be 1 621 path segments for
// a line 480px wide. The first 50 stay whole, because that is where it bends.
const curve = ranked
  .map((n, i) => [i + 1, haeufigkeit[n.id]])
  .filter(([p], i, all) => p <= 50 || p % 12 === 0 || i === all.length - 1);
const freqChart = {
  curve,
  total: ranked.length,
  maxCount: Math.max(...ranked.map((n) => haeufigkeit[n.id])),
  minCount: Math.min(...ranked.map((n) => haeufigkeit[n.id])),
};
---

  <div class="vp-workspace">
    <aside class="vp-col vp-col--rule" id="vp-rule">
      {/* The Wortschatz side column's shape, with this trainer's own contents: a rail
          of levels A1–B2 beside a panel of packs, plus the Regel as one more rail
          entry. See ArtikelPicker.astro. The hero moved out of here with it — a column
          that is navigation should open with the navigation. */}
      <div class="vp-card vp-rule-card" id="vp-rule-card">
        <ArtikelPicker counts={levelCounts} session={SESSION_SIZE} current="A1" freq={freq} packs={packs} />
      </div>

      <button
        type="button"
        class="vp-rule-peek"
        id="vp-rule-peek"
        data-show="Stufe wählen"
        data-hide="Stufen ausblenden"
        aria-controls="vp-rule-card"
      >Stufe wählen</button>
    </aside>

    <div class="vp-sheet-scrim" data-sheet-close aria-hidden="true"></div>

    <section class="vp-col vp-col--ex">
      <div class="vp-ex-toolbar">
        <button
          type="button"
          class="vp-rule-toggle"
          id="vp-rule-toggle"
          data-show="Stufen einblenden"
          data-hide="Stufen ausblenden"
        >Stufen einblenden</button>
      </div>

      <div class="vp-card">
      <div class="akk-mode-row">
        <div class="akk-mode" role="group" aria-label="Übungsmodus" data-i18n-attr="aria-label:akk.mode.ariaLabel">
          <button class="akk-mode-btn active" data-mode="fokus" type="button" data-i18n="akk.mode.fokus">Fokus-Modus</button>
          <span class="akk-mode-sep">·</span>
          <button class="akk-mode-btn" data-mode="test" type="button" data-i18n="akk.mode.test">Testmodus</button>
        </div>
        {/* Niveau and packs live in the rail beside the work. "Neu mischen" stays: it is
            about this sitting — the same pack again, a fresh draw. */}
        <div class="akk-mode" role="group" aria-label="Übung">
          <button class="akk-level-btn akk-level-reload" id="akk-new-round" type="button">Neu mischen</button>
        </div>
        {/* Sound on/off for "der Tisch" after each answer. Same switch as Leichte Sprache beside
            it; the state lives in practiceWorkspace.js, remembered per browser. */}
        <button type="button" class="ls-switch ls-switch--sound" data-sound-switch aria-pressed="true" title="Aussprache nach der Antwort an- oder ausschalten">
          <span class="ls-switch-track" aria-hidden="true"><span class="ls-switch-knob"></span></span>
          <span class="ls-switch-txt">
            <span class="ls-switch-kicker">Aussprache</span>
            <span class="ls-switch-state" data-sound-switch-state>Ton an</span>
          </span>
        </button>
        <LeichtToggle />
      </div>
      <p class="ak-now" data-ak-now aria-live="polite"></p>
      <div id="akk-exercise-root"></div>
      </div>

      {/* How common the words of this session are in real life — see artikelFreqChart.js. */}
      <figure class="vp-card afc" id="akk-freq">
        <figcaption class="afc-title">Wie oft hört man das?</figcaption>
        <p class="afc-head" data-freq-head aria-live="polite"></p>
        <div class="afc-plot">
          <svg role="img" aria-label="Häufigkeit der Wörter dieser Übung im Alltag"></svg>
          <div class="afc-tip" data-freq-tip hidden></div>
        </div>
        <p class="afc-note">Wie oft ein Wort in deutschen Film-Untertiteln vorkommt (OpenSubtitles). Rechts: Wörter, die dort zu selten sind, um gezählt zu werden.</p>
        <details class="afc-table">
          <summary>Alle Wörter dieser Übung</summary>
          <ol data-freq-list></ol>
        </details>
      </figure>

      <footer class="akk-footer">
        <div class="akk-session-ring">
          <svg viewBox="0 0 56 56">
            <circle class="akk-ring-track" cx="28" cy="28" r="24" />
            <circle class="akk-ring-fill" id="akk-ring-fill" cx="28" cy="28" r="24" stroke-dasharray="150.8" stroke-dashoffset="150.8" />
          </svg>
          <span class="akk-ring-num" id="akk-ring-num">0%</span>
        </div>
        <div class="akk-session-text">
          <span class="akk-session-label" data-i18n="akk.session.label">Diese Sitzung</span>
          <p class="akk-session-stats" id="akk-session-stats">0 von {SESSION_SIZE} beantwortet · 0 richtig · 0 Hinweise</p>
        </div>
        <span class="akk-session-badge" data-i18n="akk.session.badge">lokal · ohne Konto</span>
      </footer>
    </section>
  </div>

  <!-- The tab the folded column leaves behind. Outside .vp-col--rule on purpose: that
       column goes inert when it collapses (see ruleColumn.js), and a control inside it
       would go inert with it — the one control whose whole job is to bring it back. -->
  <button
    type="button"
    class="vp-rule-pivot"
    id="vp-rule-pivot"
    aria-controls="vp-rule-card"
    aria-expanded="true"
    title="Stufen einblenden"
  >
    <span class="vp-rule-pivot-chevron" aria-hidden="true"></span>
    <span class="vp-rule-pivot-label">Stufen</span>
  </button>

  <script type="application/json" id="akk-data" set:html={JSON.stringify(pool)}></script>
  <script type="application/json" id="akk-freq-data" set:html={JSON.stringify(freqChart)}></script>
  <script type="application/json" id="akk-session-size" set:html={JSON.stringify(SESSION_SIZE)}></script>
  <script type="application/json" id="akk-packs" set:html={JSON.stringify(clientPacks)}></script>
  <script type="application/json" id="akk-exceptions" set:html={JSON.stringify(exceptionText)}></script>
  <script type="module">
    import { mountPracticeWorkspace, isSoundOn, setSoundOn } from "../lib/practiceWorkspace.js";
    import { mountRuleColumn } from "../lib/ruleColumn.js";
    import { mountLeichteSprache } from "../lib/leichteSprache.js";
    import { recordAttempt } from "../lib/progress.js";
    import { mountFreqChart } from "../lib/artikelFreqChart.js";
    import { record, stats, buildSession, buildFehlerSession } from "../lib/artikelVerlauf.js";
    import { getLang, loadDict, onLangChange } from "../lib/i18n.js";

    let dict = {};
    function tr(key, vars) {
      const str = dict[key];
      if (str == null) return key;
      if (!vars) return str;
      return str.replace(/\{(\w+)\}/g, (m, k) => (k in vars ? String(vars[k]) : m));
    }

    const read = (id) => JSON.parse(document.getElementById(id).textContent);
    const pool = read("akk-data");
    const SESSION_SIZE = read("akk-session-size");
    const PACKS = read("akk-packs");
    const EXCEPTIONS = read("akk-exceptions");
    const byId = new Map(pool.map((q) => [q.id, q]));
    const exerciseRoot = document.getElementById("akk-exercise-root");
    const nowLine = document.querySelector("[data-ak-now]");

    // "Nach Häufigkeit": a Teil is a fixed slice of the frequency order, shuffled only
    // within itself, because which 25 nouns it is is the whole point. Everything else is
    // built from the learner's history — see artikelVerlauf.js.
    function drawFreqSlice(round) {
      const filtered = pool.filter((q) => q.freqPos > round * SESSION_SIZE && q.freqPos <= (round + 1) * SESSION_SIZE);
      const shuffled = filtered.slice();
      for (let i = shuffled.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
      }
      return shuffled.slice(0, SESSION_SIZE);
    }

    const ringFill = document.getElementById("akk-ring-fill");
    const ringNum = document.getElementById("akk-ring-num");
    const statsText = document.getElementById("akk-session-stats");
    const RING_CIRCUMFERENCE = 150.8;

    let lastStats = { answered: 0, correct: 0, hints: 0, total: SESSION_SIZE };
    function renderStats() {
      const { answered, correct, hints, total } = lastStats;
      const pct = total ? Math.round((correct / total) * 100) : 0;
      ringFill.style.strokeDashoffset = String(RING_CIRCUMFERENCE * (1 - pct / 100));
      ringNum.textContent = `${pct}%`;
      statsText.textContent = tr("akk.session.stats", { answered, total, correct, hints });
    }
    function onSessionUpdate(stats) {
      lastStats = stats;
      renderStats();
    }

    async function bootI18n() {
      dict = await loadDict(getLang());
      renderStats();
    }
    onLangChange((code, newDict) => {
      dict = newDict;
      renderStats();
    });
    bootI18n();

    // Changing level or starting a new round remounts the workspace — it builds all its
    // state from the question array it is given, so a fresh mount is the clean reset.
    //
    // The nav's Niveaus menu links straight here per level (?niveau=A2), so the opening
    // level is read from the URL. Anything unrecognised falls back to A1 rather than
    // starting an empty session.
    // The rail owns the level now. "haeufigkeit" is the frequency order, not a fifth level
    // — see the note in ArtikelPicker.astro. ?niveau= still opens a level directly, which
    // is what the nav's per-level links point at; the old ?niveau=alle lands on the
    // frequency view, which replaced it.
    const LEVEL_KEYS = ["A1", "A2", "B1", "B2", "haeufigkeit"];
    const wanted = (new URLSearchParams(location.search).get("niveau") || "").trim();
    const asKey = /^(alle?|h(ae|ä)ufigkeit)$/i.test(wanted) ? "haeufigkeit" : wanted.toUpperCase();
    let level = LEVEL_KEYS.includes(asKey) ? asKey : "A1";
    let round = 0;
    // What the running session is: "weiter" (the level, from history), "fehler", a
    // "topic"/"rule" pack, or "freq" (a Häufigkeit Teil, which `round` picks).
    let current = { kind: level === "haeufigkeit" ? "freq" : "weiter", id: null };
    let mode = "fokus";
    let practice = null;

    const freqChart = mountFreqChart(document.getElementById("akk-freq"), JSON.parse(document.getElementById("akk-freq-data").textContent));
    // The card on screen is the word the chart picks out. The workspace re-renders on every
    // step, so watch for the card rather than hook each path that changes it.
    new MutationObserver(() => {
      freqChart.setCurrent(exerciseRoot.querySelector(".akk-focus-card")?.dataset.qid ?? null);
    }).observe(exerciseRoot, { childList: true, subtree: true });

    function mount(questions) {
      exerciseRoot.innerHTML = "";
      freqChart.setRound(questions);
      practice = mountPracticeWorkspace(exerciseRoot, questions, {
        onSessionUpdate,
        onAnswer: (ok, id, info) => {
          // "Sicher" counts first tries only; a second tap among three options is half a guess.
          record(id, ok && info?.firstTry !== false);
          // `topic` too, so the topic bar above and /fortschritt count the answer for Artikel.
          recordAttempt({ skill: "grammatik", correct: ok, id, trackVocab: true, topic: "artikel" });
          dispatchEvent(new CustomEvent("da:progress", { detail: { topic: "artikel", correct: ok } }));
          refresh();
        },
      });
      practice.setMode(mode);
    }

    const levelPool = () => pool.filter((q) => q.level === level);

    function packOf(kind, id) {
      const list = kind === "topic" ? PACKS[level]?.topics : PACKS[level]?.rules;
      return list?.find((p) => p.id === id) ?? null;
    }

    const esc = (t) => String(t).replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]);

    // A rule pack is taught before it is drilled: the rule and a few real examples, then
    // the session — in which a wrong answer shows the rule again, not the generic hint.
    function ruleIntro(pack, questions) {
      const examples = pack.ids.slice(0, 3).map((x) => byId.get(x)).filter(Boolean).map((q) => `${q.answer} ${q.lemma}`);
      exerciseRoot.innerHTML = `
        <div class="akp-intro akk-anim-in">
          <p class="akp-intro-kicker">Regel</p>
          <h3 class="akp-intro-title">${esc(pack.name)}</h3>
          <p class="akp-intro-rule" data-ls="${esc(pack.rule)}" data-ls-leicht="${esc(pack.ruleLeicht)}">${esc(pack.rule)}</p>
          <ul class="akp-intro-ex">${examples.map((e) => `<li>${esc(e)}</li>`).join("")}</ul>
          <button type="button" class="akk-btn akk-btn-primary" data-akp-start>Los geht's</button>
        </div>`;
      exerciseRoot.querySelector("[data-akp-start]").addEventListener("click", () => mount(questions));
    }

    function startSession() {
      const { kind, id } = current;
      let questions;
      let label = "";
      if (kind === "freq") {
        questions = drawFreqSlice(round);
        label = `Nach Häufigkeit · Teil ${round + 1}`;
      } else if (kind === "fehler") {
        questions = buildFehlerSession(levelPool(), SESSION_SIZE);
        label = `Stufe ${level} · Fehler wiederholen`;
      } else if (kind === "topic" || kind === "rule") {
        const pack = packOf(kind, id);
        questions = buildSession(pack.ids.map((x) => byId.get(x)).filter(Boolean), SESSION_SIZE);
        label = `Stufe ${level} · ${pack.name}`;
        if (kind === "rule") {
          questions = questions.map((q) => {
            const ex = EXCEPTIONS[q.id];
            return pack.id === "ausnahmen" && ex
              ? { ...q, explain: ex.explain, explainLeicht: ex.explainLeicht }
              : { ...q, explain: pack.rule, explainLeicht: pack.ruleLeicht };
          });
        }
      } else {
        questions = buildSession(levelPool(), SESSION_SIZE);
        label = `Stufe ${level} · gemischt`;
      }
      nowLine.textContent = label;
      refresh();
      if (kind === "rule") ruleIntro(packOf("rule", id), questions);
      else mount(questions);
    }

    /* What the learner's history says, painted into the level panes: "x von n sicher",
       the Fehler button, and five dots plus "neu" / "12/25 sicher" per pack. */
    function refresh() {
      document.querySelectorAll(".ap-nvb [data-akp-go]").forEach((go) => {
        const lv = go.dataset.akpGo;
        const pane = go.closest("[data-pane]");
        if (pane.hidden) return;
        const s = stats(pool.filter((q) => q.level === lv).map((q) => q.id));
        pane.querySelector("[data-akp-sicher]").textContent = `${s.sicher} von ${s.total} Nomen sicher`;
        pane.querySelector("[data-akp-bar]").style.width = `${s.total ? (s.sicher / s.total) * 100 : 0}%`;
        const fehler = pane.querySelector("[data-akp-fehler]");
        fehler.hidden = s.fehler === 0;
        fehler.textContent = `Fehler wiederholen (${s.fehler})`;
        go.classList.toggle("is-on", lv === level && current.kind === "weiter");
        pane.querySelectorAll("[data-akp-pack]").forEach((btn) => {
          const [kind, id] = btn.dataset.akpPack.split(":");
          const list = kind === "topic" ? PACKS[lv].topics : PACKS[lv].rules;
          const pack = list.find((p) => p.id === id);
          if (!pack) return;
          const p = stats(pack.ids);
          const filled = Math.round((p.sicher / p.total) * 5);
          btn.querySelectorAll(".akp-dots i").forEach((dot, i) => dot.classList.toggle("on", i < filled));
          btn.querySelector("[data-akp-state]").textContent = p.gesehen === 0 ? "neu" : `${p.sicher}/${p.total}`;
          btn.title = p.gesehen === 0 ? `${pack.name} · ${p.total} Nomen` : `${pack.name} · ${p.sicher} von ${p.total} sicher`;
          btn.classList.toggle("active", lv === level && current.kind === kind && current.id === id);
        });
      });
    }

    /* The rail and the panel, wired the way the Lernset column is: a rail button swaps
       which pane is shown, a pack row or "Weiter üben" starts a session, and in the
       Häufigkeit pane a Teil row starts that slice. */
    const railBtns = Array.from(document.querySelectorAll(".ap-nvb [data-rail]"));
    const panes = Array.from(document.querySelectorAll(".ap-nvb [data-pane]"));

    function showPane(key) {
      panes.forEach((p) => { p.hidden = p.dataset.pane !== key; });
      railBtns.forEach((b) => {
        const on = b.dataset.rail === key;
        b.classList.toggle("active", on);
        b.setAttribute("aria-selected", String(on));
      });
    }

    function setLevel(next, { restart = true } = {}) {
      level = next;
      round = 0;
      current = { kind: next === "haeufigkeit" ? "freq" : "weiter", id: null };
      showPane(next);
      if (restart) startSession();
      markRound(0);
      refresh();
    }

    function markRound(i) {
      document.querySelectorAll(".ap-round").forEach((r) => {
        r.classList.toggle("active", r.dataset.roundLevel === level && Number(r.dataset.round) === i);
      });
      if (level === "haeufigkeit") markChart(i);
    }

    // The "you are here" on the frequency curve: the marker moves to the round, the band
    // of the timeline it falls in lights up, and the caption says what it adds up to.
    const chart = document.querySelector("[data-freq-points]");
    const chartPts = chart ? JSON.parse(chart.dataset.freqPoints) : [];
    function markChart(i) {
      const pt = chartPts[i];
      if (!pt) return;
      const [x, y, cover, words, phase] = pt;
      const ln = chart.querySelector("[data-freq-marker-line]");
      const dot = chart.querySelector("[data-freq-marker-dot]");
      ln.setAttribute("x1", x); ln.setAttribute("x2", x);
      dot.setAttribute("cx", x); dot.setAttribute("cy", y);
      chart.querySelectorAll("[data-phase]").forEach((g) => g.classList.toggle("is-now", Number(g.dataset.phase) === phase));
      const cap = document.querySelector("[data-freq-caption]");
      if (cap) cap.innerHTML = `Nach Teil ${i + 1} kennst du <b>${words} Nomen</b>, etwa <b>${cover} %</b> der Nomen, die du im Alltag hörst.`;
    }

    railBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const key = btn.dataset.rail;
        // The Regel is a pane, not a level: showing it must not throw away the session
        // the learner is in the middle of.
        if (key === "regel") { showPane("regel"); return; }
        setLevel(key);
      });
    });

    // On a phone the rail is a bottom sheet over the work: choosing something closes it,
    // so the exercise the learner just picked is what they see.
    const compact = matchMedia("(max-width: 1000px)");
    let ruleCol = null;
    const toExercise = () => { if (compact.matches) ruleCol?.apply(true, false); };

    function choose(kind, id = null, lv = level) {
      if (lv !== level) setLevel(lv, { restart: false });
      current = { kind, id };
      startSession();
      toExercise();
    }

    document.querySelectorAll(".ap-round").forEach((row) => {
      row.addEventListener("click", () => {
        // setLevel() resets `round`, so the level goes first and the Teil after it.
        if (level !== "haeufigkeit") setLevel("haeufigkeit", { restart: false });
        round = Number(row.dataset.round);
        choose("freq");
        markRound(round);
      });
    });
    document.querySelectorAll(".ap-nvb [data-akp-go]").forEach((b) =>
      b.addEventListener("click", () => choose("weiter", null, b.dataset.akpGo)));
    document.querySelectorAll(".ap-nvb [data-akp-fehler]").forEach((b) =>
      b.addEventListener("click", () => choose("fehler", null, b.dataset.akpFehler)));
    document.querySelectorAll(".ap-nvb [data-akp-pack]").forEach((b) =>
      b.addEventListener("click", () => {
        const [kind, id] = b.dataset.akpPack.split(":");
        choose(kind, id, b.dataset.akpLevel);
      }));

    // The fold: the panel goes, the rail stays — the Stufen tab on the panel's edge, as
    // the Lernset column has it. LernsetPicker.astro does the same for Wortschatz; this
    // is its twin for the one picker that page's script does not see.
    const apRoot = document.querySelector(".ap-nvb");
    const apPage = document.getElementById("vp-page");
    const FOLD_KEY = "da-artikel-stufen-fold";
    const foldBtns = Array.from(apRoot.querySelectorAll("[data-nvb-collapse]"));
    function setFold(on, persist = true) {
      apRoot.classList.toggle("collapsed", on);
      apPage.dataset.fold = on ? "1" : "";
      foldBtns.forEach((b) => {
        b.setAttribute("aria-expanded", on ? "false" : "true");
        b.setAttribute("aria-label", on ? "Liste ausklappen" : "Liste einklappen");
      });
      if (persist) { try { localStorage.setItem(FOLD_KEY, on ? "1" : "0"); } catch {} }
    }
    let folded = false;
    try { folded = localStorage.getItem(FOLD_KEY) === "1"; } catch {}
    // Restored without animating: nobody took an action.
    apRoot.classList.add("no-anim");
    setFold(folded, false);
    requestAnimationFrame(() => requestAnimationFrame(() => apRoot.classList.remove("no-anim")));
    foldBtns.forEach((b) => b.addEventListener("click", (e) => {
      e.stopPropagation();
      setFold(!apRoot.classList.contains("collapsed"));
    }));

    // The workspace rebuilds its DOM on every answer, so the switch watches for what
    // arrives rather than painting once — see the MutationObserver note in leichteSprache.js.
    mountLeichteSprache(document.getElementById("vp-page"));

    const soundSwitch = document.querySelector("[data-sound-switch]");
    const syncSoundSwitch = () => {
      soundSwitch.setAttribute("aria-pressed", String(isSoundOn()));
      soundSwitch.querySelector("[data-sound-switch-state]").textContent = isSoundOn() ? "Ton an" : "Ton aus";
    };
    soundSwitch.addEventListener("click", () => setSoundOn(!isSoundOn()));
    document.addEventListener("practice:sound", syncSoundSwitch);
    syncSoundSwitch();

    showPane(level);
    startSession();
    markRound(0);

    // "Neu mischen": the same choice, a fresh draw. In the frequency view it moves on to
    // the next Teil; repeating the same 25 is what the Teil's own row is for.
    document.getElementById("akk-new-round").addEventListener("click", () => {
      if (current.kind === "freq") round = (round + 1) % chartPts.length;
      startSession();
      if (current.kind === "freq") markRound(round);
    });

    // The rule column's behaviour — collapse state per learner, what "collapsed" means at
    // each width, the one-time tour — is the same module the grammar topics and the exam
    // pages use. Its own storage key, so this page's preference is its own.
    // The Lernkurve folds. Open until the learner closes it, then closed until they open
    // it: saved on the summary's click rather than on `toggle`, because the tour opens it
    // too and a demo is not a choice.
    const chartFold = document.querySelector("[data-freq-fold]");
    const CHART_KEY = "da-artikel-kurve";
    if (chartFold) {
      try { if (localStorage.getItem(CHART_KEY) === "closed") chartFold.open = false; } catch {}
      chartFold.querySelector("summary").addEventListener("click", () => {
        // Still the old value here: the click's default action has not run yet.
        try { localStorage.setItem(CHART_KEY, chartFold.open ? "closed" : "open"); } catch {}
      });
    }

    // The tour's extra beat: the curve, shown in whatever pane the learner is on — so it
    // borrows the Häufigkeit pane and the open fold, and hands both back.
    let tourPrev = null;
    const chartBeat = {
      title: "Wie schnell du vorankommst",
      text: "Die Kurve zeigt, wie viel vom Alltag du nach jedem Teil verstehst. Ein Tipp auf „Lernkurve“ klappt sie ein — und wieder aus.",
      target: () => chartFold?.closest(".ap-chart"),
      point: () => chartFold?.querySelector("summary"),
      enter: () => {
        tourPrev = { level, open: chartFold?.open };
        showPane("haeufigkeit");
        if (chartFold) chartFold.open = true;
        markChart(level === "haeufigkeit" ? round : 0);
      },
      // Shown, not just said: the cursor presses the summary and the curve folds away.
      // `leave` hands back whatever state the learner had.
      act: () => { if (chartFold) chartFold.open = false; },
      leave: () => {
        if (!tourPrev) return;
        showPane(tourPrev.level);
        if (chartFold) chartFold.open = tourPrev.open;
        tourPrev = null;
      },
    };

    ruleCol = mountRuleColumn(document.getElementById("vp-page"), {
      storageKey: "da-artikel-rule",
      seenKey: "da-artikel-rule-peek",
      beats: chartFold ? [chartBeat] : [],
      // Below 1001px the Regel is a bottom sheet rather than an accordion, as the
      // Wortschatz picker is. The table is five rows tall: expanded in place it pushed the
      // exercise a screen down and took its own "einklappen" button with it.
      sheet: true,
    });

    document.querySelectorAll(".akk-mode-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        document.querySelectorAll(".akk-mode-btn").forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");
        mode = btn.dataset.mode;
        practice.setMode(mode);
      });
    });
  </script>
