---
// One Sprechaufgabe: the picture (or the scene it still needs), the questions in the order
// an examiner asks them, a timer, Redemittel, and a model answer behind a fold.
//
// The timer counts DOWN and is the point of the page. Every speaking part of every exam is
// timed, and the thing that catches learners out is not vocabulary — it is that 90 seconds
// is much longer than it sounds when you are the one filling it. Practising without a clock
// practises the wrong thing.
//
// Nothing is recorded and nothing is uploaded. There is no scoring here for the same reason
// as on the Schreiben pages: it cannot be done honestly in a browser.
//
// The task and its talking points also come in the learner's language
// (src/data/uebersetzungen/sprechen.json): not understanding the instruction is no reason
// to fail a speaking task. The Redemittel and the model answer stay German — they are
// what is being practised.
import Layout from "../../../layouts/Layout.astro";
import SiteNav from "../../../components/SiteNav.astro";
import Icon from "../../../components/Icon.astro";
import GrammarHelp from "../../../components/GrammarHelp.astro";
import GrammarHelpText from "../../../components/GrammarHelpText.astro";
import sprechenHelp from "../../../data/uebersetzungen/sprechen.json";
import { field, list } from "../../../lib/helpContent.js";
import { sprechen, neighbours, sprechenSets, SPRECHEN_ICON } from "../../../lib/fertigkeiten.js";
import { photoSourceOf } from "../../../lib/sprechenBilder.js";
import "../../../styles/practice.css";
import "../../../styles/skills.css";

export function getStaticPaths() {
  const sets = Object.fromEntries(sprechenSets().map((s) => [s.id, { id: s.id, title: s.title }]));
  return sprechen.tasks.map((task) => ({
    params: { id: task.id },
    props: { task, set: sets[task.set] ?? null, ...neighbours(sprechen.tasks, task) },
  }));
}

const { task, set, prev, next } = Astro.props;
const { types } = sprechen;
// null unless this photo was fetched by scripts/fetch-sprechen-bilder.mjs AND its library
// asks to be named — the three borrowed from the older trainers are in neither case.
const credit = photoSourceOf(task);
const tx = (sprechenHelp.entries as Record<string, any>)[task.id] ?? null;
// Inside a set the way back is to the set, not to the whole library: that is where the
// learner came from and where the other three pictures are.
const back = set
  ? { href: `/uebungen/sprechen/set/${set.id}`, label: set.title, key: `sprechenSet.${set.id}.title` }
  : { href: "/uebungen/sprechen/", label: "Alle Sprechaufgaben", key: "sprechen.backAll" };
// The exam line under a task is one of a handful of fixed sentences — keyed by its text, so
// a sentence with no key yet simply stays German.
const EXAM_KEYS: Record<string, string> = {
  "Erster Teil im Sprechen bei Start Deutsch 1, telc A1 und DTZ.": "sprechen.exam.vorstellen",
  "Aufgabenform aus dem Sprechteil des DTZ.": "sprechen.exam.dtz",
  "Aufgabenform aus dem Sprechteil von telc B1/B2.": "sprechen.exam.telcB1B2",
  "Aufgabenform aus dem Sprechteil von telc B2.": "sprechen.exam.telcB2",
  "Aufgabenform aus dem gemeinsamen Sprechteil von telc B1 und B2.": "sprechen.exam.telcPair",
};
const ALSO_KEYS: Record<string, string> = {
  "/uebungen/sprechen/dtz-bildbeschreibung": "sprechen.alsoIn.dtz",
  "/uebungen/sprechen-b1b2": "sprechen.alsoIn.telc",
};
---
<Layout
  title={`${task.title} – Sprechen ${task.level} – DeutschAcademy`}
  description={task.blurb}
>
  <SiteNav active="fertigkeiten" />
  <main class="practice-main" id="sk-page" data-gx="off">
    <a href={back.href} class="vp-back-link">← <span data-i18n={back.key}>{back.label}</span></a>

    <article>
      <header class="sk-head">
        <span class="sk-card-ic"><Icon name={SPRECHEN_ICON[task.type] ?? "mic"} size={22} /></span>
        <div>
          <p class="eyebrow" data-i18n={set ? `sprechenSet.${set.id}.title` : `type.sprechen.${task.type}`}>{set ? set.title : types[task.type]}</p>
          <h1>{task.title}</h1>
        </div>
        <span class="sk-badge">{task.level}</span>
      </header>

      <p class="sk-blurb" data-i18n={`sprechen.${task.id}.blurb`}>{task.blurb}</p>

      {task.image ? (
        <section class="sk-block">
          <img class="sk-photo" src={task.image} alt={task.title} loading="lazy" />
          {/* Only the fetched photos carry a credit, and only where their library asks for
              one — the three borrowed from the older trainers are not in provenance.json
              and get nothing. See src/lib/sprechenBilder.js. */}
          {credit && (
            <p class="sk-credit">
              {credit.photographer}
              {" · "}
              <a href={credit.href} rel="noopener">{credit.label}</a>
            </p>
          )}
        </section>
      ) : task.imageNeeded ? (
        <section class="sk-block">
          <p class="sk-photo-pending">
            <b data-i18n="sprechen.pending.label">Das Bild:</b> {task.imageNeeded}<br />
            <span data-i18n="sprechen.pending.text">Das Foto zu dieser Aufgabe fehlt noch. Beschreibe die Szene so, wie sie hier steht — die Aufgabe, der Timer und die Redemittel sind dieselben.</span>
          </p>
        </section>
      ) : null}

      <section class="sk-block">
        <h2 data-i18n="skills.h2.task">Aufgabe</h2>
        {tx && <GrammarHelp level={task.level} root="sk-page" reviewed={tx.reviewed} />}
        <p>{task.prompt}</p>
        <GrammarHelpText text={field(tx?.prompt)} />
      </section>

      <section class="sk-block">
        <h2 data-i18n="sprechen.h2.time">Redezeit</h2>
        <div class="sk-timer">
          <span class="sk-timer-clock" id="sk-clock" data-seconds={task.seconds}></span>
          {/* Both words are in the button and the script only swaps which one shows, so
              the i18n pass can translate each without undoing the running state. */}
          <button class="sk-btn" type="button" id="sk-start"><span data-i18n="sprechen.timer.start">Start</span><span data-i18n="sprechen.timer.pause" hidden>Pause</span></button>
          <button class="sk-btn" type="button" id="sk-reset" data-i18n="skills.reset">Zurücksetzen</button>
        </div>
      </section>

      <section class="sk-block">
        <h2 data-i18n="sprechen.h2.points">Darüber sollst du sprechen</h2>
        <ul class="sk-points">{task.bullets.map((b) => <li>{b}</li>)}</ul>
        <GrammarHelpText text={list(tx?.bullets)} />
      </section>

      {task.phrases?.length > 0 && (
        <section class="sk-block">
          <h2 data-i18n="skills.h2.phrases">Redemittel</h2>
          <div class="sk-phrases">{task.phrases.map((p) => <span class="sk-phrase">{p}</span>)}</div>
        </section>
      )}

      {task.model && (
        <details class="sk-reveal">
          <summary data-i18n="sprechen.model">Modellantwort — erst öffnen, wenn du gesprochen hast</summary>
          <div class="sk-reveal-body"><div class="sk-model">{task.model}</div></div>
        </details>
      )}

      {task.check?.length > 0 && (
        <details class="sk-reveal">
          <summary data-i18n="sprechen.check">Worauf eine Prüferin hört</summary>
          <div class="sk-reveal-body">
            <ul class="sk-check">{task.check.map((c, i) => <li data-i18n={`sprechen.check.${task.id}.${i}`}>{c}</li>)}</ul>
          </div>
        </details>
      )}

      {(task.exam || task.href) && (
        <p class="sk-foot">
          {task.exam && <span data-i18n={EXAM_KEYS[task.exam]}>{task.exam}</span>}
          {task.exam && task.href && " "}
          {task.href && (
            <span data-i18n-html={ALSO_KEYS[task.href]} data-i18n-vars={JSON.stringify({ href: task.href })}>Dieses Bild liegt auch <a href={task.href}>{task.hrefLabel}</a>, dort mit allen anderen hintereinander.</span>
          )}
        </p>
      )}

      <nav class="sk-prevnext">
        {prev ? <a href={`/uebungen/sprechen/${prev.id}`}>← {prev.title}</a> : <span />}
        {next ? <a href={`/uebungen/sprechen/${next.id}`}>{next.title} →</a> : <span />}
      </nav>
    </article>
  </main>

  <script>
    import { recordSession } from "../../../lib/progress.js";

    const clock = document.getElementById("sk-clock");
    const start = document.getElementById("sk-start");
    const reset = document.getElementById("sk-reset");
    const total = Number(clock.dataset.seconds) || 60;
    let left = total;
    let timer = 0;

    const show = () => {
      const m = Math.floor(left / 60);
      const s = String(left % 60).padStart(2, "0");
      clock.textContent = `${m}:${s}`;
      clock.classList.toggle("is-out", left === 0);
    };
    show();

    const [startWord, pauseWord] = start.children;
    const running = (on) => { startWord.hidden = on; pauseWord.hidden = !on; };
    const stop = () => { window.clearInterval(timer); timer = 0; running(false); };

    start.addEventListener("click", () => {
      if (timer) { stop(); return; }
      if (left === 0) left = total;
      recordSession("sprechen");
      running(true);
      timer = window.setInterval(() => {
        left = Math.max(0, left - 1);
        show();
        if (left === 0) stop();
      }, 1000);
    });

    reset.addEventListener("click", () => { stop(); left = total; show(); });
  </script>
</Layout>
