---
// The words a text or a writing task asks for, with their meaning in the learner's language.
// Folded by default — it is there for the learner who needs it, not a wall in front of the
// text for the one who does not. "Abdecken & üben" hides the meanings so the same list works
// as a quick self-test: tap a row to check it.
import "../styles/help-langs.css";

interface Props {
  vocab: { de: string; [lang: string]: string }[];
  reviewed?: boolean;
  /** Folded or open on load. */
  open?: boolean;
}
const { vocab, reviewed = false, open = false } = Astro.props;
---
{vocab?.length > 0 && (
  <details class="sk-reveal vl" data-vl data-cover="off" open={open}>
    <summary data-i18n="vl.summary" data-i18n-vars={JSON.stringify({ n: vocab.length })}>Wortliste · {vocab.length} Wörter mit Übersetzung</summary>
    <div class="sk-reveal-body">
      <div class="vl-bar">
        <button type="button" class="vl-cover" data-vl-cover aria-pressed="false">Abdecken &amp; üben</button>
      </div>

      <ul class="vl-list">
        {vocab.map((w, i) => (
          <li class="vl-row" tabindex="0">
            <span class="vl-de" lang="de">{w.de}</span>
            <span class="vl-tr" data-i={i}></span>
          </li>
        ))}
      </ul>

      {!reviewed && <p class="help-draft" data-i18n="vl.draft">Maschineller Entwurf, noch nicht von einer Lehrkraft geprüft.</p>}
      <script type="application/json" data-vl-data set:html={JSON.stringify(vocab)}></script>
    </div>
  </details>
)}

<script>
  import { mountVocabList } from "../lib/textHelp.js";
  import { getLang, loadDict, onLangChange } from "../lib/i18n.js";

  // The cover button's label is rewritten in German by textHelp.js on every click. This
  // listener is added after that one, so it runs second and puts the UI language's words
  // back — and again on every language switch.
  let dict: Record<string, string> = {};
  const covers: HTMLElement[] = [];
  const paintCover = (btn: HTMLElement) => {
    const key = btn.getAttribute("aria-pressed") === "true" ? "vl.uncover" : "vl.cover";
    if (dict[key] != null) btn.textContent = dict[key];
  };
  document.querySelectorAll<HTMLElement>("[data-vl]").forEach((root) => {
    const data = root.querySelector("[data-vl-data]");
    if (data) mountVocabList(root, JSON.parse(data.textContent ?? "[]"));
    const cover = root.querySelector<HTMLElement>("[data-vl-cover]");
    if (cover) {
      covers.push(cover);
      cover.addEventListener("click", () => paintCover(cover));
    }
  });
  const useDict = (d: Record<string, string>) => { dict = d; covers.forEach(paintCover); };
  loadDict(getLang()).then(useDict).catch(() => {});
  onLangChange((_c, d) => useDict(d));
</script>
