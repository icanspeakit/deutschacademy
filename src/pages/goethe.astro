---
import Layout from "../layouts/Layout.astro";
import ExamShell from "../components/ExamShell.astro";
import ExamPractice from "../components/ExamPractice.astro";
import ExamFormat from "../components/ExamFormat.astro";
import goetheFormate from "../data/pruefungen/goethe-formate.json";
---
<Layout
  title="Goethe-Zertifikat – DeutschAcademy"
  description="Goethe-Zertifikat A1–C2: für wen es zählt, wie es aufgebaut ist, und kostenlose Übungen für jedes Niveau."
>
  <ExamShell
    header="Goethe-Zertifikat"
    title="Goethe-Zertifikat"
    lead="Die eigenen Prüfungen des Goethe-Instituts — weltweit anerkannt für Visa, Studium und Arbeitgeber."
    leadKey="goethe.lead"
    badges={["A1–C2"]}
    practiceHeading="Für Goethe üben"
    practiceHeadingKey="goethe.practiceHeading"
  >
    <Fragment slot="info">
      <section class="exam-section">
        <h2 data-i18n="goethe.who.title">Für wen ist das Goethe-Zertifikat?</h2>
        <div class="exam-meta-row">
          <span class="exam-meta-badge" data-i18n="telc.who.badge.level">Niveau A1–C2</span>
          <span class="exam-meta-badge" data-i18n="goethe.who.badge.perLevel">Ein Zertifikat pro Niveau</span>
        </div>
        <p data-i18n="goethe.who.text">
          Anders als telc ist jedes Goethe-Zertifikat eine eigenständige Prüfung für genau ein Niveau
          (z. B. Goethe-Zertifikat B1, nicht "B1 oder B2"). Goethe-Zertifikat A1 ("Start Deutsch 1") wird
          häufig für den Ehegattennachzug (Familienzusammenführung) verlangt; höhere Niveaus werden für
          Studium, Beruf und Einbürgerung genutzt.
        </p>
      </section>

      <section class="exam-section">
        <h2 data-i18n="exam.skills.title">Geprüfte Fertigkeiten</h2>
        <div class="skill-grid">
          <div class="skill-card"><div class="skill-card-icon">📖</div><h4 data-i18n="skill.lesen">Lesen</h4><p data-i18n="skill.lesen.desc">Leseverstehen</p></div>
          <div class="skill-card"><div class="skill-card-icon">🎧</div><h4 data-i18n="skill.hoeren">Hören</h4><p data-i18n="skill.hoeren.desc">Hörverstehen</p></div>
          <div class="skill-card"><div class="skill-card-icon">✍️</div><h4 data-i18n="skill.schreiben">Schreiben</h4><p data-i18n="skill.schreiben.desc">Schriftlicher Ausdruck</p></div>
          <div class="skill-card"><div class="skill-card-icon">🗣️</div><h4 data-i18n="skill.sprechen">Sprechen</h4><p data-i18n="skill.sprechen.pairDesc">Mündliche Prüfung, meist paarweise</p></div>
        </div>
      </section>

      {goetheFormate.formate.map((f) => <ExamFormat format={f} />)}

      <section class="exam-section">
        <h2 data-i18n="telc.moreLevels.title">Weitere Niveaus</h2>
        <p class="format-note" data-i18n="goethe.moreLevels.text">
          Oben steht das Niveau, für das uns ein Übungssatz als Quelle vorliegt. Zeiten, Aufgabenzahlen und
          Bestehensgrenzen unterscheiden sich zwischen A1 und C2 erheblich — für A2, B1, B2, C1 oder C2
          prüfe bitte den offiziellen Modellsatz des Goethe-Instituts. Wir tragen hier nur ein, was wir
          belegen können, statt Werte zu schätzen.
        </p>
      </section>
    </Fragment>

    <div class="mock-cta mock-cta--lead">
      <h2 data-i18n="goethe.a1.title">Für A1 zugleich telc üben</h2>
      <p data-i18n="goethe.a1.text">
        Start Deutsch 1 ist eine gemeinsame Prüfung von Goethe-Institut und telc — der mündliche Teil ist
        bei beiden identisch (Sich vorstellen · Um Informationen bitten · Bitten formulieren). Die
        telc-Seite zeigt dieselbe Prüfung mit Punkteverteilung und Notenskala.
      </p>
      <a class="quiz-btn quiz-btn--primary" href="/start-deutsch-1" data-i18n="exam.startSet">Übungssatz starten →</a>
      <a class="quiz-btn" href="/telc" data-i18n="goethe.a1.telcLink">Zur telc-Seite →</a>
    </div>

    <ExamPractice
      heading="Weiter üben"
      headingKey="exam.practice.heading"
      intro="Diese Tools sind niveau- und prüfungsübergreifend nützlich. Sie stammen aus dem DTZ-Unterrichtsmaterial und prüfen allgemeine Artikel-, Grammatik- und Wortschatzkenntnisse — keine Goethe-spezifischen Aufgabenformate."
      introKey="goethe.practice.intro"
      tools={["artikel", "grammatik", "wortschatz"]}
    />
  </ExamShell>
</Layout>
