{
  "id": "konjugation",
  "name": "Konjugation: ein Verb in fünf Zeiten",
  "level": "A2",
  "subtitle": "Die Konjugationstabellen für die wichtigsten Verben — Präsens, Präteritum, Perfekt, Plusquamperfekt und Futur I. Zum Nachschlagen und zum Üben.",
  "source": "Eigenes Material, A1–B1-Lehrplan",
  "concept": {
    "flow": [
      {
        "text": "Person · ich, du, er …",
        "variant": "prep"
      },
      {
        "text": "Zeit · jetzt, früher, später",
        "variant": "verb"
      },
      {
        "text": "Verbform"
      }
    ],
    "exampleHtml": "Ich <span class=\"vp-verb\">fahre</span> heute. — Ich <span class=\"vp-verb\">bin</span> gestern <span class=\"vp-prep\">gefahren</span>. — Ich <span class=\"vp-verb\">werde</span> morgen <span class=\"vp-prep\">fahren</span>.",
    "qa": [
      {
        "html": "<strong>Präsens</strong>: Stamm + Endung. <em>ich lern-e, du lern-st, er lern-t, wir lern-en, ihr lern-t, sie lern-en</em>. Auch für die Zukunft: <em>Morgen fahre ich.</em>",
        "tag": "jetzt"
      },
      {
        "html": "<strong>Präteritum</strong>: regelmäßig Stamm + <em>-te</em> (<em>lernte</em>), unregelmäßig mit neuem Vokal (<em>fuhr, ging, sprach</em>). <em>ich</em> und <em>er</em> sind immer gleich: <em>ich fuhr, er fuhr</em>.",
        "tag": "geschrieben"
      },
      {
        "html": "<strong>Perfekt</strong>: <em>haben</em> oder <em>sein</em> + Partizip II. <em>Ich habe gelernt. Ich bin gefahren.</em> So erzählt man mündlich von gestern.",
        "tag": "gesprochen"
      },
      {
        "html": "<strong>Plusquamperfekt</strong>: <em>hatte</em> oder <em>war</em> + Partizip II — für das, was noch <em>vor</em> der Vergangenheit war: <em>Ich hatte schon gegessen.</em>",
        "tag": "davor"
      },
      {
        "html": "<strong>Futur I</strong>: <em>werden</em> + Infinitiv. <em>Ich werde anrufen.</em> Für Pläne, Versprechen und Vermutungen.",
        "tag": "später"
      }
    ],
    "noteHtml": "Die meisten Verben muss man nicht auswendig lernen — sie folgen dem Muster von <strong>lernen</strong>. Auswendig lernen muss man <strong>sein, haben, werden</strong>, die Modalverben und die unregelmäßigen Verben wie <em>fahren, sprechen, gehen</em>.",
