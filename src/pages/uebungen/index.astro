---
// /uebungen: the main exercises + exams hub. The catalogue has two shapes and the
// viewport picks one: the card grid on anything wide enough to still be a grid, and
// below 640px the ask-first picker (src/components/PracticePicker.astro) — one question
// with five answers instead of thirteen tools under each other, which on a 390px phone
// was four screens of scroll. Both are server-rendered; the swap is CSS, in
// uebungen-vorschau.css.
// The personalized dashboard (streak, weekly goal, per-skill stats — computed client-side
// from real localStorage activity via src/lib/progress.js) still lives behind the
// "Mein Fortschritt" toggle.
import Layout from "../../layouts/Layout.astro";
import SiteNav from "../../components/SiteNav.astro";
import PracticePicker from "../../components/PracticePicker.astro";
import Icon from "../../components/Icon.astro";
import "../../styles/practice.css";
import "../../styles/uebungen-vorschau.css";
import "../../styles/dashboard.css";
// One catalogue for /uebungen and / — see src/lib/catalog.js.
import { tools, landingTools, exams, lexiconCounts, grammarWorkspaceLevels } from "../../lib/catalog.js";

const exerciseCount = tools.length;
const examCount = exams.length;
const workspaceCount = grammarWorkspaceLevels.reduce((n, row) => n + row.topics.length, 0);
---
<Layout title="Übungen – DeutschAcademy">
  <div class="uv">
    <SiteNav active="ueben" />

    <main class="uv-main">
      <div class="topic-tabs uv-mode-tabs" id="hub-mode-tabs">
        <button class="topic-tab active" type="button" data-mode="grid" data-i18n="hub.mode.grid">Übungen &amp; Prüfungen</button>
        <button class="topic-tab" type="button" data-mode="dashboard" data-i18n="hub.mode.dashboard">Mein Fortschritt</button>
      </div>

      <div id="view-grid-mode">
        <!-- One catalogue, two shapes, one per width — see the swap rule in
             uebungen-vorschau.css. Where the grid is still a grid it answers the
             question by itself, so it stays as it was; the ask-first picker takes
             over only below the width where the grid collapses to one card per row
             and thirteen of them become four screens of scroll. -->
        <div class="uv-catalogue">
          <p class="uv-eyebrow" data-i18n="nav.exercises">Übungen</p>
          <div class="uv-grid">
            {landingTools.map((t) => (
              <a class="uv-card" href={t.href}>
                <div class="uv-card-icon"><Icon name={t.icon} /></div>
                <h3 data-i18n={t.titleKey}>{t.title}</h3>
                <p data-i18n={t.descKey}>{t.desc}</p>
                <span class="uv-pill" data-i18n={t.countKey} data-i18n-vars={JSON.stringify(t.countVars)}>{t.count}</span>
              </a>
            ))}
          </div>

        </div>

        <!-- The Grammatik-Werkstatt. The Grammatik tile above leads to a level index; it
             does not, and cannot, name the 21 topics behind it, so "wo sind die
             Wechselpräpositionen?" had no answer on this page. They are listed here by
             level instead — one level at a time, because 21 cards at once is the wall of
             choice the picker below exists to avoid. -->
        <section class="uv-werkstatt">
          <p class="uv-eyebrow" data-i18n="hub.werkstatt.title">Grammatik-Werkstatt</p>
          <p class="uv-werkstatt-sub" data-i18n="hub.werkstatt.sub" data-i18n-vars={JSON.stringify({ n: workspaceCount })}>
            {workspaceCount} Themen mit Erklärung und mehreren Aufgabentypen. Wähle dein Niveau.
          </p>

          <div class="topic-tabs uv-lvl-tabs" role="tablist" aria-label="Niveau" data-i18n-attr="aria-label:pruefungen.compare.level">
            {grammarWorkspaceLevels.map((row, i) => (
              <button
                class:list={["topic-tab", i === 0 && "active"]}
                type="button"
                role="tab"
                aria-selected={i === 0 ? "true" : "false"}
                data-wk-tab={row.level}
              >
                {row.level} <span class="uv-lvl-n">{row.topics.length}</span>
              </button>
            ))}
          </div>

          {grammarWorkspaceLevels.map((row, i) => (
            <div class="uv-wk-grid" data-wk-view={row.level} hidden={i !== 0}>
              {row.topics.map((t) => (
                <a class="uv-wk-card" href={t.href}>
                  <span class="uv-wk-ic" aria-hidden="true">{t.icon}</span>
                  <span class="uv-wk-txt">
                    <b>{t.name}</b>
                    {/* Same sentences as the /uebungen/grammatik cards, so the same keys. */}
                    <i data-i18n={`grammatik.${t.id}.intro`}>{t.subtitle}</i>
                  </span>
                  <span class="uv-wk-n">{t.tasks}</span>
                </a>
              ))}
            </div>
          ))}
        </section>

        <div class="uv-catalogue uv-catalogue--exams">
          <p class="uv-eyebrow" data-i18n="nav.exams">Prüfungen</p>
          <div class="uv-grid uv-grid--exams">
            {exams.map((e) => (
              <a class="uv-card uv-card--exam" href={e.href}>
                <div class="uv-card-icon uv-card-icon--exam"><Icon name={e.icon} /></div>
                <h3>{e.title}</h3>
                <span class="uv-pill uv-pill--exam" data-i18n={e.countKey} data-i18n-vars={e.countVars ? JSON.stringify(e.countVars) : undefined}>{e.count}</span>
              </a>
            ))}
          </div>
        </div>

        <PracticePicker class="uv-ask" />
      </div>

      <div id="view-dashboard-mode" hidden>
        <div class="tabs dash-tabs" role="tablist" id="dash-tabs">
          <button class="tab-btn active" type="button" data-view="today" role="tab" aria-selected="true" data-i18n="dash.tab.today">Heute</button>
          <button class="tab-btn" type="button" data-view="skills" role="tab" aria-selected="false" data-i18n="dash.tab.skills">Fähigkeiten</button>
          <button class="tab-btn" type="button" data-view="progress" role="tab" aria-selected="false" data-i18n="dash.tab.progress">Fortschritt</button>
        </div>

        <section class="dash-view" id="view-today">
          <section class="dash-hero">
            <div class="dash-hero-main">
              <span class="dash-badge" id="dash-badge">Lade…</span>
              <h1 id="dash-headline">Willkommen zurück!</h1>
              <p class="dash-subtitle" id="dash-subtitle"></p>
              <div class="dash-progress-row">
                <div class="dash-progress-track"><span class="dash-progress-fill" id="dash-progress-fill" style="width:0%"></span></div>
                <span class="dash-progress-label" id="dash-progress-label"></span>
              </div>
              <div class="dash-hero-actions">
                <a class="quiz-btn quiz-btn--primary" id="dash-cta" href="/uebungen/wortschatz">Jetzt loslegen →</a>
                <span id="dash-goal-slot"><button class="dash-link-btn" id="dash-goal-btn" type="button">Wochenziel anpassen</button></span>
              </div>
              <span id="dash-name-slot"><button class="dash-link-btn" id="dash-name-btn" type="button">Namen hinzufügen</button></span>
            </div>
            <div class="dash-stat-grid">
              <div class="dash-stat-tile"><span class="dash-stat-label" data-i18n="dash.stat.streak">Serie</span><span class="dash-stat-value" id="stat-streak">–</span></div>
              <div class="dash-stat-tile"><span class="dash-stat-label" data-i18n="dash.stat.vocab">Wörter gelernt</span><span class="dash-stat-value" id="stat-vocab">–</span></div>
              <div class="dash-stat-tile"><span class="dash-stat-label" data-i18n="dash.stat.week">Diese Woche</span><span class="dash-stat-value" id="stat-week">–</span></div>
              <div class="dash-stat-tile"><span class="dash-stat-label" data-i18n="dash.stat.accuracy">Richtig</span><span class="dash-stat-value" id="stat-accuracy">–</span></div>
            </div>
          </section>

          <div class="dash-columns">
            <div class="dash-card">
              <h2 data-i18n="dash.today.title">Heute für dich</h2>
              <div id="dash-today-list"></div>
            </div>
            <div class="dash-card">
              <h2 data-i18n="dash.tab.skills">Fähigkeiten</h2>
              <div id="dash-skills-list" style="display:flex;flex-direction:column;gap:12px;"></div>
            </div>
            <div class="dash-card dash-card--exam">
              <div style="display:flex;flex-direction:column;gap:8px;">
                <h2 data-i18n="dash.examCard.title">Prüfungsvorbereitung</h2>
                <p data-i18n="dash.examCard.desc">DTZ-Simulation und der Einbürgerungstest „Leben in Deutschland“, mit echtem Prüfungsformat.</p>
              </div>
              <a class="quiz-btn quiz-btn--primary" href="/pruefungen" data-i18n="dash.examCard.cta">Zu den Prüfungen →</a>
            </div>
          </div>
        </section>

        <section class="dash-view" id="view-skills" hidden>
          <div class="dash-view-head">
            <h2 data-i18n="dash.skillsView.title">Deine Fähigkeiten im Überblick</h2>
            <p class="dash-view-note" data-i18n="dash.skillsView.subtitle">Ring = aktueller Stand je Fähigkeit</p>
          </div>
          <div class="dash-skills-layout">
            <div class="dash-skills-left">
              <div class="dash-skill-grid" id="dash-skill-grid"></div>
              <div class="dash-card dash-radar-card">
                <div class="dash-radar-svg-wrap" id="dash-radar"></div>
                <div class="dash-radar-copy">
                  <h3 data-i18n="dash.radar.title">Dein Fähigkeitsprofil</h3>
                  <p id="dash-radar-text"></p>
                </div>
              </div>
            </div>
            <div class="dash-skills-right">
              <div class="dash-callout" id="dash-callout"></div>
              <div class="dash-card">
                <p class="dash-view-note" style="margin:0 0 14px;" data-i18n="dash.thisWeek">Diese Woche</p>
                <div class="dash-week-bars" id="dash-week-bars"></div>
                <p id="dash-week-summary" class="dash-week-summary"></p>
              </div>
            </div>
          </div>
        </section>

        <section class="dash-view" id="view-progress" hidden>
          <div class="dash-console">
            <div class="dash-console-sidebar" id="dash-console-sidebar"></div>
            <div class="dash-console-main" id="dash-console-main"></div>
          </div>
        </section>
      </div>
    </main>
  </div>

  <script type="module">
    import { getProgress, getWeeklyCount, getWeeklyGoal, setWeeklyGoal, getDisplayName, setDisplayName, activeToday } from "../../lib/progress.js";
    import { getLang, loadDict, onLangChange } from "../../lib/i18n.js";
    import { mountPracticePicker } from "../../lib/practicePicker.js";

    // The picker is the default view, so it mounts on load rather than with the dashboard.
    // `remote` stays null until there is an account to read a last session from; see
    // getResume() in src/lib/progress.js for the seam.
    mountPracticePicker(document.querySelector("[data-pp]"), { remote: null });

    let dict = {};
    function tr(key, vars) {
      const str = dict[key];
      if (str == null) return key;
      if (!vars) return str;
      return str.replace(/\{(\w+)\}/g, (m, k) => (k in vars ? String(vars[k]) : m));
    }

    // Mode toggle: static grid (default) vs. the personalized dashboard.
    const modeTabs = document.getElementById("hub-mode-tabs");
    const viewGridMode = document.getElementById("view-grid-mode");
    const viewDashboardMode = document.getElementById("view-dashboard-mode");
    let dashboardBooted = false;

    modeTabs.querySelectorAll(".topic-tab").forEach((btn) => {
      btn.addEventListener("click", () => {
        const mode = btn.dataset.mode;
        modeTabs.querySelectorAll(".topic-tab").forEach((b) => b.classList.toggle("active", b === btn));
        viewGridMode.hidden = mode !== "grid";
        viewDashboardMode.hidden = mode !== "dashboard";
        if (mode === "dashboard" && !dashboardBooted) {
          dashboardBooted = true;
          renderAll();
        }
      });
    });

    const SKILLS = [
      { key: "wortschatz", icon: "🗂️", labelKey: "dash.skill.wortschatz", href: "/uebungen/wortschatz", type: "accuracy" },
      { key: "grammatik", icon: "📚", labelKey: "dash.skill.grammatik", href: "/uebungen/grammatik", type: "accuracy" },
      { key: "hoeren", icon: "🔊", labelKey: "dash.skill.hoeren", href: "/uebungen/aussprache", type: "sessions" },
      { key: "sprechen", icon: "🗣️", labelKey: "dash.skill.sprechen", href: "/uebungen/sprechen", type: "sessions" },
      { key: "schreiben", icon: "✍️", labelKey: "dash.skill.schreiben", href: "/uebungen/lesen-schreiben", type: "accuracy" },
    ];

    function esc(s) {
      const div = document.createElement("div");
      div.textContent = s;
      return div.innerHTML;
    }

    function greetingWord() {
      const h = new Date().getHours();
      if (h < 11) return tr("dash.greeting.morning");
      if (h < 18) return tr("dash.greeting.afternoon");
      return tr("dash.greeting.evening");
    }

    function todayStr(d = new Date()) {
      return d.toISOString().slice(0, 10);
    }

    function daysAgoStr(n) {
      const d = new Date();
      d.setDate(d.getDate() - n);
      return todayStr(d);
    }

    function relativeDate(dateStr) {
      if (!dateStr) return tr("dash.date.never");
      if (dateStr === todayStr()) return tr("dash.date.today");
      if (dateStr === daysAgoStr(1)) return tr("dash.date.yesterday");
      const days = Math.round((new Date(todayStr()) - new Date(dateStr)) / 86400000);
      if (days > 0 && days < 60) return tr("dash.date.daysAgo", { n: days });
      return tr("dash.date.longAgo");
    }

    // Same accuracy-or-session-count mastery proxy already used for the "Fähigkeiten" mini list
    // below — centralized here so the Fähigkeiten and Fortschritt tabs stay consistent with it.
    function skillStats(data) {
      return SKILLS.map((s) => {
        const st = data.skills[s.key];
        const hasData = s.type === "accuracy" ? !!(st && st.attempts > 0) : !!(st && st.sessions > 0);
        let mastery = 0;
        if (s.type === "accuracy" && st && st.attempts > 0) mastery = Math.round((st.correct / st.attempts) * 100);
        else if (s.type === "sessions" && st) mastery = Math.min(100, st.sessions * 10);
        return {
          ...s,
          attempts: st?.attempts || 0,
          correct: st?.correct || 0,
          sessions: st?.sessions || 0,
          lastActiveDate: st?.lastActiveDate || null,
          hasData,
          mastery,
        };
      });
    }

    function ringColor(hasData, mastery) {
      if (!hasData) return "var(--border-strong)";
      if (mastery < 55) return "var(--danger)";
      if (mastery < 75) return "var(--accent)";
      return "var(--success)";
    }

    function ringSvg(stat) {
      const r = 34;
      const circ = 2 * Math.PI * r;
      const offset = circ * (1 - stat.mastery / 100);
      const color = ringColor(stat.hasData, stat.mastery);
      return `<svg width="72" height="72" viewBox="0 0 84 84">
        <circle cx="42" cy="42" r="${r}" fill="none" stroke="var(--border)" stroke-width="9"></circle>
        <circle cx="42" cy="42" r="${r}" fill="none" stroke="${color}" stroke-width="9" stroke-linecap="round"
          transform="rotate(-90 42 42)" stroke-dasharray="${circ.toFixed(1)}" stroke-dashoffset="${offset.toFixed(1)}"></circle>
        <text x="42" y="47" text-anchor="middle" font-size="16" font-weight="800" fill="var(--ink)">${stat.hasData ? stat.mastery + "%" : "–"}</text>
      </svg>`;
    }

    // Five real mastery values plotted as a pentagon — no historical overlay, since we don't
    // keep past snapshots to compare against.
    function radarPolygon(values, r) {
      const cx = 100, cy = 100;
      return values.map((v, i) => {
        const angle = -Math.PI / 2 + i * ((2 * Math.PI) / values.length);
        const rad = r * (v / 100);
        return `${(cx + rad * Math.cos(angle)).toFixed(1)},${(cy + rad * Math.sin(angle)).toFixed(1)}`;
      }).join(" ");
    }

    const RADAR_LABEL_POS = [
      { left: "50%", top: "0%", transform: "translate(-50%,0)" },
      { left: "93%", top: "33%", transform: "translate(-50%,-50%)" },
      { left: "76%", top: "88%", transform: "translate(-50%,-50%)" },
      { left: "24%", top: "88%", transform: "translate(-50%,-50%)" },
      { left: "7%", top: "33%", transform: "translate(-50%,-50%)" },
    ];

    function renderRadar(stats) {
      const outer = radarPolygon(stats.map(() => 100), 88);
      const filled = radarPolygon(stats.map((s) => s.mastery), 88);
      const labels = stats.map((s, i) => {
        const pos = RADAR_LABEL_POS[i];
        return `<span class="dash-radar-label" style="left:${pos.left};top:${pos.top};transform:${pos.transform};">${esc(s.label)}</span>`;
      }).join("");
      return `<svg width="200" height="200" viewBox="0 0 200 200" style="position:absolute;inset:0;">
          <polygon points="${outer}" fill="none" stroke="var(--border)" stroke-width="1"></polygon>
          <polygon points="${filled}" fill="var(--blue-100)" fill-opacity="0.55" stroke="var(--brand-blue)" stroke-width="2"></polygon>
        </svg>${labels}`;
    }

    function weekBarsData(data) {
      const dayNames = tr("dash.dayNames").split(",");
      const labels = [];
      const vals = [];
      for (let i = 6; i >= 0; i--) {
        const ds = daysAgoStr(i);
        labels.push(dayNames[new Date(ds).getDay()]);
        vals.push(data.dailyActivity[ds] || 0);
      }
      const max = Math.max(1, ...vals);
      const thisWeekSum = vals.reduce((a, b) => a + b, 0);
      const prevWeekSum = Array.from({ length: 7 }, (_, i) => data.dailyActivity[daysAgoStr(i + 7)] || 0).reduce((a, b) => a + b, 0);
      return { labels, vals, max, thisWeekSum, prevWeekSum };
    }

    function renderWeekBars(data) {
      const { labels, vals, max, thisWeekSum, prevWeekSum } = weekBarsData(data);
      document.getElementById("dash-week-bars").innerHTML = vals.map((v, i) => `
        <div class="dash-week-bar-col">
          <div class="dash-week-bar" style="height:${Math.round((v / max) * 72)}px; background:${v > 0 ? "var(--brand-blue)" : "var(--border)"};"></div>
          <span>${labels[i]}</span>
        </div>`).join("");
      const delta = thisWeekSum - prevWeekSum;
      const deltaText = thisWeekSum === 0 && prevWeekSum === 0
        ? ""
        : ` · <span style="color:${delta >= 0 ? "var(--success)" : "var(--danger)"};font-weight:700;">${tr("dash.weekDelta", { d: (delta >= 0 ? "+" : "") + delta })}</span>`;
      document.getElementById("dash-week-summary").innerHTML = tr("dash.weekSummary", { n: thisWeekSum, delta: deltaText });
    }

    function renderSkillsView() {
      const data = getProgress();
      const stats = skillStats(data);

      document.getElementById("dash-skill-grid").innerHTML = stats.map((s) => `
        <div class="dash-ring-card">
          ${ringSvg(s)}
          <div>
            <p class="dash-ring-label">${esc(tr(s.labelKey))}</p>
            <p class="dash-ring-sub">${s.type === "accuracy"
              ? (s.hasData ? tr("dash.taskCount", { n: s.attempts }) : tr("dash.notPracticed"))
              : (s.hasData ? tr("dash.sessionCount", { n: s.sessions }) : tr("dash.notPracticed"))}</p>
            <p class="dash-ring-sub2">${relativeDate(s.lastActiveDate)}</p>
          </div>
        </div>`).join("");

      document.getElementById("dash-radar").innerHTML = renderRadar(stats);
      const withData = stats.filter((s) => s.hasData);
      document.getElementById("dash-radar-text").textContent = withData.length
        ? tr("dash.radar.filled")
        : tr("dash.radar.empty");

      const callout = document.getElementById("dash-callout");
      const weakest = withData.slice().sort((a, b) => a.mastery - b.mastery)[0];
      if (weakest) {
        callout.innerHTML = `
          <p class="dash-callout-eyebrow">${tr("dash.callout.eyebrow", { skill: esc(tr(weakest.labelKey)) })}</p>
          <h3>${tr("dash.callout.title")}</h3>
          <p>${tr("dash.callout.body", { skill: esc(tr(weakest.labelKey)), pct: weakest.mastery, metric: weakest.type === "accuracy" ? tr("dash.metric.accuracy") : tr("dash.metric.activity") })}</p>
          <a class="quiz-btn quiz-btn--primary" href="${weakest.href}">${tr("dash.cta.practiceNow")}</a>`;
      } else {
        callout.innerHTML = `
          <p class="dash-callout-eyebrow">${tr("dash.callout.startEyebrow")}</p>
          <h3>${tr("dash.callout.noDataTitle")}</h3>
          <p>${tr("dash.callout.noDataBody")}</p>
          <a class="quiz-btn quiz-btn--primary" href="/uebungen/wortschatz">${tr("dash.cta.start")}</a>`;
      }

      renderWeekBars(data);
    }

    let selectedSkillKey = "grammatik";

    function renderProgressView() {
      const data = getProgress();
      const stats = skillStats(data);

      const sidebar = document.getElementById("dash-console-sidebar");
      sidebar.innerHTML = `<p class="dash-view-note" style="margin:0 0 12px;">${tr("dash.tab.skills")}</p>` + stats.map((s) => `
        <button type="button" class="dash-console-row ${s.key === selectedSkillKey ? "active" : ""}" data-key="${s.key}">
          <span class="dash-console-row-top">
            <span>${esc(tr(s.labelKey))}</span>
            <span class="dash-console-row-badge">${s.hasData ? relativeDate(s.lastActiveDate) : "–"}</span>
          </span>
          <span class="dash-console-track"><span class="dash-console-fill" style="width:${s.mastery}%; background:${ringColor(s.hasData, s.mastery)};"></span></span>
        </button>`).join("");
      sidebar.querySelectorAll(".dash-console-row").forEach((btn) => {
        btn.addEventListener("click", () => {
          selectedSkillKey = btn.dataset.key;
          renderProgressView();
        });
      });

      const sel = stats.find((s) => s.key === selectedSkillKey) || stats[0];
      const secondaryLabel = sel.type === "accuracy" ? tr("dash.metric.accuracy") : tr("dash.progress.sessionsLabel");
      const secondaryValue = sel.type === "accuracy" ? (sel.hasData ? `${sel.mastery}%` : "–") : `${sel.sessions}`;
      document.getElementById("dash-console-main").innerHTML = `
        <p class="dash-view-note" style="margin:0 0 6px;">${tr("dash.progress.skillLabel")}</p>
        <h2 style="margin:0 0 20px; text-align:left; font-family:var(--font-display);">${esc(tr(sel.labelKey))}</h2>
        <div class="dash-console-stats">
          <div class="dash-card dash-stat-card">
            <p class="dash-view-note">${tr("dash.progress.mastery")}</p>
            <p class="dash-stat-big">${sel.hasData ? sel.mastery + "%" : "–"}</p>
            <p class="dash-stat-note">${sel.type === "accuracy" ? tr("dash.progress.correctOf", { correct: sel.correct, total: sel.attempts }) : tr("dash.sessionCount", { n: sel.sessions })}</p>
          </div>
          <div class="dash-card dash-stat-card">
            <p class="dash-view-note">${secondaryLabel}</p>
            <p class="dash-stat-big">${secondaryValue}</p>
            <p class="dash-stat-note">${sel.type === "accuracy" ? tr("dash.progress.noteAttempts") : tr("dash.progress.noteSessions")}</p>
          </div>
          <div class="dash-card dash-stat-card">
            <p class="dash-view-note">${tr("dash.progress.lastPracticed")}</p>
            <p class="dash-stat-big" style="font-size:1.3rem;">${relativeDate(sel.lastActiveDate)}</p>
            <p class="dash-stat-note">${activeToday(sel.key, data) ? tr("dash.progress.doneToday") : tr("dash.progress.notYetToday")}</p>
          </div>
          <div class="dash-card dash-stat-card">
            <p class="dash-view-note">${tr("dash.progress.totalPracticed")}</p>
            <p class="dash-stat-big">${sel.attempts + sel.sessions}</p>
            <p class="dash-stat-note">${tr("dash.progress.totalNote")}</p>
          </div>
        </div>
        <div class="dash-card dash-empty-note">
          <h3>${tr("dash.progress.moreTitle")}</h3>
          <p>${tr("dash.progress.moreBody")}</p>
          <a href="${sel.href}">${tr("dash.cta.practiceSkill", { skill: esc(tr(sel.labelKey)) })}</a>
        </div>`;
    }

    function showDashSubView(view) {
      document.querySelectorAll("#view-dashboard-mode .dash-view").forEach((el) => { el.hidden = el.id !== `view-${view}`; });
      document.querySelectorAll("#dash-tabs .tab-btn").forEach((btn) => {
        const active = btn.dataset.view === view;
        btn.classList.toggle("active", active);
        btn.setAttribute("aria-selected", String(active));
      });
      if (view === "skills") renderSkillsView();
      if (view === "progress") renderProgressView();
    }

    document.querySelectorAll("#dash-tabs .tab-btn").forEach((btn) => {
      btn.addEventListener("click", () => showDashSubView(btn.dataset.view));
    });

    function renderAll() {
      const data = getProgress();
      const weeklyCount = getWeeklyCount(data);
      const weeklyGoal = getWeeklyGoal();
      const weeklyPct = weeklyGoal > 0 ? Math.min(100, Math.round((weeklyCount / weeklyGoal) * 100)) : 0;
      const name = getDisplayName();

      // Hero badge + headline + subtitle
      document.getElementById("dash-badge").textContent = data.streak > 0 ? tr("dash.streakBadge", { n: data.streak }) : tr("dash.startStreak");
      document.getElementById("dash-headline").textContent = `${greetingWord()}${name ? ", " + name : ""}!`;
      const subtitleEl = document.getElementById("dash-subtitle");
      if (weeklyCount === 0) {
        subtitleEl.textContent = tr("dash.subtitle.zero");
      } else if (weeklyCount >= weeklyGoal) {
        subtitleEl.textContent = tr("dash.subtitle.goalMet", { n: weeklyCount });
      } else {
        subtitleEl.textContent = tr("dash.subtitle.progress", { n: weeklyCount, goal: weeklyGoal });
      }

      // Weekly progress bar
      document.getElementById("dash-progress-fill").style.width = `${weeklyPct}%`;
      document.getElementById("dash-progress-label").textContent = `${weeklyCount} / ${weeklyGoal}`;

      // CTA: continue with the last-touched skill, or a sensible default
      const lastSkill = SKILLS.find((s) => s.key === data.lastSkill);
      const cta = document.getElementById("dash-cta");
      cta.href = lastSkill ? lastSkill.href : "/uebungen/wortschatz";
      cta.textContent = lastSkill ? tr("dash.cta.continue", { skill: tr(lastSkill.labelKey) }) : tr("dash.cta.start");

      // Stat tiles
      document.getElementById("stat-streak").textContent = data.streak > 0 ? tr("dash.stat.streakValue", { n: data.streak }) : "–";
      document.getElementById("stat-vocab").textContent = String(data.vocabMastered.length);
      document.getElementById("stat-week").textContent = String(weeklyCount);
      const gradedKeys = ["wortschatz", "grammatik", "schreiben"];
      let attempts = 0, correct = 0;
      gradedKeys.forEach((k) => {
        const s = data.skills[k];
        if (s) { attempts += s.attempts; correct += s.correct; }
      });
      document.getElementById("stat-accuracy").textContent = attempts > 0 ? `${Math.round((correct / attempts) * 100)}%` : "–";

      // "Heute für dich"
      const todayList = document.getElementById("dash-today-list");
      todayList.innerHTML = SKILLS.map((s) => {
        const done = activeToday(s.key, data);
        return `<a class="dash-today-row" href="${s.href}">
          <span class="dash-today-icon">${s.icon}</span>
          <span class="dash-today-label">${esc(tr(s.labelKey))}</span>
          <span class="dash-today-status ${done ? "dash-today-status--done" : "dash-today-status--todo"}">${done ? tr("dash.today.done") : tr("dash.today.start")}</span>
        </a>`;
      }).join("");

      // "Fähigkeiten"
      const skillsList = document.getElementById("dash-skills-list");
      skillsList.innerHTML = SKILLS.map((s) => {
        const st = data.skills[s.key];
        let pct = 0, valueText = tr("dash.notPracticed");
        if (s.type === "accuracy") {
          if (st && st.attempts > 0) {
            pct = Math.round((st.correct / st.attempts) * 100);
            valueText = `${pct}% · ${st.attempts}`;
          }
        } else {
          const sessions = st?.sessions || 0;
          if (sessions > 0) {
            pct = Math.min(100, sessions * 10);
            valueText = tr("dash.sessionCount", { n: sessions });
          }
        }
        return `<div class="dash-skill-row">
          <span class="dash-skill-icon">${s.icon}</span>
          <span class="dash-skill-name">${esc(tr(s.labelKey))}</span>
          <span class="dash-skill-track"><span class="dash-skill-fill" style="width:${pct}%"></span></span>
          <span class="dash-skill-value">${esc(valueText)}</span>
        </div>`;
      }).join("");

      wireNameEditor(name);
      wireGoalEditor(weeklyGoal);
    }

    function wireNameEditor(name) {
      const slot = document.getElementById("dash-name-slot");
      slot.innerHTML = name
        ? `<button class="dash-link-btn" id="dash-name-btn" type="button">${tr("dash.name.edit", { name: esc(name) })}</button>`
        : `<button class="dash-link-btn" id="dash-name-btn" type="button">${tr("dash.name.add")}</button>`;
      document.getElementById("dash-name-btn").addEventListener("click", () => {
        slot.innerHTML = `<span class="dash-inline-edit">
          <input type="text" id="dash-name-input" placeholder="${tr("dash.name.placeholder")}" value="${esc(name)}" maxlength="40" />
          <button type="button" id="dash-name-save">${tr("dash.save")}</button>
        </span>`;
        const input = document.getElementById("dash-name-input");
        input.focus();
        const save = () => { setDisplayName(input.value); renderAll(); };
        document.getElementById("dash-name-save").addEventListener("click", save);
        input.addEventListener("keydown", (e) => { if (e.key === "Enter") save(); });
      });
    }

    function wireGoalEditor(goal) {
      const slot = document.getElementById("dash-goal-slot");
      slot.innerHTML = `<button class="dash-link-btn" id="dash-goal-btn" type="button">${tr("dash.goal.label", { goal })}</button>`;
      document.getElementById("dash-goal-btn").addEventListener("click", () => {
        slot.innerHTML = `<span class="dash-inline-edit">
          <input type="number" id="dash-goal-input" value="${goal}" min="10" max="500" step="10" />
          <button type="button" id="dash-goal-save">${tr("dash.save")}</button>
        </span>`;
        const input = document.getElementById("dash-goal-input");
        input.focus();
        const save = () => { setWeeklyGoal(Number(input.value) || goal); renderAll(); };
        document.getElementById("dash-goal-save").addEventListener("click", save);
        input.addEventListener("keydown", (e) => { if (e.key === "Enter") save(); });
      });
    }

    async function bootI18n() {
      dict = await loadDict(getLang());
      if (dashboardBooted) renderAll();
    }
    onLangChange((code, newDict) => {
      dict = newDict;
      if (dashboardBooted) {
        renderAll();
        const activeView = document.querySelector("#dash-tabs .tab-btn.active")?.dataset.view || "today";
        if (activeView === "skills") renderSkillsView();
        if (activeView === "progress") renderProgressView();
      }
    });
    bootI18n();

    // Grammatik-Werkstatt: one level at a time. Every level is in the HTML and only the
    // first is shown, so with no JS the page still lists A1 rather than nothing — and
    // the <noscript> rule below shows all four.
    const wkTabs = Array.from(document.querySelectorAll("[data-wk-tab]"));
    const wkViews = Array.from(document.querySelectorAll("[data-wk-view]"));
    for (const tab of wkTabs) {
      tab.addEventListener("click", () => {
        for (const t of wkTabs) {
          const on = t === tab;
          t.classList.toggle("active", on);
          t.setAttribute("aria-selected", String(on));
        }
        for (const v of wkViews) v.hidden = v.dataset.wkView !== tab.dataset.wkTab;
      });
    }
  </script>

  <noscript>
    <style>
      /* No JS, no tabs: every level is simply a list. */
      .uv-lvl-tabs { display: none; }
      .uv-wk-grid[hidden] { display: grid !important; }
    </style>
  </noscript>
</Layout>
