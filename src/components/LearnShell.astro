    icon: "book",
    kind: "stufe",
    blurb: "Der Anfang: die Artikel der häufigsten Nomen und der Akkusativ. Wer diese Stufe sicher hat, kann einfache Sätze bilden, die stimmen.",
    focus: ["Artikel: der, die, das", "Akkusativ nach Verben", "Grundwortschatz"],
    items: [
      ...grammarAt("A1"),
      { id: "artikel-trainer", label: "der/die/das-Trainer", icon: "target", href: "/uebungen/artikel-trainer", level: "A1", levelSource: "abgeleitet", eyebrow: "Übung · A1", lead: `Artikel gezielt trainieren — ${ARTIKEL_POOL.length} Nomen aus dem Lexikon, Fokus- oder Testmodus, mit sofortigem Feedback nach jeder Antwort.`, tasks: ARTIKEL_SESSION, done: doneOf("artikel-trainer"), minutes: 8, practice: "trainer" },
    ],
  },
  {
    id: "a2",
    label: "Stufe A2",
    badge: "A2",
    icon: "book",
    kind: "stufe",
    blurb: "Der Sprung in den Alltag: Dativ und trennbare Verben. Ab hier lassen sich Sätze bauen, die mehr können als „Ich habe einen Hund.“",
    focus: ["Dativ nach Verben und Präpositionen", "Trennbare Verben im Satz", "Alltagssituationen"],
