---
// /v2 — the merge of /dashboard and /v1.
//
// From /dashboard: the Icon-Rail over the whole catalogue sorted by CEFR level,
// the course strip, the level overviews with their own progress, and progress
// that is real and persisted (src/lib/progress.js).
//
// From /v1: what happens once a topic is open. No hero card — the topic name,
// its level and its progress on one line, then the exercises. The rule is not
// stacked above them any more; it slides in from the side behind a trigger that
// is deliberately loud, because that is the thing a learner reaches for
// mid-exercise and a quiet control in a bar was being missed.
//
// Everything is the same component and the same exercise engines as /dashboard —
// topicLayout="focus" is the only difference — so the two cannot drift apart.
import Layout from "../layouts/Layout.astro";
import PracticeHeader from "../components/PracticeHeader.astro";
import LearnShell from "../components/LearnShell.astro";
---
<Layout
  title="V2 – Dashboard + Themenseite"
  description="Der Merge aus Dashboard und Themenseite: Navigation und Fortschritt links, Übungen in einer Spalte, Regel von der Seite."
>
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow" />
  </Fragment>
  <PracticeHeader title="V2" />
  <LearnShell variants={["b"]} topicLayout="focus" />
</Layout>
