---
// /dashboard — the learner's home. Left rail of CEFR levels, a level overview in
// the middle, and the exercise for whatever is open mounted inline, so a session
// is: pick a level, pick a topic, work, without ever leaving this page.
//
// The layout is variant B of the /nav study (icon rail + list panel), which won
// on the two things that matter as the catalogue grows: the list stays the same
// length however many topics a level gains, and it folds to 64px when the
// exercise needs the room. /nav still renders all three variants from this same
// component if the comparison ever needs revisiting — see LearnShell.astro.
//
// Progress is real: every graded answer goes through recordAttempt() in
// src/lib/progress.js, the same store /uebungen reads, and the page hydrates
// from it on load. A first visit shows zeros, because on a first visit there is
// nothing to show.
import Layout from "../layouts/Layout.astro";
import PracticeHeader from "../components/PracticeHeader.astro";
import LearnShell from "../components/LearnShell.astro";
---
<Layout
  title="Dein Dashboard – DeutschAcademy"
  description="Dein Lernstand auf einen Blick: Grammatik, Wortschatz und Prüfungsvorbereitung nach GER-Stufe sortiert — und jede Übung direkt auf der Seite."
>
  <PracticeHeader title="Dein Dashboard" />
  <LearnShell variants={["b"]} />
</Layout>
