---
import Layout from "../layouts/Layout.astro";
import "../styles/landing.css";
import artikel from "../data/artikel.json";
import grammatik from "../data/grammatik.json";
import wortschatz from "../data/wortschatz.json";
import sprechen from "../data/sprechen.json";
import lesen from "../data/lesen.json";
import kultur from "../data/kultur.json";
import lid from "../data/leben-in-deutschland.json";

const grammarQuestionCount = grammatik.reduce((sum, t) => sum + t.questions.length, 0);
const readingQuestionCount = lesen.groups.reduce((sum, g) => sum + g.questions.length, 0);

// Real catalog — matches /uebungen and /pruefungen exactly, no placeholder numbers.
const tools = [
  { href: "/uebungen/artikel-trainer", icon: "🎯", title: "der/die/das-Trainer", desc: "Artikel gezielt üben, mit sofortigem Feedback.", count: `${artikel.length} Nomen` },
  { href: "/uebungen/grammatik", icon: "📚", title: "Grammatik-Quiz", desc: "Lückentext-Übungen zu Akkusativ, Dativ, Passiv und mehr.", count: `${grammatik.length} Themen · ${grammarQuestionCount} Fragen` },
  { href: "/uebungen/wortschatz", icon: "🗂️", title: "Wortschatz & Redemittel", desc: "Karteikarten zum Umdrehen und Wiederholen.", count: `${wortschatz.length} Karten` },
  { href: "/uebungen/aussprache", icon: "🔊", title: "Aussprache-Training", desc: "Wörter anhören und im Langsam-Modus üben.", count: `${wortschatz.length + artikel.length} Wörter` },
  { href: "/uebungen/sprechen", icon: "🗣️", title: "Sprechen: Bildbeschreibung", desc: "Echte DTZ-Prüferfragen, mit 90-Sekunden-Timer.", count: `${sprechen.length} Bilder` },
  { href: "/uebungen/lesen-schreiben", icon: "✍️", title: "Lesen & Schreiben", desc: "DTZ-Leseverstehen-Simulation plus Schreibaufgaben.", count: `${readingQuestionCount} Aufgaben` },
  { href: "/uebungen/kultur", icon: "🗺️", title: "Kulturwissen", desc: "Einblicke aus echten Unterrichtsgesprächen.", count: `${kultur.length} Thema${kultur.length === 1 ? "" : "n"}` },
];
const comingSoonTool = { icon: "✨", title: "Weitere Übungen", desc: "Neue Übungstools sind in Arbeit.", count: "Bald verfügbar" };

const exams = [
  { href: "/pruefungen/telc", icon: "📄", title: "telc", level: "A1–C2" },
  { href: "/pruefungen/goethe", icon: "🏛️", title: "Goethe-Zertifikat", level: "A1–C2" },
  { href: "/pruefungen/testdaf", icon: "🎓", title: "TestDaF", level: "≈ B2–C1" },
  { href: "/pruefungen/dtz", icon: "🧾", title: "DTZ", level: "A2 / B1" },
  { href: "/pruefungen/leben-in-deutschland", icon: "🇩🇪", title: "Leben in Deutschland", level: `${lid.bundeslaender.length} Bundesländer` },
];

const toolCount = tools.length;
const examCount = exams.length;
const userCount = 412; // actual signups so far
---
<Layout>
  <div class="lp">
    <!-- NAV -->
    <nav class="lp-nav">
      <div class="lp-nav-row">
        <div class="lp-nav-left">
          <a href="/"><img src="/assets/logo.png" alt="DeutschAcademy" /></a>
          <div class="lp-nav-links">
            <a href="/uebungen">Übungen</a>
            <a href="/pruefungen">Prüfungen</a>
          </div>
        </div>
        <div class="lp-nav-right">
          <a href="/uebungen" class="lp-btn lp-btn--primary">Kostenlos üben</a>
        </div>
      </div>
    </nav>

    <!-- HERO: dashboard advertisement -->
    <section class="lp-hero">
      <div class="lp-wrap lp-hero-inner">
        <div class="lp-hero-copy">
          <div class="lp-eyebrow">Dein Dashboard</div>
          <h1>Dein Fortschritt, immer im Blick</h1>
          <p class="lp-hero-lead">Level, erledigte Lektionen und nächste Schritte an einem Ort — damit du bei jedem Login genau weißt, woran du weitermachst.</p>
          <p class="lp-hero-sub">Kostenloser Grundkurs A1–C1, plus Prüfungsvorbereitung für Goethe, telc, TestDaF, DTZ und Leben in Deutschland, wenn du bereit bist.</p>
          <div class="lp-hero-actions">
            <a href="/uebungen" class="lp-btn lp-btn--primary">Kostenlos starten</a>
            <span class="lp-nav-login">Bereits dabei? Log in</span>
          </div>
          <div class="lp-hero-note">Kostenloser Grundkurs A1–C1 · kein Abo nötig</div>
        </div>
        <div class="lp-browser">
          <div class="lp-browser-bar">
            <div class="lp-browser-dot"></div><div class="lp-browser-dot"></div><div class="lp-browser-dot"></div>
            <div class="lp-browser-url">deutschacademy.com/dashboard</div>
          </div>
          <div class="lp-browser-body">
            <div class="lp-sidebar">
              <img src="/assets/logo.png" alt="" />
              <div class="lp-sidebar-link lp-sidebar-link--active">Dashboard</div>
              <div class="lp-sidebar-link">Grammatik</div>
              <div class="lp-sidebar-link">Wortschatz</div>
              <div class="lp-sidebar-link">Sprechen</div>
              <div class="lp-sidebar-link">Prüfungen</div>
              <div class="lp-sidebar-upsell">
                <strong>Go Premium</strong>
                <span>Unlock exam prep and corrections.</span>
              </div>
            </div>
            <div class="lp-dash">
              <div class="lp-dash-header">
                <div class="lp-dash-greeting"><strong>Guten Morgen, Ana</strong><span>Day 34 · B1.2 in progress</span></div>
                <div class="lp-avatar-initials">A</div>
              </div>
              <div class="lp-progress-card">
                <div class="lp-progress-row"><span>Level B1 · Selbstständig</span><span class="pct">62%</span></div>
                <div class="lp-progress-track"><div class="lp-progress-fill" style="width:62%"></div></div>
                <div class="lp-progress-note">18 of 29 lessons · next: Termin beim Amt</div>
              </div>
              <div class="lp-mini-grid">
                <div class="lp-mini-card">
                  <img src="/assets/methods.jpg" alt="" />
                  <div class="lp-mini-card-body"><span>A2 · Alltag</span><div class="lp-mini-bar"><div class="lp-mini-bar-fill" style="width:100%;background:var(--brand-blue-light)"></div></div></div>
                </div>
                <div class="lp-mini-card">
                  <img src="/assets/foto-buero-2.jpg" alt="" />
                  <div class="lp-mini-card-body"><span>B1 · Beruf</span><div class="lp-mini-bar"><div class="lp-mini-bar-fill" style="width:62%;background:var(--brand-blue)"></div></div></div>
                </div>
                <div class="lp-mini-card">
                  <img src="/assets/online-is-futur.jpg" alt="" />
                  <div class="lp-mini-card-body"><span>Authentic clips</span><div class="lp-mini-bar"><div class="lp-mini-bar-fill" style="width:24%;background:var(--accent)"></div></div></div>
                </div>
                <div class="lp-locked-card">
                  <div class="icon">🔒</div>
                  <strong>Goethe B2 prep</strong>
                  <span>Premium</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SECOND SECTION: previous hero (quiz demo), relocated as-is -->
    <section class="lp-section">
      <div class="lp-wrap lp-hero-inner">
        <div class="lp-hero-copy">
          <div class="lp-eyebrow">Deutsch von A1 bis C1</div>
          <h1>Deutsch lernen, wie es wirklich gesprochen wird</h1>
          <p class="lp-hero-lead">Grammatik, Alltagsdeutsch und Sprechpraxis — aufgebaut aus echtem Unterrichtsmaterial, nicht kalt für eine Plattform geschrieben.</p>
          <p class="lp-hero-sub">Kostenloser Grundkurs A1–C1, plus Prüfungsvorbereitung für Goethe, telc, TestDaF, DTZ und Leben in Deutschland, wenn du bereit bist.</p>
          <div class="lp-hero-actions">
            <a href="#" class="lp-btn lp-btn--primary">Start Learning Free</a>
            <a href="#" class="lp-btn lp-btn--outline">See How It Works</a>
          </div>
          <div class="lp-hero-progress"><span></span><span></span></div>
          <div class="lp-hero-note">Kostenloser Grundkurs A1–C1 · kein Abo nötig</div>
        </div>
        <div class="lp-browser">
          <div class="lp-browser-bar">
            <div class="lp-browser-dot"></div><div class="lp-browser-dot"></div><div class="lp-browser-dot"></div>
            <div class="lp-browser-url">deutschacademy.com/uebungen</div>
          </div>
          <div class="lp-browser-body">
            <div class="lp-sidebar">
              <img src="/assets/logo.png" alt="" />
              <div class="lp-sidebar-link lp-sidebar-link--active">📚 Grammatik-Quiz</div>
              <div class="lp-sidebar-link">🎯 der/die/das-Trainer</div>
              <div class="lp-sidebar-link">🗂️ Wortschatz</div>
              <div class="lp-sidebar-link">🔊 Aussprache</div>
              <div class="lp-sidebar-link">🗣️ Sprechen</div>
              <div class="lp-sidebar-link">✍️ Lesen &amp; Schreiben</div>
              <div class="lp-sidebar-link">🗺️ Kulturwissen</div>
            </div>
            <div class="lp-dash">
              <div class="lp-dash-header">
                <div class="lp-dash-greeting"><strong>Grammatik-Quiz</strong><span>Thema 1 von {grammatik.length}</span></div>
              </div>
              <div class="lp-dash-stat-row">
                <div class="lp-dash-stat"><strong>{grammarQuestionCount}</strong><span>Fragen</span></div>
                <div class="lp-dash-stat"><strong>{grammatik.length}</strong><span>Themen</span></div>
                <div class="lp-dash-stat"><strong>0€</strong><span>Kosten</span></div>
              </div>
              <div class="lp-dash-question">
                <div class="lp-quiz-kicker">Akkusativ</div>
                <p class="lp-quiz-prompt">Ich habe <span class="blank">___</span> Computer.</p>
                <p class="lp-quiz-hint">(der Computer)</p>
                <div class="lp-quiz-choices">
                  <span class="lp-quiz-choice">der</span>
                  <span class="lp-quiz-choice lp-quiz-choice--correct">den</span>
                  <span class="lp-quiz-choice">das</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- TRUST BAR -->
    <section class="lp-trust">
      <div class="lp-wrap lp-trust-grid">
        <div class="lp-trust-item"><div class="lp-trust-num">{toolCount}</div><div class="lp-trust-label">Übungstools, alle kostenlos</div></div>
        <div class="lp-trust-item"><div class="lp-trust-num">{examCount}</div><div class="lp-trust-label">Prüfungen im Überblick</div></div>
        <div class="lp-trust-item"><div class="lp-trust-num">{userCount}+</div><div class="lp-trust-label">Lernende bisher</div></div>
        <div class="lp-trust-item"><div class="lp-trust-num">0€</div><div class="lp-trust-label">für den A1–C1-Grundkurs</div></div>
      </div>
    </section>

    <!-- VALUE PROPS -->
    <section class="lp-section">
      <div class="lp-wrap">
        <div class="lp-section-head">
          <div class="lp-eyebrow">Why DeutschAcademy</div>
          <h2>Built from real classes, not templates</h2>
          <p>Every lesson below has already been taught, live, to real learners — not written cold for a course platform.</p>
        </div>
        <div class="lp-value-grid">
          <div class="lp-value-card">
            <img src="/assets/bricks-2181920_1280.jpg" alt="" />
            <div class="lp-value-card-body"><h3>60+ grammar topics, properly explained</h3><p>Every case, tense and construction — Dativ, Genitiv, Passiv, Konjunktiv II, Relativsätze — broken down with worked exercises, not just quick tips.</p></div>
          </div>
          <div class="lp-value-card">
            <img src="/assets/online-is-futur.jpg" alt="" />
            <div class="lp-value-card-body"><h3>Everyday German, not textbook dialogues</h3><p>Scenario-based practice pulled from real life: Behördengänge, moving apartments, describing your day, ordering at a café.</p></div>
          </div>
          <div class="lp-value-card">
            <img src="/assets/letsdoit.jpg" alt="" />
            <div class="lp-value-card-body"><h3>Speaking practice built in</h3><p>Role-play, partner exercises and picture descriptions (Bildbeschreibung) — the part learners usually only get in a live class.</p></div>
          </div>
          <div class="lp-value-card">
            <img src="/assets/foto-buero-1.jpg" alt="" />
            <div class="lp-value-card-body"><h3>Exam-format prep, not guesswork</h3><p>Mock sittings and writing tasks structured the way Goethe and telc actually test you, corrected by a real instructor.</p></div>
          </div>
        </div>
      </div>
    </section>

    <!-- HOW IT WORKS -->
    <section class="lp-section lp-section--alt">
      <div class="lp-wrap">
        <div class="lp-section-head" style="max-width:560px">
          <div class="lp-eyebrow">So funktioniert's</div>
          <h2>Dein Weg zu fließendem Deutsch — in drei klaren Schritten</h2>
        </div>
        <div class="lp-track">
          <div class="lp-road-step"><div class="lp-road-node">1</div><div class="lp-road-label">Schritt 1</div><h3>Grammatik</h3><p>60+ Grammatikthemen — von Dativ bis Konjunktiv II, mit durchdachten Übungen.</p></div>
          <div class="lp-road-step"><div class="lp-road-node">2</div><div class="lp-road-label">Schritt 2</div><h3>Alltagsdeutsch</h3><p>Echte Alltagsszenarien statt Lehrbuchdialoge: Ämter, Wohnungssuche, der Alltag.</p></div>
          <div class="lp-road-step"><div class="lp-road-node">3</div><div class="lp-road-label">Schritt 3</div><h3>Sprechpraxis</h3><p>Rollenspiele, Partnerübungen und Bildbeschreibungen üben.</p></div>
        </div>
      </div>
    </section>

    <!-- TOOLS -->
    <section class="lp-section">
      <div class="lp-wrap">
        <div class="lp-section-head" style="max-width:600px">
          <div class="lp-eyebrow">Alle Werkzeuge</div>
          <h2>Übungen und Prüfungsvorbereitung, an einem Ort</h2>
          <p>Kein Zusammensuchen zwischen Apps und Karteikarten — alles lebt im selben Dashboard.</p>
        </div>
        <div class="lp-tools-group">
          <div class="lp-tools-label">Übungen</div>
          <div class="lp-tools-grid">
            {tools.map((t) => (
              <a href={t.href} class="lp-tool-card">
                <div class="lp-tool-chip">{t.icon}</div>
                <h4>{t.title}</h4>
                <p>{t.desc}</p>
                <span class="lp-tool-card-count">{t.count}</span>
              </a>
            ))}
            <div class="lp-tool-card lp-tool-card--soon">
              <div class="lp-tool-chip">{comingSoonTool.icon}</div>
              <h4>{comingSoonTool.title}</h4>
              <p>{comingSoonTool.desc}</p>
              <span class="lp-tool-card-count lp-tool-card-count--soon">{comingSoonTool.count}</span>
            </div>
          </div>
        </div>
        <div class="lp-tools-group lp-tools-group--exams">
          <div class="lp-tools-label">Prüfungen</div>
          <div class="lp-tools-grid lp-tools-grid--exams">
            {exams.map((e) => (
              <a href={e.href} class="lp-tool-card">
                <div class="lp-tool-chip">{e.icon}</div>
                <h4>{e.title}</h4>
                <p>{e.level}</p>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- DEEP DIVE -->
    <section class="lp-section lp-section--alt">
      <div class="lp-wrap">
        <div class="lp-section-head" style="max-width:600px">
          <div class="lp-eyebrow">What's included</div>
          <h2>Everything you get, tier by tier</h2>
        </div>
        <div class="lp-deepdive-grid">
          <div class="lp-deep-card">
            <div class="lp-deep-icon">01</div>
            <div class="lp-deep-head"><h3>Core Course</h3><p>Everything you need to build real fluency, self-paced.</p></div>
            <div class="lp-deep-list">
              <div class="lp-deep-item"><span class="lp-check-icon">✓</span><span>Full A1–C1 curriculum, built from live-taught lessons</span></div>
              <div class="lp-deep-item"><span class="lp-check-icon">✓</span><span>60+ grammar topics explained in depth</span></div>
              <div class="lp-deep-item"><span class="lp-check-icon">✓</span><span>Real-life scenario library, not textbook dialogues</span></div>
              <div class="lp-deep-item"><span class="lp-check-icon">✓</span><span>Placement test and a structured lesson path</span></div>
            </div>
            <div class="lp-deep-cta">Start free</div>
          </div>
          <div class="lp-deep-card lp-deep-card--featured">
            <div class="lp-deep-icon lp-deep-icon--featured">02</div>
            <div class="lp-deep-head"><h3>Exam Prep &amp; Coaching</h3><p>For learners with a Goethe or telc exam on the calendar.</p></div>
            <div class="lp-deep-list">
              <div class="lp-deep-item"><span class="lp-check-icon lp-check-icon--premium">✓</span><span>Everything in Core Course</span></div>
              <div class="lp-deep-item"><span class="lp-check-icon lp-check-icon--premium">✓</span><span>Exam-format mock sittings, structured the way Goethe/telc test you</span></div>
              <div class="lp-deep-item"><span class="lp-check-icon lp-check-icon--premium">✓</span><span>Writing tasks corrected by a human instructor, not a model</span></div>
              <div class="lp-deep-item"><span class="lp-check-icon lp-check-icon--premium">✓</span><span>Speaking practice: role-play, partner exercises, Bildbeschreibung</span></div>
              <div class="lp-deep-item"><span class="lp-check-icon lp-check-icon--premium">✓</span><span>Exam-structure walkthroughs, so nothing on test day is a surprise</span></div>
            </div>
            <div class="lp-deep-cta lp-deep-cta--featured">Go Premium</div>
          </div>
          <div class="lp-deep-card lp-deep-card--cyan">
            <div class="lp-deep-icon">03</div>
            <div class="lp-deep-head"><h3>Community &amp; Practice</h3><p>Where you actually use the German you're learning.</p></div>
            <div class="lp-deep-list">
              <div class="lp-deep-item"><span class="lp-check-icon">✓</span><span>Monthly live Q&amp;A with an instructor</span></div>
              <div class="lp-deep-item"><span class="lp-check-icon">✓</span><span>Partner and small-group speaking practice</span></div>
              <div class="lp-deep-item"><span class="lp-check-icon">✓</span><span>A space to ask questions between lessons</span></div>
              <div class="lp-deep-item"><span class="lp-check-icon">✓</span><span>New practice material added as the course grows</span></div>
            </div>
            <div class="lp-deep-cta">Join the community</div>
          </div>
        </div>
      </div>
    </section>

    <!-- PRICING -->
    <section class="lp-section">
      <div class="lp-wrap">
        <div class="lp-section-head" style="max-width:560px">
          <div class="lp-eyebrow">Pricing</div>
          <h2>One free course. One upgrade, when you're ready to sit the exam.</h2>
          <p>Everything above is either included free or unlocked with Premium — no hidden tiers.</p>
        </div>
        <div class="lp-pricing-grid">
          <div class="lp-price-card">
            <div class="lp-price-name">Free</div>
            <div class="lp-price-amount"><strong>€0</strong><span>forever</span></div>
            <div class="lp-price-desc">Everything you need to learn on your own, at no cost.</div>
            <div class="lp-price-divider"></div>
            <div class="lp-price-list">
              <div class="lp-price-item"><span class="lp-check-icon">✓</span><span>Full A1–C1 core course</span></div>
              <div class="lp-price-item"><span class="lp-check-icon">✓</span><span>Placement test &amp; structured path</span></div>
              <div class="lp-price-item"><span class="lp-check-icon">✓</span><span>60+ grammar topic breakdowns</span></div>
              <div class="lp-price-item lp-price-item--off"><span class="lp-check-icon">—</span><span>Exam-format mock sittings</span></div>
              <div class="lp-price-item lp-price-item--off"><span class="lp-check-icon">—</span><span>Human writing corrections</span></div>
            </div>
            <div class="lp-price-cta">Start Free</div>
          </div>
          <!-- TODO(Edgar): confirm price - one-time vs monthly membership; see Language Cluster Strategy, open decisions -->
          <div class="lp-price-card lp-price-card--featured">
            <div class="lp-price-badge">MOST POPULAR</div>
            <div class="lp-price-name">Premium Membership</div>
            <div class="lp-price-amount"><strong>€XX</strong><span>/month (TBD)</span></div>
            <div class="lp-price-desc">Everything in Free, plus what you need to actually pass the exam.</div>
            <div class="lp-price-divider"></div>
            <div class="lp-price-list">
              <div class="lp-price-item"><span class="lp-check-icon lp-check-icon--premium">✓</span><span>Everything in the Free plan</span></div>
              <div class="lp-price-item"><span class="lp-check-icon lp-check-icon--premium">✓</span><span>Exam-format mock sittings (Goethe &amp; telc)</span></div>
              <div class="lp-price-item"><span class="lp-check-icon lp-check-icon--premium">✓</span><span>Human corrections on every writing task</span></div>
              <div class="lp-price-item"><span class="lp-check-icon lp-check-icon--premium">✓</span><span>Speaking &amp; role-play practice sessions</span></div>
              <div class="lp-price-item"><span class="lp-check-icon lp-check-icon--premium">✓</span><span>Monthly live community Q&amp;A</span></div>
            </div>
            <div class="lp-price-cta lp-price-cta--featured">Start Premium</div>
          </div>
        </div>
        <div class="lp-pricing-note">No contracts — cancel anytime.</div>
      </div>
    </section>

    <!-- FINAL CTA -->
    <section class="lp-final-cta">
      <div class="lp-wrap lp-final-cta-inner">
        <h2>Dein nächster Schritt zu fließendem Deutsch</h2>
        <p>Kostenlos starten, dein Niveau testen, in deinem Tempo weitermachen.</p>
        <a href="#" class="lp-final-cta-btn">Kostenlos starten</a>
        <div class="lp-final-cta-login">Already have an account? <b>Log in</b></div>
      </div>
    </section>

    <!-- FOOTER -->
    <footer class="lp-footer">
      <div class="lp-wrap lp-footer-inner">
        <div class="lp-footer-grid">
          <div class="lp-footer-brand">
            <img src="/assets/logo.png" alt="DeutschAcademy" />
            <strong>Da für Dich!</strong>
            <p>Lorem ipsum dolor sit amet consectetur adipiscing elit sed.</p>
          </div>
          <div class="lp-footer-col"><h5>Product</h5><span>Lorem ipsum</span><span>Dolor sit</span><span>Amet consectetur</span><span>Adipiscing</span></div>
          <div class="lp-footer-col"><h5>Company</h5><span>Lorem ipsum</span><span>Dolor sit</span><span>Amet consectetur</span><span>Adipiscing</span></div>
          <div class="lp-footer-col"><h5>Support</h5><span>Lorem ipsum</span><span>Dolor sit</span><span>Amet consectetur</span><span>Adipiscing</span></div>
