---
// Wires a page's help blocks (GrammarHelpText.astro) to the language menu in the site
// header — see mountGrammarHelp in src/lib/textHelp.js. There is no switch and no language
// row here any more: the header decides, for every page at once. What is left is the one
// thing the learner should know while reading a translation — that it is a machine draft.
//
// Used by grammar topics and by Leben in Deutschland, Kultur, Hören and Sprechen; `root`
// names the element whose blocks it drives.
import "../styles/grammar-help.css";

interface Props {
  level?: string;
  /** False while the translation is a draft nobody has checked. */
  reviewed?: boolean;
  /** id of the element holding the .gx-tr blocks. */
  root?: string;
}
const { reviewed = false, root = "vp-page" } = Astro.props;
---
<div class="gx-bar" data-gx-bar data-root={root} hidden>
  {!reviewed && (
    <p class="help-draft gx-draft" data-i18n="gx.draft">Übersetzung: maschineller Entwurf, noch nicht von einer Lehrkraft geprüft.</p>
  )}
</div>

<script>
  import { mountGrammarHelp } from "../lib/textHelp.js";
  // A page can carry the bar more than once (Artikel: in the Regel pane and the lesson);
  // every bar on the same root is driven together.
  const byRoot = new Map<string, HTMLElement[]>();
  document.querySelectorAll<HTMLElement>("[data-gx-bar]").forEach((bar) => {
    const id = bar.dataset.root ?? "vp-page";
    byRoot.set(id, [...(byRoot.get(id) ?? []), bar]);
  });
  byRoot.forEach((bars, id) => {
    const root = document.getElementById(id);
    if (root) mountGrammarHelp(root, bars);
  });
</script>
