---
// /impressum — Anbieterkennzeichnung nach § 5 DDG (ehemals § 5 TMG).
//
// The operator details live in src/lib/legal.js, not here, because the Datenschutz page
// repeats them and two copies drift. While that file still has TODO fields, this page
// renders a red warning banner instead of pretending to be complete: an Impressum with
// placeholder text is a worse legal position than a missing one.
//
// Not legal advice. Drafted from the structure of colevitate.com's legal pages and the
// facts of this codebase; have it reviewed before relying on it.
import Layout from "../layouts/Layout.astro";
import PracticeHeader from "../components/PracticeHeader.astro";
import { LEGAL, legalComplete, filled } from "../lib/legal.js";
import "../styles/practice.css";
import "../styles/legal.css";

const ready = legalComplete();
---
<Layout
  title="Impressum – DeutschAcademy"
  description="Anbieterkennzeichnung und Kontaktdaten von DeutschAcademy."
>
  <PracticeHeader title="Impressum" />
  <main class="legal-main">
    <div class="legal-head">
      <h1>Impressum</h1>
      <p class="legal-updated">Angaben gemäß § 5 DDG</p>
    </div>

    {!ready && (
      <div class="legal-warn">
        <strong>Diese Seite ist noch nicht vollständig.</strong>
        Die Pflichtangaben in <code>src/lib/legal.js</code> sind noch nicht ausgefüllt.
        Ein unvollständiges Impressum ist rechtlich schlechter als gar keins — bitte vor
        dem Veröffentlichen ergänzen.
      </div>
    )}

    <div class="legal-body">
      <h2>Diensteanbieter</h2>
      <dl class="legal-rows">
        <dt>Name</dt><dd>{LEGAL.operatorName}</dd>
        <dt>Anschrift</dt>
        <dd>
          {LEGAL.operatorStreet}<br />
          {LEGAL.operatorPostcode} {LEGAL.operatorCity}<br />
          {LEGAL.operatorCountry}
        </dd>
        <dt>E-Mail</dt>
        <dd><a href={`mailto:${LEGAL.contactEmail}`}>{LEGAL.contactEmail}</a></dd>
        {filled(LEGAL.operatorPhone) && (<><dt>Telefon</dt><dd>{LEGAL.operatorPhone}</dd></>)}
        {LEGAL.managingDirector && (<><dt>Vertreten durch</dt><dd>{LEGAL.managingDirector}</dd></>)}
        {LEGAL.register && (<><dt>Registereintrag</dt><dd>{LEGAL.register}</dd></>)}
        {LEGAL.vatId && (<><dt>USt-IdNr.</dt><dd>{LEGAL.vatId}</dd></>)}
        {LEGAL.responsibleForContent && (
          <><dt>Inhaltlich verantwortlich</dt><dd>{LEGAL.responsibleForContent}</dd></>
        )}
      </dl>

      <h2>Kontakt</h2>
      <p>
        Fragen zu den Inhalten, zu einem Konto oder zu deinen Daten gehen am schnellsten per
        E-Mail an <a href={`mailto:${LEGAL.contactEmail}`}>{LEGAL.contactEmail}</a>.
      </p>

      <h2>Streitbeilegung</h2>
      <p>
        Wir sind weder bereit noch verpflichtet, an Streitbeilegungsverfahren vor einer
        Verbraucherschlichtungsstelle teilzunehmen.
      </p>

      <h2>Haftung für Inhalte</h2>
      <p>
        Die Übungen, Wortlisten und Prüfungsinformationen auf dieser Seite werden nach bestem
        Wissen erstellt. Für die Richtigkeit, Vollständigkeit und Aktualität der Inhalte können
        wir jedoch keine Gewähr übernehmen. Verbindlich sind allein die Angaben der jeweiligen
        Prüfungsanbieter.
      </p>
      <p>
        Prüfungsformate, Prüfungsnamen und Prüfungsmaterialien Dritter (telc, Goethe-Institut,
        TestDaF-Institut, BAMF) sind Eigentum der jeweiligen Rechteinhaber. Die Übungen auf
        dieser Seite sind eigene Materialien, die sich am veröffentlichten Format orientieren,
        und sind kein offizielles Prüfungsmaterial.
      </p>

      <h2>Haftung für Links</h2>
      <p>
        Diese Seite verlinkt auf externe Webseiten, etwa auf die offiziellen Modellsätze der
        Prüfungsanbieter. Auf deren Inhalte haben wir keinen Einfluss und übernehmen dafür
        keine Haftung. Für die Inhalte verlinkter Seiten ist stets deren Anbieter verantwortlich.
      </p>

      <h2>Urheberrecht</h2>
      <p>
        Die von uns erstellten Inhalte auf dieser Seite unterliegen dem deutschen Urheberrecht.
        Die zum Download angebotenen PDFs dürfen für den eigenen Unterricht und das eigene
        Lernen frei genutzt, ausgedruckt und weitergegeben werden.
      </p>
    </div>
  </main>
</Layout>
