---
// Schreiben for the Artikel topic: a Diktat. The learner hears "der Tisch" and types it —
// article, noun, capital letter. It is the fourth beat of Aktiv (Sehen · Hören · Sprechen ·
// Schreiben), which on the other topics hands back to Üben; here Üben is the der/die/das
// trainer, where nothing is written, so the chip got a panel of its own.
//
// Only nouns with a recorded "der Tisch" (src/lib/lexicon.js `audio`, generated by
// scripts/generate-wortschatz-audio.mjs) can be dictated — the browser's voice would
// swallow exactly the ending a Diktat is about. That is the A1 set today; the pool grows
// by itself as more levels are voiced. The checking lives in src/lib/artikelDiktat.js.
import { nouns } from "../lib/lexicon.js";
import "../styles/artikel-diktat.css";

const ROUND = 10;
const pool = nouns({ level: ["A1", "A2", "B1", "B2"], has: "gender" })
  .filter((n) => n.audio)
  .map((n) => ({ id: n.id, lemma: n.lemma, gender: n.gender, level: n.level, audio: `/audio/wortschatz/${n.audio}.mp3` }));
---
<section class="ak-panel akd" data-beat-panel="schreiben" hidden>
  <h2 data-i18n="ak.beat.schreiben">Schreiben</h2>
  <p class="ak-panel-lead">
    Diktat: Du hörst ein Nomen mit Artikel. Schreib beides — mit großem Anfangsbuchstaben.
    z. B. <b>der Tisch</b>
  </p>

  <div class="ak-card akd-card" data-akd>
    <div class="akd-top">
      <span class="akd-count" data-akd-count>1 / {ROUND}</span>
      <span class="akd-score" data-akd-score></span>
    </div>

    <div class="akd-listen">
      <button type="button" class="akd-play" data-akd-play aria-label="Anhören">
        <span class="ak-play-icon" aria-hidden="true"></span>
      </button>
      <button type="button" class="akd-slow" data-akd-slow aria-pressed="false">Langsam</button>
    </div>

    <form class="akd-form" data-akd-form autocomplete="off">
      <input
        class="akd-input"
        data-akd-input
        type="text"
        inputmode="text"
        autocapitalize="off"
        autocorrect="off"
        spellcheck="false"
        placeholder="der, die oder das + Nomen"
        aria-label="Was hörst du?"
      />
      <div class="akd-keys" aria-label="Sonderzeichen">
        {["ä", "ö", "ü", "ß", "Ä", "Ö", "Ü"].map((k) => <button type="button" data-akd-key={k}>{k}</button>)}
      </div>
      <button type="submit" class="akd-check" data-akd-check>Prüfen</button>
    </form>

    <div class="akd-feedback" data-akd-feedback aria-live="polite" hidden></div>
    <button type="button" class="akd-next" data-akd-next hidden>Weiter →</button>

    <div class="akd-done" data-akd-done hidden>
      <p class="akd-done-title" data-akd-done-title></p>
      <p class="akd-done-text" data-akd-done-text></p>
      <button type="button" class="akd-check" data-akd-again>Neues Diktat</button>
    </div>
  </div>

  <script type="application/json" id="akd-data" set:html={JSON.stringify({ round: ROUND, pool })}></script>
</section>

<script>
  import { mountDiktat } from "../lib/artikelDiktat.js";
  const root = document.querySelector<HTMLElement>("[data-akd]");
  const raw = document.getElementById("akd-data")?.textContent;
  if (root && raw) mountDiktat(root, JSON.parse(raw));
</script>
