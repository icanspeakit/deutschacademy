{
  "name": "deutschacademy",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "generate:fakten-pdf": "node scripts/generate-fakten-pdf.mjs",
    "generate:grammatik-pdf": "node scripts/generate-grammatik-pdf.mjs",
    "generate:wortschatz-pdf": "node scripts/generate-wortschatz-pdf.mjs",
    "generate:pdfs": "pnpm generate:grammatik-pdf && pnpm generate:wortschatz-pdf && pnpm generate:fakten-pdf",
    "generate:audio": "node --env-file=.env.local scripts/generate-audio.mjs",
    "generate:hoeren": "node --env-file=.env.local scripts/generate-hoeren-audio.mjs",
    "validate:lexicon": "node scripts/validate-lexicon.mjs",
    "sprechen:bilder": "node scripts/list-sprechen-bilder.mjs",
    "sprechen:fetch": "node --env-file=.env.local scripts/fetch-sprechen-bilder.mjs",
    "lexicon:ranks": "node scripts/attach-ranks.mjs",
    "prebuild": "node scripts/clean-prerender.mjs",
    "lexicon:ipa": "node scripts/fetch-wiktionary.mjs",
    "lexicon:merge": "node scripts/merge-tranche.mjs"
  },
  "dependencies": {
    "astro": "^7.0.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/pdfkit": "^0.17.6",
    "pdfkit": "^0.20.2"
  }
}
