        { "de": "Das finde ich nicht.", "en": "I don't think so.", "ar": "لا أرى ذلك.", "ru": "Я так не считаю.", "tr": "Ben öyle düşünmüyorum." },
        { "de": "Ja, aber …", "en": "Yes, but …", "ar": "نعم، لكن …", "ru": "Да, но …", "tr": "Evet, ama …" },
        { "de": "Auf keinen Fall.", "en": "No way.", "ar": "مستحيل.", "ru": "Ни в коем случае.", "tr": "Kesinlikle hayır." }
      ]
