---
import Layout from "../../../layouts/Layout.astro";
import PracticeHeader from "../../../components/PracticeHeader.astro";
import "../../../styles/practice.css";
import "../../../styles/verben-praepositionen.css";
import "../../../styles/rule-intro.css";
import grammatik from "../../../data/grammatik.json";

// Two kinds of topic live on this route:
//
//   1. Workspaces — a file in src/data/grammatik/ describes a full Kursbuchseite: the
//      "Wie funktioniert das?" card plus up to five exercises, driven by grammarWorkspace.js.
//      Adding one is a JSON file; no page change needed.
//   2. Quiz topics — an entry in grammatik.json with nothing but questions. They get the
//      same shell with a single Lückentext exercise, until someone writes them a workspace.
//
// akkusativ keeps its own bespoke page (akkusativ.astro) and is skipped here.
export function getStaticPaths() {
  const mods = import.meta.glob("../../../data/grammatik/*.json", { eager: true });
  const all = Object.values(mods).map((m) => m.default ?? m);
  const covered = new Set(all.map((w) => w.id));

  return [
    ...all.map((w) => ({ params: { id: w.slug ?? w.id }, props: { workspace: w } })),
    ...grammatik
      .filter((t) => t.id !== "akkusativ" && !covered.has(t.id))
      .map((t) => ({ params: { id: t.id }, props: { topic: t } })),
  ];
}

const { workspace, topic } = Astro.props;
const name = workspace ? workspace.name : topic.name;
const level = workspace ? workspace.level : topic.level;
const intro = workspace ? workspace.subtitle : topic.intro;
const concept = workspace?.concept;
const reference = concept?.reference;
---
<Layout title={`${name} – DeutschAcademy`}>
  <PracticeHeader title={name} />

  <!-- Rendered collapsed, then opened by the script if this learner asked for it.
       Collapsed is the more common state — the side column slides away on desktop,
       the rule card crops to a preview on a phone — so starting here means no
       visible re-layout on load. -->
  <main class="vp-page vp-page--split" id="vp-page" data-rule="hidden" data-anim="off">
    <a href="/uebungen/grammatik" class="vp-back-link" data-i18n="header.back">← Zurück zur Übersicht</a>

    <!-- Two columns on desktop: rule sticky on the right, exercises on the left.
         The rule stays FIRST in the DOM so that on a phone — where scroll order is
         the only hierarchy there is — the learner still meets the rule before the
         exercises. The desktop grid then places the exercises in column 1.
         Every [data-ex-index] slot must stay inside #vp-page: mountGrammarWorkspace
         binds to them from that root. -->
    <div class="vp-workspace">
    <aside class="vp-col vp-col--rule" id="vp-rule">
    <div class="vp-hero">
      <div class="vp-hero-badges">
        <span class="badge badge-brand" data-i18n="grammatik.hero.eyebrow">GRAMMATIK ÜBEN</span>
        <span class="badge badge-info">{level}</span>
      </div>
      <h1>{name}</h1>
      <p data-i18n={workspace?.subtitleKey}>{intro}</p>
    </div>

    {concept && (
      <div class="vp-card vp-rule-card" id="vp-rule-card">
        <div class="vp-card-label" data-i18n="vp.howItWorks">Wie funktioniert das?</div>

        {concept.flow && (
          <div class="vp-flow">
            {concept.flow.map((step, i) => (
              <>
                {i > 0 && <span class="vp-flow-arrow">→</span>}
                <div class={`vp-flow-step ${step.variant ? `vp-flow-step--${step.variant}` : ""}`}>{step.text}</div>
              </>
            ))}
          </div>
        )}

        {concept.exampleHtml && <p class="vp-example" set:html={concept.exampleHtml} />}

        {concept.qa && (
          <div class="vp-qa-grid">
            {concept.qa.map((item) => (
              <div class="vp-qa-item">
                <span set:html={item.html} />
                {item.tag && <span class="vp-qa-tag">{item.tag}</span>}
              </div>
            ))}
          </div>
        )}

        {concept.noteHtml && <p class="vp-note" set:html={concept.noteHtml} />}

        {reference && (
          <>
            <button
              type="button"
              class="vp-toggle-ref"
              id="vp-toggle-ref"
              data-show={reference.showLabel ?? "Referenzliste anzeigen ▼"}
              data-hide={reference.hideLabel ?? "Referenzliste ausblenden ▲"}
            >{reference.showLabel ?? "Referenzliste anzeigen ▼"}</button>

            <div id="vp-ref-panel" hidden>
              {reference.tables?.map((table) => (
                <div class="vp-ref-table-wrap">
                  {table.caption && <p class="vp-ref-table-caption">{table.caption}</p>}
                  <div class="vp-ref-table-scroll">
                    <table class="vp-ref-table">
                      <thead>
                        <tr>{table.head.map((h) => <th>{h}</th>)}</tr>
                      </thead>
                      <tbody>
                        {table.rows.map((row) => (
                          <tr>{row.map((cell, i) => (i === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>))}</tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                  {table.note && <p class="vp-ref-table-note">{table.note}</p>}
                </div>
              ))}

              {reference.boxes && (
                <div class="vp-ref-grid">
                  {reference.boxes.map((box) => (
                    <div class={`vp-ref-box vp-ref-box--${box.variant ?? "akk"}`}>
                      <span class={`badge ${box.variant === "dat" ? "badge-info" : "badge-brand"}`}>{box.badge}</span>
                      <ul>{box.items.map((item) => <li>{item}</li>)}</ul>
                    </div>
                  ))}
                </div>
              )}
            </div>
          </>
        )}
      </div>
    )}

    <!-- Phone counterpart of .vp-rule-toggle. There is no side column to slide on a
         phone, so the same preference crops the rule card to a preview instead and
         this button opens it. Rendered only with a concept card — there is nothing
         to crop otherwise. -->
    {concept && (
      <button
        type="button"
        class="vp-rule-peek"
        id="vp-rule-peek"
        data-show="Regel anzeigen"
        data-hide="Regel einklappen"
        aria-controls="vp-rule-card"
      >Regel anzeigen</button>
    )}

    </aside>

    <section class="vp-col vp-col--ex">
    <div class="vp-ex-toolbar">
      <h2 class="vp-section-title" data-i18n="nav.exercises">Übungen</h2>
      <button
        type="button"
        class="vp-rule-toggle"
        id="vp-rule-toggle"
        data-show="Regel einblenden"
        data-hide="Regel ausblenden"
      >Regel einblenden</button>
    </div>

    <div class="vp-ex-grid">
    {workspace ? (
      workspace.exercises.map((ex, i) => (
        <div class="vp-card">
          <div class="vp-ex-head">
            <span class="badge badge-neutral">{i + 1}</span>
            <h3>{ex.title}</h3>
          </div>
          {ex.hint && <p class="vp-ex-hint">{ex.hint}</p>}
          <div data-ex-index={i}></div>
        </div>
      ))
    ) : (
      <div class="vp-card">
        <div class="vp-ex-head">
          <span class="badge badge-neutral">1</span>
          <h3>Lückentext: Ergänzen Sie.</h3>
        </div>
        <div id="quiz-root"></div>
      </div>
    )}
    </div>
    </section>
    </div>

    <!-- Dev only. The tour is a once-per-browser thing, so the moment you have seen
         it you can no longer see it the way a learner does — ?intro replays the
         animation but not the first-load path around it (the auto-play decision, the
         collapsed first paint, the scroll position it measures from). This wipes both
         stored flags and reloads clean, so the same browser gets to be a new user
         again. Stripped from the built site. -->
    {import.meta.env.DEV && (
      <button type="button" class="vp-dev-reset" id="vp-dev-reset" title="Tour-Flags löschen und neu laden">
        ↻ Tour neu
      </button>
    )}
  </main>

  <script type="application/json" id="topic-data" set:html={JSON.stringify(workspace ?? topic)}></script>
  <script type="module">
    import { mountGrammarWorkspace } from "../../../lib/grammarWorkspace.js";
    import { createRuleIntro } from "../../../lib/ruleIntro.js";
    import { createCardCollapse } from "../../../lib/cardCollapse.js";
    import { mountQuiz, withChoices } from "../../../lib/quiz.js";
    import { recordAttempt } from "../../../lib/progress.js";

    const data = JSON.parse(document.getElementById("topic-data").textContent);
    const onAnswer = (ok) => recordAttempt({ skill: "grammatik", correct: ok });

    if (Array.isArray(data.exercises)) {
      mountGrammarWorkspace(document.getElementById("vp-page"), data, { onAnswer });
    } else {
      mountQuiz(document.getElementById("quiz-root"), withChoices(data.questions), { mode: "choice", onAnswer });
    }

    // The rule panel slides in and out of its own column rather than appearing.
    // Its state is remembered, because whether you still need the rule visible is a
    // per-learner thing, not a per-visit one — and a learner who has never chosen
    // gets the panel demonstrated to them once (see the peek below).
    const page = document.getElementById("vp-page");
    const ruleEl = document.getElementById("vp-rule");
    const ruleBtn = document.getElementById("vp-rule-toggle");
    // On a phone the same preference crops the rule card to a preview instead of
    // sliding a column away, so there is a second control for it down there.
    const ruleCard = document.getElementById("vp-rule-card");
    const peekBtn = document.getElementById("vp-rule-peek");
    const RULE_KEY = "da-grammatik-rule";
    const PEEK_KEY = "da-grammatik-rule-peek";
    const wide = matchMedia("(min-width: 1001px)");
    const calm = matchMedia("(prefers-reduced-motion: reduce)");

    let ruleHidden = true;

    // Collapsed means "out of play" on both layouts, but not the same box: the
    // whole column on desktop, and on a phone only the cropped card — everything
    // under the fade is unreadable, including the reference-list button, which
    // would otherwise still be a tab stop. The hero and the toggle sit outside it.
    function syncInert() {
      if (ruleEl) ruleEl.inert = ruleHidden && wide.matches;
      if (ruleCard) ruleCard.inert = ruleHidden && !wide.matches;
    }
    wide.addEventListener("change", syncInert);

    // The phone crop: CSS owns the preview height, this owns the trip to and from it
    // (and holds the toggle still while the page shrinks above it).
    const crop = createCardCollapse({
      card: ruleCard,
      toggle: peekBtn,
      active: matchMedia("(max-width: 1000px)"),
      calm,
    });

    function applyRule(hidden, persist = true) {
      crop.animate(hidden);
      ruleHidden = hidden;
      page.dataset.rule = hidden ? "hidden" : "";
      if (ruleBtn) ruleBtn.textContent = hidden ? ruleBtn.dataset.show : ruleBtn.dataset.hide;
      if (peekBtn) {
        peekBtn.textContent = hidden ? peekBtn.dataset.show : peekBtn.dataset.hide;
        peekBtn.setAttribute("aria-expanded", hidden ? "false" : "true");
      }
      syncInert();
      if (persist) { try { localStorage.setItem(RULE_KEY, hidden ? "hidden" : "shown"); } catch {} }
    }

    let ruleSaved = null, peeked = true;
    try {
      ruleSaved = localStorage.getItem(RULE_KEY);
      peeked = localStorage.getItem(PEEK_KEY) === "1";
    } catch {}

    // Restore without animating: the slide is feedback for an action, and nobody
    // took one yet.
    applyRule(ruleSaved === null ? true : ruleSaved === "hidden", false);
    requestAnimationFrame(() => requestAnimationFrame(() => {
      delete page.dataset.anim;
      crop.arm();
    }));

    // The intro never persists a rule preference — it is a demo, not a choice the
    // learner made — so it gets applyRule with persistence off. On a phone it points
    // at the button instead of the side column: the collapsed card has no box left
    // to spotlight — it is zero-height while hidden — so the button IS the rule as
    // far as the first screen is concerned.
    const compact = !wide.matches;
    const intro = createRuleIntro({
      ruleEl: compact ? (peekBtn ?? ruleEl) : ruleEl,
      ruleBtn: compact ? peekBtn : ruleBtn,
      setRule: (hidden) => applyRule(hidden, false),
      compact,
    });

    // Once per browser on the learner's first grammar page. ?intro replays it on
    // demand without spending that one time, which is how you show it to someone.
    const forced = new URLSearchParams(location.search).has("intro");
    if (!calm.matches && (forced || (ruleSaved === null && !peeked))) {
      if (!forced) { try { localStorage.setItem(PEEK_KEY, "1"); } catch {} }
      // The phone tour frames boxes near the top of the page; a restored scroll
      // position would leave it framing nothing.
      if (compact) requestAnimationFrame(() => intro.play());
      else intro.play();
    }

    const onToggle = () => {
      intro.cancel();
      applyRule(page.dataset.rule !== "hidden");
    };
    ruleBtn?.addEventListener("click", onToggle);
    peekBtn?.addEventListener("click", onToggle);

    // Dev reset (see the button's note above). A full reload rather than just
    // intro.play(), because the interesting part is everything that happens BEFORE
    // the tour decides to run.
    document.getElementById("vp-dev-reset")?.addEventListener("click", () => {
      try {
        localStorage.removeItem(RULE_KEY);
        localStorage.removeItem(PEEK_KEY);
      } catch {}
      // A restored scroll position would put the compact tour's targets off screen,
      // which is the one thing a fresh load never has.
      history.scrollRestoration = "manual";
      window.scrollTo(0, 0);
      // Without the query string this is the plain first-visit path, not ?intro.
      location.replace(location.pathname);
    });

    const toggleRefBtn = document.getElementById("vp-toggle-ref");
    const refGrid = document.getElementById("vp-ref-panel");
    toggleRefBtn?.addEventListener("click", () => {
      refGrid.hidden = !refGrid.hidden;
      toggleRefBtn.textContent = refGrid.hidden ? toggleRefBtn.dataset.show : toggleRefBtn.dataset.hide;
    });
  </script>
</Layout>
