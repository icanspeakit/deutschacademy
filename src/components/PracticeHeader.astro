---
import LanguageSwitcher from "./LanguageSwitcher.astro";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  title: string;
  titleKey?: string;
}
const { title, titleKey } = Astro.props;
---
<header class="practice-header">
  <div class="practice-header-inner">
    <a href="/uebungen" class="practice-back" data-i18n="header.allExercises">← Alle Übungen</a>
    <span class="practice-header-title" data-i18n={titleKey}>{title}</span>
    <div class="practice-header-right">
      <a href="/" class="practice-back" data-i18n="header.home">Startseite</a>
      <LanguageSwitcher />
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .practice-header-right { display: flex; align-items: center; gap: 16px; }
</style>
