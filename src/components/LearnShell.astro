  <script>
    import { getTopicProgress, recordAttempt, resetProgress } from "../lib/progress.js";
    import { createExerciseMounter, INLINE_TITLES, loaderFor } from "../lib/inlineExercises.js";
    import { mountQuiz, withChoices } from "../lib/quiz.js";
    import { mountGrammarWorkspace } from "../lib/grammarWorkspace.js";
    import { mountPracticeWorkspace } from "../lib/practiceWorkspace.js";

    const DATA = JSON.parse(document.getElementById("nv-data")!.textContent!);
    const ITEMS: Record<string, any> = DATA.items;
    const SECTIONS: Record<string, any> = DATA.sections;
    const TOPICS: Record<string, any> = DATA.topics;
    const RING = 2 * Math.PI * 42;
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

    // Live progress. Starts from the server's mock values; the inline quiz
    // writes into it, and every bar/ring/label on the page reads from it.
    // Real progress, read back from localStorage. The server rendered zeros; this
    // is where the page learns what the learner has already done.
    const progress: Record<string, number> = {};
    const stored = (() => { try { return getTopicProgress(); } catch (e) { return {}; } })();
    Object.keys(ITEMS).forEach((id) => {
      const tasks = ITEMS[id].tasks;
      progress[id] = tasks ? Math.min(stored[id]?.done ?? 0, tasks) : 0;
    });

    const $ = <T extends Element = HTMLElement>(sel: string) => document.querySelector(sel) as T | null;
    const $$ = (sel: string) => Array.from(document.querySelectorAll(sel)) as HTMLElement[];

    // ── Motion helpers ────────────────────────────────────────────────
    // Each run stamps the element; an older run that is still animating sees a
    // newer stamp and stops. Without this, switching items fast lets the
    // previous item's count-up keep writing over the new item's number.
    let countToken = 0;
    function countUp(el: Element | null, to: number, suffix = "%") {
      if (!el) return;
      const token = String(++countToken);
      (el as HTMLElement).dataset.count = token;
      const from = parseInt(el.textContent || "0", 10) || 0;
      if (reduced || from === to) { el.textContent = to + suffix; return; }
      const start = performance.now();
      // Matches --nv-dur-value and the expo-out curve the bars and rings use, so
      // the number and the bar under it finish together instead of racing.
      const dur = 1150;
      const step = (now: number) => {
        if ((el as HTMLElement).dataset.count !== token) return;
        const t = Math.min(1, (now - start) / dur);
        const eased = t === 1 ? 1 : 1 - Math.pow(2, -10 * t);
        el.textContent = Math.round(from + (to - from) * eased) + suffix;
        if (t < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    }
    // Writing a plain value must also cancel any in-flight animation.
    function setCount(el: Element | null, text: string) {
      if (!el) return;
      (el as HTMLElement).dataset.count = String(++countToken);
      el.textContent = text;
    }

    function setRing(el: Element | null, pct: number, sweep = false) {
      if (!el) return;
      if (sweep && !reduced) {
        el.setAttribute("stroke-dashoffset", String(RING));
        // Next frame, so the transition has something to move from.
        requestAnimationFrame(() => requestAnimationFrame(() =>
          el.setAttribute("stroke-dashoffset", String(RING * (1 - pct / 100)))));
      } else {
        el.setAttribute("stroke-dashoffset", String(RING * (1 - pct / 100)));
      }
    }

    function flash(el: Element | null, cls = "nv-flash") {
      if (!el || reduced) return;
      el.classList.remove(cls);
      void (el as HTMLElement).offsetWidth; // restart the animation
      el.classList.add(cls);
    }

    let toastTimer: number | undefined;
    function toast(msg: string) {
      const t = $("[data-toast]");
      if (!t) return;
      t.textContent = msg;
      t.hidden = false;
      flash(t, "nv-toast--in");
      clearTimeout(toastTimer);
      toastTimer = window.setTimeout(() => { t.hidden = true; }, 3200);
    }

    // ── Derived numbers ───────────────────────────────────────────────
    const pctOf = (id: string) => {
      const it = ITEMS[id];
      return it.tasks ? Math.round((progress[id] / it.tasks) * 100) : null;
    };
    function sectionTotals(sid: string) {
      const ids = SECTIONS[sid].items.filter((id: string) => ITEMS[id].tasks);
      const tasks = ids.reduce((a: number, id: string) => a + ITEMS[id].tasks, 0);
      const done = ids.reduce((a: number, id: string) => a + progress[id], 0);
      return { tasks, done, pct: tasks ? Math.round((done / tasks) * 100) : null };
    }

    // Repaint every number that depends on `progress`.
    function repaint(sweep = false) {
      // Aggregates first: a course module is the sum of the topics under it.
      Object.keys(ITEMS).forEach((id) => {
        const from: string[] | null = ITEMS[id].derived;
        if (from) progress[id] = from.reduce((a, x) => a + (progress[x] ?? 0), 0);
      });

      Object.keys(ITEMS).forEach((id) => {
        const it = ITEMS[id];
        if (!it.tasks) return;
        const p = pctOf(id)!;
        $$(`[data-itembar="${id}"]`).forEach((b) => (b.style.width = p + "%"));
        $$(`[data-itempoints="${id}"]`).forEach((e) => (e.textContent = `${progress[id]} / ${it.tasks}`));
        $$(`[data-count="${id}"]`).forEach((e) => (e.textContent = `${progress[id]}/${it.tasks}`));
        $$(`[data-row="${id}"]`).forEach((e) => e.classList.toggle("done", p === 100));
      });

      Object.keys(SECTIONS).forEach((sid) => {
        const st = sectionTotals(sid);
        if (st.pct === null) return;
        $$(`[data-secbar="${sid}"]`).forEach((b) => (b.style.width = st.pct + "%"));
        $$(`[data-secpct="${sid}"]`).forEach((e) => (e.textContent = st.pct + " %"));
        const label = $(`[data-secringlabel="${sid}"]`);
        if (label) label.textContent = `${st.done} von ${st.tasks} Aufgaben`;
        const dot = $(`[data-raildot="${sid}"]`);
        if (dot) dot.dataset.state = st.pct === 100 ? "done" : st.pct > 0 ? "current" : "todo";
        const ladderBtn = $(`[data-ladder="${sid}"]`);
        if (ladderBtn) ladderBtn.dataset.state = st.pct === 100 ? "done" : st.pct > 0 ? "current" : "todo";
        // The visible section ring animates; the hidden ones just get set.
        const view = $(`[data-section-view="${sid}"]`);
        const visible = view && !(view as HTMLElement).hidden;
        setRing($(`[data-secring="${sid}"]`), st.pct, sweep && !!visible);
        if (visible) countUp($(`[data-secringvalue="${sid}"]`), st.pct);
        else setCount($(`[data-secringvalue="${sid}"]`), st.pct + "%");
      });

      mounter.repaintResult();   // keeps the Ergebnis view live while it is open

      const course = sectionTotals("weg");
      const fill = $("[data-strip-fill]");
      if (fill && course.pct !== null) fill.style.width = course.pct + "%";
      const stripLabel = $("[data-strip-label]");
      if (stripLabel && course.pct !== null) stripLabel.textContent = `${course.pct} % · ${course.done} / ${course.tasks} Aufgaben`;
    }

    // ── Variant switch ────────────────────────────────────────────────
    function showVariant(id: string) {
      $$("[data-variant-pane]").forEach((p) => { p.hidden = p.dataset.variantPane !== id; });
      $$(".nv-toggle-btn").forEach((b) => {
        const on = b.dataset.variant === id;
        b.classList.toggle("active", on);
        b.setAttribute("aria-selected", String(on));
      });
      try { localStorage.setItem("nv-variant", id); } catch (e) {}
    }
    $$(".nv-toggle-btn").forEach((b) => b.addEventListener("click", () => showVariant(b.dataset.variant!)));

    // ── The content views ─────────────────────────────────────────────
    const current = { section: "weg", item: null as string | null };
    const LEVEL_SOURCE_TEXT: Record<string, string> = {
      data: "Stufe aus den Daten",
      abgeleitet: "Stufe aus dem Inhalt abgeleitet — noch kein level-Feld",
      "—": "",
    };

    let railShown: string | null = null;
    let itemShown: string | null = null;

    // Akkusativ → W-Fragen only rewrote the card's text in place, so the swap fell
    // between two frames and read as a repaint. Slide the card in from the side the
    // new topic sits on: down the list enters from the right, up from the left, and
    // the direction itself says which way you moved. Only the card moves — the view
    // holds a fixed-position dock, and transforming its container would drag that
    // along for the ride.
    function playItemSwap(id: string, section: string) {
      const view = $("[data-item-view]");
      if (!view) return;
      const rows = $$(`[data-rail-section="${section}"] .nvb-item`).map((b) => b.dataset.navItem);
      const from = itemShown ? rows.indexOf(itemShown) : -1;
      const to = rows.indexOf(id);
      const back = from > -1 && to > -1 && to < from;
      itemShown = id;
      view.classList.remove("nv-view--fwd", "nv-view--back");
      void view.offsetWidth;
      view.classList.add(back ? "nv-view--back" : "nv-view--fwd");
    }

    function selectSection(id: string, keepItem = false) {
      current.section = id;
      if (!keepItem) current.item = null;

      $$("[data-section-view]").forEach((v) => { v.hidden = v.dataset.sectionView !== id || !!current.item; });
      const itemView = $("[data-item-view]");
      if (itemView) itemView.hidden = !current.item;

      // Swapping levels used to be a single frame: one list gone, another there.
      // Replay the stagger so the new list visibly arrives. Picking a topic inside
      // the same level must not replay it — that list did not change.
      const railChanged = railShown !== id;
      railShown = id;
      $$("[data-rail-section]").forEach((s) => {
        const on = s.dataset.railSection === id;
        s.hidden = !on;
        s.classList.remove("nvb-section--enter");
        if (on && railChanged) { void s.offsetWidth; s.classList.add("nvb-section--enter"); }
      });
      $$("[data-section-btn]").forEach((b) => b.classList.toggle("active", b.dataset.sectionBtn === id));
      $("[data-nvb]")?.classList.remove("collapsed");

      // In the accordion, choosing a group also opens it.
      const head = $(`.nvc-head[data-section-btn="${id}"]`);
      if (head) {
        $$("[data-nvc-group]").forEach((g) => {
          const on = g.contains(head);
          g.classList.toggle("open", on);
          g.querySelector(".nvc-head")?.setAttribute("aria-expanded", String(on));
        });
      }

      if (!current.item) {
        itemShown = null;
        stopQuiz();
        $$("[data-nav-item]").forEach((el) => { el.classList.remove("active"); el.setAttribute("aria-current", "false"); });
        repaint(true);
        mountQuickExercise(id);
      }
      try { localStorage.setItem("nv-view", JSON.stringify(current)); } catch (e) {}
    }

    function selectItem(id: string) {
      const it = ITEMS[id];
      if (!it) return;
      current.item = id;
      selectSection(it.section, true);

      const wasActive = $(".nvb-item.active")?.dataset.navItem;
      $$("[data-nav-item]").forEach((el) => {
        const on = el.dataset.navItem === id;
        el.classList.toggle("active", on);
        el.classList.remove("nvb-item--pick");
        el.setAttribute("aria-current", on ? "page" : "false");
        if (on && el.classList.contains("nvb-item") && wasActive !== id) {
          void el.offsetWidth;
          el.classList.add("nvb-item--pick");
        }
      });

      const set = (sel: string, text: string) => { const el = $(sel); if (el) el.textContent = text; };
      set("[data-detail-eyebrow]", it.eyebrow);
      set("[data-detail-title]", it.label);
      set("[data-detail-level]", it.level);
      set("[data-detail-levelsrc]", LEVEL_SOURCE_TEXT[it.levelSource] || "");
      set("[data-detail-lead]", it.lead);
      const href = $<HTMLAnchorElement>("[data-detail-href]");
      if (href) href.href = it.href;

      paintItemRing(id, true);
      paintFocusHead(id);


      $$("[data-section-view]").forEach((v) => (v.hidden = true));
      const itemView = $("[data-item-view]");
      if (itemView) itemView.hidden = false;
      playItemSwap(id, it.section);

      mountPractice(id);
      try { localStorage.setItem("nv-view", JSON.stringify(current)); } catch (e) {}
    }

    function paintItemRing(id: string, sweep = false) {
      const it = ITEMS[id];
      const pct = pctOf(id);
      setRing($("[data-detail-ring]"), pct ?? 0, sweep);
      const value = $("[data-detail-ringvalue]");
      if (value) {
        if (pct === null) setCount(value, "–");
        else if (sweep) { setCount(value, "0%"); countUp(value, pct); }
        else countUp(value, pct);
      }
      const label = $("[data-detail-ringlabel]");
      if (label) label.textContent = it.tasks
        ? `${progress[id]} von ${it.tasks} Aufgaben` + (it.minutes ? ` · ca. ${it.minutes} Min.` : "")
        : "Keine Aufgaben zu zählen";
    }

    // ── The inline exercise ───────────────────────────────────────────
    let mountedTopic: string | null = null;

    function stopQuiz() {
      const root = $("[data-quiz-root]");
      if (root) root.innerHTML = "";
      const ws = $("[data-ws-root]");
      if (ws) { ws.hidden = true; ws.innerHTML = ""; }
      const trainerPanel = $("[data-trainer-panel]");
      if (trainerPanel) trainerPanel.hidden = true;
      const inlinePanel = $("[data-inline-panel]");
      if (inlinePanel) inlinePanel.hidden = true;
      mountedTopic = null;
    }

    // One correct answer, wherever it came from, moves every number on the page.
    function creditAnswer(id: string, ok: boolean) {
      // Wrong answers are recorded too — they count toward the streak and the
      // per-skill accuracy, they just do not advance the topic.
      try {
        recordAttempt({
          skill: DATA.skillOf[id] ?? "grammatik",
          correct: ok,
          topic: id,
          id,
          trackVocab: id === "artikel-trainer" || DATA.skillOf[id] === "wortschatz",
        });
      } catch (e) {}
      if (!ok) return;
      const before = pctOf(id);
      progress[id] = Math.min(progress[id] + 1, ITEMS[id].tasks);
      repaint();
      paintItemRing(id);
      paintFocusHead(id);
      flash($("[data-itemringcard]"), "nv-pop");
      if (pctOf(id) === 100 && before !== 100) {
        flash($("[data-itemringcard]"), "nv-celebrate");
        toast(`✓ ${ITEMS[id].label} abgeschlossen`);
        if (sectionTotals(ITEMS[id].section).pct === 100) toast(`🎉 ${ITEMS[id].sectionLabel} komplett`);
      }
    }

    const esc = (s: any) => String(s ?? "").replace(/[&<>"']/g, (c) =>
      ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c] as string));

    // The same rule card and exercise shells [id].astro renders server-side —
    // rebuilt here so /nav can show any of the 21 topics without shipping them all.
    function ruleCardHtml(w: any): string | null {
      const c = w.concept;
      if (!c) return null;
      const ref = c?.reference;
      return `
        <div class="vp-card">
          <div class="vp-card-label">Wie funktioniert das?</div>
          ${c.flow ? `<div class="vp-flow">${c.flow
            .map((s: any, i: number) =>
              `${i > 0 ? '<span class="vp-flow-arrow">→</span>' : ""}<div class="vp-flow-step${s.variant ? ` vp-flow-step--${esc(s.variant)}` : ""}">${esc(s.text)}</div>`)
            .join("")}</div>` : ""}
          ${c.exampleHtml ? `<p class="vp-example">${c.exampleHtml}</p>` : ""}
          ${c.qa ? `<div class="vp-qa-grid">${c.qa
            .map((q: any) => `<div class="vp-qa-item"><span>${q.html}</span>${q.tag ? `<span class="vp-qa-tag">${esc(q.tag)}</span>` : ""}</div>`)
            .join("")}</div>` : ""}
          ${c.noteHtml ? `<p class="vp-note">${c.noteHtml}</p>` : ""}
          ${ref ? `
            <button type="button" class="vp-toggle-ref" data-ws-ref
              data-show="${esc(ref.showLabel ?? "Referenzliste anzeigen ▼")}"
              data-hide="${esc(ref.hideLabel ?? "Referenzliste ausblenden ▲")}"
            >${esc(ref.showLabel ?? "Referenzliste anzeigen ▼")}</button>
            <div data-ws-refpanel hidden>
              ${(ref.tables ?? []).map((t: any) => `
                <div class="vp-ref-table-wrap">
                  ${t.caption ? `<p class="vp-ref-table-caption">${esc(t.caption)}</p>` : ""}
                  <div class="vp-ref-table-scroll">
                    <table class="vp-ref-table">
                      <thead><tr>${t.head.map((h: string) => `<th>${esc(h)}</th>`).join("")}</tr></thead>
                      <tbody>${t.rows.map((r: string[]) =>
                        `<tr>${r.map((cell, i) => i === 0 ? `<th scope="row">${esc(cell)}</th>` : `<td>${esc(cell)}</td>`).join("")}</tr>`).join("")}</tbody>
                    </table>
                  </div>
                  ${t.note ? `<p class="vp-ref-table-note">${esc(t.note)}</p>` : ""}
                </div>`).join("")}
              ${ref.boxes ? `<div class="vp-ref-grid">${ref.boxes.map((b: any) => `
                <div class="vp-ref-box vp-ref-box--${esc(b.variant ?? "akk")}">
                  <span class="badge ${b.variant === "dat" ? "badge-info" : "badge-brand"}">${esc(b.badge)}</span>
                  <ul>${b.items.map((i: string) => `<li>${esc(i)}</li>`).join("")}</ul>
                </div>`).join("")}</div>` : ""}
            </div>` : ""}
        </div>`;

    }

    function exerciseCardsHtml(w: any) {
      return (w.exercises ?? []).map((ex: any, i: number) => `
        <div class="vp-card">
          <div class="vp-ex-head"><span class="badge badge-neutral">${i + 1}</span><h3>${esc(ex.title)}</h3></div>
          ${ex.hint ? `<p class="vp-ex-hint">${esc(ex.hint)}</p>` : ""}
          <div data-ex-index="${i}"></div>
        </div>`).join("");
    }

    // /dashboard stacks the rule above the exercises; /v2 puts it in the drawer
    // and starts the column at the exercises.
    function workspaceHtml(w: any, withRule = true) {
      const rule = withRule ? ruleCardHtml(w) : null;
      return `
        ${withRule ? `<div class="nv-ws-head">
          <h2>Regel &amp; Übungen</h2>
          <span class="nv-learn-badge">läuft in dieser Ansicht</span>
        </div>` : ""}
        ${rule ?? ""}
        <h3 class="nv-ws-subhead">Übungen <span>${(w.exercises ?? []).length}</span></h3>
        ${exerciseCardsHtml(w)}`;
    }

    // ── The Artikel-Trainer ───────────────────────────────────────────
    // Every exercise kind lives in src/lib/inlineExercises.js so the topic pages
    // mount the identical widgets from the identical data. This shell only says
    // what an answer means here: it moves this page's numbers, and it persists.
    const ARTIKEL = JSON.parse(document.getElementById("nv-artikel")!.textContent!);
    const mounter = createExerciseMounter({
      DATA,
      ARTIKEL,
      credit: (id: string, ok: boolean) => creditAnswer(id, ok),
      onPick: (id: string) => selectItem(id),
      totals: (sid: string) => (SECTIONS[sid] ? sectionTotals(sid) : null),
      sections: SECTIONS,
    });
    const mountInline = mounter.mountInline;
    const mountTrainer = mounter.mountTrainer;

    // ── Focus mode (/v2): the rule lives in a drawer, not above the exercises ──
    const LAYOUT = JSON.parse(document.getElementById("nv-layout")!.textContent!);
    const focusMode = LAYOUT === "focus";
    const drawer = {
      panel: $("[data-rule-panel]"),
      title: $("[data-rule-title]"),
      teaser: $("[data-rule-teaser]"),
      cta: $("[data-rule-open]"),
      scrim: $(".nvf-scrim"),
      aside: $(".nvf-drawer"),
    };

    function openRule(open: boolean) {
      if (!drawer.aside) return;
      drawer.aside.classList.toggle("open", open);
      drawer.aside.setAttribute("aria-hidden", String(!open));
      drawer.cta?.setAttribute("aria-expanded", String(open));
      if (drawer.scrim) drawer.scrim.hidden = !open;
      if (open) ($(".nvf-drawer-x") as HTMLElement | null)?.focus();
      else (drawer.cta as HTMLElement | null)?.focus();
    }
    drawer.cta?.addEventListener("click", () => openRule(true));
    $$("[data-rule-close]").forEach((b) => b.addEventListener("click", () => openRule(false)));
    addEventListener("keydown", (e) => {
      if (e.key === "Escape" && drawer.aside?.classList.contains("open")) openRule(false);
    });

    // Fills the drawer for the open topic, and hides the trigger when there is no
    // rule to show — a Karteikarten deck has none, and an empty drawer is worse
    // than no button.
    function setRule(html: string | null, name: string, teaser: string) {
      if (!focusMode || !drawer.cta) return;
      const has = !!html;
      (drawer.cta as HTMLElement).hidden = !has;
      if (!has) { openRule(false); return; }
      if (drawer.panel) drawer.panel.innerHTML = html!;
      if (drawer.title) drawer.title.textContent = `Regel — ${name}`;
      if (drawer.teaser) drawer.teaser.textContent = teaser || "Wie funktioniert das?";
    }

    // The focus head carries the progress the hero card carries elsewhere.
    function paintFocusHead(id: string) {
      if (!focusMode) return;
      const it = ITEMS[id];
      const pct = pctOf(id);
      const bar = $("[data-focus-bar]") as HTMLElement | null;
      if (bar) bar.style.width = (pct ?? 0) + "%";
      const count = $("[data-focus-count]");
      if (count) count.textContent = it.tasks ? `${progress[id]} / ${it.tasks}` : "";
    }

    const mountedQuick = new Set<string>();

    async function mountQuickExercise(sectionId: string) {
      const card = $(`[data-quickex="${sectionId}"]`);
      if (!card || mountedQuick.has(sectionId)) return;
      const topicId = (card as HTMLElement).dataset.quickTopic!;

      if ((card as HTMLElement).dataset.quickKind === "trainer") {
        mountedQuick.add(sectionId);
        mountTrainer(card.querySelector("[data-trainer-root]") as HTMLElement);
        return;
      }

      const loader = loaderFor(topicId);
      if (!loader) return;

      mountedQuick.add(sectionId);
      const mod: any = await loader();
      const w = mod.default ?? mod;
      const slot = card.querySelector("[data-ex-index]") as HTMLElement | null;
      if (slot) slot.innerHTML = "";
      mountGrammarWorkspace(card, w, { onAnswer: (ok: boolean) => creditAnswer(topicId, ok) });
    }

    async function mountWorkspace(id: string) {
      const root = $("[data-ws-root]");
      const loader = loaderFor(id);
      if (!root || !loader) return false;
      if (mountedTopic === id) { root.hidden = false; return true; }

      root.hidden = false;
      root.innerHTML = `<p class="nv-ws-loading">Übungen werden geladen …</p>`;
      const mod: any = await loader();
      // The learner may have clicked on to something else while this loaded.
      if (current.item !== id) return true;

      const w = mod.default ?? mod;
      root.innerHTML = workspaceHtml(w, !focusMode);
      if (focusMode) setRule(ruleCardHtml(w), w.name, w.subtitle ?? "");
      mountedTopic = id;

      root.querySelector("[data-ws-ref]")?.addEventListener("click", (e) => {
        const btn = e.currentTarget as HTMLElement;
        const panel = root.querySelector("[data-ws-refpanel]") as HTMLElement | null;
        if (!panel) return;
        panel.hidden = !panel.hidden;
        btn.textContent = panel.hidden ? btn.dataset.show! : btn.dataset.hide!;
      });

      mountGrammarWorkspace(root, w, { onAnswer: (ok: boolean) => creditAnswer(id, ok) });
      return true;
    }

    function mountPractice(id: string) {
      if (focusMode && ITEMS[id].practice !== "workspace") setRule(null, "", "");
      const learn = $("[data-learn]");
      const empty = $("[data-learn-empty]");
      const ws = $("[data-ws-root]");
      const root = $("[data-quiz-root]");
      const trainerPanel = $("[data-trainer-panel]");
      const kind = ITEMS[id].practice;

      if (kind !== "workspace" && ws) { ws.hidden = true; ws.innerHTML = ""; }
      if (trainerPanel) trainerPanel.hidden = kind !== "trainer";

      if (kind === "trainer") {
        if (learn) learn.hidden = true;
        if (empty) empty.hidden = true;
        if (root) root.innerHTML = "";
        mountTrainer(trainerPanel!.querySelector("[data-trainer-root]") as HTMLElement);
        return;
      }

      const INLINE_KINDS = ["choice", "cards", "audio", "speak", "read", "dtz", "picker", "result", "bausteine"];
      const inlinePanel = $("[data-inline-panel]");
      if (inlinePanel) inlinePanel.hidden = !INLINE_KINDS.includes(kind as string);
      if (kind && INLINE_KINDS.includes(kind)) {
        if (learn) learn.hidden = true;
        if (empty) empty.hidden = true;
        if (root) root.innerHTML = "";
        const it = ITEMS[id];
        const set = (sel: string, t: string) => { const el = inlinePanel!.querySelector(sel); if (el) el.textContent = t; };
        set("[data-inline-eyebrow]", it.eyebrow);
        set("[data-inline-title]", INLINE_TITLES[kind] ?? it.label);
        set("[data-inline-sub]", it.lead);
        mountInline(inlinePanel!.querySelector("[data-inline-root]") as HTMLElement, id, kind);
        return;
      }

      if (kind === "workspace") {
        if (learn) learn.hidden = true;
        if (empty) empty.hidden = true;
        if (root) root.innerHTML = "";
        mountWorkspace(id);
        return;
      }

      const topic = TOPICS[id];
      if (kind !== "quiz" || !topic) {
        stopQuiz();
        if (learn) learn.hidden = true;
        if (empty) empty.hidden = false;
        return;
      }

      if (learn) learn.hidden = false;
      if (empty) empty.hidden = true;
      const intro = $("[data-learn-intro]");
      if (intro) intro.textContent = topic.intro;

      if (mountedTopic === id || !root) return;
      root.innerHTML = "";
      mountedTopic = id;
      mountQuiz(root, withChoices(topic.questions), { mode: "choice", onAnswer: (ok: boolean) => creditAnswer(id, ok) });
    }

    // ── Wiring ────────────────────────────────────────────────────────
    $$("[data-section-btn]").forEach((b) => b.addEventListener("click", () => selectSection(b.dataset.sectionBtn!)));
    $$("[data-nav-item]").forEach((b) => b.addEventListener("click", () => selectItem(b.dataset.navItem!)));
    $$("[data-reset-progress]").forEach((b) =>
      b.addEventListener("click", () => {
        if (!confirm("Deinen gesamten Fortschritt löschen? Das lässt sich nicht rückgängig machen.")) return;
        try { resetProgress(); } catch (e) {}
        Object.keys(progress).forEach((k) => (progress[k] = 0));
        repaint(true);
        toast("Fortschritt zurückgesetzt");
      }));
    // Still live for the card's own "Zurück zur Stufe" button.
    $$("[data-back]").forEach((b) => b.addEventListener("click", () => selectSection(current.section)));
    $$("[data-nvb-collapse]").forEach((b) =>
      b.addEventListener("click", (e) => { e.stopPropagation(); $("[data-nvb]")?.classList.toggle("collapsed"); }));

    // ── Restore ───────────────────────────────────────────────────────
    const AVAILABLE: string[] = JSON.parse(document.getElementById("nv-variants")!.textContent!);
    let savedVariant = AVAILABLE[0];
    try {
      const stored = localStorage.getItem("nv-variant");
      if (stored && AVAILABLE.includes(stored)) savedVariant = stored;
    } catch (e) {}
    showVariant(savedVariant);

    let saved: any = null;
    try { saved = JSON.parse(localStorage.getItem("nv-view") || "null"); } catch (e) {}
    if (saved && saved.item && ITEMS[saved.item]) selectItem(saved.item);
    else selectSection(saved && saved.section ? saved.section : "weg");
  </script>
