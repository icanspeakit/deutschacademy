---
// /fortschritt — one page that answers "how far am I with this exam?"
//
// Shape taken from the Pflegeplace dashboard: a left rail nesting the open exam's parts
// under it with a count each, the other exams below as a switcher, and a main panel with
// the headline number, a carry-on button and a module table. The rail says where you are,
// the table says what is left.
//
// Distinct from /dashboard, which is the level-and-topic view over the practice tools.
// This one is only about the exam sittings, and it reads what those trainers already
// store (src/lib/exam/registry.js knows where each one keeps its answers).
//
// Rendered empty and filled on the client, because all of it comes from localStorage —
// there is no account yet, so a first visit genuinely has nothing to show and says so.
import Layout from "../layouts/Layout.astro";
import PracticeHeader from "../components/PracticeHeader.astro";
import { examRegistry } from "../lib/exam/registry.js";
import "../styles/practice.css";
import "../styles/exam-dashboard.css";
---
<Layout
  title="Mein Fortschritt – DeutschAcademy"
  description="Dein Stand in jeder Prüfung: Start Deutsch 1, TestDaF, DTZ und Leben in Deutschland — Punkte, begonnene Teile und der nächste offene Prüfungsteil."
>
  <PracticeHeader title="Mein Fortschritt" />
  <main class="practice-main practice-main--wide">
    <div class="fs-topbar">
      <span class="fs-topbar-brand">DeutschAcademy <small>Mein Fortschritt</small></span>
      <span class="fs-topbar-hint">Nur in diesem Browser gespeichert</span>
    </div>

    <div class="fs-shell" data-fs-root>
      <aside class="fs-rail" data-fs-rail></aside>
      <section class="fs-main" data-fs-main></section>
    </div>

    <!-- Without JS there is no localStorage to read, so the page offers the trainers
         themselves rather than an empty dashboard. -->
    <noscript>
      <ul class="fs-noscript">
        {examRegistry.map((e) => (
          <li><a href={e.href}>{e.title}</a> — {e.subtitle}</li>
        ))}
      </ul>
      <style>{`.fs-shell { display: none; }`}</style>
    </noscript>
  </main>

  <script type="module">
    import { mountExamDashboard } from "../lib/examDashboard.js";
    mountExamDashboard(document.querySelector("[data-fs-root]"));
  </script>
</Layout>
