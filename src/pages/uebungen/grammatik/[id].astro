---
import Layout from "../../../layouts/Layout.astro";
import SiteNav from "../../../components/SiteNav.astro";
import TopicBar from "../../../components/TopicBar.astro";
import TopicRail from "../../../components/TopicRail.astro";
import ArtikelTrainer from "../../../components/ArtikelTrainer.astro";
import CourseBar from "../../../components/CourseBar.astro";
import { taskCountOf, topicKeyOf } from "../../../lib/grammarTasks.js";
import "../../../styles/practice.css";
import "../../../styles/landing.css";
import "../../../styles/verben-praepositionen.css";
import "../../../styles/rule-intro.css";
import "../../../styles/aktiv.css";
import grammatik from "../../../data/grammatik.json";
import GrammarHelp from "../../../components/GrammarHelp.astro";
import GrammarHelpText from "../../../components/GrammarHelpText.astro";
import grammarHelp from "../../../data/uebersetzungen/grammatik.json";

// Two kinds of topic live on this route:
//
//   1. Workspaces — a file in src/data/grammatik/ describes a full Kursbuchseite: the
//      "Wie funktioniert das?" card plus up to five exercises, driven by grammarWorkspace.js.
//      Adding one is a JSON file; no page change needed.
//   2. Quiz topics — an entry in grammatik.json with nothing but questions. They get the
//      same shell with a single Lückentext exercise, until someone writes them a workspace.
//
// akkusativ keeps its own bespoke page (akkusativ.astro) and is skipped here.
export function getStaticPaths() {
  const mods = import.meta.glob("../../../data/grammatik/*.json", { eager: true });
  const all = Object.values(mods).map((m) => m.default ?? m);
  const covered = new Set(all.map((w) => w.id));

  return [
    ...all.map((w) => ({ params: { id: w.slug ?? w.id }, props: { workspace: w } })),
    ...grammatik
      .filter((t) => t.id !== "akkusativ" && !covered.has(t.id))
      .map((t) => ({ params: { id: t.id }, props: { topic: t } })),
  ];
}

const { workspace, topic } = Astro.props;
const data = workspace ?? topic;
const name = workspace ? workspace.name : topic.name;
const level = workspace ? workspace.level : topic.level;
const intro = workspace ? workspace.subtitle : topic.intro;
const concept = workspace?.concept;
const reference = concept?.reference;
// The rule in the learner's language (src/data/uebersetzungen/grammatik.json). A topic with
// no entry renders exactly as before: no switch, no empty blocks.
const gx = (grammarHelp.entries as Record<string, any>)[data.id] ?? null;

// This page used to wear PracticeHeader — a bar with four text links and no sign that it
// belonged to the same site as everything else. Reached from the homepage it was a dead end:
// no menu, and nothing saying that answers were being kept. It now carries the real nav, and
// TopicBar below it says where you are and how far you got.
//
// `topicKey` is the URL slug, which is the key /dashboard draws its per-topic bars from.
const topicKey = topicKeyOf(data) ?? Astro.params.id;
const tasks = taskCountOf(data);

// Artikel's Üben view is the der/die/das trainer — every gendered noun in the lexicon, in
// levels and rounds, with audio — instead of this topic's handful of fixed exercises. The
// lesson around it (Sehen, Hören, Sprechen) is unchanged. See ArtikelTrainer.astro.
const isArtikel = topicKey === "artikel";

// Aktiv mode — Sehen · Hören · Sprechen, for the topics whose JSON carries an `aktiv`
// block. It is a second view of THIS page, not a second page: the fourth beat, Schreiben,
// is the exercise column below, so the exercises are mounted once and both modes share
// their state. Topics without the block never render the switch and are untouched.
const aktiv = workspace?.aktiv ?? null;
// No mp3s for this topic yet, so the browser's own German voice reads every line. Say so
// rather than let a learner conclude the site sounds like that on purpose. The check is
// the data, not a flag, so the notice disappears by itself the moment the generator runs.
const synthetic = aktiv ? !aktiv.hoeren?.items?.some((i) => i.audio) : false;
// The collapsed rule strip's one line. Most flows are a sequence and read correctly
// joined by an arrow, but some steps are already whole alternatives — Wechselpräpositionen
// has ["Wohin? → Akkusativ", "Wo? → Dativ"], and arrowing those together claims Dativ
// follows Akkusativ. A step containing its own arrow gets a separator instead.
const flowSteps = concept?.flow?.map((s) => s.text) ?? [];
const gist = flowSteps.join(flowSteps.some((t) => t.includes("→")) ? " · " : " → ");

const BEATS = [
  { id: "sehen", n: 1, label: "Sehen" },
  { id: "hoeren", n: 2, label: "Hören" },
  { id: "sprechen", n: 3, label: "Sprechen" },
  // No panel of its own: this chip hands the learner back to Üben mode, where the
  // exercises already live. See onExit in mountBeats.
  { id: "schreiben", n: 4, label: "Schreiben" },
];
---
<Layout title={`${name} – DeutschAcademy`}>
  <SiteNav active="grammatik" />
  {/* One bar: the topic and its progress, then where it sits in its Stufe and the way
      back to it on the map. They were two stacked bars, a row of height for nothing. */}
  <TopicBar topic={topicKey} kind="Grammatik" title={name} level={level} tasks={tasks}>
    <CourseBar slot="end" inline topic={topicKey} title={`${name} – DeutschAcademy`} />
  </TopicBar>

  <!-- The dashboard's rail, folded to a 64px strip. Opening it overlays the page rather
       than pushing it, so the exercise column below keeps its full 880px. Above 1100px
       only — see topic-rail.css. -->
  {/* Not on Artikel: its trainer brings its own A1–B2 rail (the noun levels), and two
      dark A1–B2 rails side by side read as one menu twice. */}
  {!isArtikel && <TopicRail current={topicKey} />}

  <!-- Rendered collapsed, then opened by the script if this learner asked for it.
       Collapsed is the more common state — the side column slides away on desktop,
       the rule card crops to a preview on a phone — so starting here means no
       visible re-layout on load. -->
  <main class:list={["vp-page vp-page--split vp-page--sheet", isArtikel && "akk vp-page--rule-left"]} id="vp-page" data-rule="hidden" data-anim="off" data-topic-key={topicKey} data-mode="ueben" data-gx="off">
    {aktiv && (
      <div class="ak-modes" role="tablist" aria-label="Ansicht">
        <button type="button" class="ak-mode" data-mode-btn="ueben" role="tab" aria-selected="true" title="Lesen &amp; schreiben">
          Üben<span class="ak-mode-tip">lesen &amp; schreiben</span>
        </button>
        <button type="button" class="ak-mode" data-mode-btn="aktiv" role="tab" aria-selected="false" title="Hören &amp; sprechen">
          Aktiv<span class="ak-mode-tip">hören &amp; sprechen</span>
        </button>
      </div>
    )}

    {aktiv && (
      <div class="ak-aktiv" id="ak-aktiv">
        <!-- The beat chips and the rule, pinned together. On a phone this pair is the
             whole left-hand page of the book: where you are, and the rule you need. -->
        <div class="ak-sticky" id="ak-sticky">
          <div class="ak-beats" role="tablist" aria-label="Phasen">
            {BEATS.map((b) => (
              <button type="button" class="ak-beat-chip" data-beat-chip={b.id} role="tab" aria-selected="false">
                <b>{b.n}</b>{b.label}
              </button>
            ))}
          </div>

          {concept && (
            <div class="ak-rule-strip">
              <button type="button" class="ak-rule-toggle" id="ak-rule-toggle" aria-expanded="false" aria-controls="ak-rule-body">
                Regel <span class="ak-rule-gist">{gist}</span>
                <span class="ak-caret" aria-hidden="true">▾</span>
              </button>
              <div class="ak-rule-body" id="ak-rule-body">
                <div class="ak-flow">
                  {concept.flow?.map((step, i) => (
                    <>
                      {i > 0 && <span class="ak-flow-arrow">→</span>}
                      <span class={`ak-flow-step ${step.variant ? `ak-flow-step--${step.variant}` : ""}`}>{step.text}</span>
                    </>
                  ))}
                </div>
                <div class="ak-qa">
                  {concept.qa?.map((item, i) => (
                    <div class="ak-qa-item"><Fragment set:html={item.html} /><GrammarHelpText text={gx?.qa?.[i]} /></div>
                  ))}
                </div>
                {concept.noteHtml && <p class="ak-note" set:html={concept.noteHtml} />}
                <GrammarHelpText text={gx?.note} />
              </div>
            </div>
          )}
        </div>

        {synthetic && (
          <p class="ak-proto">
            <strong>Die Stimme ist noch synthetisch.</strong> Für dieses Thema gibt es noch
            keine Aufnahmen — alles wird von der deutschen Stimme deines Browsers
            vorgelesen. Auf manchen Geräten klingt das hölzern oder fehlt ganz.
          </p>
        )}

        <section class="ak-panel" data-beat-panel="sehen">
          <h2>Sehen</h2>
          <p class="ak-panel-lead">Erst die Regel, dann das Ohr. Tipp auf ▶ — die Endung hört man deutlicher, als man sie liest.</p>

          <div class="ak-card">
            <div class="ak-flow">
              {concept?.flow?.map((step, i) => (
                <>
                  {i > 0 && <span class="ak-flow-arrow">→</span>}
                  <span class={`ak-flow-step ${step.variant ? `ak-flow-step--${step.variant}` : ""}`}>{step.text}</span>
                </>
              ))}
            </div>
            <ul class="ak-listen-list" id="ak-listen"></ul>
          </div>

          {concept && (
            <div class="ak-card">
              <div class="ak-qa">
                {concept.qa?.map((item, i) => (
                  <div class="ak-qa-item"><Fragment set:html={item.html} /><GrammarHelpText text={gx?.qa?.[i]} /></div>
                ))}
              </div>
              {concept.noteHtml && <p class="ak-note" set:html={concept.noteHtml} />}
              <GrammarHelpText text={gx?.note} />
            </div>
          )}

          <button type="button" class="ak-next" data-beat-next="hoeren">Weiter → Hören</button>
        </section>

        <section class="ak-panel" data-beat-panel="hoeren" hidden>
          <h2>Hören</h2>
          <p class="ak-panel-lead">{aktiv.hoeren.instruction}</p>
          <div id="ak-hoeren"></div>
          <button type="button" class="ak-next" data-beat-next="sprechen">Weiter → Sprechen</button>
        </section>

        <section class="ak-panel" data-beat-panel="sprechen" hidden>
          <h2>Sprechen</h2>
          <p class="ak-panel-lead">Hören, kurz überlegen, laut sagen — dann kommt die Lösung. Die einzige Übung hier, bei der du die Form selbst produzieren musst.</p>
          <div id="ak-sprechen"></div>
          <button type="button" class="ak-next" data-beat-next="schreiben">Weiter → Schreiben</button>
        </section>
      </div>
    )}

    <!-- Two columns on desktop: rule sticky on the right, exercises on the left.
         The rule stays FIRST in the DOM so that on a phone — where scroll order is
         the only hierarchy there is — the learner still meets the rule before the
         exercises. The desktop grid then places the exercises in column 1.
         Every [data-ex-index] slot must stay inside #vp-page: mountGrammarWorkspace
         binds to them from that root. -->
    {isArtikel ? <ArtikelTrainer /> : (
    <div class="vp-workspace">
    <aside class="vp-col vp-col--rule" id="vp-rule">
    <div class="vp-hero">
      <div class="vp-hero-badges">
        <span class="badge badge-brand" data-i18n="grammatik.hero.eyebrow">GRAMMATIK ÜBEN</span>
        <span class="badge badge-info">{level}</span>
      </div>
      <h1>{name}</h1>
      <p data-i18n={workspace?.subtitleKey}>{intro}</p>
      <GrammarHelpText text={gx?.intro} />
      {/* The switch sits with the rule it translates — in the rule card when there is one.
          A quiz-only topic has no card, so its switch goes under the intro here. */}
      {gx && !concept && <GrammarHelp level={level} reviewed={gx.reviewed} />}
    </div>

    {concept && (
      <div class="vp-card vp-rule-card" id="vp-rule-card">
        <!-- On a desktop this head is just the card's label. On a phone the card is a
             bottom sheet and the head is its handle: pinned to the top with the ✕, so the
             way out is never a scroll away. A rule with a flow, a table and its examples
             is several screens tall, and the only control that closed it used to sit
             under all of them — the same reason the Artikel-Trainer and the Wortschatz
             picker grew this head. -->
        <div class="vp-sheet-head">
          <div class="vp-card-label" data-i18n="vp.howItWorks">Wie funktioniert das?</div>
          <button
            type="button"
            class="vp-sheet-fold"
            data-sheet-close
            aria-label="Regel einklappen"
            data-i18n-attr="aria-label:vp.rule.collapse"
            aria-controls="vp-rule-card"
          >
            <span data-i18n="vp.rule.collapseShort">Einklappen</span>
            {/* Down, because that is where the sheet goes. */}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </button>
          <button
            type="button"
            class="vp-sheet-x"
            data-sheet-close
            aria-label="Regel schließen"
            data-i18n-attr="aria-label:vp.rule.close"
            aria-controls="vp-rule-card"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="6" y1="6" x2="18" y2="18"></line><line x1="18" y1="6" x2="6" y2="18"></line></svg>
          </button>
        </div>
        <div class="vp-sheet-body">

        {gx && <GrammarHelp level={level} reviewed={gx.reviewed} />}

        {concept.flow && (
          <div class="vp-flow">
            {concept.flow.map((step, i) => (
              <>
                {i > 0 && <span class="vp-flow-arrow">→</span>}
                <div class={`vp-flow-step ${step.variant ? `vp-flow-step--${step.variant}` : ""}`}>{step.text}</div>
              </>
            ))}
          </div>
        )}

        {concept.exampleHtml && <p class="vp-example" set:html={concept.exampleHtml} />}

        {concept.qa && (
          <div class="vp-qa-grid">
            {concept.qa.map((item, i) => (
              <div class="vp-qa-item">
                <span set:html={item.html} />
                {item.tag && <span class="vp-qa-tag">{item.tag}</span>}
                <GrammarHelpText text={gx?.qa?.[i]} />
              </div>
            ))}
          </div>
        )}

        {concept.noteHtml && <p class="vp-note" set:html={concept.noteHtml} />}
        <GrammarHelpText text={gx?.note} />

        {reference && (
          <>
            <button
              type="button"
              class="vp-toggle-ref"
              id="vp-toggle-ref"
              data-show={reference.showLabel ?? "Referenzliste anzeigen ▼"}
              data-hide={reference.hideLabel ?? "Referenzliste ausblenden ▲"}
            >{reference.open
                ? (reference.hideLabel ?? "Referenzliste ausblenden ▲")
                : (reference.showLabel ?? "Referenzliste anzeigen ▼")}</button>

            {/* `open`: for topics where the tables are the lesson (Konjugation), not an appendix. */}
            <div id="vp-ref-panel" hidden={!reference.open}>
              {reference.tables?.map((table) => (
                <div class="vp-ref-table-wrap">
                  {table.caption && <p class="vp-ref-table-caption">{table.caption}</p>}
                  <div class="vp-ref-table-scroll">
                    <table class:list={["vp-ref-table", table.compact && "vp-ref-table--compact"]}>
                      <thead>
                        <tr>{table.head.map((h) => <th>{h}</th>)}</tr>
                      </thead>
                      <tbody>
                        {table.rows.map((row) => (
                          <tr>{row.map((cell, i) => (i === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>))}</tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                  {table.note && <p class="vp-ref-table-note">{table.note}</p>}
                </div>
              ))}

              {reference.boxes && (
                <div class="vp-ref-grid">
                  {reference.boxes.map((box) => (
                    <div class={`vp-ref-box vp-ref-box--${box.variant ?? "akk"}`}>
                      <span class={`badge ${box.variant === "dat" ? "badge-info" : "badge-brand"}`}>{box.badge}</span>
                      <ul>{box.items.map((item) => <li>{item}</li>)}</ul>
                    </div>
                  ))}
                </div>
              )}
            </div>
          </>
        )}
        </div>
      </div>
    )}

    <!-- Phone counterpart of .vp-rule-toggle. There is no side column to slide on a
         phone, so the same preference crops the rule card to a preview instead and
         this button opens it. Rendered only with a concept card — there is nothing
         to crop otherwise. -->
    {concept && (
      <button
        type="button"
        class="vp-rule-peek"
        id="vp-rule-peek"
        data-show="Regel anzeigen"
        data-hide="Regel einklappen"
        aria-controls="vp-rule-card"
      >Regel anzeigen</button>
    )}

    </aside>

    <!-- The sheet's backdrop. Outside .vp-col--rule, because that column goes inert when
         the rule collapses and a control inside it would go inert with it. -->
    <div class="vp-sheet-scrim" data-sheet-close aria-hidden="true"></div>

    <section class="vp-col vp-col--ex">
    <div class="vp-ex-toolbar">
      <button
        type="button"
        class="vp-rule-toggle"
        id="vp-rule-toggle"
        data-show="Regel einblenden"
        data-hide="Regel ausblenden"
      >Regel einblenden</button>
    </div>

    <div class="vp-ex-grid">
    {workspace ? (
      workspace.exercises.map((ex, i) => (
        <div class="vp-card">
          <div class="vp-ex-head">
            <span class="badge badge-neutral">{i + 1}</span>
            <h3>{ex.title}</h3>

            {/* Same control as the column's "Regel einblenden", at this exercise's
                height: the learner asks for the rule where they are, not at the top
                of the page. Same pill, same show/hide, driven by the same
                mountRefToggle as the reference panel. */}
            {ex.rule && (
              <button
                type="button"
                class="vp-rule-toggle vp-ex-rule-btn"
                data-ex-rule={i}
                data-show="Regel"
                data-hide="Regel ausblenden"
                aria-controls={`vp-ex-rule-${i}`}
              >Regel</button>
            )}
          </div>
          {ex.hint && <p class="vp-ex-hint">{ex.hint}</p>}

          {/* Per-exercise rule. The topic's own rule card is one level up and covers the
              whole page; an exercise that asks the learner to apply ONE narrow rule needs
              that rule within reach of the thing they are doing, not behind a toggle in
              another column. Nested rather than promoted: it is a detail of this exercise,
              and putting it in the main card would bury the topic's actual point.
              `open: true` for the case where the exercise is impossible without it. */}
          {ex.rule && (
            <div class="vp-ex-rule" id={`vp-ex-rule-${i}`} hidden>
              {ex.rule.label && <p class="vp-ex-rule-label">{ex.rule.label}</p>}
              <div class="vp-ex-rule-body">
                {ex.rule.groups?.map((g) => (
                  <div class="vp-ex-rule-group">
                    <span class="vp-ex-rule-artikel">{g.artikel}</span>
                    <div>
                      <div class="vp-ex-rule-endungen">
                        {g.endungen.map((e) => <code>{e}</code>)}
                      </div>
                      {g.examples && <p class="vp-ex-rule-examples">{g.examples}</p>}
                    </div>
                  </div>
                ))}
                {/* Nested one level deeper, and closed. The endings above have to be open —
                    the exercise is impossible without them — but the caveat is four
                    paragraphs, and open it pushes the first noun two screens down at 390px.
                    The summary carries the point on its own, so a learner who never opens
                    it has still been told not to trust the table. */}
                {ex.rule.disclaimer && (
                  <details class="vp-ex-rule-warn">
                    <summary>{ex.rule.disclaimer.label}</summary>
                    <div set:html={ex.rule.disclaimer.html} />
                  </details>
                )}
              </div>
            </div>
          )}

          <div data-ex-index={i}></div>
        </div>
      ))
    ) : (
      <div class="vp-card">
        <div class="vp-ex-head">
          <span class="badge badge-neutral">1</span>
          <h3>Lückentext: Ergänzen Sie.</h3>
        </div>
        <div id="quiz-root"></div>
      </div>
    )}
    </div>
    </section>
    </div>
    )}

    <!-- Dev only. The tour is a once-per-browser thing, so the moment you have seen
         it you can no longer see it the way a learner does — ?intro replays the
         animation but not the first-load path around it (the auto-play decision, the
         collapsed first paint, the scroll position it measures from). This wipes both
         stored flags and reloads clean, so the same browser gets to be a new user
         again. Shown on the live site too. -->
    <button type="button" class="vp-dev-reset" id="vp-dev-reset" title="Tour-Flags löschen und neu laden">
      ↻ Tour neu
    </button>
  </main>

  <script type="application/json" id="topic-data" set:html={JSON.stringify(workspace ?? topic)}></script>
  <script type="module">
    import { mountGrammarWorkspace } from "../../../lib/grammarWorkspace.js";
    import { mountRuleColumn, mountRefToggle } from "../../../lib/ruleColumn.js";
    import { mountExerciseRules } from "../../../lib/exerciseRule.js";
    import { mountQuiz, withChoices } from "../../../lib/quiz.js";
    import { recordAttempt } from "../../../lib/progress.js";

    const data = JSON.parse(document.getElementById("topic-data").textContent);

    // `topic` was missing here, which is why practising on this page never moved the row for
    // this same topic on /dashboard: recordAttempt() only counts per topic when it is told
    // which one. The key is the URL slug — the one /dashboard keys its rows on too.
    const topicKey = document.getElementById("vp-page").dataset.topicKey;
    const onAnswer = (ok) => {
      try { recordAttempt({ skill: "grammatik", correct: ok, topic: topicKey }); } catch (e) {}
      dispatchEvent(new CustomEvent("da:progress", { detail: { topic: topicKey, correct: ok } }));
    };

    // Artikel brings its own workspace and rule column (ArtikelTrainer.astro); mounting
    // this page's on top of it would bind two sets of handlers to one column.
    const ownTrainer = Boolean(document.getElementById("akk-exercise-root"));

    if (ownTrainer) {
      // Nothing to mount — the trainer's own script has.
    } else if (Array.isArray(data.exercises)) {
      mountGrammarWorkspace(document.getElementById("vp-page"), data, { onAnswer });
    } else {
      mountQuiz(document.getElementById("quiz-root"), withChoices(data.questions), { mode: "choice", onAnswer });
    }

    // The rule column's own behaviour — collapse state, what it means at each width,
    // and the one-time tour — is shared with the exam pages; see src/lib/ruleColumn.js.
    if (!ownTrainer) mountRuleColumn(document.getElementById("vp-page"), {
      storageKey: "da-grammatik-rule",
      seenKey: "da-grammatik-rule-peek",
      // Below 1001px the rule is a bottom sheet rather than an accordion, matching the
      // Artikel-Trainer and the Wortschatz picker. Expanded in place it pushed the
      // exercise off the screen and carried its own way out down with it.
      sheet: true,
    });

    if (!ownTrainer) mountRefToggle(document.getElementById("vp-toggle-ref"), document.getElementById("vp-ref-panel"));

    // Per-exercise rule buttons, plus the glow that waits until one is on screen so it
    // does not compete with the column's tour. See src/lib/exerciseRule.js.
    if (!ownTrainer) mountExerciseRules(document.getElementById("vp-page"), { seenKey: "da-grammatik-ex-rule-peek" });

    // Aktiv mode. Only topics whose JSON carries an `aktiv` block have the markup.
    if (data.aktiv && document.getElementById("ak-aktiv")) {
      const { makeVoice, mountBeats, mountListen, mountHoeren, mountSprechen } =
        await import("../../../lib/aktivMode.js");
      const { recordDrill } = await import("../../../lib/progress.js");

      const page = document.getElementById("vp-page");
      const voice = makeVoice();

      // Read before mountBeats: it writes the opening beat into the hash, so asking
      // afterwards always finds one and every first visit would land in Aktiv.
      const askedForBeat = ["sehen", "hoeren", "sprechen"].includes(location.hash.slice(1));

      mountListen(document.getElementById("ak-listen"), data.aktiv.listen, voice);
      mountHoeren(document.getElementById("ak-hoeren"), data.aktiv.hoeren, { voice, notify: onAnswer });
      // Self-rated, so it goes on its own counter rather than into the accuracy figure
      // /dashboard presents as measured. See recordDrill in progress.js.
      mountSprechen(document.getElementById("ak-sprechen"), data.aktiv.sprechen, {
        voice,
        onRate: (sure) => { try { recordDrill({ topic: topicKey, sure }); } catch (e) {} },
      });

      // The beat chips pin below the site nav, not under it. Measured, because the nav is
      // 69px tall today and a different height the moment it gains a row.
      // .lp-nav on the pages that carry SiteNav, .practice-header on the trainers — both
      // are sticky at top:0 now, and the chips have to pin under whichever one is there.
      const navEl = document.querySelector(".lp-nav, .practice-header");
      const syncNav = () => {
        if (navEl) page.style.setProperty("--ak-nav-h", navEl.offsetHeight + "px");
      };
      syncNav();
      addEventListener("resize", syncNav);

      const setMode = (mode) => {
        page.dataset.mode = mode;
        page.querySelectorAll("[data-mode-btn]").forEach((b) => {
          const on = b.dataset.modeBtn === mode;
          b.classList.toggle("is-active", on);
          b.setAttribute("aria-selected", String(on));
        });
        if (mode !== "aktiv") voice.stop();
        // The address says which step you are on only in Aktiv (see mountBeats): leaving it
        // takes the step off, entering it puts the current one back.
        if (history.replaceState) {
          const url = location.pathname + location.search;
          history.replaceState(null, "", mode === "aktiv" && page.dataset.beat ? `${url}#${page.dataset.beat}` : url);
        }
        try { localStorage.setItem("da-grammatik-mode", mode); } catch (e) {}
      };

      mountBeats(page, {
        onLeave: () => voice.stop(),
        // The fourth chip has no panel: Schreiben IS the exercise column, one mode over.
        onExit: () => setMode("ueben"),
        anchor: document.getElementById("ak-sticky"),
      });

      page.querySelectorAll("[data-mode-btn]").forEach((b) =>
        b.addEventListener("click", () => setMode(b.dataset.modeBtn))
      );

      const ruleBtn = document.getElementById("ak-rule-toggle");
      if (ruleBtn) {
        ruleBtn.addEventListener("click", () => {
          const open = page.dataset.aktivRule === "open";
          page.dataset.aktivRule = open ? "closed" : "open";
          ruleBtn.setAttribute("aria-expanded", String(!open));
        });
      }

      // A link to #sprechen means "open the drill", not "scroll past the exercises", so
      // the hash decides the mode. Otherwise the learner's last choice wins, and Üben —
      // the mode every topic has — is the default for anyone who has never picked.
      let saved = null;
      try { saved = localStorage.getItem("da-grammatik-mode"); } catch (e) {}
      setMode(askedForBeat || saved === "aktiv" ? "aktiv" : "ueben");
    }
  </script>
</Layout>
