          );
        })}

        <!-- Einzelansicht: eine Hülle, aus den Daten des geklickten Eintrags gefüllt. -->
        <div class="nv-view" data-item-view hidden>
          <section class="nv-detail">
            <div>
              <p class="nv-detail-eyebrow" data-detail-eyebrow></p>
              <h1 data-detail-title></h1>
              <p class="nv-detail-level">
                <span class="nv-levelchip nv-levelchip--lg" data-detail-level></span>
                <span class="nv-detail-levelsrc" data-detail-levelsrc></span>
              </p>
              <p data-detail-lead></p>
              {/* The one way on: a plain same-tab link to where this is practised.
                  The label follows progress — see paintStart(). */}
              <div class="nv-detail-actions">
                <a class="nv-btn nv-btn--primary" href="#" data-detail-start>Übungen starten →</a>
                <button type="button" class="nv-btn nv-btn--ghost" data-back>Zurück zur Stufe</button>
              </div>
            </div>
            <div class="nv-ring-card" data-itemringcard>
              <div class="nv-ring">
                <svg width="96" height="96" viewBox="0 0 96 96">
                  <circle cx="48" cy="48" r="42" fill="none" stroke="rgba(255,255,255,.28)" stroke-width="8" />
                  <circle cx="48" cy="48" r="42" fill="none" stroke="#fff" stroke-width="8" stroke-linecap="round"
                          stroke-dasharray={RING} stroke-dashoffset={RING} data-detail-ring />
                </svg>
                <span class="nv-ring-value" data-detail-ringvalue>–</span>
              </div>
              <span class="nv-ring-label" data-detail-ringlabel></span>
            </div>
          </section>

        </div>

        <!-- How much else is here, at the foot of the page. Scrolls sideways on a phone
             and wraps on a desktop; every chip is a link to that part of the site. -->
        <nav class="nv-scale nv-scale--foot" aria-label="Was diese Seite enthält">
          {scaleChips.map((chip) => (
            <a class="nv-scale-chip" href={chip.href}>
              <span class="nv-scale-ic"><Icon name={chip.icon} size={15} /></span>
              <span class="nv-scale-txt">
                <b>{chip.value}</b>
                <i>{chip.label}</i>
              </span>
            </a>
          ))}
        </nav>
      </main>
    </div>

    <div class="nv-toast" data-toast hidden role="status" aria-live="polite"></div>
  </div>

  <script type="application/json" id="nv-variants" set:html={JSON.stringify(variants)}></script>
  <script type="application/json" id="nv-data" set:html={JSON.stringify(clientData)}></script>

  <script>
    import { getTopicProgress, resetProgress } from "../lib/progress.js";
    import { mountWegPanel, paintWegPanel } from "../lib/wegPanel.js";
    import { createRuleIntro } from "../lib/ruleIntro.js";

    const DATA = JSON.parse(document.getElementById("nv-data")!.textContent!);
    const ITEMS: Record<string, any> = DATA.items;
    const SECTIONS: Record<string, any> = DATA.sections;
    const PORTIONS: any[] = DATA.portions ?? [];
    const SECTION_IDS = new Set(Object.keys(SECTIONS));
    const RING = 2 * Math.PI * 42;
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

    // Real progress, read back from localStorage. The server rendered zeros; this
    // is where the page learns what the learner has already done.
    const progress: Record<string, number> = {};
    const stored = (() => { try { return getTopicProgress(); } catch (e) { return {}; } })();
    Object.keys(ITEMS).forEach((id) => {
      const tasks = ITEMS[id].tasks;
      progress[id] = tasks ? Math.min(stored[id]?.done ?? 0, tasks) : 0;
    });

    const $ = <T extends Element = HTMLElement>(sel: string) => document.querySelector(sel) as T | null;
    const $$ = (sel: string) => Array.from(document.querySelectorAll(sel)) as HTMLElement[];

    // ── Motion helpers ────────────────────────────────────────────────
    // Each run stamps the element; an older run that is still animating sees a
    // newer stamp and stops. Without this, switching items fast lets the
    // previous item's count-up keep writing over the new item's number.
    let countToken = 0;
    function countUp(el: Element | null, to: number, suffix = "%") {
      if (!el) return;
      const token = String(++countToken);
      (el as HTMLElement).dataset.count = token;
      const from = parseInt(el.textContent || "0", 10) || 0;
      if (reduced || from === to) { el.textContent = to + suffix; return; }
      const start = performance.now();
      // Matches --nv-dur-value and the expo-out curve the bars and rings use, so
      // the number and the bar under it finish together instead of racing.
      const dur = 1150;
      const step = (now: number) => {
        if ((el as HTMLElement).dataset.count !== token) return;
        const t = Math.min(1, (now - start) / dur);
        const eased = t === 1 ? 1 : 1 - Math.pow(2, -10 * t);
        el.textContent = Math.round(from + (to - from) * eased) + suffix;
        if (t < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    }
    // Writing a plain value must also cancel any in-flight animation.
    function setCount(el: Element | null, text: string) {
      if (!el) return;
      (el as HTMLElement).dataset.count = String(++countToken);
      el.textContent = text;
    }

    function setRing(el: Element | null, pct: number, sweep = false) {
      if (!el) return;
      if (sweep && !reduced) {
        el.setAttribute("stroke-dashoffset", String(RING));
        // Next frame, so the transition has something to move from.
        requestAnimationFrame(() => requestAnimationFrame(() =>
          el.setAttribute("stroke-dashoffset", String(RING * (1 - pct / 100)))));
      } else {
        el.setAttribute("stroke-dashoffset", String(RING * (1 - pct / 100)));
      }
    }

    function flash(el: Element | null, cls = "nv-flash") {
      if (!el || reduced) return;
      el.classList.remove(cls);
      void (el as HTMLElement).offsetWidth; // restart the animation
      el.classList.add(cls);
    }

    let toastTimer: number | undefined;
    function toast(msg: string) {
      const t = $("[data-toast]");
      if (!t) return;
      t.textContent = msg;
      t.hidden = false;
      flash(t, "nv-toast--in");
      clearTimeout(toastTimer);
      toastTimer = window.setTimeout(() => { t.hidden = true; }, 3200);
    }

    // ── Derived numbers ───────────────────────────────────────────────
    const pctOf = (id: string) => {
      const it = ITEMS[id];
      return it.tasks ? Math.round((progress[id] / it.tasks) * 100) : null;
    };
    // The course as a whole: every grammar topic behind the portions, plus the
    // two modules that are not split. Only the strip reads this — everything
    // else speaks in portions.
    function wholeCourse() {
      const grammar = (DATA.picker ?? []) as { id: string; tasks: number | null }[];
      let tasks = 0;
      let done = 0;
      for (const g of grammar) {
        if (!g.tasks) continue;
        tasks += g.tasks;
        done += Math.min(progress[g.id] ?? 0, g.tasks);
      }
      for (const id of ["wortschatz-kurs", "probelauf"]) {
        const it = ITEMS[id];
        if (!it?.tasks) continue;
        tasks += it.tasks;
        done += Math.min(progress[id] ?? 0, it.tasks);
      }
      return { tasks, done, pct: tasks ? Math.round((done / tasks) * 100) : null };
    }

    function sectionTotals(sid: string) {
      const ids = SECTIONS[sid].items.filter((id: string) => ITEMS[id].tasks);
      const tasks = ids.reduce((a: number, id: string) => a + ITEMS[id].tasks, 0);
      const done = ids.reduce((a: number, id: string) => a + progress[id], 0);
      return { tasks, done, pct: tasks ? Math.round((done / tasks) * 100) : null };
    }

    // How much of one portion is done. A portion is a window over the ordered
    // slots of a topic, so its progress is the overlap of that window with what
    // the topic has answered — the workspaces run their exercises in order, so
    // the overlap is the honest reading.
    const portionDone = (p: any) => p.parts.reduce(
      (n: number, part: any) => n + Math.min(Math.max((progress[part.topic] ?? 0) - part.from, 0), part.size),
      0,
    );

    /** The first portion that is not finished — or the last, once they all are. */
    function currentPortion() {
      return PORTIONS.find((p) => portionDone(p) < p.tasks) ?? PORTIONS[PORTIONS.length - 1];
    }

    // Move the grammar module onto whichever portion is now current. Called from
    // repaint, so finishing one hands over the next without a reload.
    function paintPortion() {
      if (!PORTIONS.length) return;
      const cur = currentPortion();
      const nth = PORTIONS.indexOf(cur) + 1;
      const it = ITEMS["grammatik-basis"];
      if (!it) return;
      it.label = cur.label;
      it.href = cur.href;
      it.level = cur.level;
      it.tasks = cur.tasks;
      it.minutes = cur.minutes;
      it.eyebrow = `Modul 1 · Portion ${nth} von ${PORTIONS.length}`;
      it.lead = `Portion ${nth} von ${PORTIONS.length}: ${cur.label}. ${cur.tasks} Aufgaben, ca. ${cur.minutes} Min.`;
      progress["grammatik-basis"] = portionDone(cur);

      $$('[data-modrow="grammatik-basis"] .nv-modname').forEach((e) => (e.textContent = cur.label));
      $$('[data-modrow="grammatik-basis"] .nv-modmeta').forEach((e) => {
        e.textContent = `${cur.level} · ${cur.tasks} Aufgaben · ca. ${cur.minutes} Min. · Portion ${nth} von ${PORTIONS.length}`;
      });
      $$('[data-row="grammatik-basis"] > span:not(.nv-count):not(.nv-icon):not(.nva-dot)')
        .forEach((e) => (e.textContent = cur.label));
    }

    // The group's main button. It names a module, so it has to move when that module is
    // finished — otherwise it keeps pointing at something with a full bar, which is the
    // exact complaint "Stufe starten" had.
    function paintCta() {
      Object.keys(SECTIONS).forEach((sid) => {
        const btn = $(`[data-cta="${sid}"]`) as HTMLElement | null;
        if (!btn) return;
        const ids: string[] = SECTIONS[sid].items;
        const open = ids.find((id) => ITEMS[id]?.practice && ITEMS[id].tasks && (progress[id] ?? 0) < ITEMS[id].tasks);
        const target = open ?? ids.find((id) => ITEMS[id]?.practice) ?? ids[0];
        const anyDone = ids.some((id) => (progress[id] ?? 0) > 0);
        btn.dataset.navItem = target;
        const kicker = $(`[data-cta-kicker="${sid}"]`);
        const label = $(`[data-cta-label="${sid}"]`);
        // Nothing left anywhere in the group: say so instead of inviting them into a
        // module whose bar is already full.
        if (kicker) kicker.textContent = !open ? "Alles geschafft ·" : anyDone ? "Weiter mit" : "Fang an mit";
        if (label) label.textContent = `${ITEMS[target]?.label ?? ""} →`;
      });
    }

    // "Dein Weg" in the left pane. Its four levels have to be counted here rather than in
    // wegPanel.js: sectionTotals() is the one place that knows how a level's topics add
    // up, and a second copy of that arithmetic would disagree the first time a topic moved
    // between levels. The module gets the finished numbers and owns only the presentation.
    const wegRoot = $("[data-weg-panel]");
    function paintWeg() {
      if (!wegRoot) return;
      const levels = ["a1", "a2", "b1", "b2"]
        .filter((id) => SECTIONS[id])
        .map((id) => ({ id, label: SECTIONS[id].badge ?? id.toUpperCase(), ...sectionTotals(id) }));
      const cur = currentPortion();
      paintWegPanel(wegRoot, {
        levels,
        resume: cur
          ? { label: cur.label, meta: `${cur.level} · ${cur.tasks} Aufgaben · ca. ${cur.minutes} Min.` }
          : null,
      });
    }

    // Repaint every number that depends on `progress`.
    function repaint(sweep = false) {
      // The grammar module before the aggregates: it decides its own count.
      paintPortion();
      // Aggregates: a course module is the sum of the topics under it.
      Object.keys(ITEMS).forEach((id) => {
        const from: string[] | null = ITEMS[id].derived;
        if (from) progress[id] = from.reduce((a, x) => a + (progress[x] ?? 0), 0);
      });

      Object.keys(ITEMS).forEach((id) => {
        const it = ITEMS[id];
        if (!it.tasks) return;
        const p = pctOf(id)!;
        $$(`[data-itembar="${id}"]`).forEach((b) => (b.style.width = p + "%"));
        $$(`[data-itempoints="${id}"]`).forEach((e) => (e.textContent = `${progress[id]} / ${it.tasks}`));
        $$(`[data-count="${id}"]`).forEach((e) => (e.textContent = `${progress[id]}/${it.tasks}`));
        $$(`[data-row="${id}"]`).forEach((e) => e.classList.toggle("done", p === 100));
      });

      Object.keys(SECTIONS).forEach((sid) => {
        const st = sectionTotals(sid);
        if (st.pct === null) return;
        $$(`[data-secbar="${sid}"]`).forEach((b) => (b.style.width = st.pct + "%"));
        $$(`[data-secpct="${sid}"]`).forEach((e) => (e.textContent = st.pct + " %"));
        const label = $(`[data-secringlabel="${sid}"]`);
        if (label) label.textContent = `${st.done} von ${st.tasks} Aufgaben`;
        const dot = $(`[data-raildot="${sid}"]`);
        if (dot) dot.dataset.state = st.pct === 100 ? "done" : st.pct > 0 ? "current" : "todo";
        const ladderBtn = $(`[data-ladder="${sid}"]`);
        if (ladderBtn) ladderBtn.dataset.state = st.pct === 100 ? "done" : st.pct > 0 ? "current" : "todo";
        // The visible section ring animates; the hidden ones just get set.
        const view = $(`[data-section-view="${sid}"]`);
        const visible = view && !(view as HTMLElement).hidden;
        setRing($(`[data-secring="${sid}"]`), st.pct, sweep && !!visible);
        if (visible) countUp($(`[data-secringvalue="${sid}"]`), st.pct);
        else setCount($(`[data-secringvalue="${sid}"]`), st.pct + "%");
      });

      paintCta();
      paintWeg();

      // The strip carries both numbers, because neither alone is honest. The bar
      // and the percentage are the whole course — all 27 grammar topics, the
      // cards and the Probelauf — so finishing a portion visibly moves it. The
      // count beside it is the portion, because that is the pile actually in
      // front of the learner. Showing the course as a count instead put "0 / 724"
      // at the top of the page, which is a number nobody starts.
      const course = wholeCourse();
      const fill = $("[data-strip-fill]");
      if (fill && course.pct !== null) fill.style.width = course.pct + "%";
      const stripLabel = $("[data-strip-label]");
      const cur = PORTIONS.length ? currentPortion() : null;
      if (stripLabel && course.pct !== null) {
        stripLabel.textContent = cur
          ? `${course.pct} % · Portion ${PORTIONS.indexOf(cur) + 1} von ${PORTIONS.length} · ${portionDone(cur)} / ${cur.tasks} Aufgaben`
          : `${course.pct} % · ${course.done} / ${course.tasks} Aufgaben`;
      }
    }

    // ── The level chips, on a phone ───────────────────────────────────
    // The rail sits last in the shell on a phone, because navigation should not
    // stand between the learner and the exercise (see .nv-aside order in
    // nav.css). That was right about the list and wrong about the chips: the
    // whole rail ended up at y=1929 on a 390px screen, two and a half screens
    // down, so "which level am I on" and "switch level" were effectively gone.
    //
    // The two halves split. The chip row — 58px — rides at the top of the shell
    // and sticks there; the 328px list it used to sit on keeps its place below
    // the exercise. CSS cannot lift one child of the aside to the top of the
    // shell, so the row is moved in the DOM, and moved back when the viewport
    // grows again.
    const phone = window.matchMedia("(max-width: 900px)");
    const shellEl = $(".nv-shell");
    const railRow = $(".nvb-rail");
    const railHome = railRow?.parentElement ?? null;

    function placeRail() {
      if (!shellEl || !railRow || !railHome) return;
      if (phone.matches) {
        if (railRow.parentElement !== shellEl) {
          shellEl.prepend(railRow);
          railRow.classList.add("nvb-rail--top");
        }
      } else if (railRow.parentElement !== railHome) {
        railHome.prepend(railRow);
        railRow.classList.remove("nvb-rail--top");
      }
    }
    placeRail();
    phone.addEventListener("change", placeRail);

    // ── Variant switch ────────────────────────────────────────────────
    function showVariant(id: string) {
      $$("[data-variant-pane]").forEach((p) => { p.hidden = p.dataset.variantPane !== id; });
      $$(".nv-toggle-btn").forEach((b) => {
        const on = b.dataset.variant === id;
        b.classList.toggle("active", on);
        b.setAttribute("aria-selected", String(on));
      });
      try { localStorage.setItem("nv-variant", id); } catch (e) {}
    }
    $$(".nv-toggle-btn").forEach((b) => b.addEventListener("click", () => showVariant(b.dataset.variant!)));

    // ── The content views ─────────────────────────────────────────────
    const current = { section: "weg", item: null as string | null };
    const LEVEL_SOURCE_TEXT: Record<string, string> = {
      data: "Stufe aus den Daten",
      abgeleitet: "Stufe aus dem Inhalt abgeleitet — noch kein level-Feld",
      "—": "",
    };

    let railShown: string | null = null;

    // One shake, once per browser, for the Stufenübersicht button — see the .nvb-ov-jiggle
    // block in nav.css. Read once here rather than per open, so a throwing localStorage
    // costs one try/catch instead of one per level switch.
    const OV_JIGGLE_KEY = "da_ov_jiggled_v1";
    let ovJiggled = (() => { try { return localStorage.getItem(OV_JIGGLE_KEY) === "1"; } catch (e) { return true; } })();
    let itemShown: string | null = null;

    // Akkusativ → W-Fragen only rewrote the card's text in place, so the swap fell
    // between two frames and read as a repaint. Slide the card in from the side the
    // new topic sits on: down the list enters from the right, up from the left, and
    // the direction itself says which way you moved. Only the card moves — the view
    // holds a fixed-position dock, and transforming its container would drag that
    // along for the ride.
    function playItemSwap(id: string, section: string) {
      const view = $("[data-item-view]");
      if (!view) return;
      const rows = $$(`[data-rail-section="${section}"] .nvb-item`).map((b) => b.dataset.navItem);
      const from = itemShown ? rows.indexOf(itemShown) : -1;
      const to = rows.indexOf(id);
      const back = from > -1 && to > -1 && to < from;
      itemShown = id;
      view.classList.remove("nv-view--fwd", "nv-view--back");
      void view.offsetWidth;
      view.classList.add(back ? "nv-view--back" : "nv-view--fwd");
    }

    function selectSection(id: string, keepItem = false) {
      current.section = id;
      if (!keepItem) current.item = null;

      $$("[data-section-view]").forEach((v) => { v.hidden = v.dataset.sectionView !== id || !!current.item; });
      const itemView = $("[data-item-view]");
      if (itemView) itemView.hidden = !current.item;

      // Swapping levels used to be a single frame: one list gone, another there.
      // Replay the stagger so the new list visibly arrives. Picking a topic inside
      // the same level must not replay it — that list did not change.
      const railChanged = railShown !== id;
      railShown = id;
      $$("[data-rail-section]").forEach((s) => {
        const on = s.dataset.railSection === id;
        s.hidden = !on;
        s.classList.remove("nvb-section--enter");
        if (on && railChanged) { void s.offsetWidth; s.classList.add("nvb-section--enter"); }
        // The Stufenübersicht button is the one control in here that changes the other
        // column, and it is easy to read past on the way to the topic list. The first time
        // a panel is ever opened it shakes once to be noticed; after that the flag is set
        // and it never does it again. Storage can throw (private mode, blocked cookies),
        // and a decoration must not take the rail down with it.
        if (on && railChanged && !ovJiggled) {
          // By id, not by walking up from the rail section: .nvb-ovwrap is a SIBLING of
          // [data-rail-section], one per section, so a parentElement lookup finds
          // whichever button comes first in the panel rather than this section's.
          const btn = document.querySelector(`.nvb-overview[data-section-btn="${id}"]`);
          if (btn) {
            ovJiggled = true;
            try { localStorage.setItem(OV_JIGGLE_KEY, "1"); } catch (e) {}
            btn.classList.remove("nvb-ov-jiggle");
            void (btn as HTMLElement).offsetWidth;
            btn.classList.add("nvb-ov-jiggle");
            btn.addEventListener("animationend", () => btn.classList.remove("nvb-ov-jiggle"), { once: true });
          }
        }
      });
      $$("[data-section-btn]").forEach((b) => b.classList.toggle("active", b.dataset.sectionBtn === id));
      $("[data-nvb]")?.classList.remove("collapsed");

      // In the accordion, choosing a group also opens it.
      const head = $(`.nvc-head[data-section-btn="${id}"]`);
      if (head) {
        $$("[data-nvc-group]").forEach((g) => {
          const on = g.contains(head);
          g.classList.toggle("open", on);
          g.querySelector(".nvc-head")?.setAttribute("aria-expanded", String(on));
        });
      }

      if (!current.item) {
        itemShown = null;
        $$("[data-nav-item]").forEach((el) => { el.classList.remove("active"); el.setAttribute("aria-current", "false"); });
        repaint(true);
      }
      try { localStorage.setItem("nv-view", JSON.stringify(current)); } catch (e) {}
    }

    function selectItem(id: string) {
      const it = ITEMS[id];
      if (!it) return;
      current.item = id;
      selectSection(it.section, true);

      const wasActive = $(".nvb-item.active")?.dataset.navItem;
      $$("[data-nav-item]").forEach((el) => {
        const on = el.dataset.navItem === id;
        el.classList.toggle("active", on);
        el.classList.remove("nvb-item--pick");
        el.setAttribute("aria-current", on ? "page" : "false");
        if (on && el.classList.contains("nvb-item") && wasActive !== id) {
          void el.offsetWidth;
          el.classList.add("nvb-item--pick");
        }
      });

      const set = (sel: string, text: string) => { const el = $(sel); if (el) el.textContent = text; };
      set("[data-detail-eyebrow]", it.eyebrow);
      set("[data-detail-title]", it.label);
      set("[data-detail-level]", it.level);
      set("[data-detail-levelsrc]", LEVEL_SOURCE_TEXT[it.levelSource] || "");
      set("[data-detail-lead]", it.lead);
      paintStart(id);
      paintItemRing(id, true);
      // The list rows, the level bar and the course strip only repainted when a LEVEL was
      // picked, so landing straight on a topic — now possible by link, ?thema=artikel — left
      // the sidebar reading "0 / 42" next to a ring that said "4 von 42". Same numbers, same
      // store, two answers on one screen.
      repaint();


      $$("[data-section-view]").forEach((v) => (v.hidden = true));
      const itemView = $("[data-item-view]");
      if (itemView) itemView.hidden = false;
      playItemSwap(id, it.section);

      try { localStorage.setItem("nv-view", JSON.stringify(current)); } catch (e) {}
    }

    // The item card's one action. Where it goes never changes; what it says follows the
    // learner — "starten" on an untouched topic, "Weiter üben" once anything is answered,
    // and "Öffnen" for an entry with nothing to count (an overview, an exam page).
    function paintStart(id: string) {
      const it = ITEMS[id];
      const start = $<HTMLAnchorElement>("[data-detail-start]");
      if (!start) return;
      start.href = it.href;
      start.textContent = !it.tasks ? "Öffnen →" : (progress[id] ?? 0) > 0 ? "Weiter üben →" : "Übungen starten →";
    }

    function paintItemRing(id: string, sweep = false) {
      const it = ITEMS[id];
      const pct = pctOf(id);
      setRing($("[data-detail-ring]"), pct ?? 0, sweep);
      const value = $("[data-detail-ringvalue]");
      if (value) {
        if (pct === null) setCount(value, "–");
        else if (sweep) { setCount(value, "0%"); countUp(value, pct); }
        else countUp(value, pct);
      }
      const label = $("[data-detail-ringlabel]");
      if (label) label.textContent = it.tasks
        ? `${progress[id]} von ${it.tasks} Aufgaben` + (it.minutes ? ` · ca. ${it.minutes} Min.` : "")
        : "";
      // An item with no countable tasks (an overview, the Ergebnis page) hides the ring
      // instead of showing an empty one. This card is shared by every item, so it is
      // toggled rather than skipped at render time.
      const card = $("[data-itemringcard]");
      if (card) (card as HTMLElement).hidden = !it.tasks;
    }

    // ── The URL ───────────────────────────────────────────────────────
    // What is open in this shell is real state — a level, and often one topic inside it —
    // and until now it lived only in localStorage. Every view was /dashboard: you could not
    // link a classmate to "Artikel: der, die, das", could not bookmark the topic you are
    // working through, and the browser's back button walked out of the page instead of back
    // to the level you came from.
    //
    // Query parameters rather than a route per topic: this shell is one client-rendered page
    // over ~40 items, and /dashboard/a1/artikel would mean pre-rendering every combination of
    // something that never reloads. `?stufe=a1&thema=artikel` is as linkable and costs nothing.
    //
    // Restoring from a URL must not push a new entry, or arriving at a link would leave a
    // duplicate in history and the first Back would appear to do nothing — hence `applying`.
    let applying = false;

    function urlFor(section: string, item: string | null) {
      /* Seeded from the current query, not empty: on /fortschritt this component shares
         the address bar with the view tabs (?ansicht=) and the exam dashboard's
         selection (?pruefung=). Rebuilding from scratch dropped both the first time
         anyone clicked a level, which silently threw you back to the practice tab. */
      const p = new URLSearchParams(location.search);
      p.delete("stufe");
      p.delete("thema");
      if (section && section !== "weg") p.set("stufe", section);
      if (item) p.set("thema", item);
      const q = p.toString();
      return location.pathname + (q ? `?${q}` : "") + location.hash;
    }

    function syncUrl(replace = false) {
      if (applying) return;
      const next = urlFor(current.section, current.item);
      if (next === location.pathname + location.search + location.hash) return;
      try { history[replace ? "replaceState" : "pushState"]({ nv: true }, "", next); } catch (e) {}
    }

    /** Apply whatever the address bar currently says, without writing to it. */
    function applyUrl(fallbackToSaved = false) {
      const p = new URLSearchParams(location.search);
      const wanted = p.get("thema");
      const stufe = p.get("stufe");
      applying = true;
      try {
        if (wanted && ITEMS[wanted]) selectItem(wanted);
        else if (stufe && SECTION_IDS.has(stufe)) selectSection(stufe);
        else if (fallbackToSaved) return false;
        else selectSection("weg");
      } finally {
        applying = false;
      }
      return true;
    }

    addEventListener("popstate", () => applyUrl());

    // ── Wiring ────────────────────────────────────────────────────────
    $$("[data-section-btn]").forEach((b) => b.addEventListener("click", () => { selectSection(b.dataset.sectionBtn!); syncUrl(); }));
    $$("[data-nav-item]").forEach((b) => b.addEventListener("click", () => { selectItem(b.dataset.navItem!); syncUrl(); }));

    // "Weitermachen" in Dein Weg opens the portion the course is actually on — the same
    // target the grammatik-basis row used to be, which is why that row could go.
    mountWegPanel(wegRoot, {
      onResume: () => { selectItem("grammatik-basis"); syncUrl(); },
    });
    $$("[data-reset-progress]").forEach((b) =>
      b.addEventListener("click", () => {
        if (!confirm("Deinen gesamten Fortschritt löschen? Das lässt sich nicht rückgängig machen.")) return;
        try { resetProgress(); } catch (e) {}
        Object.keys(progress).forEach((k) => (progress[k] = 0));
        repaint(true);
        toast("Fortschritt zurückgesetzt");
      }));
    // Still live for the card's own "Zurück zur Stufe" button.
    $$("[data-back]").forEach((b) => b.addEventListener("click", () => { selectSection(current.section); syncUrl(); }));
    $$("[data-nvb-collapse]").forEach((b) =>
      b.addEventListener("click", (e) => { e.stopPropagation(); $("[data-nvb]")?.classList.toggle("collapsed"); }));

    // ── Restore ───────────────────────────────────────────────────────
    const AVAILABLE: string[] = JSON.parse(document.getElementById("nv-variants")!.textContent!);
    let savedVariant = AVAILABLE[0];
    try {
      const stored = localStorage.getItem("nv-variant");
      if (stored && AVAILABLE.includes(stored)) savedVariant = stored;
    } catch (e) {}
    showVariant(savedVariant);

    // A link someone was sent beats what this browser happened to be looking at last.
    let saved: any = null;
    try { saved = JSON.parse(localStorage.getItem("nv-view") || "null"); } catch (e) {}

    if (!applyUrl(true)) {
      applying = true;
      try {
        if (saved && saved.item && ITEMS[saved.item]) selectItem(saved.item);
        else selectSection(saved && saved.section ? saved.section : "weg");
      } finally {
        applying = false;
      }
      // replace, not push: the restored view is where this page load started, so Back
      // belongs to whatever the learner was on before /dashboard.
      syncUrl(true);
    }

    /* The Stufen tab explains itself to nobody. The list is open on arrival, so what a
       learner cannot guess is that it folds — and that the 40px sliver left at the edge is
       what brings it back. Same story the Wortschatz Lernset column tells, so it is the
       same module: `restHidden: false` because this column rests OPEN, which puts the two
       beats the other way round — beat 1 names what is already in front of you, beat 2 is
       the fold and the light landing on the tab.

       Once per browser. ?intro replays it without spending that one time. */
    {
      const nvb = $("[data-nvb]");
      const foldtab = $(".nvb-foldtab") as HTMLElement | null;
      const panel = $(".nvb-panel") as HTMLElement | null;
      const SEEN = "da-stufen-foldtab-seen";
      if (nvb && foldtab && panel) {
        const intro = createRuleIntro({
          ruleEl: panel,
          ruleBtn: foldtab,
          ruleCard: panel,
          setRule: (next: boolean) => nvb.classList.toggle("collapsed", next),
          // It rests open, and the tour has to give back the state it borrowed.
          restHidden: false,
          // The tab both folds the list and brings it back, so it is also the pivot —
          // beat 2 lights the thing the learner will actually reach for.
          pivot: foldtab,
          coach: [
            ["intro.stufen.title", "intro.stufen.text"],
            ["intro.stufenAway.title", "intro.stufenAway.text"],
          ],
        });
        const forced = new URLSearchParams(location.search).has("intro");
        let seen = false;
        try { seen = localStorage.getItem(SEEN) === "1"; } catch {}
        const calm = matchMedia("(prefers-reduced-motion: reduce)").matches;
        // Desktop only: below the breakpoint the rail is not the navigation and there is
        // no tab to explain.
        const playIntro = () => {
          if (!forced) { try { localStorage.setItem(SEEN, "1"); } catch {} }
          intro.play();
        };
        if (!calm && matchMedia("(min-width: 1001px)").matches && (forced || !seen)) {
          /* Only once it is actually on screen. On /fortschritt this shell sits in a tab
             panel that starts `hidden` when the URL asks for the Prüfungen view — which
             is what every "back to the overview" link from a sitting now does. Playing
             there would run the tour where nobody can see it AND spend the once-per-
             browser flag, so the learner who later opens the Übungen tab would never be
             shown it at all. */
          if (nvb.offsetParent !== null) playIntro();
          else {
            const io = new IntersectionObserver((entries) => {
              if (!entries.some((e) => e.isIntersecting)) return;
              io.disconnect();
              playIntro();
            });
            io.observe(nvb);
          }
        }
        // The dev button already clears the other tours' flags; this one joins them.
        document.getElementById("vp-dev-reset")?.addEventListener("click", () => {
          try { localStorage.removeItem(SEEN); } catch {}
        });
      }
    }

    // The demo dock (DemoDock.astro, rendered by Layout) seeds whatever the page publishes
    // here — the items already on screen, so it fills bars that exist rather than inventing
    // slugs, and a renamed topic stays empty instead of becoming a phantom row.
    (window as any).__daDemoItems = ITEMS;
  </script>
