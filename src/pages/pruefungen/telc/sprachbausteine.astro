---
// Sprachbausteine trainer. Uses the same workspace shell and engine as the grammar
// topics (src/lib/grammarWorkspace.js) — the two telc-specific exercise types
// (wordbank, mcgap) live there alongside the grammar ones.
import Layout from "../../../layouts/Layout.astro";
import SiteNav from "../../../components/SiteNav.astro";
import "../../../styles/practice.css";
import "../../../styles/verben-praepositionen.css";
// Sets are JSON files in src/data/pruefungen/sprachbausteine/ — adding one turns on the
// picker automatically. The concept card comes from the first set; every set shares it.
const modules = import.meta.glob("../../../data/pruefungen/sprachbausteine/*.json", { eager: true });
const saetze = Object.values(modules)
  .map((m) => m.default ?? m)
  .sort((a, b) => a.setId.localeCompare(b.setId));
const data = saetze[0];
const concept = data.concept;
const reference = concept.reference;

// The explanation around the exercises is translated; the German gap texts, the word
// bank and the reference lists of German constructions are not. Keys are derived from
// the German string ("telcSb.t.<hash>") so the data files stay as authored.
function tk(s) {
  if (!s) return undefined;
  let h = 0x811c9dc5;
  for (let i = 0; i < s.length; i++) { h ^= s.charCodeAt(i); h = Math.imul(h, 0x01000193) >>> 0; }
  return "telcSb.t." + h.toString(16);
}
---
<Layout
  title="Sprachbausteine üben – DeutschAcademy"
  description="Sprachbausteine im telc-Format üben: Zuordnung aus dem Wortkasten (Teil 1) und Multiple Choice im Text (Teil 2), mit sofortiger Auswertung."
>
  <SiteNav active="pruefungen" />

  <main class="vp-page" id="vp-page">
    <a href="/pruefungen/telc" class="vp-back-link" data-i18n="telcSb.back">← Zurück zu telc</a>

    <div class="vp-hero">
      <div class="vp-hero-badges">
        <span class="badge badge-brand" data-i18n="telcSb.badge">telc üben</span>
        <span class="badge badge-info">{data.level}</span>
      </div>
      <h1>{data.name}</h1>
      <p data-i18n={tk(data.subtitle)}>{data.subtitle}</p>
    </div>

    <div class="vp-card">
      <div class="vp-card-label" data-i18n="telcSb.how">Wie funktioniert das?</div>

      <div class="vp-flow">
        {concept.flow.map((step, i) => (
          <>
            {i > 0 && <span class="vp-flow-arrow">→</span>}
            <div class={`vp-flow-step ${step.variant ? `vp-flow-step--${step.variant}` : ""}`} data-i18n={tk(step.text)}>{step.text}</div>
          </>
        ))}
      </div>

      <p class="vp-example" set:html={concept.exampleHtml} />

      <div class="vp-qa-grid">
        {concept.qa.map((item) => (
          <div class="vp-qa-item">
            <span data-i18n-html={tk(item.html)} set:html={item.html} />
            {item.tag && <span class="vp-qa-tag" data-i18n={tk(item.tag)}>{item.tag}</span>}
          </div>
        ))}
      </div>

      <p class="vp-note" data-i18n-html={tk(concept.noteHtml)} set:html={concept.noteHtml} />

      <button
        type="button"
        class="vp-toggle-ref"
        id="vp-toggle-ref"
        data-show={reference.showLabel}
        data-hide={reference.hideLabel}
        data-i18n-attr={`data-show:${tk(reference.showLabel)};data-hide:${tk(reference.hideLabel)}`}
      >{reference.showLabel}</button>

      <div id="vp-ref-panel" hidden>
        <div class="vp-ref-grid">
          {reference.boxes.map((box) => (
            <div class={`vp-ref-box vp-ref-box--${box.variant}`}>
              <span class={`badge ${box.variant === "dat" ? "badge-info" : "badge-brand"}`} data-i18n={tk(box.badge)}>{box.badge}</span>
              <ul>{box.items.map((item) => <li>{item}</li>)}</ul>
            </div>
          ))}
        </div>
      </div>
    </div>

    <h2 class="vp-section-title" data-i18n="telcSb.exercises">Übungen</h2>

    {saetze.length > 1 && (
      <div class="sb-setpicker" data-sb-setpicker>
        {saetze.map((st, i) => (
          <button type="button" class={`vp-chip ${i === 0 ? "vp-chip-chosen" : ""}`} data-set={st.setId} data-i18n={/^Satz d+$/.test(st.setLabel) ? "telcSb.setLabel" : undefined} data-i18n-vars={JSON.stringify({ n: (st.setLabel.match(/d+/) || [""])[0] })}>{st.setLabel}</button>
        ))}
      </div>
    )}

    {data.exercises.map((ex, i) => (
      <div class="vp-card" data-ex-card={i}>
        <div class="vp-ex-head">
          <span class="badge badge-neutral">{i + 1}</span>
          <h3>{ex.title}</h3>
        </div>
        {ex.hint && <p class="vp-ex-hint" data-i18n={tk(ex.hint)}>{ex.hint}</p>}
        <div data-ex-index={i}></div>
      </div>
    ))}

    <p class="format-note" data-i18n="telcSb.sourceNote">{data.sourceNote}</p>
  </main>

  <script type="application/json" id="sb-data" set:html={JSON.stringify(saetze)}></script>
  <script type="module">
    import { mountGrammarWorkspace } from "../../../lib/grammarWorkspace.js";
    import { recordAttempt } from "../../../lib/progress.js";
    import { readyExamI18n, tx } from "../../../lib/exam/i18n.js";
    import { onLangChange } from "../../../lib/i18n.js";

    // Same key scheme as the frontmatter's tk().
    function tk(s) {
      let h = 0x811c9dc5;
      for (let i = 0; i < s.length; i++) { h ^= s.charCodeAt(i); h = Math.imul(h, 0x01000193) >>> 0; }
      return "telcSb.t." + h.toString(16);
    }
    await readyExamI18n();

    const saetze = JSON.parse(document.getElementById("sb-data").textContent);
    const page = document.getElementById("vp-page");

    function mount(satz) {
      // Titles and hints are server-rendered from set 1; swap them when the set changes.
      satz.exercises.forEach((ex, i) => {
        const card = page.querySelector(`[data-ex-card="${i}"]`);
        if (!card) return;
        card.querySelector("h3").textContent = ex.title;
        const hint = card.querySelector(".vp-ex-hint");
        if (hint && ex.hint) {
          // Switching sets swaps the hint, so the element's key has to follow it.
          hint.setAttribute("data-i18n", tk(ex.hint));
          hint.textContent = tx(tk(ex.hint), ex.hint);
        }
      });
      mountGrammarWorkspace(page, satz, {
        onAnswer: (ok) => recordAttempt({ skill: "grammatik", correct: ok }),
      });
    }
    mount(saetze[0]);

    const picker = document.querySelector("[data-sb-setpicker]");
    picker?.querySelectorAll("[data-set]").forEach((btn) =>
      btn.addEventListener("click", () => {
        picker.querySelectorAll("[data-set]").forEach((b) => b.classList.toggle("vp-chip-chosen", b === btn));
        mount(saetze.find((s) => s.setId === btn.dataset.set));
        document.querySelector("[data-ex-card='0']").scrollIntoView({ block: "start", behavior: "smooth" });
      })
    );

    const toggleRefBtn = document.getElementById("vp-toggle-ref");
    const refPanel = document.getElementById("vp-ref-panel");
    const paintRefBtn = () => {
      toggleRefBtn.textContent = refPanel.hidden ? toggleRefBtn.dataset.show : toggleRefBtn.dataset.hide;
    };
    toggleRefBtn.addEventListener("click", () => {
      refPanel.hidden = !refPanel.hidden;
      paintRefBtn();
    });
    // i18n rewrites data-show/data-hide; the visible label is painted from them.
    onLangChange(paintRefBtn);
    paintRefBtn();
  </script>
</Layout>
