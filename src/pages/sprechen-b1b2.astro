---
// Mündliche Prüfung B1/B2 — the three-stage telc shape (Bildbeschreibung → Kurzvortrag →
// Diskussion), each stage with its own timer. The existing /sprechen covers the
// DTZ shape instead (description + personal follow-ups, 90 s each), so the two don't overlap.
import Layout from "../layouts/Layout.astro";
import SiteNav from "../components/SiteNav.astro";
import "../styles/practice.css";
import data from "../data/sprechen-b1b2.json";
---
<Layout
  title="Sprechen B1/B2: Kurzvortrag – DeutschAcademy"
  description="Mündliche Prüfung B1/B2 im telc-Format üben: Bildbeschreibung, Kurzvortrag und Diskussion — jede Stufe mit eigenem Timer."
>
  <SiteNav active="fertigkeiten" />
  <main class="practice-main practice-main--wide">
    <div class="practice-hero">
      <p class="eyebrow" data-i18n="sprechenB1B2.eyebrow">Mündliche Prüfung B1/B2</p>
      <h1 data-i18n="sprechenB1B2.title">Kurzvortrag und Diskussion üben</h1>
      <p data-i18n="sprechenB1B2.lead">Drei Stufen pro Thema — genau wie in der mündlichen Prüfung: erst das Bild beschreiben, dann einen kurzen Vortrag halten, dann diskutieren. Jede Stufe hat ihren eigenen Timer.</p>
    </div>

    <div class="prompt-card" id="prompt-root"></div>

    <p class="format-note" data-i18n="sprechenB1B2.note">{data.note}</p>
  </main>

  <script type="application/json" id="sb-data" set:html={JSON.stringify(data)}></script>
  <script type="module">
    import { recordSession } from "../lib/progress.js";
    import { getLang, loadDict, onLangChange, translate } from "../lib/i18n.js";

    // Painted with innerHTML after the page's i18n pass, so it translates its own words.
    // The German here is only the first frame before the dictionary lands.
    let dict = null;
    const t = (key, fallback, vars) => (dict && dict[key] != null ? translate(dict, key, vars) : fallback);

    const { stages, prompts } = JSON.parse(document.getElementById("sb-data").textContent);
    const root = document.getElementById("prompt-root");
    let idx = 0;
    let stage = 0;
    let timerId = null;
    let seconds = 0;

    function stopTimer() {
      if (timerId) clearInterval(timerId);
      timerId = null;
    }
    function fmt(s) {
      return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, "0")}`;
    }

    function stageBody(p, s) {
      if (s.key === "beschreibung") {
        return `<ul>${p.beschreibung.map((q) => `<li>${q}</li>`).join("")}</ul>`;
      }
      if (s.key === "kurzvortrag") {
        return `<p class="prompt-topic"><strong>${t("sprechenB1B2.topic", "Thema:")}</strong> ${p.kurzvortrag.topic}</p>
                <ul>${p.kurzvortrag.points.map((q) => `<li>${q}</li>`).join("")}</ul>`;
      }
      return `<p class="prompt-topic">${p.diskussion}</p>`;
    }

    function render() {
      stopTimer();
      const p = prompts[idx];
      const s = stages[stage];
      seconds = s.seconds;

      root.innerHTML = `
        <h3>${p.title}</h3>
        <img class="prompt-image" src="${p.image}" alt="${p.title}" />

        <div class="prompt-stages">
          ${stages.map((st, i) => `<button type="button" class="quiz-btn ${i === stage ? "quiz-btn--primary" : ""}" data-stage="${i}">${t(`sprechenB1B2.stage.${st.key}`, st.label)}</button>`).join("")}
        </div>

        <div class="prompt-timer" id="timer">${fmt(seconds)}</div>
        <button class="quiz-btn quiz-btn--primary prompt-reveal-btn" id="start-timer" type="button">${t("sprechenB1B2.startTimer", `Timer starten (${fmt(s.seconds)})`, { time: fmt(s.seconds) })}</button>

        <div class="prompt-section-label">${t(`sprechenB1B2.stage.${s.key}`, s.label)}</div>
        <p class="prompt-hint">${t(`sprechenB1B2.hint.${s.key}`, s.hint)}</p>
        ${stageBody(p, s)}

        <div class="prompt-nav">
          <button class="quiz-btn" id="prev-prompt" type="button">${t("sprechen.prevImage", "← Vorheriges Bild")}</button>
          <button class="quiz-btn" id="next-prompt" type="button">${t("sprechen.nextImage", "Nächstes Bild →")}</button>
        </div>`;

      // Same orientation trick as /sprechen: portrait photos are capped by height.
      const img = root.querySelector(".prompt-image");
      const applyOrientation = () => {
        if (!img.naturalWidth) return;
        img.classList.toggle("prompt-image--portrait", img.naturalHeight > img.naturalWidth);
      };
      if (img.complete) applyOrientation();
      else img.addEventListener("load", applyOrientation, { once: true });

      root.querySelectorAll("[data-stage]").forEach((b) =>
        b.addEventListener("click", () => {
          stage = +b.dataset.stage;
          render();
        })
      );
      document.getElementById("start-timer").addEventListener("click", (e) => {
        stopTimer();
        seconds = s.seconds;
        const timerEl = document.getElementById("timer");
        e.target.disabled = true;
        timerId = setInterval(() => {
          seconds--;
          timerEl.textContent = fmt(Math.max(0, seconds));
          if (seconds <= 0) {
            stopTimer();
            timerEl.textContent = t("sprechenB1B2.timeUp", "Zeit um");
            e.target.disabled = false;
            recordSession("sprechen");
          }
        }, 1000);
      });
      document.getElementById("prev-prompt").addEventListener("click", () => {
        idx = (idx - 1 + prompts.length) % prompts.length;
        stage = 0;
        render();
      });
      document.getElementById("next-prompt").addEventListener("click", () => {
        idx = (idx + 1) % prompts.length;
        stage = 0;
        render();
      });
    }

    render();
    // A language switch repaints the card — which also stops a running timer, the same as
    // switching stage does.
    const useDict = (d) => { dict = d; render(); };
    loadDict(getLang()).then(useDict).catch(() => {});
    onLangChange((_c, d) => useDict(d));
  </script>
</Layout>
