---
// One Schreibaufgabe.
//
// Three editors behind one page, picked by `kind`:
//   form    a source text and fields to transfer — the answers reveal together, at the end
//   prompt  a situation, Leitpunkte, Redemittel, a textarea, and a Modelltext behind a fold
//   errors  a text with mistakes to find, and no Lösungsschlüssel on purpose
//
// What they share is the order: write first, compare after. The Modelltext and the
// examiner's checklist both sit inside a closed <details>, because a model answer read
// beforehand turns every writing task into a reading task — and the thing being practised
// is producing German, not recognising it.
//
// Nothing is graded. It cannot be, and pretending otherwise would be worse than admitting
// it: a score on a Beschwerdebrief would have to come from counting words.
import Layout from "../../../layouts/Layout.astro";
import SiteNav from "../../../components/SiteNav.astro";
import Icon from "../../../components/Icon.astro";
import VocabList from "../../../components/VocabList.astro";
import uebersetzungen from "../../../data/uebersetzungen/schreiben.json";
import { schreiben, neighbours, SCHREIBEN_ICON } from "../../../lib/fertigkeiten.js";
import "../../../styles/practice.css";
import "../../../styles/skills.css";

export function getStaticPaths() {
  return schreiben.tasks.map((task) => ({
    params: { id: task.id },
    props: { task, ...neighbours(schreiben.tasks, task) },
  }));
}

const { task, prev, next } = Astro.props;
const { types } = schreiben;
const help = (uebersetzungen.entries as Record<string, any>)[task.id] ?? null;
const parts = (task.source ?? "").split(/\*\*(.+?)\*\*/g);
---
<Layout
  title={`${task.title} – Schreiben ${task.level} – DeutschAcademy`}
  description={task.blurb}
>
  <SiteNav active="fertigkeiten" />
  <main class="practice-main">
    <a href="/uebungen/schreiben" class="vp-back-link" data-i18n="schreiben.back">← Alle Schreibaufgaben</a>

    <article>
      <header class="sk-head">
        <span class="sk-card-ic"><Icon name={SCHREIBEN_ICON[task.type] ?? "pencil"} size={22} /></span>
        <div>
          <p class="eyebrow" data-i18n={`type.schreiben.${task.type}`}>{types[task.type]}</p>
          <h1>{task.title}</h1>
        </div>
        <span class="sk-badge">{task.level}</span>
      </header>

      <p class="sk-blurb"><span data-i18n={`schreiben.${task.id}.blurb`}>{task.blurb}</span> · <span data-i18n="skills.minutes" data-i18n-vars={JSON.stringify({ m: task.minutes })}>ca. {task.minutes} Minuten</span></p>

      {task.situation && (
        <section class="sk-block">
          <h2 data-i18n="skills.h2.task">Aufgabe</h2>
          <p>{task.situation}</p>
        </section>
      )}

      {task.source && (
        <section class="sk-block">
          {task.kind === "errors"
            ? <h2 data-i18n="schreiben.h2.errorText">Modelltext mit Fehlern</h2>
            : <h2 data-i18n="schreiben.h2.source">Vorlage</h2>}
          <div class="sk-text">{parts.map((p, i) => (i % 2 ? <b>{p}</b> : p))}</div>
        </section>
      )}

      {/* After the material, before the writing: the words to understand the task and the
          ones the answer will need. */}
      {help?.vocab && <VocabList vocab={help.vocab} reviewed={help.reviewed} />}

      {task.kind === "form" && (
        <section class="sk-block">
          <h2 data-i18n="schreiben.h2.form">Formular</h2>
          <p class="sk-blurb" data-i18n="schreiben.form.hint">Übertrage die Angaben aus der Vorlage. Die Lösungen erscheinen erst, wenn du unten auf „Lösung zeigen“ klickst.</p>
          <div class="sk-fields" id="sk-form">
            {task.fields.map((f, i) => (
              <>
                <div class="sk-field">
                  <label for={`sk-f${i}`}>{f.label}</label>
                  <input id={`sk-f${i}`} type="text" autocomplete="off" />
                </div>
                <p class="sk-field-answer" data-answer hidden>{f.answer}</p>
              </>
            ))}
          </div>
          <p style="margin-top:16px"><button class="sk-btn" type="button" id="sk-solve"><span data-i18n="schreiben.solve">Lösung zeigen</span><span data-i18n="schreiben.solved" hidden>Lösung steht dabei</span></button></p>
        </section>
      )}

      {task.kind === "prompt" && (
        <>
          <section class="sk-block">
            <h2 data-i18n="schreiben.h2.points">Das muss vorkommen</h2>
            <ul class="sk-points">{task.points.map((p) => <li>{p}</li>)}</ul>
            {task.phrases?.length > 0 && (
              <div class="sk-phrases">{task.phrases.map((p) => <span class="sk-phrase">{p}</span>)}</div>
            )}
          </section>

          <section class="sk-block">
            <h2 data-i18n="schreiben.h2.yourText">Dein Text</h2>
            <textarea
              class="sk-write"
              id="sk-write"
              placeholder="Schreib hier…"
              aria-label="Dein Text"
              data-i18n-attr="placeholder:schreiben.placeholder;aria-label:schreiben.h2.yourText"
            ></textarea>
            <div class="sk-write-bar">
              <span id="sk-count" data-i18n="skills.words.many" data-i18n-vars='{"n":0}'>0 Wörter</span>
              <span data-i18n="schreiben.privacy">Der Text bleibt in diesem Browser — er wird nirgendwohin geschickt.</span>
            </div>
          </section>
        </>
      )}

      {task.kind === "errors" && (
        <section class="sk-block">
          <h2 data-i18n="schreiben.h2.correction">Deine Korrektur</h2>
          <p class="sk-blurb" data-i18n="schreiben.correction.hint">Schreib den Text richtig ab — oder notiere nur die Stellen, die dir auffallen.</p>
          <textarea class="sk-write" id="sk-write" aria-label="Deine Korrektur" data-i18n-attr="aria-label:schreiben.h2.correction"></textarea>
          <div class="sk-write-bar">
            <span id="sk-count" data-i18n="skills.words.many" data-i18n-vars='{"n":0}'>0 Wörter</span>
            <span data-i18n="schreiben.privacyShort">Der Text bleibt in diesem Browser.</span>
          </div>
        </section>
      )}

      {task.model && (
        <details class="sk-reveal">
          <summary data-i18n="schreiben.model">Modelltext — erst öffnen, wenn du geschrieben hast</summary>
          <div class="sk-reveal-body"><div class="sk-model">{task.model}</div></div>
        </details>
      )}

      {task.check?.length > 0 && (
        <details class="sk-reveal">
          <summary data-i18n="schreiben.check">Worauf eine Prüferin schaut</summary>
          <div class="sk-reveal-body">
            <ul class="sk-check">{task.check.map((c, i) => <li data-i18n={`schreiben.check.${task.id}.${i}`}>{c}</li>)}</ul>
          </div>
        </details>
      )}

      {task.kind === "errors" && (
        <p class="sk-foot" data-i18n="schreiben.errors.foot">Zu dieser Aufgabe gibt es bewusst keinen Lösungsschlüssel: Die Fehler zu finden ist die Übung, und welche davon schwer wiegen, entscheidet sich im Gespräch. Nimm den Text mit in den Kurs oder zu einem Lernpartner.</p>
      )}

      <nav class="sk-prevnext">
        {prev ? <a href={`/uebungen/schreiben/${prev.id}`}>← {prev.title}</a> : <span />}
        {next ? <a href={`/uebungen/schreiben/${next.id}`}>{next.title} →</a> : <span />}
      </nav>
    </article>
  </main>

  <script>
    import { recordSession } from "../../../lib/progress.js";
    import { getLang, loadDict, onLangChange } from "../../../lib/i18n.js";

    let uiDict = null;
    loadDict(getLang()).then((d) => { uiDict = d; }).catch(() => {});
    onLangChange((_c, d) => { uiDict = d; });

    // Word count. Nothing is graded here, but a learner writing to "60–80 Wörter" needs to
    // know where they are without counting by hand — and in the DTZ the length is part of
    // the task, not a detail.
    const write = document.getElementById("sk-write");
    const count = document.getElementById("sk-count");
    if (write && count) {
      let counted = false;
      write.addEventListener("input", () => {
        const n = write.value.trim().split(/\s+/).filter(Boolean).length;
        // The key and its count live on the element, so the i18n pass repaints the right
        // words after a language switch too.
        count.dataset.i18n = n === 1 ? "skills.words.one" : "skills.words.many";
        count.dataset.i18nVars = JSON.stringify({ n });
        const d = uiDict?.[count.dataset.i18n];
        count.textContent = d != null ? d.replace("{n}", String(n)) : `${n} ${n === 1 ? "Wort" : "Wörter"}`;
        // One session per page, once the learner has actually started.
        if (!counted && n > 4) { counted = true; recordSession("schreiben"); }
      });
    }

    // The form task reveals every answer at once. Row by row would turn a transfer exercise
    // into a guessing game: you would check field one, learn the pattern, and fill the rest
    // from the answer rather than from the text.
    const solve = document.getElementById("sk-solve");
    if (solve) {
      solve.addEventListener("click", () => {
        for (const el of document.querySelectorAll("[data-answer]")) el.hidden = false;
        solve.disabled = true;
        const [before, after] = solve.children;
        before.hidden = true;
        after.hidden = false;
        recordSession("schreiben");
      });
    }
  </script>
</Layout>
