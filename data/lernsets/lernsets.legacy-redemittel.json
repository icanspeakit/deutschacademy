      "front": "das Nagetier / die Nagetiere",
      "note": "kleine Haustiere, brauchen wenig Platz und wenig Futter",
      "translations": {
        "en": "rodent(s)",
        "ar": "القارض / القوارض",
        "ru": "грызун / грызуны",
        "tr": "kemirgen / kemirgenler"
      }
    },
    {
      "id": "redemittel-11",
      "front": "der Käfig",
      "note": "muss regelmäßig saubergemacht werden",
      "translations": {
        "en": "cage",
        "ar": "القفص",
        "ru": "клетка",
        "tr": "kafes"
      }
    },
    {
      "id": "redemittel-12",
      "front": "der Tierarzt / die Tierärztin",
      "note": "für Haustiere, die krank werden können",
      "translations": {
        "en": "vet",
        "ar": "الطبيب البيطري / الطبيبة البيطرية",
        "ru": "ветеринар",
        "tr": "veteriner"
      }
    },
    {
      "id": "redemittel-13",
      "front": "eine Reise planen",
      "note": "Übernachtung, Aktivitäten, Kosten gemeinsam besprechen",
      "translations": {
        "en": "to plan a trip",
        "ar": "التخطيط لرحلة",
        "ru": "планировать поездку",
        "tr": "bir seyahat planlamak"
      }
    },
    {
      "id": "redemittel-14",
      "front": "Wo wollen wir übernachten?",
      "note": "Reiseplanung, Vorschläge machen",
      "translations": {
        "en": "Where do we want to stay overnight?",
        "ar": "أين نريد أن نبيت؟",
        "ru": "Где мы хотим переночевать?",
        "tr": "Nerede kalmak istiyoruz?"
      }
    },
    {
      "id": "redemittel-15",
      "front": "Wie viel Geld wollen wir ausgeben?",
      "note": "Budget-Frage beim Planen",
      "translations": {
        "en": "How much money do we want to spend?",
        "ar": "كم من المال نريد أن ننفق؟",
        "ru": "Сколько денег мы хотим потратить?",
        "tr": "Ne kadar para harcamak istiyoruz?"
      }
    }
