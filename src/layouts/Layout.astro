---
import "../styles/global.css";
import "../styles/components.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Deutsch Academy – Da für Dich!",
  description = "Deutsch lernen mit echtem Unterrichtsmaterial: kostenlose Übungen und Prüfungsvorbereitung für telc, Goethe-Zertifikat, TestDaF, DTZ und Leben in Deutschland.",
} = Astro.props;

// Open Graph / Twitter. There were none, so every link anyone pasted into WhatsApp,
// Telegram or a Facebook group — which is how this audience actually shares things —
// rendered as a grey box with a URL in it.
//
// The image is absolute where it can be. Scrapers fetch og:image out of band, with no
// page to resolve a relative path against; Facebook and Twitter reject one outright,
// while WhatsApp and Slack happen to cope. `site` is not set in astro.config.mjs yet, so
// this falls back to the relative path rather than inventing a hostname — half the
// scrapers is better than all of them pointed at the wrong domain. Set `site` and every
// tag below becomes absolute with no further change.
const OG_IMAGE = "/assets/og-default.png";
const abs = (path) => (Astro.site ? new URL(path, Astro.site).href : path);
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <!-- Runs before first paint so a dark-mode reload never flashes white.
         Keep in sync with STORAGE_KEY/THEME_COLOR in src/lib/theme.js. -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("da-theme");
          // The Wortschatz trainer used to own a night mode of its own; honour it
          // once so anyone who had it on does not get flipped back to light.
          if (stored !== "light" && stored !== "dark" && localStorage.getItem("da-fc-theme") === "dark") {
            stored = "dark";
            localStorage.setItem("da-theme", "dark");
          }
          var theme = stored === "light" || stored === "dark"
            ? stored
            : (window.matchMedia && matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
          document.documentElement.dataset.theme = theme;
        } catch (e) {
          document.documentElement.dataset.theme = "light";
        }
      })();
    </script>
    <!-- Favicons. The `?v=` is load-bearing, not decoration: Chrome caches favicons by
         URL in a store that survives a hard reload, so replacing the file at the same
         path leaves returning visitors on the old icon indefinitely. That is exactly what
         happened here — the Astro starter placeholder (a PNG saved as favicon.ico) stayed
         pinned in tabs long after the real logo shipped. Bump the version whenever an
         icon changes.
         `rel="shortcut icon"` was dropped: it is a non-standard legacy alias for
         `rel="icon"` and adds a second, competing declaration for the same file. -->
    <link rel="icon" href="/favicon.ico?v=2" sizes="32x32" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=2" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=2" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=2" />
    <link rel="manifest" href="/site.webmanifest?v=2" />
    <!-- Brand teal (--brand-blue in global.css). Was #4d9be1, a blue left over from an
         earlier palette, so the browser chrome did not match the site. -->
    <meta name="theme-color" content="#0d9488" />
    <script is:inline>
      (function () {
        var m = document.querySelector('meta[name="theme-color"]');
        if (m && document.documentElement.dataset.theme === "dark") m.setAttribute("content", "#0f141b");
      })();
    </script>
    <!-- All four families are self-hosted from /public/fonts; nothing is
         fetched from fonts.googleapis.com. Preload the three that paint
         above the fold (Bungee Shade is accent-only, so it can wait). -->
    <link rel="preload" href="/fonts/sora-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/big-shoulders-display-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/albert-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Deutsch Academy" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={abs(OG_IMAGE)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="da für Dich — Deutsch Academy" />
    {Astro.site && <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={abs(OG_IMAGE)} />

    <slot name="head" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <script>
      import { initI18n } from "../lib/i18n.js";
      initI18n();
    </script>
  </body>
</html>
