---
// The hub for the Sprechen library, at /uebungen/sprechen/.
//
// Bildbeschreibungen come in Sätze of four, the way the Wortschatz Lernsets do: a set is
// one sitting on one subject. Sixteen pictures listed flat would be a scroll; four under a
// heading you picked is something you finish. The tasks that are not pictures are listed
// separately, because they are one-offs rather than a series.
//
// The two older trainers keep their own URLs (/uebungen/sprechen/dtz-bildbeschreibung and
// /uebungen/sprechen-b1b2) and their pictures appear here as the entries they are, so the
// skill has one index across all four levels.
import Layout from "../../../layouts/Layout.astro";
import SiteNav from "../../../components/SiteNav.astro";
import Icon from "../../../components/Icon.astro";
import { sprechen, sprechenSets, sprechenLoose, SPRECHEN_ICON } from "../../../lib/fertigkeiten.js";
import { levels as siteLevels } from "../../../lib/catalog.js";
import { photoSources, thumbFor } from "../../../lib/sprechenBilder.js";
import "../../../styles/practice.css";
import "../../../styles/skills.css";

const { tasks, types } = sprechen;
const blurbOf = Object.fromEntries(siteLevels.map((lv) => [lv.level, lv]));
const sets = sprechenSets().filter((s) => s.items.length);
const loose = sprechenLoose();
const pictures = tasks.filter((t) => t.type === "bild").length;
const pending = tasks.filter((t) => t.imageNeeded && !t.image).length;
// Rendered from provenance.json, so the line names the libraries the photos on this page
// really came from — and says nothing at all while there are none. See sprechenBilder.js.
const credits = photoSources();
---
<Layout
  title="Sprechen – DeutschAcademy"
  description="Sprechen von A1 bis B2: Bildbeschreibungen in Serien zu vier, dazu sich vorstellen, gemeinsam planen, Kurzvortrag und Diskussion — mit Timer, Redemitteln und Modellantwort."
>
  <SiteNav active="fertigkeiten" />
  <main class="practice-main practice-main--wide">
    <div class="practice-hero">
      <p class="eyebrow" data-i18n="skill.sprechen">Sprechen</p>
      <h1 data-i18n="skill.sprechen.h1">Sprechen üben</h1>
      <p data-i18n="sprechen.hub.lead" data-i18n-vars={JSON.stringify({ n: pictures })}>{pictures} Bildbeschreibungen in Serien zu vier, dazu sich vorstellen, gemeinsam planen, Kurzvortrag und Diskussion. Jede Aufgabe mit Timer, Redemitteln und einer Modellantwort zum Vergleichen.</p>
    </div>

    <section class="sk-group">
      <h2 class="sk-group-title"><span data-i18n="sprechen.hub.series" data-i18n-vars={JSON.stringify({ n: sets.length })}>Bildbeschreibung · {sets.length} Serien zu vier</span></h2>
      <div class="sk-grid">
        {sets.map((set) => (
          <a class="sk-card" href={`/uebungen/sprechen/set/${set.id}`}>
            {/* The series' first picture stands for the series. Four cards that differ only
                in their heading, each behind the same map pin, made the Bildserien look like
                categories rather than pictures. */}
            {set.items[0]?.image
              ? <img class="sk-card-thumb" src={thumbFor(set.items[0].image)} alt="" loading="lazy" decoding="async" width="38" height="38" />
              : <span class="sk-card-ic"><Icon name="map-pin" size={20} /></span>}
            <span class="sk-card-txt">
              <b data-i18n={`sprechenSet.${set.id}.title`}>{set.title}</b>
              <i data-i18n={`sprechenSet.${set.id}.blurb`}>{set.blurb}</i>
              <span class="sk-card-meta">
                {set.level}
                {" · "}
                <span data-i18n="meta.bilder" data-i18n-vars={JSON.stringify({ n: set.items.length })}>{set.items.length} Bilder</span>
              </span>
            </span>
            <span class="sk-card-go" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </section>

    <h2 class="sk-group-title" style="margin-top:44px">
      <span data-i18n="sprechen.moreTasks">Weitere Sprechaufgaben</span>
    </h2>
    {loose.map((g) => (
      <section class="sk-group" id={`niveau-${g.level.toLowerCase()}`}>
        <h2 class="sk-group-title">
          <span class="sk-badge">{g.level}</span>
          <span data-i18n={blurbOf[g.level]?.blurbKey}>{blurbOf[g.level]?.blurb}</span>
        </h2>
        <div class="sk-grid">
          {g.items.map((t) => (
            <a class="sk-card" href={`/uebungen/sprechen/${t.id}`}>
              {/* Picture tasks show the picture; Kurzvortrag, Diskussion and the rest keep
                  their type icon, because for those the icon is the honest summary. */}
              {t.image
                ? <img class="sk-card-thumb" src={thumbFor(t.image)} alt="" loading="lazy" decoding="async" width="38" height="38" />
                : <span class="sk-card-ic"><Icon name={SPRECHEN_ICON[t.type] ?? "mic"} size={20} /></span>}
              <span class="sk-card-txt">
                <b>{t.title}</b>
                <i data-i18n={`sprechen.${t.id}.blurb`}>{t.blurb}</i>
                <span class="sk-card-meta">
                  <span data-i18n={`type.sprechen.${t.type}`}>{types[t.type]}</span>
                  {" · "}
                  <span data-i18n="meta.redezeit" data-i18n-vars={JSON.stringify({ s: t.seconds })}>{t.seconds} Sek. Redezeit</span>
                </span>
              </span>
              <span class="sk-card-go" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      </section>
    ))}

    <p class="sk-foot">
      {/* The always-there part carries the key on a span of its own: data-i18n replaces
          textContent, which would take the conditional sentence after it with it. */}
      <span data-i18n="sprechen.foot" data-i18n-vars={JSON.stringify({ n: tasks.length })}>
        {tasks.length} Aufgaben. Sprechen ist die Fertigkeit, die man allein am schwersten übt —
        deshalb steht bei jeder Aufgabe, was eine Prüferin hören will, und eine Modellantwort daneben.
      </span>
      {pending > 0 && <span data-i18n="sprechen.foot.pending" data-i18n-vars={JSON.stringify({ n: pending })}>{` Zu ${pending} Aufgaben fehlt noch das Foto; solange steht die beschriebene Szene an seiner Stelle und die Aufgabe funktioniert trotzdem.`}</span>}
    </p>

    {credits.length > 0 && (
      <p class="sk-foot sk-credit">
        <span data-i18n="sprechen.foot.photos">Fotos von</span>{" "}
        {credits.map((c, i) => (
          <>
            {i > 0 && ", "}
            <a href={c.href} rel="noopener">{c.label}</a>
          </>
        ))}.
      </p>
    )}
  </main>
</Layout>
