      }
    ],
    "exampleHtml": "Er hat <span class=\"vp-verb\">nicht nur</span> einen guten Job, <span class=\"vp-prep\">sondern auch</span> eine tolle Wohnung.",
    "qa": [
      {
        "html": "<strong>sowohl … als auch</strong> — beides gilt, gleichwertig. <em>Ich trinke Kaffee sowohl mit Milch als auch mit Zucker.</em>",
        "tag": "+ +"
      },
      {
        "html": "<strong>nicht nur … sondern auch</strong> — beides gilt, aber der zweite Teil wird betont. <em>Er trinkt Kaffee nicht nur mit Zucker, sondern auch mit Sahne.</em>",
        "tag": "+ + betont"
      },
      {
        "html": "<strong>weder … noch</strong> — beides gilt nicht. Achtung: <em>weder…noch</em> ist schon negativ, ein zusätzliches <em>nicht</em> wäre falsch.",
        "tag": "− −"
      },
      {
        "html": "<strong>entweder … oder</strong> — nur eins von beiden, ein starkes „oder“. <em>Ich trinke Tee entweder mit Zitrone oder mit Milch.</em>",
        "tag": "a oder b"
      }
    ],
    "noteHtml": "Drei weitere gehören dazu: <strong>zwar … aber</strong> räumt erst ein und schränkt dann ein (<em>Jan möchte zwar gern reisen, aber er hat Angst vorm Fliegen</em>), <strong>einerseits … andererseits</strong> stellt zwei Seiten nebeneinander, und <strong>je … desto</strong> verbindet zwei Steigerungen — dabei steht nach <em>je</em> ein Nebensatz mit Verb am Ende und nach <em>desto</em> das Verb direkt hinter dem Komparativ: <em>Je länger Lara lernt, desto mehr Spaß macht ihr die Schule.</em>",
    "reference": {
      "showLabel": "Übersicht anzeigen ▼",
      "hideLabel": "Übersicht ausblenden ▲",
      "tables": [
        {
          "caption": "Die sieben Paare",
          "head": [
            "Konnektor",
            "Bedeutung",
            "Beispiel"
          ],
          "rows": [
            [
              "sowohl … als auch",
              "+ + beides",
              "Hier kann man sowohl schwimmen als auch klettern."
            ],
            [
              "nicht nur … sondern auch",
              "+ + das 2. betont",
              "Er hat nicht nur einen guten Job, sondern auch eine tolle Wohnung."
            ],
            [
              "weder … noch",
              "− − beides nicht",
              "Julia gefällt weder das grüne noch das rote Kleid."
            ],
            [
              "entweder … oder",
              "a oder b",
              "Wir können entweder ins Kino oder ins Museum gehen."
            ],
            [
              "zwar … aber",
              "Einschränkung",
              "Jan möchte zwar gern nach Australien reisen, aber er hat Angst vorm Fliegen."
            ],
            [
              "einerseits … andererseits",
              "zwei Seiten",
              "Einerseits möchte ich studieren, andererseits finde ich auch einen Handwerksberuf interessant."
            ],
            [
              "je … desto",
              "zwei Steigerungen",
              "Je länger Lara lernt, desto mehr Spaß macht ihr die Schule."
            ]
          ]
        },
        {
          "caption": "je … desto — die Wortstellung",
