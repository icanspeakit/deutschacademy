---
import Layout from "../layouts/Layout.astro";
import SiteNav from "../components/SiteNav.astro";
// Still used in the footer; the nav imports its own copies.
import LanguageSwitcher from "../components/LanguageSwitcher.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import DashboardMock from "../components/mocks/DashboardMock.astro";
import UebungenMock from "../components/mocks/UebungenMock.astro";
import LevelFold from "../components/LevelFold.astro";
import PracticePicker from "../components/PracticePicker.astro";
import Icon from "../components/Icon.astro";
// One catalogue for / and /uebungen — see src/lib/catalog.js.
import { tools, exams } from "../lib/catalog.js";
import "../styles/landing.css";
import "../styles/m1.css";
import "../styles/front.css";
// Last, so its fold-switching rules win over front.css at equal specificity.
import "../styles/home-fold.css";


const toolCount = tools.length;
const examCount = exams.length;
const userCount = 412; // actual signups so far
---
<Layout>
  <div class="lp">
    <SiteNav />

    <!-- HERO FOLD, ≤1024px: "Wo stehst du?" — five tap targets instead of a
         paragraph. Below that width the two mockups cannot be shown at a size
         where their controls are clickable, so they are replaced rather than
         shrunk; they reappear further down, at real width, in the peek band. -->
    <!-- Returning learners only: "Wo stehst du?" below is a question they have already
         answered, so the thing they were last doing goes above it. Filled client-side from
         this browser's own record; a first visit renders nothing here at all. -->
    <div class="lp-resume-band" data-pp-resume-top hidden></div>
    <LevelFold />

    <!-- HERO FOLD, >1024px: the "A · Versetzt" arrangement promoted from the
         /front layout studies. Overlapping 12x12 grid: headline left, dashboard
         mock over the right edge of it, exercises mock below-left, brand line
         bottom-right. Markup is identical across the three studied variants —
         only the grid-area rules in front.css differ — so switching to "buehne"
         or "split" is a one-word change to data-variant below. -->
    <section class="fr-page fr-page--home" data-variant="versetzt">
      <div class="fr-stage">
        <div class="fr-grid">
          <div class="fr-block fr-copy">
            <p class="fr-eyebrow" data-i18n="home.hero2.eyebrow">Deutsch von A1 bis C1</p>
            <h1 class="fr-title" data-i18n="front.title">Deutsch lernen</h1>
            <p class="fr-accent">Schritt für Schritt.</p>
            <p class="fr-lead" data-i18n="home.hero2.lead">
              Grammatik, Alltagsdeutsch und Sprechpraxis — aufgebaut aus echtem
              Unterrichtsmaterial, nicht kalt für eine Plattform geschrieben.
            </p>
            <div class="fr-actions">
              <a href="/uebungen" class="lp-btn lp-btn--primary" data-i18n="home.cta.startFree">Kostenlos starten</a>
              <a href="/pruefungen" class="lp-btn lp-btn--outline" data-i18n="home.hero2.cta2">So funktioniert's</a>
            </div>
          </div>

          <div class="fr-block fr-mock fr-mock--dash" aria-label="Dashboard-Vorschau">
            <DashboardMock />
          </div>

          <div class="fr-block fr-mock fr-mock--ueb" aria-label="Übungen-Vorschau">
            <UebungenMock />
          </div>

          <div class="fr-block fr-slogan">
            <p class="fr-slogan-line" data-i18n="home.footer.tagline">Da für Dich!</p>
            <p class="fr-slogan-sub" data-i18n="front.slogan.sub">
              Kostenlos, ohne Konto — von Lehrkräften, die wirklich unterrichten.
            </p>
          </div>
        </div>
      </div>
    </section>

    <script>
      // The fold's mocks are fixed-size artwork laid out at their design width and
      // taken out of flow (see front.css), so each has to be scaled to its grid
      // cell. Ported from /front, minus the variant switcher.
      const DEFAULT_W = 760;
      // Past this the dashboard stops reading as a UI and starts reading as a
      // poster of one.
      const MAX_SCALE = 1.15;
      // Breathing room so the frame's shadow is not flush against its neighbour.
      const GUTTER = 20;
      const mocks = [...document.querySelectorAll(".fr-page--home .fr-mock")];

      function designWidth(cell) {
        const raw = getComputedStyle(cell).getPropertyValue("--fr-mock-w");
        return parseFloat(raw) || DEFAULT_W;
      }

      function fitMocks() {
        // Below the breakpoint front.css puts the mocks back in normal flow.
        if (window.matchMedia("(max-width: 900px)").matches) {
          for (const cell of mocks) {
            const b = cell.querySelector(".lp-browser");
            if (b) b.style.transform = "";
          }
          return;
        }
        for (const cell of mocks) {
          const browser = cell.querySelector(".lp-browser");
          if (!browser) continue;
          browser.style.transform = "";
          const cw = cell.clientWidth - GUTTER * 2;
          const ch = cell.clientHeight - GUTTER * 2;
          const mh = browser.offsetHeight;
          const dw = designWidth(cell);
          if (cw <= 0 || ch <= 0 || !mh) continue;
          const scale = Math.min(cw / dw, ch / mh, MAX_SCALE);
          const x = GUTTER + (cw - dw * scale) / 2;
          const y = GUTTER + (ch - mh * scale) / 2;
          browser.style.transform = `translate(${x}px, ${y}px) scale(${scale})`;
        }
      }

      requestAnimationFrame(() => requestAnimationFrame(fitMocks));
      addEventListener("resize", fitMocks);
      // Fonts land after first paint and change the mock's intrinsic height; so do
      // late images and, in dev, stylesheets injected after hydration.
      if (window.ResizeObserver) {
        const ro = new ResizeObserver(() => fitMocks());
        for (const cell of mocks) {
          const browser = cell.querySelector(".lp-browser");
          if (browser) ro.observe(browser);
        }
      }
      document.fonts?.ready.then(fitMocks);
    </script>

    <!-- TRUST BAR -->
    <section class="lp-trust">
      <div class="lp-wrap lp-trust-grid">
        <div class="lp-trust-item"><div class="lp-trust-num">{toolCount}</div><div class="lp-trust-label" data-i18n="home.trust.tools">Übungstools, alle kostenlos</div></div>
        <div class="lp-trust-item"><div class="lp-trust-num">{examCount}</div><div class="lp-trust-label" data-i18n="home.trust.exams">Prüfungen im Überblick</div></div>
        <div class="lp-trust-item"><div class="lp-trust-num">{userCount}+</div><div class="lp-trust-label" data-i18n="home.trust.learners">Lernende bisher</div></div>
        <div class="lp-trust-item"><div class="lp-trust-num">0€</div><div class="lp-trust-label" data-i18n="home.trust.freeCourse">für den A1–C1-Grundkurs</div></div>
      </div>
    </section>

    <!-- VALUE PROPS -->
    <section class="lp-section">
      <div class="lp-wrap">
        <div class="lp-section-head">
          <div class="lp-eyebrow" data-i18n="home.value.eyebrow">Why DeutschAcademy</div>
          <h2 data-i18n="home.value.title">Built from real classes, not templates</h2>
          <p data-i18n="home.value.subtitle">Every lesson below has already been taught, live, to real learners — not written cold for a course platform.</p>
        </div>
        <div class="lp-value-grid">
          <div class="lp-value-card">
            <img src="/assets/bricks-2181920_1280.jpg" alt="" />
            <div class="lp-value-card-body"><h3 data-i18n="home.value.card1.title">60+ grammar topics, properly explained</h3><p data-i18n="home.value.card1.desc">Every case, tense and construction — Dativ, Genitiv, Passiv, Konjunktiv II, Relativsätze — broken down with worked exercises, not just quick tips.</p></div>
          </div>
          <div class="lp-value-card">
            <img src="/assets/online-is-futur.jpg" alt="" />
            <div class="lp-value-card-body"><h3 data-i18n="home.value.card2.title">Everyday German, not textbook dialogues</h3><p data-i18n="home.value.card2.desc">Scenario-based practice pulled from real life: Behördengänge, moving apartments, describing your day, ordering at a café.</p></div>
          </div>
          <div class="lp-value-card">
            <img src="/assets/letsdoit.jpg" alt="" />
            <div class="lp-value-card-body"><h3 data-i18n="home.value.card3.title">Speaking practice built in</h3><p data-i18n="home.value.card3.desc">Role-play, partner exercises and picture descriptions (Bildbeschreibung) — the part learners usually only get in a live class.</p></div>
          </div>
          <div class="lp-value-card">
            <img src="/assets/foto-buero-1.jpg" alt="" />
            <div class="lp-value-card-body"><h3 data-i18n="home.value.card4.title">Exam-format prep, not guesswork</h3><p data-i18n="home.value.card4.desc">Mock sittings and writing tasks structured the way Goethe and telc actually test you, corrected by a real instructor.</p></div>
          </div>
        </div>
      </div>
    </section>

    <!-- HOW IT WORKS -->
    <section class="lp-section lp-section--alt">
      <div class="lp-wrap">
        <div class="lp-section-head" style="max-width:560px">
          <div class="lp-eyebrow" data-i18n="home.how.eyebrow">So funktioniert's</div>
          <h2 data-i18n="home.how.title">Dein Weg zu fließendem Deutsch — in drei klaren Schritten</h2>
        </div>
        <div class="lp-track">
          <div class="lp-road-step"><div class="lp-road-node">1</div><div class="lp-road-label" data-i18n="home.how.step1.label">Schritt 1</div><h3 data-i18n="home.how.step1.title">Grammatik</h3><p data-i18n="home.how.step1.desc">60+ Grammatikthemen — von Dativ bis Konjunktiv II, mit durchdachten Übungen.</p></div>
          <div class="lp-road-step"><div class="lp-road-node">2</div><div class="lp-road-label" data-i18n="home.how.step2.label">Schritt 2</div><h3 data-i18n="home.how.step2.title">Alltagsdeutsch</h3><p data-i18n="home.how.step2.desc">Echte Alltagsszenarien statt Lehrbuchdialoge: Ämter, Wohnungssuche, der Alltag.</p></div>
          <div class="lp-road-step"><div class="lp-road-node">3</div><div class="lp-road-label" data-i18n="home.how.step3.label">Schritt 3</div><h3 data-i18n="home.how.step3.title">Sprechpraxis</h3><p data-i18n="home.how.step3.desc">Rollenspiele, Partnerübungen und Bildbeschreibungen üben.</p></div>
        </div>
      </div>
    </section>

    <!-- TOOLS -->
    <section class="lp-section">
      <div class="lp-wrap">
        <!-- One catalogue, two shapes, one per width — see the swap rule at the end of
             landing.css. Wide enough for a grid, the grid is the better answer: thirteen
             tools read at a glance and nothing has to be asked. It is only when the grid
             collapses to one card per row that the list becomes the page, and there the
             question earns its tap. Both are in the HTML; CSS shows one. -->
        <div class="lp-section-head lp-desk" style="max-width:600px">
          <div class="lp-eyebrow" data-i18n="home.tools.eyebrow">Alle Werkzeuge</div>
          <h2 data-i18n="home.tools.heading2">Übungen und Prüfungsvorbereitung, an einem Ort</h2>
          <p data-i18n="home.tools.subtitle">Kein Zusammensuchen zwischen Apps und Karteikarten — alles lebt im selben Dashboard.</p>
        </div>
        <div class="lp-section-head lp-phone" style="max-width:600px">
          <div class="lp-eyebrow" data-i18n="home.tools.eyebrow">Alle Werkzeuge</div>
          <h2 data-i18n="picker.title">Was willst du üben?</h2>
          <p data-i18n="home.tools.subtitle">Kein Zusammensuchen zwischen Apps und Karteikarten — alles lebt im selben Dashboard.</p>
        </div>

        <div class="lp-desk">
          <div class="lp-tools-group">
            <div class="lp-tools-label" data-i18n="nav.exercises">Übungen</div>
            <div class="lp-tools-grid lp-tools-grid--tools">
              {tools.map((t) => (
                <a href={t.href} class="lp-tool-card">
                  <div class="lp-tool-tile"><Icon name={t.icon} /></div>
                  <h4 data-i18n={t.titleKey}>{t.title}</h4>
                  <p data-i18n={t.descKey}>{t.desc}</p>
                  <span class="badge badge-brand" data-i18n={t.countKey} data-i18n-vars={JSON.stringify(t.countVars)}>{t.count}</span>
                </a>
              ))}
            </div>
          </div>
          <div class="lp-tools-group lp-tools-group--exams">
            <div class="lp-tools-label" data-i18n="nav.exams">Prüfungen</div>
            <div class="lp-tools-grid lp-tools-grid--exams">
              {exams.map((e) => (
                <a href={e.href} class="lp-tool-card">
                  <div class="lp-tool-tile"><Icon name={e.icon} /></div>
                  <h4>{e.title}</h4>
                  <span class="badge badge-neutral" data-i18n={e.countKey} data-i18n-vars={e.countVars ? JSON.stringify(e.countVars) : undefined}>{e.count}</span>
                </a>
              ))}
            </div>
          </div>
        </div>

        <PracticePicker class="lp-picker lp-phone" />
      </div>
    </section>

    <!-- PEEK, ≤1024px only: the two mockups the fold no longer shows at this
         width. Down here they are useful rather than in the way, and at real
         width they are not pictures of a UI — they are the UI. -->
    <section class="lp-section hf-peek-band">
      <div class="lp-wrap">
        <div class="lp-section-head" style="max-width:600px">
          <div class="lp-eyebrow" data-i18n="home.peek.eyebrow">Ein Blick hinein</div>
          <h2 data-i18n="home.peek.title">So sieht es von innen aus</h2>
          <p data-i18n="home.peek.subtitle">Keine Bilder — beide funktionieren. Tipp in der Seitenleiste auf ein Thema.</p>
        </div>
        <div class="hf-peek">
          <div class="hf-peek-item">
            <p class="hf-peek-label" data-i18n="home.peek.progress">Dein Fortschritt</p>
            <DashboardMock />
          </div>
          <div class="hf-peek-item">
            <p class="hf-peek-label" data-i18n="nav.exercises">Übungen</p>
            <UebungenMock />
          </div>
        </div>
      </div>
    </section>

    <!-- DEEP DIVE -->
    <section class="lp-section lp-section--alt">
      <div class="lp-wrap">
        <div class="lp-section-head" style="max-width:600px">
          <div class="lp-eyebrow" data-i18n="home.deepdive.eyebrow">What's included</div>
          <h2 data-i18n="home.deepdive.title">Everything you get, tier by tier</h2>
        </div>
        <div class="lp-deepdive-grid">
          <div class="lp-deep-card">
            <div class="lp-deep-icon">01</div>
            <div class="lp-deep-head"><h3 data-i18n="home.deepdive.core.title">Core Course</h3><p data-i18n="home.deepdive.core.subtitle">Everything you need to build real fluency, self-paced.</p></div>
            <div class="lp-deep-list">
              <div class="lp-deep-item"><span class="lp-check-icon">✓</span><span data-i18n="home.deepdive.core.item1">Full A1–C1 curriculum, built from live-taught lessons</span></div>
              <div class="lp-deep-item"><span class="lp-check-icon">✓</span><span data-i18n="home.deepdive.core.item2">60+ grammar topics explained in depth</span></div>
              <div class="lp-deep-item"><span class="lp-check-icon">✓</span><span data-i18n="home.deepdive.core.item3">Real-life scenario library, not textbook dialogues</span></div>
              <div class="lp-deep-item"><span class="lp-check-icon">✓</span><span data-i18n="home.deepdive.core.item4">Placement test and a structured lesson path</span></div>
            </div>
            <div class="lp-deep-cta" data-i18n="home.deepdive.core.cta">Start free</div>
          </div>
          <div class="lp-deep-card lp-deep-card--featured">
            <div class="lp-deep-icon lp-deep-icon--featured">02</div>
            <div class="lp-deep-head"><h3 data-i18n="home.deepdive.exam.title">Exam Prep &amp; Coaching</h3><p data-i18n="home.deepdive.exam.subtitle">For learners with a Goethe or telc exam on the calendar.</p></div>
            <div class="lp-deep-list">
              <div class="lp-deep-item"><span class="lp-check-icon lp-check-icon--premium">✓</span><span data-i18n="home.deepdive.exam.item1">Everything in Core Course</span></div>
              <div class="lp-deep-item"><span class="lp-check-icon lp-check-icon--premium">✓</span><span data-i18n="home.deepdive.exam.item2">Exam-format mock sittings, structured the way Goethe/telc test you</span></div>
              <div class="lp-deep-item"><span class="lp-check-icon lp-check-icon--premium">✓</span><span data-i18n="home.deepdive.exam.item3">Writing tasks corrected by a human instructor, not a model</span></div>
              <div class="lp-deep-item"><span class="lp-check-icon lp-check-icon--premium">✓</span><span data-i18n="home.deepdive.exam.item4">Speaking practice: role-play, partner exercises, Bildbeschreibung</span></div>
              <div class="lp-deep-item"><span class="lp-check-icon lp-check-icon--premium">✓</span><span data-i18n="home.deepdive.exam.item5">Exam-structure walkthroughs, so nothing on test day is a surprise</span></div>
            </div>
            <div class="lp-deep-cta lp-deep-cta--featured" data-i18n="home.deepdive.exam.cta">Go Premium</div>
          </div>
          <div class="lp-deep-card lp-deep-card--cyan">
            <div class="lp-deep-icon">03</div>
            <div class="lp-deep-head"><h3 data-i18n="home.deepdive.community.title">Community &amp; Practice</h3><p data-i18n="home.deepdive.community.subtitle">Where you actually use the German you're learning.</p></div>
            <div class="lp-deep-list">
              <div class="lp-deep-item"><span class="lp-check-icon">✓</span><span data-i18n="home.deepdive.community.item1">Monthly live Q&amp;A with an instructor</span></div>
              <div class="lp-deep-item"><span class="lp-check-icon">✓</span><span data-i18n="home.deepdive.community.item2">Partner and small-group speaking practice</span></div>
              <div class="lp-deep-item"><span class="lp-check-icon">✓</span><span data-i18n="home.deepdive.community.item3">A space to ask questions between lessons</span></div>
              <div class="lp-deep-item"><span class="lp-check-icon">✓</span><span data-i18n="home.deepdive.community.item4">New practice material added as the course grows</span></div>
            </div>
            <div class="lp-deep-cta" data-i18n="home.deepdive.community.cta">Join the community</div>
          </div>
        </div>
      </div>
    </section>

    <!-- PRICING -->
    <section class="lp-section">
      <div class="lp-wrap">
        <div class="lp-section-head" style="max-width:560px">
          <div class="lp-eyebrow" data-i18n="home.pricing.eyebrow">Pricing</div>
          <h2 data-i18n="home.pricing.title">One free course. One upgrade, when you're ready to sit the exam.</h2>
          <p data-i18n="home.pricing.subtitle">Everything above is either included free or unlocked with Premium — no hidden tiers.</p>
        </div>
        <div class="lp-pricing-grid">
          <div class="lp-price-card">
            <div class="lp-price-name" data-i18n="home.pricing.free.name">Free</div>
            <div class="lp-price-amount"><strong>€0</strong><span data-i18n="home.pricing.free.period">forever</span></div>
            <div class="lp-price-desc" data-i18n="home.pricing.free.desc">Everything you need to learn on your own, at no cost.</div>
            <div class="lp-price-divider"></div>
            <div class="lp-price-list">
              <div class="lp-price-item"><span class="lp-check-icon">✓</span><span data-i18n="home.pricing.free.item1">Full A1–C1 core course</span></div>
              <div class="lp-price-item"><span class="lp-check-icon">✓</span><span data-i18n="home.pricing.free.item2">Placement test &amp; structured path</span></div>
              <div class="lp-price-item"><span class="lp-check-icon">✓</span><span data-i18n="home.pricing.free.item3">60+ grammar topic breakdowns</span></div>
              <div class="lp-price-item lp-price-item--off"><span class="lp-check-icon">—</span><span data-i18n="home.pricing.free.item4">Exam-format mock sittings</span></div>
              <div class="lp-price-item lp-price-item--off"><span class="lp-check-icon">—</span><span data-i18n="home.pricing.free.item5">Human writing corrections</span></div>
            </div>
            <div class="lp-price-cta" data-i18n="home.pricing.free.cta">Start Free</div>
          </div>
          <!-- TODO(Edgar): confirm price - one-time vs monthly membership; see Language Cluster Strategy, open decisions -->
          <div class="lp-price-card lp-price-card--featured">
            <div class="lp-price-badge" data-i18n="home.pricing.badge">MOST POPULAR</div>
            <div class="lp-price-name" data-i18n="home.pricing.premium.name">Premium Membership</div>
            <div class="lp-price-amount"><strong>€XX</strong><span data-i18n="home.pricing.premium.period">/month (TBD)</span></div>
            <div class="lp-price-desc" data-i18n="home.pricing.premium.desc">Everything in Free, plus what you need to actually pass the exam.</div>
            <div class="lp-price-divider"></div>
            <div class="lp-price-list">
              <div class="lp-price-item"><span class="lp-check-icon lp-check-icon--premium">✓</span><span data-i18n="home.pricing.premium.item1">Everything in the Free plan</span></div>
              <div class="lp-price-item"><span class="lp-check-icon lp-check-icon--premium">✓</span><span data-i18n="home.pricing.premium.item2">Exam-format mock sittings (Goethe &amp; telc)</span></div>
              <div class="lp-price-item"><span class="lp-check-icon lp-check-icon--premium">✓</span><span data-i18n="home.pricing.premium.item3">Human corrections on every writing task</span></div>
              <div class="lp-price-item"><span class="lp-check-icon lp-check-icon--premium">✓</span><span data-i18n="home.pricing.premium.item4">Speaking &amp; role-play practice sessions</span></div>
              <div class="lp-price-item"><span class="lp-check-icon lp-check-icon--premium">✓</span><span data-i18n="home.pricing.premium.item5">Monthly live community Q&amp;A</span></div>
            </div>
            <div class="lp-price-cta lp-price-cta--featured" data-i18n="home.pricing.premium.cta">Start Premium</div>
          </div>
        </div>
        <div class="lp-pricing-note" data-i18n="home.pricing.note">No contracts — cancel anytime.</div>
      </div>
    </section>

    <!-- FINAL CTA -->
    <section class="lp-final-cta">
      <div class="lp-wrap lp-final-cta-inner">
        <h2 data-i18n="home.finalcta.title">Dein nächster Schritt zu fließendem Deutsch</h2>
        <p data-i18n="home.finalcta.subtitle">Kostenlos starten, dein Niveau testen, in deinem Tempo weitermachen.</p>
        <a href="#" class="lp-final-cta-btn" data-i18n="home.finalcta.cta">Kostenlos starten</a>
        <div class="lp-final-cta-login"><span data-i18n="home.finalcta.loginQuestion">Already have an account?</span> <b data-i18n="home.finalcta.loginAction">Log in</b></div>
      </div>
    </section>

    <!-- FOOTER -->
    <footer class="lp-footer">
      <div class="lp-wrap lp-footer-inner">
        <div class="lp-footer-grid">
          <div class="lp-footer-brand">
            <img src="/assets/logo.png" alt="DeutschAcademy" />
            <strong data-i18n="home.footer.tagline">Da für Dich!</strong>
