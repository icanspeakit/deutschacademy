---
// Shared shell behind /jetzt and /v1.
//
//   variant="jetzt"  the current shape: the whole rule on top, inline, then the exercises
//                    one per row in an 880px column, and nothing either side of it.
//
//   variant="v1"     the merge. Keeps Jetzt's single column — one column reads better,
//                    which is why Jetzt wins — but:
//                      · the empty side is filled with the Icon-Rail navigation from
//                        /nav (variant B, the favoured one there), reusing its real
//                        .nvb-* markup and nav.css rather than a second implementation;
//                      · the rule leaves the top and slides in from the side, behind a
//                        trigger that is prominent in the main column instead of a small
//                        control in the bar;
//                      · there is no Grammatik/Lesen toggle — the navigation does that.
//
// Side-by-side survives in exactly one place: the reading exercise, where the answers sit
// next to the text so the eye can criss-cross between them.
//
// Exercises render through the real engine (src/lib/grammarWorkspace.js) from the real
// topic JSON — these are not mock-ups.
import ThemeToggle from "../ThemeToggle.astro";
import Icon from "../Icon.astro";
import lesen from "../../data/lesen.json";

import artikel from "../../data/grammatik/artikel.json";
import perfekt from "../../data/grammatik/perfekt.json";
import wechsel from "../../data/grammatik/wechselpraepositionen.json";
import satzstellung from "../../data/grammatik/satzstellung.json";
import nvv from "../../data/grammatik/nomen-verb-verbindungen.json";

interface Props { variant: "jetzt" | "v1" }
const { variant } = Astro.props;
const isV1 = variant === "v1";

const topics = [
  { id: "perfekt", data: perfekt },
  { id: "artikel", data: artikel },
  { id: "wechselpraepositionen", data: wechsel },
  { id: "nomen-verb-verbindungen", data: nvv },
  { id: "satzstellung", data: satzstellung },
];
const reading = lesen.groups[0];
const payload = Object.fromEntries(topics.map((t) => [t.id, t.data]));

const itemCount = (t: any) =>
  (t.exercises ?? []).reduce(
    (n: number, e: any) =>
      n + (e.rows?.length ?? 0) + (e.items?.length ?? 0) + (e.pairs?.length ?? 0) +
      (e.segments?.filter((s: any) => s.blank != null).length ?? 0),
    0
  );

// Grouped by CEFR level, the same information architecture /nav uses: level first,
// tool type second.
const LEVELS = ["A1", "A2", "B1", "B2"];
const groups = LEVELS
  .map((lvl) => ({ level: lvl, items: topics.filter((t) => t.data.level === lvl) }))
  .filter((g) => g.items.length > 0);
---
<div class="dm" data-variant={variant} data-area="grammatik">
  <header class="dm-bar">
    <div class="dm-bar-row">
      <div class="dm-bar-text">
        <p class="dm-title">{isV1 ? "V1" : "Jetzt"}</p>
        <p class="dm-note">
          {isV1
            ? "Eine Spalte, Navigation links, Regel kommt von der Seite — die Seite startet bei den Übungen."
            : "Eine Spalte, die ganze Regel steht über der ersten Übung, daneben nichts."}
        </p>
      </div>
      <a class="dm-linkbtn" href={isV1 ? "/jetzt" : "/v1"}>{isV1 ? "Jetzt ansehen →" : "V1 ansehen →"}</a>
      <span class="dm-metric">Seitenhöhe: <b data-m-screens>–</b> Bildschirme</span>
      <ThemeToggle />
    </div>
  </header>

  {isV1 ? (
    <div class="nv-shell dm-shell">
      <!-- Icon-Rail from /nav (variant B). Real .nvb-* markup + nav.css, so this is the
           same component, not a lookalike. It also replaces the old area toggle: Lesen
           is simply another entry in the list. -->
      <aside class="nv-aside" aria-label="Seitennavigation">
        <div class="nvb">
          <div class="nvb-rail" role="tablist" aria-label="Stufe">
            {groups.map((g, i) => (
              <button type="button" class={`nvb-railbtn${i === 0 ? " active" : ""}`} data-rail-btn={g.level} role="tab" aria-label={`Stufe ${g.level}`}>
                <span class="nvb-railbadge">{g.level}</span>
                <span class="nvb-tip">Stufe {g.level}</span>
              </button>
            ))}
            <button type="button" class="nvb-railbtn" data-rail-btn="lesen" role="tab" aria-label="Lesen">
              <Icon name="pencil" size={20} />
              <span class="nvb-tip">Lesen</span>
            </button>
          </div>

          <div class="nvb-panel">
            {groups.map((g, i) => (
              <div class="nvb-section" data-rail-section={g.level} hidden={i !== 0}>
                <div class="nvb-panelhead"><h3>Stufe {g.level}</h3></div>
                {g.items.map((t) => (
                  <button type="button" class="nvb-item" data-topic-btn={t.id}>
                    <span class="nv-icon"><Icon name="book" size={16} /></span>
                    <span>{t.data.name}</span>
                    <span class="nv-count">{itemCount(t.data)}</span>
                  </button>
                ))}
              </div>
            ))}
            <div class="nvb-section" data-rail-section="lesen" hidden>
              <div class="nvb-panelhead"><h3>Lesen</h3></div>
              <button type="button" class="nvb-item" data-area-btn="lesen">
                <span class="nv-icon"><Icon name="pencil" size={16} /></span>
                <span>{reading.title}</span>
                <span class="nv-count">{reading.questions.length}</span>
              </button>
            </div>
          </div>
        </div>
      </aside>

      <main class="nv-main dm-main">
        <div data-area-panel="grammatik">
          <div class="dm-col" id="dm-root">
            <div class="dm-head">
              <h1 class="dm-h1" data-t-name>—</h1>
              <span class="badge badge-info" data-t-level>—</span>
            </div>

            <!-- The rule trigger lives in the main column and is deliberately loud: it is
                 the one thing a learner reaches for mid-exercise, and a quiet control in
                 the top bar was being missed. -->
            <button class="dm-rulecta" type="button" data-rule-open aria-controls="dm-rule-panel" aria-expanded="false">
              <span class="dm-rulecta-icon" aria-hidden="true">?</span>
              <span class="dm-rulecta-text">
                <span class="dm-rulecta-title">Regel ansehen</span>
                <span class="dm-rulecta-sub" data-rule-teaser>Wie funktioniert das?</span>
              </span>
              <span class="dm-rulecta-arrow" aria-hidden="true">→</span>
            </button>

            <div class="dm-ex" data-ex-grid></div>
          </div>
        </div>

        <div data-area-panel="lesen" hidden>
          <div class="dm-read">
            <article class="dm-box dm-read-text">
              <h2 class="dm-h2">{reading.title}</h2>
              <p class="dm-meta">{reading.level}</p>
              <div class="dm-readtext">{reading.text}</div>
            </article>
            <aside class="dm-box dm-read-q">
              <p class="dm-kicker">Fragen</p>
              <ol class="dm-qlist">
                {reading.questions.map((q) => (
                  <li class="dm-qrow">
                    <p class="dm-q">{q.prompt}</p>
                    <div class="dm-opts">
                      {q.options.map((o) => (
                        <button class="dm-chip" type="button" data-correct={o === q.answer ? "1" : "0"}>{o}</button>
                      ))}
                    </div>
                  </li>
                ))}
              </ol>
            </aside>
          </div>
        </div>
      </main>
    </div>
  ) : (
    <main class="dm-stage">
      <div data-area-panel="grammatik">
        <div class="dm-col" id="dm-root">
          <div class="dm-head">
            <h1 class="dm-h1" data-t-name>—</h1>
            <span class="badge badge-info" data-t-level>—</span>
          </div>
          <div class="vp-card" data-rule-inline></div>
          <h2 class="dm-sec">Übungen</h2>
          <div class="dm-ex" data-ex-grid></div>
        </div>
      </div>

      <div class="dm-topicrow">
        {topics.map((t, i) => (
          <button type="button" class="dm-topicbtn" data-topic-btn={t.id} aria-selected={i === 0 ? "true" : "false"}>{t.data.name}</button>
        ))}
        <button type="button" class="dm-topicbtn" data-area-btn="lesen">Lesen</button>
      </div>

      <div data-area-panel="lesen" hidden>
        <div class="dm-col">
          <div class="dm-box">
            <h2 class="dm-h2">{reading.title}</h2>
            <p class="dm-meta">{reading.level}</p>
            <div class="dm-readtext">{reading.text}</div>
          </div>
          <div class="dm-box">
            <p class="dm-kicker">Fragen</p>
            {reading.questions.map((q) => (
              <div class="dm-qrow dm-qrow--plain">
                <p class="dm-q dm-q--plain">{q.prompt}</p>
                <div class="dm-opts">
                  {q.options.map((o) => (
                    <button class="dm-chip" type="button" data-correct={o === q.answer ? "1" : "0"}>{o}</button>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </main>
  )}

  {isV1 && (
    <>
      <div class="dm-scrim" data-rule-close hidden></div>
      <aside class="dm-drawer" id="dm-rule-panel" aria-label="Regel" aria-hidden="true">
        <div class="dm-drawer-head">
          <p class="dm-kicker" data-rule-title>Regel</p>
          <button class="dm-drawer-x" type="button" data-rule-close aria-label="Regel schließen">×</button>
        </div>
        <div class="vp-card dm-drawer-card" data-rule-panel></div>
      </aside>
    </>
  )}
</div>

<script type="application/json" data-topics set:html={JSON.stringify(payload)}></script>

<!-- is:global — exercises are injected by grammarWorkspace.js at runtime and Astro's
     scoped styles only reach build-time elements. Namespaced `dm-`; the `nv-*`/`nvb-*`
     classes come from nav.css unchanged. -->
<style is:global>
  .dm { min-height: 100vh; background: var(--page-bg); }

  .dm-bar { position: sticky; top: 0; z-index: 30; background: var(--page-bg); border-bottom: 1px solid var(--border); }
  .dm-bar-row { display: flex; align-items: center; gap: 16px; padding: 11px clamp(14px, 3vw, 26px); flex-wrap: wrap; }
  .dm-bar-text { min-width: 0; margin-right: auto; }
  .dm-title { margin: 0; font-family: var(--font-display); font-size: var(--text-lg); font-weight: var(--fw-bold); color: var(--ink); line-height: 1.1; }
  .dm-note { margin: 1px 0 0; font-size: var(--text-xs); color: var(--muted); }
  .dm-linkbtn { border: 1px solid var(--border-strong); background: var(--surface-card); border-radius: var(--radius-pill); padding: 7px 15px; font-family: var(--font-label); font-size: var(--text-xs); font-weight: var(--fw-semibold); color: var(--brand-blue-dark); text-decoration: none; }
  .dm-linkbtn:hover { border-color: var(--brand-blue); }
  .dm-metric { font-size: var(--text-xs); color: var(--muted); }
  .dm-metric b { color: var(--brand-blue-dark); font-weight: var(--fw-bold); }

  /* ---- shells ---- */
  .dm-stage { padding: 24px clamp(14px, 3vw, 26px) 96px; }
  /* nav.css caps .nv-shell at 1280px, which suits /nav's dense panels but left ~590px
     of a 1800px screen unused here and squeezed the reading columns to 442px each.
     Widened for this page only; the grammar column still self-limits to 880px, so only
     the reading view actually uses the extra room. */
  /* Two classes on purpose: .nv-shell (nav.css) and a bare .dm-shell tie on
     specificity, and nav.css wins on order, so the cap never lifted. */
  .nv-shell.dm-shell { padding-top: 20px; max-width: 1640px; }
  .dm-main { min-width: 0; }
  .dm-col { max-width: 880px; }
  .dm-stage .dm-col { margin: 0 auto; }
  .dm-head { display: flex; align-items: center; gap: 10px; margin-bottom: 16px; flex-wrap: wrap; }
  .dm-h1 { margin: 0; font-family: var(--font-body); font-weight: var(--fw-regular); letter-spacing: -.02em; font-size: 1.75rem; color: var(--ink); }
  .dm-h2 { margin: 0 0 3px; text-align: left; font-weight: var(--fw-semibold); letter-spacing: -.01em; color: var(--ink); }
  .dm-sec { font-family: var(--font-body); font-weight: var(--fw-regular); letter-spacing: -.02em; font-size: 1.375rem; color: var(--ink); margin: 30px 0 16px; text-align: left; }
  .dm-kicker { font-family: var(--font-label); font-size: var(--text-xs); font-weight: var(--fw-bold); letter-spacing: .06em; text-transform: uppercase; color: var(--muted-soft); margin: 0 0 10px; }
  .dm-meta { color: var(--muted); font-size: .82rem; margin: 0 0 12px; }
  .dm-ex { display: grid; grid-template-columns: 1fr; gap: 16px; }
  .dm-ex .vp-card { margin-bottom: 0; }
  .dm-box { background: var(--surface-card); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 18px 20px; margin-bottom: 14px; }

  /* Jetzt keeps a plain topic row — it has no side navigation. */
  .dm-topicrow { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; max-width: 880px; margin: 30px auto 0; }
  .dm-topicbtn { border: 1px solid var(--border); background: var(--surface-card); border-radius: var(--radius-pill); padding: 7px 14px; cursor: pointer; font-family: var(--font-label); font-size: var(--text-xs); font-weight: var(--fw-semibold); color: var(--muted); }
  .dm-topicbtn[aria-selected="true"] { background: var(--gradient-brand); color: #fff; border-color: transparent; }

  /* ---- the loud rule trigger (V1) ---- */
  .dm-rulecta {
    display: flex; align-items: center; gap: 14px; width: 100%;
    margin: 0 0 22px; padding: 14px 18px; cursor: pointer; text-align: left;
    border: 1px solid var(--blue-200);
    border-radius: var(--radius-lg);
    background: var(--gradient-brand-soft, var(--blue-50));
    transition: border-color .18s ease, transform .18s ease;
  }
  .dm-rulecta:hover { border-color: var(--brand-blue); transform: translateY(-1px); }
  .dm-rulecta-icon { flex-shrink: 0; width: 34px; height: 34px; border-radius: 50%; background: var(--gradient-brand); color: #fff; display: inline-flex; align-items: center; justify-content: center; font-family: var(--font-display); font-weight: var(--fw-bold); font-size: 1.05rem; }
  .dm-rulecta-text { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .dm-rulecta-title { font-weight: var(--fw-semibold); color: var(--ink); font-size: .95rem; }
  .dm-rulecta-sub { font-size: .8rem; color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .dm-rulecta-arrow { margin-left: auto; color: var(--brand-blue-dark); font-size: 1.1rem; }
  @media (prefers-reduced-motion: reduce) { .dm-rulecta { transition: none; } }

  /* ---- reading: the one two-column case ---- */
  .dm-read { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 16px; align-items: start; }
  .dm-stage .dm-read { max-width: 1500px; margin: 0 auto; }
  .dm-read-text { position: sticky; top: 110px; margin-bottom: 0; }
  .dm-read-q { margin-bottom: 0; }
  .dm-readtext { white-space: pre-line; background: var(--surface); border-radius: var(--radius-sm); padding: 16px; line-height: 1.65; font-size: .9rem; }
  .dm-qlist { list-style: none; counter-reset: q; margin: 0; padding: 0; }
  .dm-qrow { counter-increment: q; padding: 13px 0; border-top: 1px solid var(--border); }
  .dm-qrow:first-child { border-top: none; padding-top: 0; }
  .dm-q { margin: 0 0 9px; font-size: .9rem; line-height: 1.5; position: relative; padding-left: 28px; }
  .dm-q::before { content: counter(q); position: absolute; left: 0; top: 0; display: inline-flex; align-items: center; justify-content: center; width: 20px; height: 20px; border-radius: 50%; background: var(--blue-100); color: var(--brand-blue-dark); font-family: var(--font-label); font-size: .68rem; font-weight: var(--fw-bold); }
  .dm-q--plain { padding-left: 0; }
  .dm-q--plain::before { content: none; }
  .dm-opts { display: flex; gap: 7px; flex-wrap: wrap; }
  .dm-chip { border: 1px solid var(--border-strong); background: var(--surface-card); color: var(--ink); border-radius: var(--radius-pill); padding: 6px 14px; cursor: pointer; font-family: var(--font-body); font-size: .84rem; }
  .dm-chip:hover:not(:disabled) { border-color: var(--brand-blue); }
  .dm-chip[data-state="ok"] { background: var(--blue-100); border-color: var(--brand-blue); color: var(--brand-blue-dark); font-weight: var(--fw-bold); }
  .dm-chip[data-state="no"] { background: #fdeeea; border-color: #c1462f; color: #c1462f; }

  /* ---- rule panel: slides in from the right ----
     640px, not 400: the rule's case grid is auto-fit/minmax(220px), so a narrow panel
     collapses it to one column and reads worse than leaving it inline. */
  .dm-scrim { position: fixed; inset: 0; background: rgba(15, 20, 27, .34); opacity: 0; pointer-events: none; transition: opacity .26s ease; z-index: 55; }
  .dm[data-rule="open"] .dm-scrim { opacity: 1; pointer-events: auto; }
  .dm-drawer {
    position: fixed; top: 0; right: 0; height: 100vh; width: min(640px, 94vw);
    background: var(--surface-card); border-left: 1px solid var(--border);
    box-shadow: -20px 0 46px rgba(15, 20, 27, .14);
    transform: translateX(100%);
    transition: transform .3s cubic-bezier(.2, 0, 0, 1);
    z-index: 60; overflow-y: auto; padding: 18px 22px 40px;
  }
  .dm[data-rule="open"] .dm-drawer { transform: none; }
  .dm-drawer-head { display: flex; align-items: center; gap: 12px; margin-bottom: 10px; }
  .dm-drawer-head .dm-kicker { margin: 0; }
  .dm-drawer-x { margin-left: auto; border: none; background: none; font-size: 1.6rem; line-height: 1; color: var(--muted); cursor: pointer; padding: 0 4px; }
  .dm-drawer-x:hover { color: var(--ink); }
  .dm-drawer-card { margin-bottom: 0; }
  @media (prefers-reduced-motion: reduce) { .dm-drawer, .dm-scrim { transition: none; } }

  .nvb-item.is-active { background: var(--blue-50); color: var(--brand-blue-dark); font-weight: var(--fw-semibold); }

  @media (max-width: 900px) {
    .dm-read { grid-template-columns: 1fr; }
    .dm-read-text { position: static; }
    .dm-bar-text { margin-right: 0; width: 100%; }
  }
</style>

<script>
  import { mountGrammarWorkspace } from "../../lib/grammarWorkspace.js";

  const root = document.querySelector(".dm");
  const TOPICS = JSON.parse(document.querySelector("[data-topics]").textContent);
  const $ = (s, r = document) => r.querySelector(s);
  const $$ = (s, r = document) => [...r.querySelectorAll(s)];

  const grid = $("[data-ex-grid]");
  const ruleInline = $("[data-rule-inline]");
  const rulePanel = $("[data-rule-panel]");

  function ruleHtml(t) {
    const c = t.concept || {};
    const flow = c.flow
      ? `<div class="vp-flow">${c.flow.map((s, i) =>
          `${i ? '<span class="vp-flow-arrow">→</span>' : ""}<span class="vp-flow-step${s.variant ? ` vp-flow-step--${s.variant}` : ""}">${s.text}</span>`).join("")}</div>`
      : "";
    const qa = c.qa
      ? `<div class="vp-qa-grid">${c.qa.map((q) =>
          `<div class="vp-qa-item">${q.html}${q.tag ? `<span class="vp-qa-tag">${q.tag}</span>` : ""}</div>`).join("")}</div>`
      : "";
    return `<div class="vp-card-label">Wie funktioniert das?</div>${flow}${c.exampleHtml ? `<p class="vp-example">${c.exampleHtml}</p>` : ""}${qa}${c.noteHtml ? `<p class="vp-note">${c.noteHtml}</p>` : ""}`;
  }

  function renderTopic(id) {
    const t = TOPICS[id];
    if (!t) return;
    $("[data-t-name]").textContent = t.name;
    $("[data-t-level]").textContent = t.level;
    const html = ruleHtml(t);
    if (ruleInline) ruleInline.innerHTML = html;
    if (rulePanel) rulePanel.innerHTML = html;
    const title = $("[data-rule-title]");
    if (title) title.textContent = `Regel — ${t.name}`;
    // The trigger carries the topic's own first line, so it reads as this rule rather
    // than a generic help button.
    const teaser = $("[data-rule-teaser]");
    if (teaser) teaser.textContent = t.subtitle || "Wie funktioniert das?";

    grid.innerHTML = (t.exercises || []).map((ex, i) => `
      <div class="vp-card">
        <div class="vp-ex-head">
          <span class="badge badge-neutral">${i + 1}</span>
          <h3>${ex.title}</h3>
        </div>
        ${ex.hint ? `<p class="vp-ex-hint">${ex.hint}</p>` : ""}
        <div data-ex-index="${i}"></div>
      </div>`).join("");
    mountGrammarWorkspace(grid, t, { onAnswer: () => {} });

    $$("[data-topic-btn]").forEach((b) => {
      b.classList.toggle("is-active", b.dataset.topicBtn === id);
      if (b.hasAttribute("aria-selected")) b.setAttribute("aria-selected", String(b.dataset.topicBtn === id));
    });
    // Keep the rail pointing at the level the open topic actually belongs to —
    // otherwise the page can open on an A2 topic while the rail highlights A1 and
    // lists something else entirely.
    selectRail(t.level);
    showArea("grammatik");
    remeasure();
  }

  function showArea(id) {
    root.dataset.area = id;
    $$("[data-area-panel]").forEach((p) => (p.hidden = p.dataset.areaPanel !== id));
    remeasure();
  }

  function measure() {
    $("[data-m-screens]").textContent = (document.body.scrollHeight / innerHeight).toFixed(1);
  }
  function remeasure() {
    measure();
    requestAnimationFrame(() => requestAnimationFrame(measure));
    setTimeout(measure, 80);
  }

  $$("[data-topic-btn]").forEach((b) => b.addEventListener("click", () => renderTopic(b.dataset.topicBtn)));
  $$("[data-area-btn]").forEach((b) => b.addEventListener("click", () => showArea(b.dataset.areaBtn)));

  // Icon-Rail: the level column swaps which list is shown, exactly as in /nav.
  function selectRail(key) {
    if (!$("[data-rail-btn]")) return;
    $$("[data-rail-btn]").forEach((x) => x.classList.toggle("active", x.dataset.railBtn === key));
    $$("[data-rail-section]").forEach((s) => (s.hidden = s.dataset.railSection !== key));
  }
  $$("[data-rail-btn]").forEach((b) => b.addEventListener("click", () => selectRail(b.dataset.railBtn)));

  const opener = $("[data-rule-open]");
  if (opener) {
    const scrim = $(".dm-scrim");
    const drawer = $(".dm-drawer");
    const openRule = (open) => {
      root.dataset.rule = open ? "open" : "";
      opener.setAttribute("aria-expanded", String(open));
      drawer.setAttribute("aria-hidden", String(!open));
      scrim.hidden = !open;
      if (open) $(".dm-drawer-x").focus();
      else opener.focus();
    };
    opener.addEventListener("click", () => openRule(true));
    $$("[data-rule-close]").forEach((b) => b.addEventListener("click", () => openRule(false)));
    addEventListener("keydown", (e) => { if (e.key === "Escape" && root.dataset.rule === "open") openRule(false); });
  }

  $$(".dm-chip[data-correct]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const row = btn.closest(".dm-qrow");
      if (row.dataset.done) return;
      row.dataset.done = "1";
      $$(".dm-chip", row).forEach((b) => {
        if (b.dataset.correct === "1") b.dataset.state = "ok";
        b.disabled = true;
      });
      if (btn.dataset.correct !== "1") btn.dataset.state = "no";
    });
  });

  addEventListener("resize", remeasure);
  renderTopic("perfekt");
</script>
