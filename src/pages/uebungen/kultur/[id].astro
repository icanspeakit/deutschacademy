---
// One Landeskunde topic: what the rule is, where it varies, how to say it, and a quiz.
//
// The blocks are all optional — a topic renders whichever of facts / prosCons / table /
// phrases it actually carries, so a new topic can be added to kultur.json without
// touching this file, and none of them has its shape hardcoded the way the old single
// page hardcoded a broadcaster table.
import Layout from "../../../layouts/Layout.astro";
import PracticeHeader from "../../../components/PracticeHeader.astro";
import Icon from "../../../components/Icon.astro";
import kultur from "../../../data/kultur.json";
import "../../../styles/practice.css";
import "../../../styles/kultur.css";

export function getStaticPaths() {
  return kultur.topics.map((topic, i) => ({
    params: { id: topic.id },
    props: {
      topic,
      prev: kultur.topics[i - 1] ?? null,
      next: kultur.topics[i + 1] ?? null,
    },
  }));
}

const { topic, prev, next } = Astro.props;
const sourcedInClass = topic.sourcing === "unterricht";
---
<Layout
  title={`${topic.title} – Landeskunde – DeutschAcademy`}
  description={topic.intro.slice(0, 160)}
>
  <PracticeHeader title="Landeskunde" />
  <main class="practice-main">
    <a href="/uebungen/kultur" class="vp-back-link">← Alle Themen</a>

    <article class="ku-topic">
      <header class="ku-topic-head">
        <span class="ku-card-ic"><Icon name={topic.icon} size={22} /></span>
        <div>
          <p class="eyebrow">{topic.eyebrow}</p>
          <h1>{topic.title}</h1>
        </div>
        <span class="ku-badge">{topic.level}</span>
      </header>

      <p class="ku-intro">{topic.intro}</p>
      <p class="ku-question">{topic.question}</p>

      {topic.facts && (
        <section class="ku-block">
          <h2>Das Wichtigste</h2>
          <ul class="ku-facts">{topic.facts.map((f: string) => <li>{f}</li>)}</ul>
        </section>
      )}

      {topic.prosCons && (
        <section class="ku-block">
          <h2>Dafür und dagegen</h2>
          <div class="ku-proscons">
            <div>
              <h3>{topic.prosCons.prosLabel}</h3>
              <ul>{topic.prosCons.pros.map((i: string) => <li>{i}</li>)}</ul>
            </div>
            <div>
              <h3>{topic.prosCons.consLabel}</h3>
              <ul>{topic.prosCons.cons.map((i: string) => <li>{i}</li>)}</ul>
            </div>
          </div>
        </section>
      )}

      {topic.context && <p class="ku-context">{topic.context}</p>}

      {topic.table && (
        <section class="ku-block">
          <h2>{topic.table.label}</h2>
          <div class="ku-tablewrap">
            <table class="ku-table">
              <thead><tr>{topic.table.columns.map((c: string) => <th>{c}</th>)}</tr></thead>
              <tbody>
                {topic.table.rows.map((row: string[]) => (
                  <tr>{row.map((cell) => <td>{cell}</td>)}</tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )}

      {topic.phrases && (
        <section class="ku-block">
          <h2>So sagt man das</h2>
          <ul class="ku-phrases">{topic.phrases.map((p: string) => <li>{p}</li>)}</ul>
        </section>
      )}

      <p class={`ku-source ${sourcedInClass ? "is-lesson" : ""}`}>
        {sourcedInClass ? "Aus dem Unterricht: " : "Sachwissen: "}{topic.sourceNote}
      </p>

      {topic.links && (
        <div class="ku-links">
          {topic.links.map((l: { label: string; href: string }) => (
            <a class="quiz-btn" href={l.href}>{l.label} →</a>
          ))}
        </div>
      )}
    </article>

    <section class="ku-block ku-quizblock">
      <h2>Quiz zu diesem Thema</h2>
      <p class="ku-quiz-intro">{topic.quiz.length} Fragen. Antworte per Klick — die Erklärung steht danach dabei.</p>
      <div class="quiz-card" id="ku-quiz"></div>
      <p class="ku-quiz-more">
        <a href="/uebungen/kultur/quiz">Quiz über alle Themen →</a>
      </p>
    </section>

    <nav class="ku-prevnext">
      {prev ? <a href={`/uebungen/kultur/${prev.id}`}>← {prev.title}</a> : <span />}
      {next ? <a href={`/uebungen/kultur/${next.id}`}>{next.title} →</a> : <span />}
    </nav>
  </main>

  <script type="application/json" id="ku-quiz-data" set:html={JSON.stringify(topic.quiz)}></script>
  <script type="module">
    import { mountQuiz } from "../../../lib/quiz.js";
    import { recordAttempt } from "../../../lib/progress.js";

    const questions = JSON.parse(document.getElementById("ku-quiz-data").textContent);
    mountQuiz(document.getElementById("ku-quiz"), questions, {
      mode: "choice",
      showWrongCount: true,
      onAnswer: (ok) => recordAttempt({ skill: "kultur", correct: ok }),
    });
  </script>
</Layout>
