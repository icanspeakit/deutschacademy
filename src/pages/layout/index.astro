  <script>
    var toggleBtns = document.querySelectorAll(".hp-toggle-btn");
    var concepts = document.querySelectorAll(".hp-concept");

    var preiseLink = document.querySelector(".hp-nav-preise-link");

    function showConcept(id) {
      concepts.forEach(function (c) {
        c.hidden = c.getAttribute("data-concept") !== id;
      });
      toggleBtns.forEach(function (b) {
        b.classList.toggle("active", b.getAttribute("data-concept") === id);
      });
      if (preiseLink) { preiseLink.setAttribute("href", "#preise-" + id); }
      try { localStorage.setItem("hp-concept", id); } catch (e) {}
    }

    toggleBtns.forEach(function (b) {
      b.addEventListener("click", function () {
        showConcept(b.getAttribute("data-concept"));
      });
    });

    var savedConcept = "1";
    try { savedConcept = localStorage.getItem("hp-concept") || "1"; } catch (e) {}
    showConcept(savedConcept);

    // Generic tab switcher (used by concept 2's Übungen/Prüfungen toggle)
    document.querySelectorAll(".hp-tabbar[data-tabgroup]").forEach(function (bar) {
      var group = bar.getAttribute("data-tabgroup");
      var panels = document.querySelectorAll('.hp-tab-panel[data-tabgroup="' + group + '"]');
      bar.querySelectorAll(".hp-tab").forEach(function (tab) {
        tab.addEventListener("click", function () {
          var target = tab.getAttribute("data-tab");
          bar.querySelectorAll(".hp-tab").forEach(function (t) {
            t.classList.toggle("active", t === tab);
          });
          panels.forEach(function (p) {
            p.hidden = p.getAttribute("data-panel") !== target;
          });
        });
      });
    });
  </script>
