{
  "id": "adjektivdeklination",
  "name": "Adjektivdeklination",
  "level": "B1",
  "subtitle": "Die Endung des Adjektivs hängt nicht vom Nomen ab, sondern davon, was davorsteht. Drei Typen — bestimmter Artikel, unbestimmter Artikel, kein Artikel — und das Muster sitzt.",
  "source": "MATRIX ADJEKTIVE.pdf (vollständige Deklinationstabelle), Adjektivübung.pdf, Adjektivubung nur ABs.pdf",
  "concept": {
    "flow": [
      {
        "text": "Artikelwort",
        "variant": "verb"
      },
      {
        "text": "Adjektiv + Endung",
        "variant": "prep"
      },
      {
        "text": "Nomen"
      }
    ],
    "exampleHtml": "der <span class=\"vp-prep\">hohe</span> Baum · ein <span class=\"vp-prep\">hoher</span> Baum · <span class=\"vp-prep\">alter</span> Wein",
    "qa": [
      {
        "html": "<strong>Typ A</strong> — nach <em>der/die/das</em>: das Artikelwort zeigt den Kasus schon an, das Adjektiv bekommt nur <strong>-e</strong> oder <strong>-en</strong>.",
        "tag": "schwach"
      },
      {
        "html": "<strong>Typ B</strong> — nach <em>ein-/kein-/mein-</em>: dort, wo <em>ein</em> keine Endung hat, muss das Adjektiv die Arbeit machen (<em>ein hoh<strong>er</strong> Baum</em>).",
        "tag": "gemischt"
      },
      {
        "html": "<strong>Typ C</strong> — ohne Artikel: das Adjektiv trägt die Artikelendung selbst (<em>alt<strong>er</strong> Wein</em>, <em>mit alt<strong>em</strong> Wein</em>).",
        "tag": "stark"
      }
    ],
    "noteHtml": "Faustregel für Typ A: im <em>Singular Nominativ</em> (und Akkusativ feminin/neutral) steht <em>-e</em> — überall sonst <em>-en</em>. Im <em>Plural</em> ist nach jedem Artikelwort immer <em>-en</em>.",
    "reference": {
