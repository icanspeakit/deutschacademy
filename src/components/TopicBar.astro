---
// The strip under the site nav on a single practice topic: where you are, how far you got,
// and the fact that getting further is being kept.
//
// It exists because the two ways into a topic did not look like the same product. Opening
// "Artikel: der, die, das" inside /dashboard put it under the course strip with a live
// "0 / 42 Aufgaben" ring; opening the very same topic at /uebungen/grammatik/artikel gave a
// bare page with no site nav and nothing to say whether any of it was being recorded. It was
// — /dashboard just never saw it, because the page logged answers to the "grammatik" skill
// bucket without naming the topic. That bug is fixed at the call site; this bar is the part
// the learner can see.
//
// Deliberately the same shape as .nv-strip in nav.css (title · subtitle · track · count), so
// moving between the dashboard and a standalone topic reads as one site rather than two.
//
// The numbers render at zero and are filled in on the client from getTopicProgress() — the
// store is per-browser localStorage, so the server has nothing true to say about them.
interface Props {
  /** Progress key — the topic's URL slug. Must match what recordAttempt() writes. */
  topic: string;
  /** Section the topic belongs to, e.g. "Grammatik". */
  kind: string;
  /** The topic's own name. */
  title: string;
  /** CEFR level badge, when the data carries one. */
  level?: string;
  /** Gradeable answers in this topic; 0 hides the counter rather than showing "0 / 0". */
  tasks?: number;
  /** false drops the section link ("Grammatik") — the site nav already leads there. */
  showKind?: boolean;
  /** The page has decks of its own (the Artikel trainer) and says through `da:topic-scope`
      which one is running. The counter and track then stay hidden until a deck is chosen,
      and hide again for mixed practice: "0 / 386" in front of a beginner is a wall, not a goal. */
  scoped?: boolean;
}
const { topic, kind, title, level, tasks = 0, showKind = true, scoped = false } = Astro.props;
---
<div class:list={["tb", Astro.slots.has("end") && "tb--merged"]} data-topic-bar data-topic={topic} data-tasks={tasks}>
  <div class="tb-inner">
    <p class="tb-where">
      {showKind && <a href="/uebungen/grammatik">{kind}</a>}
      {level && <span class="tb-level">{level}</span>}
      <span class="tb-sep" aria-hidden="true">·</span>
      <span class="tb-title">{title}</span>
    </p>

    {tasks > 0 && (
      <>
        <span class="tb-track" data-topic-track hidden={scoped}><span class="tb-fill" data-topic-fill style="width:0%"></span></span>
        <span class="tb-count" data-topic-count hidden={scoped}>0 / {tasks} Aufgaben</span>
      </>
    )}

    <!-- Says where progress lives, not just that it exists. "Gespeichert" alone would imply
         an account; there is none, and a learner who clears their browser should know that
         before they lose six weeks of it. -->
    <a class="tb-saved" href="/fortschritt" data-topic-saved title="Fortschritt wird auf diesem Gerät gespeichert" data-i18n-attr="title:topic.savedLocally">
      <svg viewBox="0 0 24 24" aria-hidden="true" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 12 10 18 20 6"></polyline></svg>
      <span data-topic-saved-text data-i18n="topic.savedLocally">Fortschritt wird auf diesem Gerät gespeichert</span>
    </a>

    {/* The course controls (CourseBar inline): one bar instead of two stacked. */}
    {Astro.slots.has("end") && <div class="tb-end"><slot name="end" /></div>}
  </div>
</div>

<style>
  .tb {
    background: var(--surface-card);
    border-bottom: 1px solid var(--border);
  }
  .tb-inner {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    max-width: 1240px;
    margin: 0 auto;
    padding: 10px 24px;
  }

  .tb-end { margin-left: auto; min-width: 0; }
  /* Sharing the row with the course controls, the saved note is its check mark only —
     the sentence stays for screen readers and as the tooltip. The full sentence cost the
     row its single line. */
  .tb--merged .tb-inner { padding-top: 6px; padding-bottom: 6px; }
  .tb--merged .tb-saved [data-topic-saved-text] {
    position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap;
  }
  .tb--merged .tb-saved.is-idle { opacity: 1; visibility: visible; }
  .tb-where {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    min-width: 0;
    font-size: 13px;
    color: var(--muted);
  }
  .tb-where a { color: var(--brand-blue); text-decoration: none; }
  .tb-where a:hover { text-decoration: underline; }
  .tb-level {
    padding: 1px 7px;
    border-radius: 999px;
    background: var(--blue-50);
    color: var(--brand-blue-dark);
    font-size: 11px;
    font-weight: 600;
  }
  .tb-sep { color: var(--muted-soft); }
  .tb-title {
    font-weight: 500;
    color: var(--ink);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .tb-track {
    flex: 1;
    min-width: 120px;
    height: 6px;
    border-radius: 999px;
    background: var(--blue-50);
    overflow: hidden;
  }
  .tb-fill {
    display: block;
    height: 100%;
    border-radius: 999px;
    background: var(--gradient-brand);
    transition: width .35s ease;
  }
  @media (prefers-reduced-motion: reduce) { .tb-fill { transition: none; } }

  .tb-track[hidden], .tb-count[hidden] { display: none; }
  .tb-count {
    font-size: 12.5px;
    font-weight: 600;
    color: var(--muted);
    white-space: nowrap;
  }

  .tb-saved {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: var(--muted-soft);
    text-decoration: none;
    white-space: nowrap;
  }
  .tb-saved svg { color: var(--brand-blue); flex-shrink: 0; }
  .tb-saved:hover { color: var(--brand-blue); }
  /* Briefly after an answer lands, so the claim is tied to the thing that just happened
     rather than being a permanent label nobody reads twice. */
  .tb-saved.is-just-saved { color: var(--brand-blue); opacity: 1; }
  /* And then it goes. It is a reassurance, not a status: worth reading once on arrival
     and worth nothing on the four hundredth answer, while it costs a line of the bar on
     a phone the whole time. It comes back for a moment whenever something is actually
     saved (is-just-saved above), which is the only time it says anything new. */
  .tb-saved {
    transition: opacity .5s ease, visibility 0s linear .5s;
  }
  .tb-saved.is-idle {
    opacity: 0;
    visibility: hidden;
  }
  @media (prefers-reduced-motion: reduce) { .tb-saved { transition: none; } }

  @media (max-width: 720px) {
    .tb-inner { gap: 8px 12px; padding: 9px 16px; }
    /* The track takes its own row at phone width: three items sharing one line left it
       ~40px wide, which reads as decoration rather than as a measure. */
    .tb-track { order: 4; flex-basis: 100%; height: 5px; }
    .tb-count { margin-left: auto; font-size: 12px; }
    .tb-saved { font-size: 11px; flex-basis: 100%; order: 5; }
    .tb-where { font-size: 12.5px; }
    /* Merged on a phone: the topic, then the course controls, then the track with its
       count: three short rows where the two bars took five. */
    .tb--merged .tb-inner { padding: 6px 16px 8px; }
    .tb--merged .tb-where { flex-basis: 100%; }
    .tb--merged .tb-end { order: 2; margin-left: 0; }
    .tb--merged .tb-count { order: 5; margin-left: 0; }
    .tb--merged .tb-saved { order: 6; flex-basis: auto; }
    .tb--merged .tb-track { order: 4; flex: 1 1 calc(100% - 140px); min-width: 0; }
  }
</style>

<script>
  // Hydrate from the store, then keep the bar in step with answers as they land. The page
  // that owns the exercise tells us about each one via a `da:progress` event, so this file
  // never has to know which of the five exercise widgets produced it.
  import { getTopicProgress } from "../lib/progress.js";
  import { onLangChange, translate } from "../lib/i18n.js";

  const bar = document.querySelector<HTMLElement>("[data-topic-bar]");
  if (bar) {
    const topic = bar.dataset.topic!;
    let tasks = Number(bar.dataset.tasks || 0);
    const fill = bar.querySelector<HTMLElement>("[data-topic-fill]");
    const count = bar.querySelector<HTMLElement>("[data-topic-count]");
    const saved = bar.querySelector<HTMLElement>("[data-topic-saved]");
    const savedText = bar.querySelector<HTMLElement>("[data-topic-saved-text]");
    // Seeded with the German so the first paint — which happens before initI18n() has
    // fetched anything — says words rather than the key itself.
    let dict: Record<string, string> = {
      "topic.taskCount": "{n} / {total} Aufgaben",
      "topic.saved": "Gespeichert",
      "topic.savedLocally": "Fortschritt wird auf diesem Gerät gespeichert",
    };
    let done = 0;
    let savedTimer = 0;
    let idleTimer = 0;

    // Read once, then out of the way. Six seconds is long enough to notice and short
    // enough that it is gone before the first exercise is answered.
    function idle() {
      window.clearTimeout(idleTimer);
      idleTimer = window.setTimeout(() => saved?.classList.add("is-idle"), 6000);
    }

    function paint() {
      if (!tasks) return;
      const pct = Math.min(100, Math.round((done / tasks) * 100));
      if (fill) fill.style.width = pct + "%";
      if (count) count.textContent = translate(dict, "topic.taskCount", { n: done, total: tasks });
    }

    // The counter and the "saved" flash are painted from JS, so they need the dictionary
    // rather than a data-i18n. The flash is transient; the resting label is not, and
    // i18n repaints that one itself through its data-i18n.
    onLangChange((_code, d) => { dict = d; paint(); });

    try {
      done = Math.min(getTopicProgress()[topic]?.done ?? 0, tasks || Infinity);
    } catch (e) {}
    paint();
    idle();

    // `correct` is what moves the bar; a wrong answer is still recorded (it counts toward
    // accuracy and the streak) and still proves the saving is live, so it flashes too.
    // A page whose exercise has decks of its own (the Artikel trainer) says which one is
    // running and how far it is; from then on that, not the topic total, is the count.
    let scoped = false;
    // `total: 0` means no deck is running (mixed practice): the count and track step aside.
    const track = bar.querySelector<HTMLElement>("[data-topic-track]");
    addEventListener("da:topic-scope", (e) => {
      const d = (e as CustomEvent).detail ?? {};
      scoped = true;
      if (track) track.hidden = !d.total;
      if (count) count.hidden = !d.total;
      if (!d.total) return;
      tasks = d.total;
      done = Math.min(d.done ?? 0, tasks);
      paint();
    });

    addEventListener("da:progress", (e) => {
      const ok = (e as CustomEvent).detail?.correct;
      if (ok && tasks && !scoped) done = Math.min(done + 1, tasks);
      paint();
      if (!saved) return;
      saved.classList.remove("is-idle");
      saved.classList.add("is-just-saved");
      if (savedText) savedText.textContent = translate(dict, "topic.saved");
      window.clearTimeout(savedTimer);
      savedTimer = window.setTimeout(() => {
        saved.classList.remove("is-just-saved");
        if (savedText) savedText.textContent = translate(dict, "topic.savedLocally");
        idle();
      }, 1600);
    });
  }
</script>
