    {
      "id": "widersprechen",
      "name": "Widersprechen",
      "icon": "✋",
      "phrases": [
        { "de": "Das sehe ich anders.", "en": "I see it differently.", "ar": "أرى الأمر بشكل مختلف.", "ru": "Я вижу это иначе.", "tr": "Ben farklı görüyorum." },
        { "de": "Da bin ich anderer Meinung.", "en": "I have a different opinion on that.", "ar": "لديّ رأي مختلف في ذلك.", "ru": "Здесь я другого мнения.", "tr": "Bu konuda farklı düşünüyorum." },
        { "de": "Das stimmt so nicht.", "en": "That's not quite right.", "ar": "هذا ليس صحيحًا تمامًا.", "ru": "Это не совсем так.", "tr": "Bu tam olarak doğru değil." },
        { "de": "Da muss ich dir widersprechen.", "en": "I have to disagree with you there.", "ar": "عليّ أن أخالفك في هذا.", "ru": "Тут я вынужден с тобой не согласиться.", "tr": "Burada sana itiraz etmem gerek." },
