---
// The site nav, one component for both widths, driven by src/lib/catalog.js so the menu
// can never drift from what the site actually offers.
//
// The top level names subjects, not URL folders. "Übungen" and "Prüfungen" mirrored the
// route tree and asked a learner to know which folder a tool lived in before they could
// find it; the four subject menus (Grammatik, Wortschatz, Sprechen, Prüfungen) name the
// thing they came to practise. Two more entries are about the learner rather than the
// material: Niveaus, which opens an A1–B2 grid and then that level's own grammar and
// vocabulary, and Profil, a plain link to the dashboard.
//
// Desktop (>900px): each subject opens a panel. Niveaus opens a wide panel whose four
// level tiles switch the two columns below them — grammar on the left, words on the
// right — so picking a level never costs a page load.
//
// Mobile (≤900px): a full-height panel slides in from the right. It is a small stack of
// panes, one screen at a time: subjects → a subject's tools, or subjects → Niveaus →
// one level's grammar and words. The utilities (language, theme, CTA) stay pinned to the
// bottom, in the thumb's reach, rather than at the top where the burger is.
//
// Both menus are rendered here on the server and merely shown/hidden, so every link is in
// the HTML for crawlers and the nav still navigates with JS off.
import Icon from "./Icon.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { navSections, levels } from "../lib/catalog.js";
import "../styles/site-nav.css";

interface Props {
  /** Marks the current section so its nav item reads as active. */
  active?: "grammatik" | "wortschatz" | "fertigkeiten" | "landeskunde" | "pruefungen" | "niveaus" | "profil";
}
const { active } = Astro.props;

// B1 has eleven grammar topics and a menu that scrolls is a menu nobody reads to the end
// of, so a level previews its first few and links to the rest.
const GRAMMAR_PREVIEW = 5;

// Up to this many sub-sections render side by side; more than this and the panel switches
// to tabs, so its height stops tracking the size of the catalogue.
const TAB_AT = 2;
const PROFILE_HREF = "/dashboard";
---
<nav class="lp-nav" data-nav>
  <div class="lp-nav-row">
    <div class="lp-nav-left">
      <a href="/" class="lp-nav-logo"><img src="/assets/logo.png" alt="DeutschAcademy" /></a>

      <!-- Desktop menu bar. Hidden below 900px, where the drawer takes over. -->
      <div class="lp-menubar" data-menubar>
        {navSections.map((section) => (
          <div class="lp-menu" data-menu={section.id}>
            <a
              class:list={["lp-menu-btn", active === section.id && "is-active"]}
              href={section.href}
              aria-expanded="false"
              aria-controls={`lp-panel-${section.id}`}
              data-menu-btn
            >
              <span data-i18n={section.nameKey}>{section.name}</span>
              <svg class="lp-menu-caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </a>
            <div
              class:list={[
                "lp-panel",
                section.groups && (section.groups.length > TAB_AT ? "lp-panel--tabbed" : "lp-panel--grouped"),
              ]}
              id={`lp-panel-${section.id}`}
              data-menu-panel
              hidden
            >
              {/* Spans every group, so it sits above them rather than inside one. */}
              {section.feature && (
                <a class="lp-panel-feature" href={section.feature.href}>
                  <span class="lp-panel-ic"><Icon name={section.feature.icon} size={18} /></span>
                  <span class="lp-panel-txt">
                    <b>{section.feature.title}</b>
                    <i>{section.feature.count}</i>
                  </span>
                  <span aria-hidden="true">→</span>
                </a>
              )}

              {/* Two ways to show sub-sections, picked by how many there are.

                  Up to TAB_AT they sit side by side and everything is visible at once.
                  Beyond that, side by side stops working: five Landeskunde groups in
                  columns ran 626px tall at 1440px and 823px on a small laptop — off the
                  bottom of the screen — because the panel's height grows with the
                  catalogue. Tabs cap it at one group's worth however many topics land
                  later, and they are the same control the Niveaus menu already uses. */}
              {section.groups && section.groups.length > TAB_AT ? (
                <>
                  <div class="lp-tabs" role="tablist" aria-label={section.name}>
                    {section.groups.map((group, i) => (
                      <button
                        class:list={["lp-tab", i === 0 && "is-on"]}
                        type="button"
                        role="tab"
                        id={`lp-tab-${section.id}-${group.id}`}
                        aria-selected={i === 0 ? "true" : "false"}
                        aria-controls={`lp-tabview-${section.id}-${group.id}`}
                        data-group-tab={`${section.id}:${group.id}`}
                        data-group-scope={section.id}
                      >
                        <span data-i18n={group.nameKey}>{group.name}</span>
                        <i>{group.items.length}</i>
                      </button>
                    ))}
                  </div>

                  {section.groups.map((group, i) => (
                    <div
                      class="lp-tabview"
                      id={`lp-tabview-${section.id}-${group.id}`}
                      role="tabpanel"
                      aria-labelledby={`lp-tab-${section.id}-${group.id}`}
                      data-group-view={`${section.id}:${group.id}`}
                      hidden={i !== 0}
                    >
                      <ul class="lp-panel-list">
                        {group.items.map((item) => (
                          <li>
                            <a href={item.href}>
                              <span class="lp-panel-ic"><Icon name={item.icon} size={18} /></span>
                              <span class="lp-panel-txt">
                                <b data-i18n={item.titleKey}>{item.title}</b>
                                <i data-i18n={item.countKey} data-i18n-vars={item.countVars ? JSON.stringify(item.countVars) : undefined}>{item.count}</i>
                              </span>
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </>
              ) : section.groups ? (
                <div class="lp-panel-cols">
                  {section.groups.map((group) => (
                    <div class:list={["lp-panel-col", group.inline && "lp-panel-col--inline"]}>
                      <p class="lp-panel-head">
                        <span data-i18n={group.nameKey}>{group.name}</span>
                      </p>
                      <ul>
                        {group.items.map((item) => (
                          <li>
                            <a href={item.href}>
                              <b data-i18n={item.titleKey}>{item.title}</b>
                              <i data-i18n={item.countKey} data-i18n-vars={item.countVars ? JSON.stringify(item.countVars) : undefined}>{item.count}</i>
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
              ) : (
                <ul class="lp-panel-list">
                  {section.items.map((item) => (
                    <li>
                      <a href={item.href}>
                        <span class="lp-panel-ic"><Icon name={item.icon} size={18} /></span>
                        <span class="lp-panel-txt">
                          <b data-i18n={item.titleKey}>{item.title}</b>
                          <i data-i18n={item.countKey} data-i18n-vars={item.countVars ? JSON.stringify(item.countVars) : undefined}>{item.count}</i>
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
              )}

              <a class="lp-panel-foot" href={section.href}>
                <span data-i18n="nav.panel.all">Übersicht</span>
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        ))}

        <!-- Niveaus: the tiles pick, the columns below answer. -->
        <div class="lp-menu" data-menu="niveaus">
          <a
            class:list={["lp-menu-btn", active === "niveaus" && "is-active"]}
            href="/uebungen/grammatik"
            aria-expanded="false"
            aria-controls="lp-panel-niveaus"
            data-menu-btn
          >
            <span data-i18n="nav.subject.niveaus">Niveaus</span>
            <svg class="lp-menu-caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </a>
          <div class="lp-panel lp-panel--wide" id="lp-panel-niveaus" data-menu-panel hidden>
            <div class="lp-levels" role="tablist" aria-label="Niveau">
              {levels.map((lv, i) => (
                <button
                  class:list={["lp-level-tile", i === 0 && "is-on"]}
                  type="button"
                  role="tab"
                  id={`lp-level-tab-${lv.slug}`}
                  aria-selected={i === 0 ? "true" : "false"}
                  aria-controls={`lp-level-view-${lv.slug}`}
                  data-level-tab={lv.slug}
                >
                  <b>{lv.level}</b>
                  <i data-i18n={lv.blurbKey}>{lv.blurb}</i>
                </button>
              ))}
            </div>

            {levels.map((lv, i) => (
              <div
                class="lp-level-view"
                id={`lp-level-view-${lv.slug}`}
                role="tabpanel"
                aria-labelledby={`lp-level-tab-${lv.slug}`}
                data-level-view={lv.slug}
                hidden={i !== 0}
              >
                <div class="lp-panel-grid">
                  <div class="lp-panel-col">
                    <p class="lp-panel-head">
                      <span class="lp-panel-head-ic"><Icon name="book" size={16} /></span>
                      <span data-i18n="nav.level.grammar">Grammatik</span>
                    </p>
                    <ul>
                      {lv.grammar.slice(0, GRAMMAR_PREVIEW).map((t) => (
                        <li><a href={t.href}><b>{t.name}</b></a></li>
                      ))}
                    </ul>
                    {lv.grammar.length > GRAMMAR_PREVIEW && (
                      <a class="lp-level-more" href={`/uebungen/grammatik#niveau-${lv.slug}`}>
                        <span
                          data-i18n="nav.level.allTopics"
                          data-i18n-vars={JSON.stringify({ n: lv.grammar.length })}
                        >Alle {lv.grammar.length} Themen</span>
                        <span aria-hidden="true">→</span>
                      </a>
                    )}
                  </div>

                  <div class="lp-panel-col">
                    <p class="lp-panel-head">
                      <span class="lp-panel-head-ic"><Icon name="folder" size={16} /></span>
                      <span data-i18n="nav.level.vocab">Wortschatz</span>
                    </p>
                    {lv.vocab.length ? (
                      <ul>
                        {lv.vocab.map((v) => (
                          <li>
                            <a href={v.href}>
                              <b>{v.title}</b>
                              <i>{v.count}</i>
                            </a>
                          </li>
                        ))}
                      </ul>
                    ) : (
                      // The lexicon stops at A2 today. Saying so beats linking to a
                      // "Wortschatz B1" that would quietly hand back the A1 deck.
                      <p class="lp-level-empty" data-i18n="nav.level.vocabSoon">
                        Wortlisten für dieses Niveau folgen.
                      </p>
                    )}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>

        <a
          class:list={["lp-menu-btn", "lp-menu-btn--plain", active === "profil" && "is-active"]}
          href={PROFILE_HREF}
        >
          <span data-i18n="nav.subject.profil">Profil</span>
        </a>
      </div>

      <!-- No JS: neither the panels nor the drawer can open, so the sections get plain
           links and the menus get out of the way entirely. -->
      <noscript>
        <div class="lp-nav-fallback">
          {navSections.map((s) => <a href={s.href} data-i18n={s.nameKey}>{s.name}</a>)}
          <a href={PROFILE_HREF} data-i18n="nav.subject.profil">Profil</a>
        </div>
      </noscript>
    </div>

    <div class="lp-nav-right">
      <a href="/uebungen" class="lp-btn lp-btn--primary" data-i18n="nav.cta">Kostenlos üben</a>
      <div class="lp-nav-utils"><LanguageSwitcher /><ThemeToggle /></div>
      <button
        class="lp-nav-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="lp-drawer"
        aria-label="Menü öffnen"
        data-drawer-open
        data-i18n-attr="aria-label:nav.menuOpen"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>
</nav>

<!-- Mobile drawer. Outside .lp-nav, which is `position: sticky` with a background —
     a fixed child of a stacking context like that is fine, but the drawer also needs to
     sit above the sticky bar's own z-index, so it is a sibling at the top level. -->
<div class="lp-drawer" id="lp-drawer" data-drawer hidden>
  <div class="lp-drawer-scrim" data-drawer-close></div>
  <div class="lp-drawer-panel" role="dialog" aria-modal="true" aria-label="Menü">
    <div class="lp-drawer-top">
      <img src="/assets/logo.png" alt="DeutschAcademy" />
      <button class="lp-drawer-x" type="button" aria-label="Menü schließen" data-drawer-close data-i18n-attr="aria-label:nav.menuClose">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="6" y1="6" x2="18" y2="18"></line><line x1="18" y1="6" x2="6" y2="18"></line></svg>
      </button>
    </div>

    <!-- One pane on screen at a time. Every pane carries `data-pane`, every back button
         names the pane it returns to, so the tree stays declarative. -->
    <div class="lp-drawer-body" data-drawer-body>
      <div data-pane="home">
        {navSections.map((section) => (
          <button class="lp-drawer-row" type="button" data-drawer-to={`sub:${section.id}`}>
            <span class="lp-drawer-ic"><Icon name={section.icon} size={18} /></span>
            <span class="lp-drawer-txt">
              <b data-i18n={section.nameKey}>{section.name}</b>
              <i data-i18n={section.blurbKey}>{section.blurb}</i>
            </span>
            <span class="lp-drawer-n">{section.items.length}</span>
            <svg class="lp-drawer-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 6 15 12 9 18"></polyline></svg>
          </button>
        ))}

        <button class="lp-drawer-row" type="button" data-drawer-to="niveaus">
          <span class="lp-drawer-ic"><Icon name="layers" size={18} /></span>
          <span class="lp-drawer-txt">
            <b data-i18n="nav.subject.niveaus">Niveaus</b>
            <i data-i18n="nav.subject.niveaus.blurb">A1 bis B2, Schritt für Schritt</i>
          </span>
          <span class="lp-drawer-n">{levels.length}</span>
          <svg class="lp-drawer-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 6 15 12 9 18"></polyline></svg>
        </button>

        <a class="lp-drawer-row" href={PROFILE_HREF}>
          <span class="lp-drawer-ic"><Icon name="user" size={18} /></span>
          <span class="lp-drawer-txt">
            <b data-i18n="nav.subject.profil">Profil</b>
            <i data-i18n="nav.subject.profil.blurb">Dein Lernstand und deine Woche</i>
          </span>
          <svg class="lp-drawer-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 6 15 12 9 18"></polyline></svg>
        </a>
      </div>

      {navSections.map((section) => (
        <div data-pane={`sub:${section.id}`} hidden>
          <button class="lp-drawer-back" type="button" data-drawer-to="home">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 6 9 12 15 18"></polyline></svg>
            <span data-i18n="picker.back">Zurück</span>
          </button>
          <p class="lp-drawer-subhead" data-i18n={section.nameKey}>{section.name}</p>

          {section.feature && (
            <a class="lp-drawer-row" href={section.feature.href}>
              <span class="lp-drawer-ic"><Icon name={section.feature.icon} size={18} /></span>
              <span class="lp-drawer-txt">
                <b>{section.feature.title}</b>
                <i>{section.feature.count}</i>
              </span>
              <svg class="lp-drawer-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 6 15 12 9 18"></polyline></svg>
            </a>
          )}

          {/* Same sub-sections as the desktop panel, stacked. Fifteen rows in a row is a
              scroll with no landmarks; five headings give the thumb something to aim at. */}
          {(section.groups ?? [{ id: "all", name: null, nameKey: undefined, items: section.items }]).map((group) => (
            <>
              {group.name && <p class="lp-drawer-grouphead" data-i18n={group.nameKey}>{group.name}</p>}
              {group.items.map((item) => (
                <a class="lp-drawer-row" href={item.href}>
                  <span class="lp-drawer-ic"><Icon name={item.icon} size={18} /></span>
                  <span class="lp-drawer-txt">
                    <b data-i18n={item.titleKey}>{item.title}</b>
                    <i data-i18n={item.countKey} data-i18n-vars={item.countVars ? JSON.stringify(item.countVars) : undefined}>{item.count}</i>
                  </span>
                  <svg class="lp-drawer-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 6 15 12 9 18"></polyline></svg>
                </a>
              ))}
            </>
          ))}
          <a class="lp-drawer-all" href={section.href}>
            <span data-i18n="nav.panel.all">Übersicht</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>
      ))}

      <!-- Niveaus: a 2×2 grid, because four levels side by side are comparable at a
           glance in a way four stacked rows are not. -->
      <div data-pane="niveaus" hidden>
        <button class="lp-drawer-back" type="button" data-drawer-to="home">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 6 9 12 15 18"></polyline></svg>
          <span data-i18n="picker.back">Zurück</span>
        </button>
        <p class="lp-drawer-subhead" data-i18n="nav.subject.niveaus">Niveaus</p>
        <div class="lp-drawer-levels">
          {levels.map((lv) => (
            <button class="lp-level-tile lp-level-tile--grid" type="button" data-drawer-to={`level:${lv.slug}`}>
              <b>{lv.level}</b>
              <i data-i18n={lv.blurbKey}>{lv.blurb}</i>
              <span
                class="lp-level-meta"
                data-i18n="nav.level.topicCount"
                data-i18n-vars={JSON.stringify({ n: lv.grammar.length })}
              >{lv.grammar.length} Themen</span>
            </button>
          ))}
        </div>
      </div>

      {levels.map((lv) => (
        <div data-pane={`level:${lv.slug}`} hidden>
          <button class="lp-drawer-back" type="button" data-drawer-to="niveaus">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 6 9 12 15 18"></polyline></svg>
            <span data-i18n="picker.back">Zurück</span>
          </button>
          <p class="lp-drawer-subhead">{lv.level} · <span data-i18n={lv.blurbKey}>{lv.blurb}</span></p>

          <p class="lp-drawer-grouphead" data-i18n="nav.level.grammar">Grammatik</p>
          {/* No icon per row: every grammar topic would carry the same book, which is
              decoration, and dropping it lifts the Wortschatz block above the fold. */}
          {lv.grammar.slice(0, GRAMMAR_PREVIEW).map((t) => (
            <a class="lp-drawer-row lp-drawer-row--compact" href={t.href}>
              <span class="lp-drawer-txt"><b>{t.name}</b></span>
              <svg class="lp-drawer-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 6 15 12 9 18"></polyline></svg>
            </a>
          ))}
          {lv.grammar.length > GRAMMAR_PREVIEW && (
            <a class="lp-drawer-all" href={`/uebungen/grammatik#niveau-${lv.slug}`}>
              <span
                data-i18n="nav.level.allTopics"
                data-i18n-vars={JSON.stringify({ n: lv.grammar.length })}
              >Alle {lv.grammar.length} Themen</span>
              <span aria-hidden="true">→</span>
            </a>
          )}

          <p class="lp-drawer-grouphead" data-i18n="nav.level.vocab">Wortschatz</p>
          {lv.vocab.length ? lv.vocab.map((v) => (
            <a class="lp-drawer-row" href={v.href}>
              <span class="lp-drawer-ic"><Icon name={v.icon} size={18} /></span>
              <span class="lp-drawer-txt">
                <b>{v.title}</b>
                <i>{v.count}</i>
              </span>
              <svg class="lp-drawer-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 6 15 12 9 18"></polyline></svg>
            </a>
          )) : (
            <p class="lp-level-empty" data-i18n="nav.level.vocabSoon">Wortlisten für dieses Niveau folgen.</p>
          )}
        </div>
      ))}
    </div>

    <!-- Bottom, not top: language, theme and the CTA are where the thumb rests. -->
    <div class="lp-drawer-foot">
      <a href="/uebungen" class="lp-btn lp-btn--primary lp-drawer-cta" data-i18n="nav.cta">Kostenlos üben</a>
      <div class="lp-drawer-utils"><LanguageSwitcher /><ThemeToggle /></div>
    </div>
  </div>
</div>

<noscript>
  <style>
    /* Both menus are click-driven, so with JS off they are dead weight — the plain
       links in .lp-nav-fallback take over at every width. */
    .lp-menubar, .lp-nav-toggle, .lp-drawer { display: none !important; }
    .lp-nav-fallback { display: flex; align-items: center; gap: 20px; font-size: 14px; font-weight: 500; flex-wrap: wrap; }
    .lp-nav-fallback a { color: var(--ink); text-decoration: none; }
  </style>
</noscript>

<script>
  /* Desktop panels ------------------------------------------------------------ */
  const menus = Array.from(document.querySelectorAll<HTMLElement>("[data-menu]"));

  function closeMenus(except?: HTMLElement) {
    for (const m of menus) {
      if (m === except) continue;
      m.querySelector("[data-menu-btn]")?.setAttribute("aria-expanded", "false");
      m.querySelector<HTMLElement>("[data-menu-panel]")?.setAttribute("hidden", "");
      m.classList.remove("is-open");
    }
  }

  // Each subject is a link to its own page first and a menu trigger second: with a
  // mouse, hovering opens the panel and clicking still goes to the section page.
  // Without hover, there is nothing to hover — so the first tap opens the panel
  // instead of navigating, and the panel's own footer link is the way in.
  const canHover = window.matchMedia("(hover: hover)").matches;

  for (const menu of menus) {
    const btn = menu.querySelector<HTMLAnchorElement>("[data-menu-btn]");
    const panel = menu.querySelector<HTMLElement>("[data-menu-panel]");
    if (!btn || !panel) continue;

    const open = () => {
      closeMenus(menu);
      panel.removeAttribute("hidden");
      btn.setAttribute("aria-expanded", "true");
      menu.classList.add("is-open");
    };
    const close = () => {
      panel.setAttribute("hidden", "");
      btn.setAttribute("aria-expanded", "false");
      menu.classList.remove("is-open");
    };

    btn.addEventListener("click", (e) => {
      if (canHover) return; // let the link navigate
      if (!menu.classList.contains("is-open")) {
        e.preventDefault();
        open();
      }
    });
    // Keyboard users never fire pointerenter, so focus opens the panel for them.
    btn.addEventListener("focus", () => { if (canHover) open(); });

    menu.addEventListener("pointerenter", (e) => {
      if (e.pointerType === "mouse") open();
    });
    menu.addEventListener("pointerleave", (e) => {
      if (e.pointerType === "mouse") close();
    });
    menu.addEventListener("focusout", (e) => {
      if (!menu.contains(e.relatedTarget as Node)) close();
    });
  }

  document.addEventListener("click", (e) => {
    if (!(e.target as HTMLElement).closest("[data-menu]")) closeMenus();
  });

  /* Niveaus tiles (desktop) --------------------------------------------------- */
  // Hover switches as well as click: with a mouse, reading across A1…B2 should not
  // cost four clicks. The tiles are real buttons, so keyboard focus switches too.
  const levelTabs = Array.from(document.querySelectorAll<HTMLElement>("[data-level-tab]"));
  const levelViews = Array.from(document.querySelectorAll<HTMLElement>("[data-level-view]"));

  function showLevel(slug: string) {
    for (const tab of levelTabs) {
      const on = tab.dataset.levelTab === slug;
      tab.classList.toggle("is-on", on);
      tab.setAttribute("aria-selected", String(on));
    }
    for (const view of levelViews) {
      if (view.dataset.levelView === slug) view.removeAttribute("hidden");
      else view.setAttribute("hidden", "");
    }
  }

  for (const tab of levelTabs) {
    const slug = tab.dataset.levelTab!;
    tab.addEventListener("click", () => showLevel(slug));
    tab.addEventListener("focus", () => showLevel(slug));
    tab.addEventListener("pointerenter", (e) => {
      if ((e as PointerEvent).pointerType === "mouse") showLevel(slug);
    });
  }

  /* Sub-section tabs (desktop) ------------------------------------------------ */
  // Same behaviour as the Niveaus tiles — hover, click and keyboard focus all switch —
  // but keyed "<section>:<group>" so several tabbed panels can coexist in one nav.
  const groupTabs = Array.from(document.querySelectorAll<HTMLElement>("[data-group-tab]"));
  const groupViews = Array.from(document.querySelectorAll<HTMLElement>("[data-group-view]"));

  function showGroup(key: string) {
    const scope = key.split(":")[0];
    for (const tab of groupTabs) {
      if (tab.dataset.groupScope !== scope) continue;
      const on = tab.dataset.groupTab === key;
      tab.classList.toggle("is-on", on);
      tab.setAttribute("aria-selected", String(on));
    }
    for (const view of groupViews) {
      if (!view.dataset.groupView!.startsWith(scope + ":")) continue;
      if (view.dataset.groupView === key) view.removeAttribute("hidden");
      else view.setAttribute("hidden", "");
    }
  }

  for (const tab of groupTabs) {
    const key = tab.dataset.groupTab!;
    tab.addEventListener("click", () => showGroup(key));
    tab.addEventListener("focus", () => showGroup(key));
    tab.addEventListener("pointerenter", (e) => {
      if ((e as PointerEvent).pointerType === "mouse") showGroup(key);
    });
  }

  /* Mobile drawer ------------------------------------------------------------- */
  const drawer = document.querySelector<HTMLElement>("[data-drawer]");
  const openBtn = document.querySelector<HTMLButtonElement>("[data-drawer-open]");
  const body = drawer?.querySelector<HTMLElement>("[data-drawer-body]");
  const panes = Array.from(drawer?.querySelectorAll<HTMLElement>("[data-pane]") ?? []);

  function showPane(id: string) {
    for (const pane of panes) {
      if (pane.dataset.pane === id) pane.removeAttribute("hidden");
      else pane.setAttribute("hidden", "");
    }
    body?.scrollTo({ top: 0 });
  }

  function openDrawer() {
    if (!drawer) return;
    // Back to the top level, so reopening never resumes inside a level the learner
    // left two taps ago.
    showPane("home");
    drawer.removeAttribute("hidden");
    // Next frame, so the transition has a "closed" state to animate away from.
    requestAnimationFrame(() => drawer.classList.add("is-open"));
    openBtn?.setAttribute("aria-expanded", "true");
    document.body.style.overflow = "hidden";
    drawer.querySelector<HTMLElement>("[data-drawer-close]")?.focus();
  }

  function closeDrawer() {
    if (!drawer) return;
    drawer.classList.remove("is-open");
    openBtn?.setAttribute("aria-expanded", "false");
    document.body.style.overflow = "";
    // Keep it mounted for the slide-out; 240ms matches the transition in site-nav.css.
    window.setTimeout(() => drawer.setAttribute("hidden", ""), 240);
  }

  openBtn?.addEventListener("click", openDrawer);
  for (const el of document.querySelectorAll("[data-drawer-close]")) {
    el.addEventListener("click", closeDrawer);
  }
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && drawer && !drawer.hasAttribute("hidden")) closeDrawer();
  });

  for (const btn of drawer?.querySelectorAll<HTMLElement>("[data-drawer-to]") ?? []) {
    btn.addEventListener("click", () => showPane(btn.dataset.drawerTo!));
  }

  // Navigating away closes it, so the back button never lands on a locked-scroll page.
  drawer?.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).closest("a")) closeDrawer();
  });
</script>
