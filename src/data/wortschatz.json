  { "front": "der Tierarzt / die Tierärztin", "note": "für Haustiere, die krank werden können", "translations": { "en": "vet", "ar": "الطبيب البيطري / الطبيبة البيطرية", "ru": "ветеринар", "tr": "veteriner" } },
