---
// The Lernset navigation that fills the side column on every Wortschatz page.
//
// It IS the dashboard's rail now — nav.css's `.nvb`, variant B, the same stylesheet
// /dashboard loads — rather than a lookalike built out of `.ls-*` classes beside it. The
// lookalike had already drifted: its rows were a bespoke three-column grid, its rail
// buttons were 40px against the dashboard's 42, and its tooltips were a second
// implementation of `.nvb-tip`. Two components meant to be one thing, kept in step by
// hand, stay in step until the first time nobody checks.
//
// What is genuinely ours stays ours, under `ls-*`: the Thema/Reihe switch, the
// collapsible Bereiche and the Portionen blocks are Wortschatz ideas with no dashboard
// counterpart. Everything that exists on both sides — rail, panel, head, rows, overview
// button — is nav.css's.
//
// This component renders only the column's *contents*. The shell — the card, the two
// toggles, the collapse behaviour — lives in VokabelTrainer.astro, the same way a grammar
// topic owns its own .vp-rule-card.
//
// Every row and every count comes from src/lib/lernsets.js, i.e. from the lexicon at build
// time. Nothing here is hand-typed, so a Lernset cannot appear unless its words exist
// (docs/wortschatz-programm-v1.md §3).
import Icon from "./Icon.astro";
import { counts, modules, cohortBlocks, frequencyCounts, portionBlocks, portions } from "../lib/lernsets.js";
import { LEVELS } from "../lib/lexicon.js";
import "../styles/nav.css";
import "../styles/lernset-picker.css";

interface Props {
  /** Deck id of the page this sits on: "redemittel", a level ("a1") or a unit ("a1-04"). */
  current: string;
}
const { current } = Astro.props;

const c = counts();
// A level is offered when it has Lernsets that can actually be opened. C1/C2 have modules
// planned and no words, so they are named at the bottom instead of linked.
const liveLevels = LEVELS.filter((l) => c[l].sets > 0);
const planLevels = LEVELS.filter((l) => c[l].sets === 0 && c[l].plannedModules > 0);

const groupsByLevel = Object.fromEntries(
  liveLevels.map((level) => [
    level,
    // A module with no sets is a plan, not an offering. Once a level has real sets, its
    // empty modules would be fifteen dead rows above the live ones — the summary line
    // under the list says how many are still coming instead.
    modules(level).filter((g) => g.sets.length > 0),
  ])
);

const openLevel = liveLevels.find((l) => current.startsWith(l.toLowerCase())) ?? liveLevels[0];

// A level is 26 to 46 Lernsets, and listing them flat under open headings was a single
// scroll several screens long — the group names went past as captions rather than working
// as a way in. So the groups are collapsible: one open at a time, the rest one line each,
// which puts the whole level's shape on one screen.
//
// Not collapsed when the level has only one group: a lone accordion that is always open
// is a heading wearing a chevron.
const groupsCollapse = (level) => groupsByLevel[level].length > 1;
// The group holding the set you are on, so arriving on /a1-14 opens its Bereich rather
// than the first one and a scroll.
const openGroup = (level) =>
  groupsByLevel[level].find((g) => g.sets.some((set) => set.id === current)) ?? groupsByLevel[level][0];

// The level's own list in the level's own order, twenty at a time — a finer grain of the
// level you already chose, rather than another way of ordering the whole lexicon. Blocks
// of ten, collapsed, for the same reason the Bereiche collapse: B1 is 58 rows.
const isTeil = /-teil-\d+$/.test(current);
const teileByLevel = Object.fromEntries(liveLevels.map((level) => [level, portionBlocks(level)]));
const teileCount = Object.fromEntries(liveLevels.map((level) => [level, portions(level).length]));
const openCut = (level) => (isTeil && current.startsWith(level.toLowerCase()) ? "teile" : "thema");
const openTeilBlock = (level) =>
  teileByLevel[level].find((b) => b.portions.some((t) => t.id === current)) ?? teileByLevel[level][0];

// The other way to cut the same lexicon: by corpus frequency rather than by topic. See
// the long note in src/lib/lernsets.js for why it exists and what it does not claim.
const freq = frequencyCounts();
const blocks = cohortBlocks();
const isFreq = current.startsWith("haeufigkeit-");
const openBlock = isFreq
  ? blocks.find((b) => b.cohorts.some((c) => c.id === current)) ?? blocks[0]
  : blocks[0];
---
<div class="nvb ls-nvb" data-nvb data-current={current}>
  <!-- The fold tab, on the panel's right edge, where a Karteiordner carries its own: the
       list pivots away to the left and the tab stays behind, still attached to the rail,
       so the way back is exactly the thing that put it away. It replaces the chevron that
       used to sit in the panel head — the same act, but a control you can find without
       first reading the head, and one that survives the fold instead of going with it. -->
  <button type="button" class="ls-foldtab" data-nvb-collapse aria-label="Liste einklappen" aria-controls="ls-pane">
    <span class="ls-foldtab-txt">Lernsets</span>
    <svg class="ls-foldtab-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg>
  </button>
  <!-- The rail. A level is its own badge, exactly as on the dashboard; the two entries
       that are not a level get an icon. Weiterlernen and Redemittel are links — they go
       to a page — and the rest are tabs that switch the panel beside them, which is why
       they are different elements rather than one element styled twice. -->
  <div class="nvb-rail" role="tablist" aria-label="Wortschatz-Bereich">
    <!-- The way back, and the reason it is here rather than in the panel head with its
         twin: the head's chevron folds the panel away, and it is *inside* the panel, so
         folding takes the control with it. What was left was a rail of levels and no
         sign that a list had ever been beside it — the way out of a state cannot be
         the state you just left.

         Only one of the two is ever on screen. Both carry data-nvb-collapse, so the same
         handler toggles either way. -->
    <button type="button" class="nvb-railbtn ls-unfold" data-nvb-collapse aria-label="Liste ausklappen">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
      <span class="nvb-tip">Liste ausklappen</span>
    </button>

    <!-- Its pane is written by the script from this browser's own record. Never
         server-rendered: there is no account, so the server cannot know. -->
    <button
      type="button"
      role="tab"
      class="nvb-railbtn"
      data-rail="fortschritt"
      aria-selected="false"
      aria-controls="ls-pane-fortschritt"
      aria-label="Dein Fortschritt"
    >
      <Icon name="target" size={20} />
      <span class="nvb-tip">Dein Fortschritt · Weiterlernen</span>
    </button>

    {liveLevels.map((level) => (
      <button
        type="button"
        role="tab"
        class:list={["nvb-railbtn", !isFreq && level === openLevel && "active"]}
        data-rail={level}
        aria-selected={!isFreq && level === openLevel ? "true" : "false"}
        aria-controls={`ls-pane-${level}`}
        aria-label={`Stufe ${level}`}
      >
        <span class="nvb-railbadge">{level}</span>
        <span class="nvb-tip">Stufe {level} · {c[level].sets} Lernsets</span>
      </button>
    ))}

    <span class="ls-raildiv" aria-hidden="true"></span>

    <button
      type="button"
      role="tab"
      class:list={["nvb-railbtn", isFreq && "active"]}
      data-rail="haeufigkeit"
      aria-selected={isFreq ? "true" : "false"}
      aria-controls="ls-pane-haeufigkeit"
      aria-label="Nach Häufigkeit"
      data-i18n-attr="aria-label:sets.byFrequency"
    >
      <Icon name="bars" size={20} />
      <span class="nvb-tip" data-i18n="sets.byFrequency.tip" data-i18n-vars={JSON.stringify({ n: freq.cohorts })}>Nach Häufigkeit · {freq.cohorts} Portionen</span>
    </button>

    <a
      class="nvb-railbtn"
      href="/uebungen/wortschatz"
      aria-current={current === "redemittel" ? "page" : undefined}
      aria-label="Redemittel"
    >
      <Icon name="volume" size={20} />
      <span class="nvb-tip">Redemittel · Alltag, 4 Sprachen</span>
    </a>
  </div>

  <div class="nvb-panel">
    {liveLevels.map((level) => (
      <div
        class="nvb-section ls-sets"
        id={`ls-pane-${level}`}
        data-pane={level}
        data-level={level}
        hidden={isFreq || level !== openLevel}
      >
        <div class="nvb-panelhead">
          <h3>Stufe {level}<span class="ls-head-where" data-ls-where>{openGroup(level)?.title ? ` · ${openGroup(level).title}` : ""}</span></h3>
          <!-- The dashboard's own fold control, doing the dashboard's own job: the panel
               goes, the rail stays, and a level icon brings it back. A different act from
               "Lernsets ausblenden" in the tab row, which takes the whole column away —
               one trades the list for room, the other trades the whole side. -->
          <button type="button" class="nvb-collapse" data-nvb-collapse aria-label="Liste einklappen">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"/></svg>
          </button>
        </div>

        <!-- Two grains of the same level: the topic a word belongs to, or the place it
             sits in the list. Picking a theme and working straight through are different
             intentions, and neither is a sub-case of the other. -->
        <div class="ls-cuts" role="tablist" aria-label="Einteilung wählen" data-i18n-attr="aria-label:sets.chooseCut">
          <button
            type="button"
            role="tab"
            class:list={["ls-cut", openCut(level) === "thema" && "is-active"]}
            data-cut="thema"
            aria-selected={openCut(level) === "thema" ? "true" : "false"}
          >Nach Thema<span class="ls-cut-n">25er</span></button>
          <button
            type="button"
            role="tab"
            class:list={["ls-cut", openCut(level) === "teile" && "is-active"]}
            data-cut="teile"
            aria-selected={openCut(level) === "teile" ? "true" : "false"}
          >Der Reihe nach<span class="ls-cut-n">20er</span></button>
        </div>

        <div class="ls-cut-panel" data-cut="thema" hidden={openCut(level) !== "thema"}>
          {groupsByLevel[level].map((group) => (
            <section class="ls-group">
              {group.title && (groupsCollapse(level) ? (
                <h4 class="ls-group-head">
                  <button
                    type="button"
                    class:list={["ls-block-toggle", group === openGroup(level) && "is-open"]}
                    data-block={group.id}
                    aria-expanded={group === openGroup(level) ? "true" : "false"}
                    aria-controls={`ls-block-${group.id}`}
                  >{group.title}</button>
                  <span class="ls-group-n">{group.sets.length} Sets</span>
                </h4>
              ) : (
                <h4 class="ls-group-head">{group.title}<span class="ls-group-n">{group.sets.length} Sets</span></h4>
              ))}
              <div
                class="ls-grouplist"
                id={`ls-block-${group.id}`}
                hidden={groupsCollapse(level) && !!group.title && group !== openGroup(level)}
              >
                {group.sets.map((set) => (
                  <a
                    class:list={["nvb-item", set.id === current && "active"]}
                    href={`/uebungen/wortschatz/${set.id}`}
                    aria-current={set.id === current ? "page" : undefined}
                  >
                    <span class="nv-icon ls-num">{set.id.split("-")[1]}</span>
                    <span>{set.title}</span>
                    <span class="nv-count">{set.words}</span>
                  </a>
                ))}
              </div>
            </section>
          ))}
          {c[level].plannedModules > 0 && (
            <p class="ls-plan">
              {c[level].plannedModules} weitere Module sind geplant ({c[level].plannedUnits} Lernsets) —
              die Wörter dafür gibt es noch nicht.
            </p>
          )}
        </div>

        <div class="ls-cut-panel" data-cut="teile" hidden={openCut(level) !== "teile"}>
          <p class="ls-lead">
            Alle {c[level].words} Wörter von {level} der Reihe nach, in {teileCount[level]} Portionen
            zu je 20. Eine Portion läuft quer durch die Themen — darunter steht, durch welche.
          </p>
          {teileByLevel[level].map((block) => (
            <section class="ls-group">
              <h4 class="ls-group-head">
                <button
                  type="button"
                  class:list={["ls-block-toggle", block === openTeilBlock(level) && "is-open"]}
                  data-block={block.id}
                  aria-expanded={block === openTeilBlock(level) ? "true" : "false"}
                  aria-controls={`ls-block-${block.id}`}
                >{block.title}</button>
                <span class="ls-group-n">{block.words}</span>
              </h4>
              <div class="ls-grouplist" id={`ls-block-${block.id}`} hidden={block !== openTeilBlock(level)}>
                {block.portions.map((teil) => (
                  <a
                    class:list={["nvb-item", "ls-item--teil", teil.id === current && "active"]}
                    href={`/uebungen/wortschatz/${teil.id}`}
                    aria-current={teil.id === current ? "page" : undefined}
                  >
                    <span class="nv-icon ls-num">{teil.index}</span>
                    <span>
                      {teil.from}-{teil.to}
                      <span class="ls-item-sub">{teil.topics.join(" · ")}</span>
                    </span>
                    <span class="nv-count">{teil.words}</span>
                  </a>
                ))}
              </div>
            </section>
          ))}
        </div>
      </div>
    ))}

    <!-- Everything inside is written by the script: it all comes from localStorage, so a
         server-rendered number here would be a guess about a stranger. -->
    <div class="nvb-section ls-prog" id="ls-pane-fortschritt" data-pane="fortschritt" hidden>
      <div class="nvb-panelhead">
        <h3>Dein Fortschritt <span class="ls-head-where">· Wortschatz</span></h3>
      </div>
      <div data-ls-prog></div>
    </div>

    <div class="nvb-section" id="ls-pane-haeufigkeit" data-pane="haeufigkeit" hidden={!isFreq}>
      <div class="nvb-panelhead">
        {/* The heading's own words sit in a span of their own: data-i18n replaces
            textContent, which would take the "· <block>" suffix with it. */}
        <h3><span data-i18n="sets.byFrequency">Nach Häufigkeit</span><span class="ls-head-where" data-ls-where>{openBlock?.title ? ` · ${openBlock.title}` : ""}</span></h3>
        <button type="button" class="nvb-collapse" data-nvb-collapse aria-label="Liste einklappen" data-i18n-attr="aria-label:sets.collapseList">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"/></svg>
        </button>
      </div>
      <p class="ls-lead" data-i18n="sets.byFrequency.lead" data-i18n-vars={JSON.stringify({ n: freq.words, c: freq.cohorts, s: freq.size })}>
        {freq.words} Wörter nach Korpushäufigkeit, in {freq.cohorts} Portionen zu je {freq.size}.
        Gemischt — Verben, Nomen und Funktionswörter zusammen, so wie sie in der Liste stehen.
      </p>

      {blocks.map((block) => (
        <section class="ls-group">
          <h4 class="ls-group-head">
            <button
              type="button"
              class:list={["ls-block-toggle", block === openBlock && "is-open"]}
              data-block={block.id}
              aria-expanded={block === openBlock ? "true" : "false"}
              aria-controls={`ls-block-${block.id}`}
            >{block.title}</button>
            <span class="ls-group-n">{block.words}</span>
          </h4>
          <div class="ls-grouplist" id={`ls-block-${block.id}`} hidden={block !== openBlock}>
            {block.cohorts.map((co) => (
              <a
                class:list={["nvb-item", co.id === current && "active"]}
                href={`/uebungen/wortschatz/${co.id}`}
                aria-current={co.id === current ? "page" : undefined}
              >
                <span class="nv-icon ls-num">{co.index}</span>
                <span>{co.from}-{co.to}</span>
                <span class="nv-count">{co.levels.join("·")}</span>
              </a>
            ))}
          </div>
        </section>
      ))}

      <!-- Said out loud rather than quietly dropped. The frequency source is a wordform
           list, so a compound like "Ausländerbehörde" comes back unmatched because of how
           it is written, not because it is rare — calling those words "selten" would be a
           claim the data does not support. -->
      <p class="ls-plan">
        {freq.unranked} Wörter stehen nicht in der Häufigkeitsliste — meist Komposita, die dort
        als Wortform nicht vorkommen. Das heißt nicht, dass sie selten sind; sie stehen in
        ihrem Lernset unter ihrer Stufe.
      </p>
      {planLevels.length > 0 && (
        <p class="ls-plan">
          {planLevels.join(" und ")}: {planLevels.reduce((n, l) => n + c[l].plannedModules, 0)} Module
          geplant, noch keine Wörter. Die Einstufung ist an A1–C2 orientiert, nicht die
          offizielle Goethe-/telc-Liste.
        </p>
      )}
    </div>
  </div>
</div>

<script>
  import { getResume, getProgress } from "../lib/progress.js";
  import { slide, replay } from "../lib/fold.js";

  const root = document.querySelector(".ls-nvb");
  const FOLD_KEY = "da-wortschatz-lernsets-fold";

  // ── Fold: the panel goes, the rail stays ──────────────────────────────────────
  // Distinct from the column's own collapse, which takes rail and all. This is the
  // dashboard's `collapsed` class; the width animation that goes with it lives in
  // lernset-picker.css, because nav.css expresses the fold as `display: none` on the
  // panel and display cannot tween.
  //
  // The page is told as well as the picker: the grid track the column sits in is sized
  // from --rule-w, and a panel that shrank inside a track that did not would just leave a
  // hole where it used to be. .vt-split reads [data-fold] for that.
  const page = document.getElementById("vp-page");
  const foldBtns = () => [...root.querySelectorAll("[data-nvb-collapse]")];
  function setFold(on, persist = true) {
    root.classList.toggle("collapsed", on);
    if (page) page.dataset.fold = on ? "1" : "";
    foldBtns().forEach((b) => {
      b.setAttribute("aria-expanded", on ? "false" : "true");
      b.setAttribute("aria-label", on ? "Liste ausklappen" : "Liste einklappen");
    });
    if (persist) { try { localStorage.setItem(FOLD_KEY, on ? "1" : "0"); } catch {} }
  }

  let folded = false;
  try { folded = localStorage.getItem(FOLD_KEY) === "1"; } catch {}
  // Restored without animating: the slide is feedback for an action, and nobody took one.
  root.classList.add("no-anim");
  setFold(folded, false);
  requestAnimationFrame(() => requestAnimationFrame(() => root.classList.remove("no-anim")));

  foldBtns().forEach((b) =>
    b.addEventListener("click", (e) => {
      e.stopPropagation();
      setFold(!root.classList.contains("collapsed"));
    }));

  // ── The rail ──────────────────────────────────────────────────────────────────
  // One handler for the whole rail: A1–B2 and "Nach Häufigkeit" are five views of the
  // same lexicon, not a level switch nested inside a mode switch.
  // Asking for the picker is asking for the list. The fold is remembered per browser, so
  // without this "Lernset wechseln" could open a sheet showing only the level rail — the
  // one thing the learner did not tap for. Not persisted: it answers this opening, it
  // does not overwrite the preference the fold button set.
  if (page) {
    new MutationObserver(() => {
      if (page.dataset.rule !== "hidden" && root.classList.contains("collapsed")) setFold(false, false);
    }).observe(page, { attributes: true, attributeFilter: ["data-rule"] });
  }

  root.querySelectorAll("[data-rail]").forEach((tab) => {
    tab.addEventListener("click", () => {
      const pane = tab.dataset.rail;
      root.querySelectorAll("[data-rail]").forEach((t) => {
        const on = t === tab;
        t.classList.toggle("active", on);
        t.setAttribute("aria-selected", String(on));
      });
      root.querySelectorAll(".nvb-section").forEach((p) => { p.hidden = p.dataset.pane !== pane; });
      // Pressing a rail icon is a request to see that list. Answering it by switching a
      // panel nobody can see is not an answer, so a folded picker unfolds.
      if (root.classList.contains("collapsed")) setFold(false);
      // The dashboard's own arrival stagger, replayed so that switching level reads as
      // the panel being replaced rather than quietly re-labelled.
      const sec = root.querySelector(`.nvb-section[data-pane="${pane}"]`);
      if (sec) {
        sec.classList.remove("nvb-section--enter");
        void sec.offsetWidth;
        sec.classList.add("nvb-section--enter");
      }
    });
  });

  const motionOk = () => !matchMedia("(prefers-reduced-motion: reduce)").matches;

  /** The nearest ancestor that actually scrolls: .nvb-panel on a desktop, the sheet body
   *  on a phone — the picker gives its own scroll up inside the sheet. */
  function scrollerOf(el) {
    for (let n = el?.parentElement; n; n = n.parentElement) {
      const oy = getComputedStyle(n).overflowY;
      if ((oy === "auto" || oy === "scroll") && n.scrollHeight > n.clientHeight + 1) return n;
    }
    return null;
  }

  // ── Groups ────────────────────────────────────────────────────────────────────
  // One open at a time: 123 cohorts listed flat is a scroll, not a menu. Scoped to the
  // list the button sits in — the Bereiche, the Portionen blocks and the frequency blocks
  // are separate lists and must not close each other.
  root.querySelectorAll(".ls-block-toggle").forEach((btn) => {
    btn.addEventListener("click", () => {
      const scope = btn.closest(".ls-cut-panel") ?? btn.closest(".nvb-section") ?? root;
      const panel = document.getElementById(`ls-block-${btn.dataset.block}`);
      const open = panel.hidden;
      // The same pivot as the exam rail on /fortschritt: the one that was open slides
      // shut while this one slides open, and its rows arrive staggered — so the two
      // movements read as one list being replaced rather than as the page jumping.
      scope.querySelectorAll(".ls-block-toggle").forEach((b) => {
        if (b === btn && open) return;
        const other = document.getElementById(`ls-block-${b.dataset.block}`);
        b.classList.remove("is-open");
        b.setAttribute("aria-expanded", "false");
        if (!other.hidden) slide(other, false);
      });
      if (open) {
        btn.classList.add("is-open");
        btn.setAttribute("aria-expanded", "true");
        slide(panel, true);
        replay(panel, "ls-grouplist--enter");
        // Opening a block near the bottom of the list unfolds it below the fold: the
        // rows are there, the learner sees nothing move. So once the height has landed,
        // the block's own head is pulled to the top of whatever is scrolling — the panel
        // on a desktop, the sheet body on a phone — and its rows come with it.
        const group = btn.closest(".ls-group");
        const scroller = scrollerOf(group);
        if (group && scroller) {
          setTimeout(() => {
            const top = group.getBoundingClientRect().top - scroller.getBoundingClientRect().top + scroller.scrollTop;
            scroller.scrollTo({ top: Math.max(0, top - 8), behavior: motionOk() ? "smooth" : "auto" });
          }, 260);
        }
      }
      // The panel head names the open group — the rail then says where you are
      // ("Stufe A1 · Wohnen") without a breadcrumb above the list. Closing the last
      // open group empties it rather than leaving a stale name.
      const where = btn.closest(".nvb-section")?.querySelector("[data-ls-where]");
      if (where) where.textContent = open ? ` · ${btn.textContent.trim()}` : "";
    });
  });

  // ── Thema / Der Reihe nach, per level ─────────────────────────────────────────
  root.querySelectorAll(".ls-cut").forEach((tab) => {
    tab.addEventListener("click", () => {
      const scope = tab.closest(".ls-sets");
      scope.querySelectorAll(".ls-cut").forEach((t) => {
        const on = t === tab;
        t.classList.toggle("is-active", on);
        t.setAttribute("aria-selected", String(on));
      });
      scope.querySelectorAll(".ls-cut-panel").forEach((pnl) => {
        pnl.hidden = pnl.dataset.cut !== tab.dataset.cut;
        // Thema and Reihe are two cuts of one level, so switching them gets the same
        // arrival as opening a group — the list is replaced, not redrawn.
        if (!pnl.hidden) replay(pnl, "ls-cut-panel--enter");
      });
    });
  });

  // ── Dein Fortschritt ──────────────────────────────────────────────────────────
  // The same question /dashboard answers, asked about this one tool: what have I done
  // here, and where do I carry on? Every number is read from progress.js, which only ever
  // writes from a real graded answer — so a first visit says "noch nichts" rather than
  // drawing an empty ring and calling it 0 %.
  const esc = (t) => String(t ?? "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));

  function progressHtml() {
    const resume = getResume();
    const data = getProgress();
    const here = location.pathname.replace(/\/+$/, "");
    const mine = (resume ? [resume.last, ...resume.recents] : []).filter(
      (r) => r && r.path.startsWith("/uebungen/wortschatz")
    );
    const next = mine.find((r) => r.path !== here);
    const words = (data.vocabMastered || []).filter((k) => k.startsWith("wortschatz:")).length;
    const skill = data.skills?.wortschatz ?? { attempts: 0, sessions: 0 };
    const week = resume?.week ?? { count: 0, goal: 0 };
    const pct = week.goal ? Math.min(100, Math.round((week.count / week.goal) * 100)) : 0;

    if (!words && !skill.attempts && !mine.length) {
      return `<p class="ls-lead">Noch nichts geübt. Sobald du Karten umdrehst, steht hier,
        wie viele Wörter du schon kannst und wo du weitermachst.</p>`;
    }

    return `
      ${next ? `<a class="ls-prog-next" href="${esc(next.path)}">
        <span class="ls-prog-next-label">Weiterlernen</span>
        <b>${esc(next.title)}</b>
        <span class="ls-prog-next-go">Öffnen →</span>
      </a>` : ""}

      <div class="ls-prog-stats">
        <div class="ls-prog-stat"><b>${words}</b><i>Wörter gekonnt</i></div>
        <div class="ls-prog-stat"><b>${skill.attempts}</b><i>Karten geprüft</i></div>
        <div class="ls-prog-stat"><b>${data.streak || 0}</b><i>Tage in Folge</i></div>
      </div>

      ${week.goal ? `<div class="ls-prog-week">
        <p><span>Diese Woche</span><span>${week.count} / ${week.goal}</span></p>
        <span class="ls-prog-bar"><span style="width:${pct}%"></span></span>
      </div>` : ""}

      ${mine.length ? `<p class="ls-group-head ls-prog-head">Zuletzt geübt</p>
      <div class="ls-grouplist">${mine
        .slice(0, 4)
        .map((r) => `<a class="nvb-item${r.path === here ? " active" : ""}" href="${esc(r.path)}">
          <span class="nv-icon ls-prog-dot"></span><span>${esc(r.title)}</span>
        </a>`)
        .join("")}</div>` : ""}

      <a class="ls-prog-more" href="/fortschritt">Alles im Fortschritt ansehen &rarr;</a>`;
  }

  const progEl = root.querySelector("[data-ls-prog]");
  if (progEl) progEl.innerHTML = progressHtml();
</script>
