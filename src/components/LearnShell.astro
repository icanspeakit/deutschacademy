---
// /nav — navigation test bed. Takes the "list on the left" shell from the
// Pflegeplace dashboard (sticky step list + grouped sections + content pane)
// and tries three ways of doing it, swapped by the toggle in the top bar:
//
//   A · Rail      — one flat column, everything visible at once.
//   B · Icon-Rail — a 64px level column plus a list panel.  ← the favoured one
//   C · Akkordeon — folding groups, each header carrying its own progress.
//
// All three are driven by the SAME `sections` array below, so the comparison is
// only ever about the layout. The order of that array is the information
// architecture: items are sorted by CEFR level (A1 → A2 → B1 → B2), not by tool
// type, with the current course path pinned above it and the exams — which are
// targets rather than a level — kept in their own group at the end.
//
// THREE CONTENT VIEWS. Picking a Stufe shows that level's OVERVIEW (own hero,
// own ring, own content table). Picking an entry shows the ITEM view. And a
// grammar entry ALSO mounts the real exercise inline — the same mountQuiz() the
// live /uebungen/grammatik pages use — so you can answer questions without ever
// leaving the shell, and watch the ring, the level bar and the strip move while
// you do. That is the open question this page exists to answer: can a learner
// stay in this view, or does practice need its own page?
//
// LEVELS: grammatik.json carries a real `level` per topic (source: "data").
// The other exercise data files have no level field, so those entries are
// derived from what the exercise itself contains (source: "abgeleitet") and are
// the ones to correct first. When this concept graduates, the derived levels
// should move into the data files rather than living in this page.
//
// NUMBERS: `tasks` counts are real, from the same data files the live pages use.
// `done` values are mock (nobody is logged in here) but every percentage on the
// page is computed from them, so the strip, the rings, the bars and the tables
// can never contradict each other — and correct answers in the inline quiz feed
// straight back into the same numbers. `minutes` are rough estimates, always
// shown with "ca.". Not linked from the public nav; noindex.
import Icon from "./Icon.astro";

// The workspace styles the inline rule card and the five exercise widgets need.
// Both files are fully class-scoped (.vp-*, .quiz-*) — no bare element selectors —
// so they cannot leak into the .nv shell.
import "../styles/practice.css";
import "../styles/akkusativ.css";
import "../styles/dtz.css";
import "../styles/verben-praepositionen.css";
import "../styles/nav.css";
import artikel from "../data/artikel.json";
import { nouns } from "../lib/lexicon.js";
import grammatik from "../data/grammatik.json";
import wortschatz from "../data/wortschatz.json";
import sprechen from "../data/sprechen.json";
import lesen from "../data/lesen.json";
import kultur from "../data/kultur.json";
import lid from "../data/leben-in-deutschland.json";

const readingQuestionCount = lesen.groups.reduce((sum, g) => sum + g.questions.length, 0);
const ausspracheWordCount = wortschatz.length + artikel.length;
const byLevel = (level: string) => grammatik.filter((t) => t.level === level);

type IconName = "target" | "book" | "book-open" | "folder" | "volume" | "mic" | "pencil" | "map-pin" | "sparkle" | "document" | "landmark" | "graduation-cap";

type Item = {
  id: string;
  label: string;
  icon: IconName;
  href: string;
  level: string;
  levelSource: "data" | "abgeleitet" | "—";
  eyebrow: string;
  lead: string;
  tasks?: number;
  done?: number;
  minutes?: number;
  meta?: string;
  // "quiz"      — a single Lückentext from grammatik.json
  // "workspace" — the full rule card plus four or five exercises
  // "trainer" — the real Artikel-Trainer (practiceWorkspace.js)
  // Every kind of inline exercise /nav can mount. "info" means the row really
  // has nothing to practise (an overview, an exam description).
  practice?: "quiz" | "workspace" | "trainer" | "choice" | "cards" | "audio" | "speak" | "read" | "dtz" | "picker" | "result" | "bausteine";
  // Aggregate rows (the course modules) are the sum of other rows, so practising
  // a single topic has to move them too — otherwise the course strip sits still
  // while the level bar climbs, and the page contradicts itself.
  derived?: string[];
};

type Section = {
  id: string;
  label: string;
  badge: string;
  icon: IconName;
  kind: "kurs" | "stufe" | "ziel";
  blurb: string;
  focus: string[];
  items: Item[];
};

// Nothing is pre-filled. Every number on this page starts at zero and is filled
// in on the client from what the learner has actually answered, via
// getTopicProgress() in src/lib/progress.js. The server render is the empty state.
const doneOf = (_id: string) => 0;

// ── The Artikel-Trainer, embedded ────────────────────────────────────────
// Same pool and same question shape as /uebungen/artikel-trainer, driven by the
// same practiceWorkspace.js. The live page ships the whole ~860-noun lexicon;
// this study page caps it at PER_LEVEL per level, which is still several rounds
// deep and keeps the HTML from doubling.
const ARTIKEL_SESSION = 25;
const ARTIKEL_PER_LEVEL = 60;

function explainArtikel(word: string, gender: string) {
  const lower = word.toLowerCase();
  if (lower.endsWith("in")) return "Die Endung -in kennzeichnet die weibliche Form — solche Wörter sind feminin.";
  if (lower.endsWith("chen") || lower.endsWith("lein")) return "Verkleinerungsformen auf -chen oder -lein sind immer neutrum.";
  if (lower.endsWith("e")) return "Viele zweisilbige Wörter auf -e sind feminin (z. B. Tasche, Sonne, Katze).";
  if (lower.endsWith("er")) return "Viele Wörter auf -er — Werkzeuge, Geräte, männliche Personen — sind maskulin.";
  if (lower.endsWith("el")) return "Viele Wörter auf -el sind maskulin (z. B. Schlüssel, Apfel).";
  return `Für „${word}" gibt es keine feste Regel — der Artikel wird mit dem Wort zusammen gelernt.`;
}

const artikelQuestion = (n: any) => ({
  id: n.id,
  level: n.level,
  prompt: `___ ${n.lemma}?`,
  options: ["der", "die", "das"],
  answer: n.gender,
  explain: explainArtikel(n.lemma, n.gender),
  change: `${n.gender} ${n.lemma}`,
});

const ARTIKEL_POOL = [
  ...nouns({ level: "A1", has: "gender" }).slice(0, ARTIKEL_PER_LEVEL),
  ...nouns({ level: "A2", has: "gender" }).slice(0, ARTIKEL_PER_LEVEL),
].map(artikelQuestion);

const ARTIKEL_LEVELS = [
  { key: "A1", label: "A1", count: ARTIKEL_POOL.filter((q) => q.level === "A1").length },
  { key: "A2", label: "A2", count: ARTIKEL_POOL.filter((q) => q.level === "A2").length },
  { key: "all", label: "Alle", count: ARTIKEL_POOL.length },
];

const grammarItem = (t: (typeof grammatik)[number], level: string): Item => ({
  id: t.id,
  label: t.name,
  icon: "book",
  href: `/uebungen/grammatik/${t.id}`,
  level,
  levelSource: "data",
  eyebrow: `Grammatik · ${level}`,
  lead: t.intro,
  tasks: t.questions.length,
  done: doneOf(t.id),
  minutes: Math.round(t.questions.length * 1.5),
  practice: "quiz",
});

// ── The full grammar workspaces ──────────────────────────────────────────
// src/data/grammatik/*.json each describe a complete Kursbuchseite: the
// "Wie funktioniert das?" rule card plus four or five exercises. The live
// /uebungen/grammatik/<topic> route renders exactly these. Here they are
// globbed for their metadata only — the JSON itself is loaded lazily in the
// browser, one topic at a time, so this page does not ship all 180 KB of them.
const workspaceMods = import.meta.glob("../data/grammatik/*.json", { eager: true });
const workspaces = Object.values(workspaceMods).map((m: any) => m.default ?? m);

// One "Slot" is one thing the learner has to get right, counted the same way
// the five exercise renderers in grammarWorkspace.js consume their data.
const slotsOf = (ex: any): number => {
  if (ex.type === "fill") return ex.items.length;
  if (ex.type === "match") return ex.pairs.length;
  if (ex.type === "table") return ex.rows.length;
  if (ex.type === "story") return ex.segments.filter((s: any) => s.blank !== undefined).length;
  if (ex.type === "build") return ex.sentences.length;
  return 0;
};
const workspaceSlots = (w: any) => (w.exercises ?? []).reduce((a: number, e: any) => a + slotsOf(e), 0);

const workspaceItem = (w: any): Item => {
  const id = w.slug ?? w.id;
  const tasks = workspaceSlots(w);
  return {
    id,
    label: w.name,
    icon: "book-open",
    href: `/uebungen/grammatik/${id}`,
    level: w.level,
    levelSource: "data",
    eyebrow: `Grammatik · ${w.level}`,
    lead: w.subtitle ?? "",
    tasks,
    done: doneOf(id),
    minutes: Math.max(8, Math.round(tasks * 0.8)),
    practice: "workspace",
  };
};

// A workspace always beats a bare quiz topic of the same id — same rule the
// live [id].astro route uses, so /nav never offers a thinner version of a page
// that already exists in full.
const workspaceIds = new Set(workspaces.flatMap((w: any) => [w.id, w.slug].filter(Boolean)));
const workspacesAt = (level: string) =>
  workspaces.filter((w: any) => w.level === level).sort((a: any, b: any) => a.name.localeCompare(b.name, "de")).map(workspaceItem);
const quizTopicsAt = (level: string) =>
  byLevel(level).filter((t) => !workspaceIds.has(t.id)).map((t) => grammarItem(t, level));
const grammarAt = (level: string) => [...workspacesAt(level), ...quizTopicsAt(level)];

// ── The exercise that sits on every overview ─────────────────────────────
// Each Stufenübersicht carries one ready-to-use exercise directly under the top
// card, so /nav always has something to actually do without drilling into a
// topic first. Preference: that level's first workspace, and within it the first
// "fill" exercise (the most self-explanatory of the five widgets).
const workspaceById = Object.fromEntries(workspaces.map((w: any) => [w.slug ?? w.id, w]));
const quickIndexOf = (w: any) => {
  const i = (w.exercises ?? []).findIndex((e: any) => e.type === "fill");
  return i >= 0 ? i : 0;
};
const quickFor = (items: Item[], fallbackId: string) => {
  // A1 and the course get the Artikel-Trainer itself — it is the most
  // immediately usable thing on the site and needs no rule read first.
  if (items.some((i) => i.practice === "trainer")) {
    return { kind: "trainer" as const, topicId: "artikel-trainer", topicLabel: "der/die/das-Trainer", level: "A1", index: 0, title: "der, die oder das?", hint: "Wähle den passenden Artikel — Fokus- oder Testmodus." };
  }
  const item = items.find((i) => i.practice === "workspace");
  const id = item ? item.id : fallbackId;
  const w = workspaceById[id];
  if (!w) return null;
  const idx = quickIndexOf(w);
  const ex = w.exercises[idx];
  return { kind: "workspace" as const, topicId: id, topicLabel: w.name, level: w.level, index: idx, title: ex.title, hint: ex.hint ?? "" };
};

// Every grammar entry, in one list — the course module "Grammatik-Basis" is
// their sum, so practising any single topic moves the course strip too.
const allGrammarItems = ["A1", "A2", "B1", "B2"].flatMap(grammarAt);
const allGrammarIds = allGrammarItems.map((i) => i.id);
const allGrammarTasks = allGrammarItems.reduce((a, i) => a + (i.tasks ?? 0), 0);
const allGrammarDone = allGrammarItems.reduce((a, i) => a + (i.done ?? 0), 0);
const allGrammarMinutes = allGrammarItems.reduce((a, i) => a + (i.minutes ?? 0), 0);

const sections: Section[] = [
