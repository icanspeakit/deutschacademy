    focus: ["Format und Dauer", "Was zum Bestehen reicht", "Welche Prüfung zu welchem Ziel passt"],
    items: [
      { id: "dtz", label: "DTZ", icon: "document", href: "/pruefungen/dtz", level: "A2/B1", levelSource: "data", eyebrow: "Prüfung", lead: "Deutsch-Test für Zuwanderer: Hören, Lesen, Schreiben, Sprechen — 45 bewertete Aufgaben plus Schreibteil.", tasks: 45, done: 0, minutes: 54, practice: "dtz" },
      { id: "lid", label: "Leben in Deutschland", icon: "map-pin", href: "/pruefungen/leben-in-deutschland", level: "kein GER", levelSource: "data", eyebrow: "Prüfung", lead: `33 Fragen aus dem offiziellen Katalog, dazu die Landesfragen aller ${lid.bundeslaender.length} Bundesländer — Wissenstest, keine Sprachprüfung.`, tasks: lid.questions.length, done: 0, minutes: 20, practice: "choice" },
      { id: "telc", label: "telc", icon: "document", href: "/pruefungen/telc", level: "A1–C2", levelSource: "data", eyebrow: "Prüfung", lead: "Sprachbausteine — der Prüfungsteil, den es so nur bei telc gibt: Grammatik im laufenden Text.", tasks: 20, done: 0, minutes: 20, practice: "bausteine" },
      { id: "goethe", label: "Goethe-Zertifikat", icon: "landmark", href: "/pruefungen/goethe", level: "A1–C2", levelSource: "data", eyebrow: "Prüfung", lead: "Die Goethe-Zertifikate decken A1 bis C2 ab — hier alle Themen, nach Stufe sortiert.", meta: "A1–C2", practice: "picker" },
      { id: "testdaf", label: "TestDaF", icon: "graduation-cap", href: "/pruefungen/testdaf", level: "B2–C1", levelSource: "data", eyebrow: "Prüfung", lead: "TestDaF setzt B2–C1 voraus — hier die Themen dieser Stufen.", meta: "B2–C1", practice: "picker" },
    ],
  },
];

// Everything below is derived — no percentage is typed by hand.
const sum = (ns: number[]) => ns.reduce((a, b) => a + b, 0);
const stats = (s: Section) => {
  const counted = s.items.filter((i) => typeof i.tasks === "number");
  const tasks = sum(counted.map((i) => i.tasks!));
  const done = sum(counted.map((i) => i.done ?? 0));
  return { tasks, done, minutes: sum(s.items.map((i) => i.minutes ?? 0)), pct: tasks ? Math.round((done / tasks) * 100) : null };
};
const sectionStats = Object.fromEntries(sections.map((s) => [s.id, stats(s)]));
// "artikel" is the fallback for the groups with no grammar of their own
// (Dein Weg, Alle Stufen, Prüfungen) — A1, concrete, and nobody is too advanced
// to benefit from a der/die/das drill.
// Which groups get the Artikel-Trainer as their exercise rather than a grammar
// workspace: the landing view and A1, plus the two groups with no grammar of
// their own — nobody is too advanced for a der/die/das drill.
const TRAINER_SECTIONS = new Set(["weg", "a1", "alle", "pruefungen"]);
const sectionQuick = Object.fromEntries(sections.map((s) => [
  s.id,
  TRAINER_SECTIONS.has(s.id)
    ? quickFor([{ practice: "trainer" } as Item], "artikel")
    : quickFor(s.items, "artikel"),
]));
const itemPct = (i: Item) => (i.tasks ? Math.round(((i.done ?? 0) / i.tasks) * 100) : null);
const sectionOf = Object.fromEntries(sections.flatMap((s) => s.items.map((i) => [i.id, s])));
const courseStats = sectionStats.weg;

const ladder = ["a1", "a2", "b1", "b2"].map((id) => {
  const s = sections.find((x) => x.id === id)!;
  const p = sectionStats[id].pct ?? 0;
  return { id, label: s.badge, state: p === 100 ? "done" : p > 0 ? "current" : "todo" };
});

// Handed to the client: one flat item table plus the questions for every topic
// that can be practised inline.
const clientData = {
  items: Object.fromEntries(sections.flatMap((s) => s.items.map((i) => [i.id, {
    label: i.label, eyebrow: i.eyebrow, lead: i.lead, href: i.href,
    level: i.level, levelSource: i.levelSource,
    tasks: i.tasks ?? null, done: i.done ?? 0, minutes: i.minutes ?? null,
    practice: i.practice ?? null, derived: i.derived ?? null,
    section: sectionOf[i.id].id, sectionLabel: sectionOf[i.id].label,
  }]))),
  sections: Object.fromEntries(sections.map((s) => [s.id, { label: s.label, items: s.items.map((i) => i.id) }])),
  // Which coarse skill bucket each kind of exercise reports into, so /uebungen's
  // existing per-skill stats keep working alongside the per-topic numbers.
  skillOf: Object.fromEntries(sections.flatMap((s) => s.items.map((i) => [i.id,
    i.practice === "cards" ? "wortschatz"
    : i.practice === "audio" ? "hoeren"
    : i.practice === "speak" ? "sprechen"
    : i.practice === "choice" || i.practice === "read" ? "lesen"
    : i.practice === "dtz" || i.practice === "bausteine" ? "pruefungen"
    : "grammatik"]))),
  topics: Object.fromEntries(grammatik.map((t) => [t.id, { name: t.name, intro: t.intro, questions: t.questions }])),
  // Content for the non-grammar exercises. All real, from the same files the
  // live pages read; the DTZ Übungssatz is the only one loaded lazily.
  choice: {
    lesen: lesen.groups.map((g) => ({ id: g.id, title: g.title, level: g.level, text: g.text, questions: g.questions })),
