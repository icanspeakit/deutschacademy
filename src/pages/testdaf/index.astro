---
import Layout from "../../layouts/Layout.astro";
import ExamShell from "../../components/ExamShell.astro";
import ExamPractice from "../../components/ExamPractice.astro";
---
<Layout
  title="TestDaF – DeutschAcademy"
  description="TestDaF (TDN 3–5): der Sprachnachweis für ein Hochschulstudium in Deutschland — Aufbau, Bewertung und Übungen."
>
  <ExamShell
    header="TestDaF"
    title="TestDaF"
    lead="Test Deutsch als Fremdsprache — der Standardnachweis für ein Hochschulstudium in Deutschland."
    leadKey="testdaf.lead"
    badges={["≈ B2–C1"]}
    practiceHeading="Für TestDaF üben"
    practiceHeadingKey="testdaf.practiceHeading"
  >
    <Fragment slot="info">
      <section class="exam-section">
        <h2 data-i18n="testdaf.who.title">Für wen ist TestDaF?</h2>
        <div class="exam-meta-row">
          <span class="exam-meta-badge" data-i18n="testdaf.who.badge.result">Ergebnis: TDN 3–5 (≈ B2–C1)</span>
          <span class="exam-meta-badge" data-i18n="testdaf.who.badge.oneFormat">Ein Prüfungsformat</span>
        </div>
        <p data-i18n="testdaf.who.text">
          TestDaF richtet sich vor allem an internationale Studieninteressierte: Das Ergebnis ist der
          gängige Sprachnachweis für die Zulassung an deutschen Hochschulen. Anders als Goethe oder telc
          gibt es kein "Niveau, das man bucht" — alle Teilnehmenden schreiben dieselbe Prüfung, und jede
          der vier Fertigkeiten wird einzeln mit einer TestDaF-Niveaustufe (TDN 3, 4 oder 5) bewertet.
        </p>
      </section>

      <section class="exam-section">
        <h2 data-i18n="exam.skills.title">Geprüfte Fertigkeiten</h2>
        <div class="skill-grid">
          <div class="skill-card"><div class="skill-card-icon">📖</div><h4 data-i18n="skill.lesen">Lesen</h4><p data-i18n="skill.lesen.desc">Leseverstehen</p></div>
          <div class="skill-card"><div class="skill-card-icon">🎧</div><h4 data-i18n="skill.hoeren">Hören</h4><p data-i18n="skill.hoeren.desc">Hörverstehen</p></div>
          <div class="skill-card"><div class="skill-card-icon">✍️</div><h4 data-i18n="skill.schreiben">Schreiben</h4><p data-i18n="skill.schreiben.desc">Schriftlicher Ausdruck</p></div>
          <div class="skill-card"><div class="skill-card-icon">🗣️</div><h4 data-i18n="skill.sprechen">Sprechen</h4><p data-i18n="skill.sprechen.oralDesc">Mündlicher Ausdruck</p></div>
        </div>
      </section>

      <section class="exam-section">
        <!-- GENERIC FORMAT INFO: no deutschacademy source material for this exam yet -->
        <h2 data-i18n="exam.format.title">Format</h2>
        <div class="format-table-wrap">
          <table class="format-table">
            <thead><tr><th data-i18n="format.th.part">Teil</th><th data-i18n="format.th.what">Was wird geprüft</th><th data-i18n="format.th.duration">Dauer (ca.)</th></tr></thead>
            <tbody>
              <tr><td data-i18n="skill.lesen.desc">Leseverstehen</td><td data-i18n="testdaf.fmt.lesen.what">Textverständnis, mehrere Texte</td><td data-i18n="testdaf.fmt.min60">ca. 60 Min.</td></tr>
              <tr><td data-i18n="skill.hoeren.desc">Hörverstehen</td><td data-i18n="testdaf.fmt.hoeren.what">Gesprächs- und Vortragsverständnis</td><td data-i18n="testdaf.fmt.min40">ca. 40 Min.</td></tr>
              <tr><td data-i18n="skill.schreiben.desc">Schriftlicher Ausdruck</td><td data-i18n="testdaf.fmt.schreiben.what">Ein zusammenhängender Text zu einer Grafik/Statistik</td><td data-i18n="testdaf.fmt.min60">ca. 60 Min.</td></tr>
              <tr><td data-i18n="skill.sprechen.oralDesc">Mündlicher Ausdruck</td><td data-i18n="testdaf.fmt.sprechen.what">Kurze gesprochene Antworten, meist aufgezeichnet</td><td data-i18n="testdaf.fmt.min35">ca. 35 Min.</td></tr>
            </tbody>
          </table>
        </div>
        <p class="format-note" data-i18n="testdaf.format.note">
          Es gibt keine einfache Bestehensgrenze in Prozent — jede Fertigkeit wird separat als TDN 3, 4
          oder 5 eingestuft, und Hochschulen legen selbst fest, welche Kombination sie verlangen. Es liegt
          uns kein eigenes TestDaF-Quellmaterial vor; die Angaben hier sind allgemein bekannte, öffentliche
          Informationen zum Prüfungsformat, keine erfundenen Details. Für die genauen aktuellen Zeiten
          prüfe den offiziellen TestDaF-Modellsatz.
        </p>
      </section>
    </Fragment>

    <div class="mock-cta mock-cta--lead">
      <h2 data-i18n="testdaf.set.title">Leseverstehen im Prüfungsformat üben</h2>
      <p data-i18n-html="testdaf.set.text">
        Drei Leseaufgaben in der Reihenfolge der echten Prüfung — Zuordnung, Multiple Choice und
        Ja/Nein/steht-nicht-im-Text — dazu der Schreibauftrag zur Grafik, mit Aufbau, Redemitteln und
        Checkliste. Uns liegt kein TestDaF-Quellmaterial vor: Der <em>Aufbau</em> ist öffentlich
        bekanntes Wissen über das Format, alle Texte und Aufgaben sind von uns selbst geschrieben und
        werden nirgends als offizielles Prüfungsmaterial ausgegeben. Hörverstehen fehlt noch — dafür
        brauchen wir Tonaufnahmen.
      </p>
      <a class="quiz-btn quiz-btn--primary" href="/testdaf/uebungssatz" data-i18n="exam.startSet">Übungssatz starten →</a>
    </div>

    <ExamPractice
      heading="Weiter üben"
      headingKey="exam.practice.heading"
      intro="Neben dem Übungssatz oben sind diese drei Tools niveau- und prüfungsübergreifend nützlich — sie stammen aus dem DTZ-Unterrichtsmaterial, prüfen aber allgemeine Artikel-, Grammatik- und Wortschatzkenntnisse, keinen TestDaF-spezifischen Inhalt."
      introKey="testdaf.practice.intro"
      tools={["artikel", "grammatik", "wortschatz"]}
    />
  </ExamShell>
</Layout>
