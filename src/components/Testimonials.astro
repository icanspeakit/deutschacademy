---
const quotes = [
  {
    text: "German isn’t always easy, and especially because I have a big family I can’t study undisturbed at home. Luckily DeutschAcademy made it work.",
    name: "Richard Gustavo Volente",
  },
  {
    text: "Thank you very much! I thought German is so hard but nevertheless I made it! And you guys helped me.",
    name: "Kenneth Coribella",
  },
  {
    text: "Why would I have to sit in front of the computer for 4 hours and learn? But I understood after a little while, that there was a reason for it.",
    name: "Precious Lima",
  },
  {
    text: "Ugh, German can be very hard. I really had different expectations and had to burn my night candle to make it. But it was worth it.",
    name: "Gusta Delgado",
  },
];

function initials(name: string) {
  return name.split(" ").map((w) => w[0]).slice(0, 2).join("");
}
---
<section class="section testimonials">
  <div class="container">
    <div class="testimonials-head">
      <p class="eyebrow">What Our Clients Say</p>
      <div class="testimonial-switcher" role="tablist" aria-label="Ansicht wählen">
        <button type="button" class="testimonial-switch-btn active" data-view="grid">Karten</button>
        <button type="button" class="testimonial-switch-btn" data-view="list">Liste</button>
      </div>
    </div>
    <div class="testimonial-grid" id="testimonial-grid">
      {quotes.map((quote) => (
        <blockquote>
          <p>{quote.text}</p>
          <div class="testimonial-author">
            <span class="avatar-initials">{initials(quote.name)}</span>
            <cite>{quote.name}</cite>
          </div>
        </blockquote>
      ))}
    </div>
  </div>
</section>

<script>
  const grid = document.getElementById("testimonial-grid");
  const switchBtns = document.querySelectorAll(".testimonial-switch-btn");
  switchBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      switchBtns.forEach((b) => b.classList.toggle("active", b === btn));
      grid?.classList.toggle("testimonial-grid--list", btn.dataset.view === "list");
    });
  });
</script>
