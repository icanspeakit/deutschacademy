---
// Aussprache-Check: read a sentence aloud, get a score per word from Azure's
// pronunciation assessment. /aussprache next door is listen-and-repeat with no
// feedback; this is the half that says how it went.
//
// The page itself is static like every other exercise. The only server part is
// /api/speech-token, which trades the Azure key for a 10-minute token — and only for a
// signed-in learner. Listening works for everyone; scoring needs an account.
// Logic: src/lib/ausspracheCheck.js. Sentences: src/data/aussprache-check.json.
import Layout from "../layouts/Layout.astro";
import SiteNav from "../components/SiteNav.astro";
import "../styles/practice.css";
import "../styles/aussprache-check.css";
import data from "../data/aussprache-check.json";

const levels = data.levels;
const total = levels.reduce((n, l) => n + l.sentences.length, 0);
---
<Layout
  title="Aussprache-Check – DeutschAcademy"
  description="Sprich deutsche Sätze ins Mikrofon und sieh sofort, welche Wörter gut klingen — mit Punkten für jedes Wort und einem Tipp für ü, ö, ch, r und sch."
>
  <SiteNav active="fertigkeiten" />

  <main class="ac" id="ac-root">
    <header class="ac-head">
      <p class="ac-eyebrow">Sprechen · Aussprache</p>
      <h1 class="ac-title">Aussprache-Check</h1>
      <p class="ac-lead">Lies den Satz laut vor. Du siehst sofort, welche Wörter schon gut klingen — und bekommst einen Tipp für das schwierigste. {total} Sätze, A1 bis B1.</p>
    </header>

    <div class="ac-levels" role="tablist" aria-label="Niveau">
      {levels.map((l, i) => (
        <button type="button" role="tab" class="ac-level" data-level={l.level} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1}>
          {l.level}<span class="ac-level-n">{l.sentences.length}</span>
        </button>
      ))}
    </div>

    <section class="ac-card" aria-labelledby="ac-sentence-label">
      <div class="ac-meta">
        <span id="ac-sentence-label" data-pos>Satz 1</span>
        <span class="ac-best" data-best></span>
      </div>
      <div class="ac-focus" data-focus aria-label="Laute in diesem Satz"></div>

      <p class="ac-sentence" data-sentence lang="de" aria-live="polite"></p>

      <div class="ac-actions">
        <button type="button" class="ac-btn ac-btn--ghost" data-listen>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9v6h4l5 4V5L8 9H4Z" /><path d="M16.5 8.5a5 5 0 0 1 0 7" /></svg>
          Anhören
        </button>
        <button type="button" class="ac-btn ac-btn--rec" data-record data-state="idle">
          <span class="ac-rec-dot" aria-hidden="true"></span>
          <span data-record-label>Aufnehmen</span>
        </button>
      </div>

      <p class="ac-status" data-status role="status"></p>
      <p class="ac-login" data-login hidden>
        <a class="ac-btn ac-btn--primary" href="/anmelden?next=/aussprache-check">Anmelden</a>
        <span>Kostenlos. Anhören geht auch ohne Konto.</span>
      </p>

      <div class="ac-results" data-results hidden>
        <div class="ac-overall">
          <div class="ac-ring" data-overall-ring style="--p:0">
            <b data-overall>0</b><small>von 100</small>
          </div>
          <div class="ac-legend" aria-hidden="true">
            <span><i class="ac-dot ac-dot--good"></i>ab 80</span>
            <span><i class="ac-dot ac-dot--ok"></i>60–79</span>
            <span><i class="ac-dot ac-dot--bad"></i>unter 60</span>
            <span><s>Wort</s> ausgelassen</span>
          </div>
        </div>
        <div class="ac-scores" data-scores></div>
        <div class="ac-melody" data-melody hidden></div>
        <div class="ac-detail" data-detail hidden></div>
        <div class="ac-tip" data-tip></div>
      </div>

      <nav class="ac-nav" aria-label="Sätze">
        <button type="button" class="ac-btn ac-btn--quiet" data-prev>← Zurück</button>
        <button type="button" class="ac-btn ac-btn--quiet" data-next>Weiter →</button>
      </nav>
    </section>

    <p class="ac-privacy">
      Deine Aufnahme wird zur Auswertung an Microsoft Azure geschickt und dort nicht gespeichert.
      Die Satzmelodie wird direkt in deinem Browser berechnet. Mehr in der <a href="/datenschutz">Datenschutzerklärung</a>.
    </p>
  </main>

  <script type="application/json" id="ac-data" set:html={JSON.stringify({ levels })}></script>
  <script>
    import { mountAusspracheCheck } from "../lib/ausspracheCheck.js";
    const root = document.getElementById("ac-root");
    const data = JSON.parse(document.getElementById("ac-data")!.textContent || "{}");
    if (root) mountAusspracheCheck(root, data);
  </script>
</Layout>
