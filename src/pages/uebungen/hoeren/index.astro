---
// /uebungen/hoeren — the Hörverstehen hub.
//
// Grouped by level, like the Landeskunde hub and the nav menu, so all three agree on what
// "A2" contains. Each card says the task type (Durchsage, Telefonat, Gespräch …) because
// that, not the topic, is what a DTZ or telc Hörteil actually varies.
//
// Every clip here is voiced with ElevenLabs from a script written for this site — see the
// note at the top of src/data/hoeren.json for why none of it comes off a Lehrwerk-CD.
import Layout from "../../../layouts/Layout.astro";
import PracticeHeader from "../../../components/PracticeHeader.astro";
import Icon from "../../../components/Icon.astro";
import hoeren from "../../../data/hoeren.json";
import { levels as siteLevels } from "../../../lib/catalog.js";
import { clipSeconds, hasClip, TYPE_ICON } from "../../../lib/hoeren.js";
import "../../../styles/practice.css";
import "../../../styles/hoeren.css";

const { texts, types } = hoeren;
const questionCount = texts.reduce((n, t) => n + t.questions.length, 0);

const groups = siteLevels
  .map((lv) => ({ ...lv, items: texts.filter((t) => t.level === lv.level) }))
  .filter((g) => g.items.length);

// How many clips are actually rendered. Until `pnpm generate:hoeren` has run there are
// none, and the page says so rather than showing sixteen silent players.
const rendered = texts.filter((t) => hasClip(t.id)).length;
---
<Layout
  title="Hörverstehen – DeutschAcademy"
  description="Hörverstehen von A1 bis B2: Durchsagen, Telefonate, Gespräche, Radiobeiträge und Vorträge — mit Fragen, Transkript und langsamer Wiedergabe."
>
  <PracticeHeader title="Hören" />
  <main class="practice-main practice-main--wide">
    <div class="practice-hero">
      <p class="eyebrow" data-i18n="hoeren.hero.eyebrow">Hörverstehen</p>
      <h1 data-i18n="hoeren.hero.title">Hören üben</h1>
      <p data-i18n="hoeren.hero.lead">
        {texts.length} Hörtexte von A1 bis B2 — Durchsagen, Telefonate, Gespräche und Radiobeiträge,
        jeweils in den Aufgabenformen aus DTZ und telc. Mit Fragen, Transkript und langsamer Wiedergabe.
      </p>
    </div>

    {rendered === 0 && (
      <p class="ho-pending">
        Die Audiodateien sind noch nicht gerendert — <code>pnpm generate:hoeren</code> erzeugt sie.
        Bis dahin lassen sich die Texte als Lesetexte mit denselben Fragen üben.
      </p>
    )}

    {groups.map((g) => (
      <section class="ho-group" id={`niveau-${g.slug}`}>
        <h2 class="ho-group-title">
          <span class="ho-badge">{g.level}</span>
          <span data-i18n={g.blurbKey}>{g.blurb}</span>
        </h2>
        <div class="ho-grid">
          {g.items.map((t) => (
            <a class="ho-card" href={`/uebungen/hoeren/${t.id}`}>
              <span class="ho-card-ic"><Icon name={TYPE_ICON[t.type] ?? "volume"} size={20} /></span>
              <span class="ho-card-txt">
                <b>{t.title}</b>
                {/* Scenario titles stay German — they name the situation in the language
                    being learnt. The line under each says what to listen for. */}
                <i data-i18n={`hoeren.${t.id}.blurb`}>{t.blurb}</i>
                {/* Two spans, not one: the task type and the counts translate from
                    separate keys, so the "Sek. · Fragen" template is written once per
                    shape instead of being baked into all 24 type names. */}
                <span class="ho-card-meta">
                  <span data-i18n={`type.hoeren.${t.type}`}>{types[t.type]}</span>
                  {" · "}
                  <span data-i18n="meta.secQ" data-i18n-vars={JSON.stringify({ s: clipSeconds(t), q: t.questions.length })}>{clipSeconds(t)} Sek. · {t.questions.length} Fragen</span>
                </span>
              </span>
              <span class="ho-card-go" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      </section>
    ))}

    <p class="ho-foot">
      {texts.length} Hörtexte · {questionCount} Fragen · alle Stimmen synthetisch, alle Skripte für
      diese Seite geschrieben.
    </p>
  </main>
</Layout>
