    "exampleHtml": "Sie <span class=\"vp-verb\">ärgert sich</span> <span class=\"vp-prep\">über den Verkehr</span>.",
    "qa": [
      {
        "html": "<strong>Worüber</strong> ärgert sie sich? — Über den Verkehr.",
        "tag": "(Sache)"
      },
      {
        "html": "<strong>Über wen</strong> ärgert sie sich? — Über ihren Chef.",
        "tag": "(Person)"
      }
    ],
    "noteHtml": "Fragewort für Sachen: <em>wo(r) + Präposition</em>, z. B. <em>worüber</em>. Fragewort für Personen: <em>Präposition + wen/wem</em>, z. B. <em>über wen</em>.",
