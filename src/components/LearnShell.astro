import { nouns } from "../lib/lexicon.js";
import { kursTopicsAt, workspaces as kursWorkspaces } from "../lib/kursOrder.js";
import grammatik from "../data/grammatik.json";
import wortschatz from "../data/wortschatz.json";
import sprechen from "../data/sprechen.json";
import lesen from "../data/lesen.json";
import kultur from "../data/kultur.json";
import lid from "../data/leben-in-deutschland.json";
import hoeren from "../data/hoeren.json";
import { counts as lexiconCounts } from "../lib/lexicon.js";
import { files as downloadFiles } from "../lib/downloads.js";
import { exams } from "../lib/catalog.js";

const readingQuestionCount = lesen.groups.reduce((sum, g) => sum + g.questions.length, 0);

/* What the site actually holds, counted from the data rather than typed out.
 *
 * On a phone the dashboard opens onto one exercise card and nothing else — the module list
 * that shows how much is here sits two screens down, so the first impression of a site with
 * 3.375 Wörter and 664 Aufgaben is "one gap-fill". This strip is that scale in one
 * swipeable line, directly under the rail, and every chip is a way in. */
const de = (n: number) => n.toLocaleString("de-DE");
const ausspracheWordCount = wortschatz.length + artikel.length;
const byLevel = (level: string) => grammatik.filter((t) => t.level === level);

type IconName = "target" | "book" | "book-open" | "folder" | "volume" | "mic" | "pencil" | "map-pin" | "sparkle" | "document" | "landmark" | "graduation-cap";

type Item = {
  id: string;
  label: string;
  icon: IconName;
  href: string;
  level: string;
  levelSource: "data" | "abgeleitet" | "—";
  eyebrow: string;
  lead: string;
  tasks?: number;
  done?: number;
  minutes?: number;
  meta?: string;
  // "quiz"      — a single Lückentext from grammatik.json
  // "workspace" — the full rule card plus four or five exercises
  // "trainer" — the real Artikel-Trainer (practiceWorkspace.js)
  // Every kind of inline exercise /nav can mount. "info" means the row really
  // has nothing to practise (an overview, an exam description).
  practice?: "quiz" | "workspace" | "trainer" | "choice" | "cards" | "audio" | "speak" | "read" | "dtz" | "picker" | "result" | "bausteine";
  // Aggregate rows (the course modules) are the sum of other rows, so practising
  // a single topic has to move them too — otherwise the course strip sits still
  // while the level bar climbs, and the page contradicts itself.
  derived?: string[];
};

type Section = {
  id: string;
  label: string;
  badge: string;
  icon: IconName;
  kind: "kurs" | "stufe" | "ziel" | "uebergreifend";
  /** Two-word caption under an icon-only rail chip; falls back to `badge`. */
  blurb: string;
  focus: string[];
  items: Item[];
};

// Nothing is pre-filled. Every number on this page starts at zero and is filled
// in on the client from what the learner has actually answered, via
// getTopicProgress() in src/lib/progress.js. The server render is the empty state.
const doneOf = (_id: string) => 0;

// The der/die/das trainer is a row on the map like any other: a round is
// ARTIKEL_SESSION nouns, drawn from every gendered noun in the lexicon.
const ARTIKEL_SESSION = 25;
const ARTIKEL_NOUNS = nouns({ level: ["A1", "A2", "B1", "B2"], has: "gender" }).length;

const grammarItem = (t: (typeof grammatik)[number], level: string): Item => ({
  id: t.id,
  label: t.name,
  icon: "book",
  href: `/uebungen/grammatik/${t.id}`,
  level,
  levelSource: "data",
  eyebrow: `Grammatik · ${level}`,
  lead: t.intro,
  tasks: t.questions.length,
  done: doneOf(t.id),
  minutes: Math.round(t.questions.length * 1.5),
  practice: "quiz",
});

// ── The full grammar workspaces ──────────────────────────────────────────
// src/data/grammatik/*.json each describe a complete Kursbuchseite: the
// "Wie funktioniert das?" rule card plus four or five exercises. The live
// /uebungen/grammatik/<topic> route renders exactly these. The map reads their
// metadata only — which topics a level has and in what order comes from
// src/lib/kursOrder.js, the same list the topic page's course bar walks.
const workspaces = kursWorkspaces;

// One "Slot" is one thing the learner has to get right, counted the same way
// the five exercise renderers in grammarWorkspace.js consume their data.
const slotsOf = (ex: any): number => {
  if (ex.type === "fill") return ex.items.length;
  if (ex.type === "match") return ex.pairs.length;
  if (ex.type === "table") return ex.rows.length;
  if (ex.type === "story") return ex.segments.filter((s: any) => s.blank !== undefined).length;
  if (ex.type === "build") return ex.sentences.length;
  return 0;
};
const workspaceSlots = (w: any) => (w.exercises ?? []).reduce((a: number, e: any) => a + slotsOf(e), 0);

const workspaceItem = (w: any): Item => {
  const id = w.slug ?? w.id;
  const tasks = workspaceSlots(w);
  return {
    id,
    label: w.name,
    icon: "book-open",
    href: `/uebungen/grammatik/${id}`,
    level: w.level,
    levelSource: "data",
    eyebrow: `Grammatik · ${w.level}`,
    lead: w.subtitle ?? "",
    tasks,
    done: doneOf(id),
    minutes: Math.max(8, Math.round(tasks * 0.8)),
    practice: "workspace",
  };
};

// Which topics a level holds, in course order: kursTopicsAt() in src/lib/kursOrder.js.
// One list for this map and for the topic page's "Thema x von y" and ‹ ›.
const grammarAt = (level: string) =>
  kursTopicsAt(level).map((t: any) => (t.kind === "workspace" ? workspaceItem(t.data) : grammarItem(t.data, level)));

// The portions below split a topic on its exercise boundaries, so they need the
// workspace behind an id.
const workspaceById = Object.fromEntries(workspaces.map((w: any) => [w.slug ?? w.id, w]));

// Every grammar entry, in one list — the course module "Grammatik-Basis" is
// their sum, so practising any single topic moves the course strip too.
const allGrammarItems = ["A1", "A2", "B1", "B2"].flatMap(grammarAt);
const allGrammarIds = allGrammarItems.map((i) => i.id);
const allGrammarTasks = allGrammarItems.reduce((a, i) => a + (i.tasks ?? 0), 0);
const allGrammarDone = allGrammarItems.reduce((a, i) => a + (i.done ?? 0), 0);
const allGrammarMinutes = allGrammarItems.reduce((a, i) => a + (i.minutes ?? 0), 0);

/* The scale strip's chips. `allGrammarTasks` rather than a fresh count over grammatik.json:
   that file holds only the seven quiz-only topics now, and counting it alone would advertise
   37 Aufgaben two centimetres above a blurb that says 664. One number, one source. */
const scaleChips = [
  { label: "Grammatik", value: `${de(allGrammarTasks)} Aufgaben`, href: "/uebungen/grammatik", icon: "book" as const },
  { label: "Wortschatz", value: `${de(lexiconCounts().total)} Wörter`, href: "/uebungen/wortschatz", icon: "folder" as const },
  { label: "Hören", value: `${hoeren.texts.length} Hörtexte`, href: "/uebungen/hoeren", icon: "volume" as const },
  { label: "Landeskunde", value: `${kultur.topics.length} Themen`, href: "/uebungen/kultur", icon: "map-pin" as const },
  { label: "Prüfungen", value: `${exams.length} Formate`, href: "/pruefungen", icon: "graduation-cap" as const },
  { label: "Downloads", value: `${downloadFiles.length} PDFs`, href: "/wissen", icon: "document" as const },
];

// ── The grammar module, handed out in portions ───────────────────────────
// "Grammatik-Basis" was one row of 664 Aufgaben and the course strip above it
// read 0 / 724. Neither is a number anyone starts. It is the whole grammar
// catalogue stated as a single task, and a bar across it cannot visibly move
// for days — the one thing a progress bar exists to do.
//
// Same material, handed out in portions of ten to thirty: a sitting, not a
// syllabus. A portion never crosses a level, and apart from the short quiz
// topics that cannot fill one alone it never crosses a topic either, so it is
// always one page to open. Cuts fall on exercise boundaries, never inside one.
// A topic over PORTION_MAX is divided into equal parts rather than a full one
// and a remainder: 33 Aufgaben become 15 + 18, not 25 + 8.
const PORTION_MAX = 25;
const PORTION_MIN = 10;
/** What absorbing a too-small portion may grow its neighbour to. */
const PORTION_CAP = 30;

type Part = { topic: string; from: number; size: number; topicLabel: string; href: string; level: string };

/** One number per exercise, in the order the workspace renders them. */
const exerciseSizes = (i: Item): number[] => {
  const w = workspaceById[i.id];
  const sizes = w ? (w.exercises ?? []).map(slotsOf) : [];
  return sizes.length ? sizes : [i.tasks ?? 0];
};

function splitTopic(i: Item): Part[][] {
  const sizes = exerciseSizes(i);
  const total = sizes.reduce((a, b) => a + b, 0);
  const wanted = Math.max(1, Math.ceil(total / PORTION_MAX));
  const out: Part[][] = [];
  let cur: Part[] = [];
  let from = 0;
  let acc = 0;
  let left = total;
  let made = 1;
  for (const size of sizes) {
    const share = left / (wanted - made + 1);
    // Close here when taking one more exercise would land further from this
    // part's share than stopping does.
    if (cur.length && made < wanted && Math.abs(acc + size - share) > Math.abs(acc - share)) {
      out.push(cur);
      left -= acc;
      cur = [];
      acc = 0;
      made++;
    }
    cur.push({ topic: i.id, from, size, topicLabel: i.label, href: i.href, level: i.level });
    from += size;
    acc += size;
  }
  if (cur.length) out.push(cur);
  return out;
}

const partsSize = (parts: Part[]) => parts.reduce((a, x) => a + x.size, 0);

// A four-question quiz topic is not a sitting. Those are the only portions that
// come out under PORTION_MIN, they sit at the end of their level (grammarAt puts
// the workspaces first), and they are also the only case a portion covers more
// than one topic — so they pair off with each other before they are allowed to
// weigh down a full topic's portion.
const packedPortions: Part[][] = allGrammarItems.flatMap(splitTopic);

const sameLevel = (a: Part[], b: Part[]) => a[0].level === b[0].level;

// Pass one: two undersized neighbours make one portion (Dativ + Trennbare Verben).
for (let k = packedPortions.length - 2; k >= 0; k--) {
  const here = packedPortions[k];
  const next = packedPortions[k + 1];
  if (partsSize(here) < PORTION_MIN && partsSize(next) < PORTION_MIN && sameLevel(here, next)) {
    packedPortions.splice(k, 2, [...here, ...next]);
  }
}
// Pass two: whatever is still too small joins the portion before it, or the one
// after when the level starts with it.
for (let k = packedPortions.length - 1; k >= 0; k--) {
  const here = packedPortions[k];
  if (partsSize(here) >= PORTION_MIN) continue;
  const prev = packedPortions[k - 1];
  const next = packedPortions[k + 1];
  if (prev && sameLevel(prev, here) && partsSize(prev) + partsSize(here) <= PORTION_CAP) {
    packedPortions.splice(k - 1, 2, [...prev, ...here]);
  } else if (next && sameLevel(here, next) && partsSize(here) + partsSize(next) <= PORTION_CAP) {
    packedPortions.splice(k, 2, [...here, ...next]);
  }
}

const pieceCount: Record<string, number> = {};
for (const parts of packedPortions) pieceCount[parts[0].topic] = (pieceCount[parts[0].topic] ?? 0) + 1;
const pieceSeen: Record<string, number> = {};

const portions = packedPortions.map((parts, idx) => {
  const head = parts[0];
  const of = pieceCount[head.topic];
  const nth = (pieceSeen[head.topic] = (pieceSeen[head.topic] ?? 0) + 1);
  const names = parts.map((x) => x.topicLabel).filter((n, k, all) => all.indexOf(n) === k);
  const base = of > 1 ? `${head.topicLabel} · Teil ${nth} von ${of}` : head.topicLabel;
  const tasks = partsSize(parts);
  return {
    id: `portion-${idx + 1}`,
    level: head.level,
    label: names.length > 1 ? `${base} + ${names.slice(1).join(" + ")}` : base,
    href: head.href,
    topic: head.topic,
    tasks,
    minutes: Math.max(8, Math.round(tasks * 0.8)),
    parts: parts.map((x) => ({ topic: x.topic, from: x.from, size: x.size })),
  };
});
const firstPortion = portions[0];

