    {
      "id": "zweifeln",
      "name": "Zweifel äußern",
      "icon": "🤔",
      "phrases": [
        { "de": "Da bin ich mir nicht so sicher.", "en": "I'm not so sure about that.", "ar": "لست متأكدًا من ذلك.", "ru": "Я в этом не уверен.", "tr": "Bundan pek emin değilim." },
        { "de": "Meinst du wirklich?", "en": "Do you really think so?", "ar": "هل تظن ذلك حقًا؟", "ru": "Ты правда так думаешь?", "tr": "Gerçekten öyle mi düşünüyorsun?" },
        { "de": "Ich weiß nicht so recht.", "en": "I'm not really sure.", "ar": "لا أعرف تمامًا.", "ru": "Даже не знаю.", "tr": "Pek bilemiyorum." },
        { "de": "Ist das wirklich so?", "en": "Is that really the case?", "ar": "هل هذا صحيح فعلًا؟", "ru": "Это действительно так?", "tr": "Gerçekten öyle mi?" },
        { "de": "Das kann ich mir kaum vorstellen.", "en": "I can hardly imagine that.", "ar": "بالكاد أستطيع تخيّل ذلك.", "ru": "С трудом могу себе это представить.", "tr": "Bunu pek hayal edemiyorum." },
        { "de": "Hm, ich habe da meine Zweifel.", "en": "Hmm, I have my doubts.", "ar": "همم، لديّ شكوك في ذلك.", "ru": "Хм, у меня есть сомнения.", "tr": "Hmm, bu konuda şüphelerim var." },
        { "de": "Bist du sicher?", "en": "Are you sure?", "ar": "هل أنت متأكد؟", "ru": "Ты уверен?", "tr": "Emin misin?" },
        { "de": "Das glaube ich eher nicht.", "en": "I rather doubt it.", "ar": "لا أظن ذلك على الأرجح.", "ru": "Скорее всего, нет.", "tr": "Pek sanmıyorum." }
      ]
    },
    {
