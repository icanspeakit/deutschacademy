[
  { "front": "Ich bin der Meinung, dass...", "note": "Meinung äußern — der Standard-Einstieg für jedes Gespräch. Achtung: Verb ans Satzende!", "translations": { "en": "I'm of the opinion that...", "ar": "في رأيي أنّ...", "ru": "Я считаю, что...", "tr": "Bence..." } },
  { "front": "Das sehe ich auch so.", "note": "Zustimmen — klingt natürlicher und höflicher als ein einfaches \"Ja\".", "translations": { "en": "I see it that way too.", "ar": "أرى الأمر كذلك أيضًا.", "ru": "Я тоже так считаю.", "tr": "Ben de öyle düşünüyorum." } },
  { "front": "Wie geht's dir?", "note": "Lockere Begrüßung unter Freunden (du-Form).", "translations": { "en": "How's it going?", "ar": "كيف حالك؟", "ru": "Как дела?", "tr": "Nasılsın?" } },
  { "front": "Woher kommst du?", "note": "→ Antwort: Ich komme aus [Land].", "translations": { "en": "Where are you from?", "ar": "من أين أنت؟", "ru": "Откуда ты?", "tr": "Nerelisin?" } },
  { "front": "Was machst du beruflich?", "note": "→ Antwort: Ich bin [Beruf].", "translations": { "en": "What do you do for work?", "ar": "ما هي مهنتك؟", "ru": "Кем ты работаешь?", "tr": "Mesleğin ne?" } },
  { "front": "Welche Sprachen sprichst du?", "note": "→ Antwort: Ich spreche...", "translations": { "en": "Which languages do you speak?", "ar": "ما هي اللغات التي تتحدثها؟", "ru": "На каких языках ты говоришь?", "tr": "Hangi dilleri konuşuyorsun?" } },
  { "front": "Wo wohnst du?", "note": "→ Antwort: Ich wohne in...", "translations": { "en": "Where do you live?", "ar": "أين تسكن؟", "ru": "Где ты живёшь?", "tr": "Nerede oturuyorsun?" } },
  { "front": "der Hund", "note": "Vorteil: braucht wenig Zeit; Nachteil: viele Haare, kann Allergien verursachen", "translations": { "en": "dog", "ar": "الكلب", "ru": "собака", "tr": "köpek" } },
  { "front": "die Katze", "note": "Vorteil: braucht nicht viel Platz; Nachteil: kann Möbel kaputt machen", "translations": { "en": "cat", "ar": "القطة", "ru": "кошка", "tr": "kedi" } },
