---
// Facts page for "Leben in Deutschland". The federal chapters (Demokratie, Wahlen, Grundrechte,
// Geschichte, Arbeit, Familie) are sourced from Leben_in_Deutschland_Bayern_A2.pdf,
// Leben_in_Deutschland_Bayern_B1.pdf and Leben_in_Deutschland_Bayern_B1_A.pdf (Deutsch v3
// folder) — see docs/section-prompts-v1.md section 14. The Bayern entry in `bundeslaender`
// carries that same sourced material. The other 15 Bundesländer have no DeutschAcademy source
// material in the project: their basic facts (capital, parliament name, head-of-government
// title) are general public knowledge, not teaching-material sourced — see meta.stateFactsNote,
// shown on this page. Deliberately excludes officeholder names and exact election-cycle lengths,
// which change over time and aren't worth the risk of going stale on a citizenship-test page.
//
// Visual design is fixed to the "minimal" concept (flat, near-monochrome, self-hosted
// Albert Sans) baked directly into .fk-page in fakten-layouts.css — no design switcher.
//
// "Ansicht" (structural layout: Tabs default / Inhaltsverzeichnis / Karten) is a small icon-only
// control fixed to the bottom-right corner (.fk-view-switcher) so it stays out of the reading
// flow. Switching layouts crossfades the old/new section (see the .fk-anim-out/.fk-anim-in
// classes and the setLayout() logic below) instead of an instant swap, and a sliding indicator
// behind the active icon reinforces which view is active.
//
// "Sprache" (Standard / In einfachem Deutsch) is a second, content-level toggle shown prominently
// under the hero — it swaps every fact/definition/source-note to its A1–A2 simplified rewrite
// (data.*Easy fields in leben-in-deutschland.json). Implementation: every piece of togglable text
// is rendered TWICE server-side, once wrapped in .fk-std and once in .fk-easy; fakten-layouts.css
// shows only the one matching .fk-page[data-lang]. This works identically across all three
// structural layouts with no extra JS beyond flipping the attribute (see setLang() below), except
// for the Bundesland detail panel, which is built client-side and re-rendered on language change.
// generate-fakten-pdf.mjs reads the same *Easy fields to build the parallel "einfach" PDF.
//
// "In meiner Sprache" is a third, independent switch: every fact, definition and source note
// also carries its translation (src/data/uebersetzungen/leben-in-deutschland.json), for both
// the standard and the easy text, shown under the German by GrammarHelp's mechanism. The
// German stays first — the test is taken in German — but a fact you cannot read is not one
// you can learn.
import Layout from "../../../layouts/Layout.astro";
import SiteNav from "../../../components/SiteNav.astro";
import "../../../styles/practice.css";
import "../../../styles/pruefungen.css";
import "../../../styles/fakten-layouts.css";
import GrammarHelp from "../../../components/GrammarHelp.astro";
import GrammarHelpText from "../../../components/GrammarHelpText.astro";
import lid from "../../../data/leben-in-deutschland.json";
import lidHelp from "../../../data/uebersetzungen/leben-in-deutschland.json";
import { field, item } from "../../../lib/helpContent.js";
import { files } from "../../../lib/downloads.js";

const { topics, glossary, meta, bundeslaender } = lid;
const tx = lidHelp as any;
const topicTx = (id: string) => tx.topics?.[id] ?? {};
const glossTx = (term: string) => tx.glossary?.[term] ?? {};
// The translated editions are found on disk by lib/downloads.js, the same way /wissen
// lists them — the generator skips a language that misses a fact.
// Labels without the "↓" (the tab and card lists add it, the sidebar list does not), each
// with an i18n key; the edition's own language name ("English", "العربية") is a var.
const editions = (id: string, what: string, key: string) =>
  (files.find((f) => f.id === id)?.editions ?? []).map((e: any) => ({ href: e.href, label: `${what} · ${e.label}`, key, vars: { lang: e.label } }));
const downloads: { href: string; label: string; key?: string; vars?: Record<string, string> }[] = [
  { href: "/downloads/leben-in-deutschland-fakten.pdf", label: "Fakten als PDF", key: "lid.fk.dl.facts" },
  ...editions("lid-fakten", "Fakten", "lid.fk.dl.factsEd"),
  { href: "/downloads/leben-in-deutschland-fakten-einfach.pdf", label: "Fakten in einfachem Deutsch (PDF)", key: "lid.fk.dl.easy" },
  ...editions("lid-fakten-einfach", "Einfach", "lid.fk.dl.easyEd"),
  { href: "/downloads/leben-in-deutschland-bayern-a2.pdf", label: "Bayern A2" },
  { href: "/downloads/leben-in-deutschland-bayern-b1.pdf", label: "Bayern B1" },
  { href: "/downloads/leben-in-deutschland-bayern-b1-grafiken.pdf", label: "Bayern B1, mit Grafiken", key: "lid.fk.dl.b1charts" },
];
const dlVars = (d: { vars?: Record<string, string> }) => (d.vars ? JSON.stringify(d.vars) : undefined);
---
<Layout
  title="Leben in Deutschland: Fakten – DeutschAcademy"
  description="Die wichtigsten Fakten für den Einbürgerungstest 'Leben in Deutschland' — Demokratie, Wahlen, Grundrechte, Geschichte, Arbeit, Familie und alle 16 Bundesländer."
>
  <div class="fk-page" id="fk-page" data-lang="standard" data-gx="off">
  <SiteNav active="pruefungen" />

  <div class="fk-view-switcher" role="tablist" aria-label="Ansicht wählen" data-i18n-attr="aria-label:lid.fk.view.aria">
    <span class="fk-view-switcher-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 3 8l9 5 9-5-9-5Z"/><path d="M3 12l9 5 9-5"/><path d="M3 16.5l9 5 9-5"/></svg>
    </span>
    <div class="fk-view-switcher-track">
      <span class="fk-view-switcher-indicator" aria-hidden="true"></span>
      <button type="button" class="fk-view-btn" data-layout="tabs" title="Tabs" aria-label="Ansicht: Tabs" data-i18n-attr="title:lid.fk.view.tabs;aria-label:lid.fk.view.tabsAria">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8V6.5A1.5 1.5 0 0 1 4.5 5h4l2 2h9A1.5 1.5 0 0 1 21 8.5v9A1.5 1.5 0 0 1 19.5 19h-15A1.5 1.5 0 0 1 3 17.5V8Z"/></svg>
      </button>
      <button type="button" class="fk-view-btn" data-layout="sidebar" title="Inhaltsverzeichnis" aria-label="Ansicht: Inhaltsverzeichnis" data-i18n-attr="title:lid.fk.view.toc;aria-label:lid.fk.view.tocAria">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="1.5"/><line x1="9.5" y1="4" x2="9.5" y2="20"/></svg>
      </button>
      <button type="button" class="fk-view-btn" data-layout="cards" title="Karten" aria-label="Ansicht: Karten" data-i18n-attr="title:lid.fk.view.cards;aria-label:lid.fk.view.cardsAria">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.2"/><rect x="14" y="3" width="7" height="7" rx="1.2"/><rect x="3" y="14" width="7" height="7" rx="1.2"/><rect x="14" y="14" width="7" height="7" rx="1.2"/></svg>
      </button>
    </div>
  </div>

  <main class="practice-main">
    <div class="fk-hero">
      <p class="eyebrow">Leben in Deutschland · <span data-i18n="lid.fk.eyebrow">Fakten</span></p>
      <h1 data-i18n="lid.fk.title">Fakten zum Lernen</h1>
      <p data-i18n-html="lid.fk.hero">
        Bundesweite Fakten aus echtem Unterrichtsmaterial, gegliedert nach Themen, plus die Grunddaten
        zu deinem Bundesland — bevor du den <a href="/pruefungen/leben-in-deutschland/test">Übungstest</a> übst.
      </p>
      <details class="fk-source-note">
        <summary data-i18n="exam.aboutSource">Über die Quelle</summary>
        <p><span class="fk-std">{meta.sourceNote}</span><span class="fk-easy">{meta.sourceNoteEasy}</span></p>
        <GrammarHelpText class="fk-std" text={field(tx.meta?.sourceNote)} />
        <GrammarHelpText class="fk-easy" text={field(tx.meta?.sourceNoteEasy)} />
      </details>
    </div>

    <div class="fk-lang-toggle" role="tablist" aria-label="Sprachniveau wählen" data-i18n-attr="aria-label:lid.fk.level.aria">
      <button type="button" class="fk-lang-btn" data-lang="standard">
        <span data-i18n="lid.fk.level.standard">Standard</span>
      </button>
      <button type="button" class="fk-lang-btn" data-lang="easy">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19.5V6a2 2 0 0 1 2-2h13.5v15H6a2 2 0 0 0-2 2Z"/><path d="M19.5 19.5H6a2 2 0 0 1 0-4h13.5"/></svg>
        <span data-i18n="lid.fk.level.easy">In einfachem Deutsch</span>
      </button>
    </div>
    <GrammarHelp level="A2" root="fk-page" reviewed={tx.reviewed} />

    <!-- ================= Layout 1: Tabs ================= -->
    <section class="fk-layout fk-layout--tabs" id="fk-tabs" data-layout-panel="tabs">
      <div class="fk-tabbar" role="tablist">
        {topics.map((t) => (
          <button class="fk-tab" type="button" data-target={`fkt-${t.id}`}>{t.title}</button>
        ))}
        <button class="fk-tab" type="button" data-target="fkt-glossar" data-i18n="lid.fk.glossary">Glossar</button>
        <button class="fk-tab" type="button" data-target="fkt-bundesland" data-i18n="lid.fk.yourState">Dein Bundesland</button>
        <button class="fk-tab" type="button" data-target="fkt-downloads" data-i18n="lid.fk.downloads">Downloads</button>
      </div>

      {topics.map((t, i) => (
        <div class={`fk-tab-panel${i === 0 ? " active" : ""}`} id={`fkt-${t.id}`}>
          <h3>{t.title}</h3>
          <GrammarHelpText text={field(topicTx(t.id).title)} />
          <ul class="fact-list">{t.facts.map((f, fi) => <li><span class="fk-std">{f}</span><span class="fk-easy">{t.factsEasy[fi]}</span><GrammarHelpText class="fk-std" text={item(topicTx(t.id).facts, fi)} /><GrammarHelpText class="fk-easy" text={item(topicTx(t.id).factsEasy, fi)} /></li>)}</ul>
        </div>
      ))}

      <div class="fk-tab-panel" id="fkt-glossar">
        <h3 data-i18n="lid.fk.glossary">Glossar</h3>
        <dl class="glossary-list">
          {glossary.map((g) => (<><dt>{g.term}</dt><dd><span class="fk-std">{g.def}</span><span class="fk-easy">{g.defEasy}</span><GrammarHelpText class="fk-std" text={field(glossTx(g.term).def)} /><GrammarHelpText class="fk-easy" text={field(glossTx(g.term).defEasy)} /></dd></>))}
        </dl>
      </div>

      <div class="fk-tab-panel" id="fkt-bundesland">
        <h3 data-i18n="lid.fk.yourState">Dein Bundesland</h3>
        <div data-land-wrap>
          <select class="fk-land-select">
            {bundeslaender.map((l) => <option value={l.id} selected={l.id === "bayern"}>{l.name}</option>)}
          </select>
          <div class="fk-land-detail"></div>
        </div>
      </div>

      <div class="fk-tab-panel" id="fkt-downloads">
        <h3 data-i18n="lid.fk.downloads">Downloads</h3>
        <div class="fk-downloads-list">
          {downloads.map((d) => <a class="quiz-btn" href={d.href} download><span data-i18n={d.key} data-i18n-vars={dlVars(d)}>{d.label}</span> ↓</a>)}
        </div>
      </div>
    </section>

    <!-- ================= Layout 2: Sidebar / Inhaltsverzeichnis ================= -->
    <section class="fk-layout fk-layout--sidebar" id="fk-sidebar" data-layout-panel="sidebar" hidden>
      <div class="fk-doc-grid">
        <nav class="fk-doc-nav">
          <p class="fk-doc-nav-label" data-i18n="lid.fk.topics">Themen</p>
          <ul>
            {topics.map((t) => <li><a href={`#fks-${t.id}`}>{t.title}</a></li>)}
            <li><a href="#fks-glossar" data-i18n="lid.fk.glossary">Glossar</a></li>
            <li><a href="#fks-bundesland" data-i18n="lid.fk.yourState">Dein Bundesland</a></li>
          </ul>
          <p class="fk-doc-nav-label" data-i18n="lid.fk.downloads">Downloads</p>
          <ul class="fk-doc-nav-downloads">
            {downloads.map((d) => <li><a href={d.href} download data-i18n={d.key} data-i18n-vars={dlVars(d)}>{d.label}</a></li>)}
          </ul>
        </nav>

        <div class="fk-doc-content">
          {topics.map((t) => (
            <article class="fk-doc-section" id={`fks-${t.id}`}>
              <h3>{t.title}</h3>
          <GrammarHelpText text={field(topicTx(t.id).title)} />
              <ul class="fact-list">{t.facts.map((f, fi) => <li><span class="fk-std">{f}</span><span class="fk-easy">{t.factsEasy[fi]}</span><GrammarHelpText class="fk-std" text={item(topicTx(t.id).facts, fi)} /><GrammarHelpText class="fk-easy" text={item(topicTx(t.id).factsEasy, fi)} /></li>)}</ul>
            </article>
          ))}

          <article class="fk-doc-section" id="fks-glossar">
            <h3 data-i18n="lid.fk.glossary">Glossar</h3>
            <dl class="glossary-list">
              {glossary.map((g) => (<><dt>{g.term}</dt><dd><span class="fk-std">{g.def}</span><span class="fk-easy">{g.defEasy}</span><GrammarHelpText class="fk-std" text={field(glossTx(g.term).def)} /><GrammarHelpText class="fk-easy" text={field(glossTx(g.term).defEasy)} /></dd></>))}
            </dl>
          </article>

          <article class="fk-doc-section" id="fks-bundesland">
            <h3 data-i18n="lid.fk.yourState">Dein Bundesland</h3>
            <div data-land-wrap>
              <select class="fk-land-select">
                {bundeslaender.map((l) => <option value={l.id} selected={l.id === "bayern"}>{l.name}</option>)}
              </select>
              <div class="fk-land-detail"></div>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- ================= Layout 3: Cards ================= -->
    <section class="fk-layout fk-layout--cards" id="fk-cards" data-layout-panel="cards" hidden>
      <div class="fk-card-grid">
        {topics.map((t, i) => (
          <details class="fk-fact-card" open={i === 0}>
            <summary>
              <span class="fk-fact-card-title">{t.title}</span>
              <span class="fk-fact-card-count" data-i18n="lid.fk.nFacts" data-i18n-vars={JSON.stringify({ n: t.facts.length })}>{t.facts.length} Fakten</span>
            </summary>
            <ul class="fact-list">{t.facts.map((f, fi) => <li><span class="fk-std">{f}</span><span class="fk-easy">{t.factsEasy[fi]}</span><GrammarHelpText class="fk-std" text={item(topicTx(t.id).facts, fi)} /><GrammarHelpText class="fk-easy" text={item(topicTx(t.id).factsEasy, fi)} /></li>)}</ul>
          </details>
        ))}
      </div>

      <div class="fk-card-row">
        <details class="fk-fact-card fk-fact-card--wide">
          <summary>
            <span class="fk-fact-card-title" data-i18n="lid.fk.glossary">Glossar</span>
            <span class="fk-fact-card-count" data-i18n="lid.fk.nTerms" data-i18n-vars={JSON.stringify({ n: glossary.length })}>{glossary.length} Begriffe</span>
          </summary>
          <div class="fk-glossary-grid">
            {glossary.map((g) => (
              <div class="fk-glossary-item"><strong>{g.term}</strong><span class="fk-std">{g.def}</span><span class="fk-easy">{g.defEasy}</span><GrammarHelpText class="fk-std" text={field(glossTx(g.term).def)} /><GrammarHelpText class="fk-easy" text={field(glossTx(g.term).defEasy)} /></div>
            ))}
          </div>
        </details>

        <details class="fk-fact-card fk-fact-card--wide">
          <summary><span class="fk-fact-card-title" data-i18n="lid.fk.yourState">Dein Bundesland</span></summary>
          <div data-land-wrap>
            <select class="fk-land-select">
              {bundeslaender.map((l) => <option value={l.id} selected={l.id === "bayern"}>{l.name}</option>)}
            </select>
            <div class="fk-land-detail"></div>
          </div>
        </details>
      </div>

      <details class="fk-downloads-card">
        <summary data-i18n="lid.fk.sourcesDownloads">Quellen &amp; Downloads</summary>
        <div class="fk-downloads-list">
          {downloads.map((d) => <a class="quiz-btn" href={d.href} download><span data-i18n={d.key} data-i18n-vars={dlVars(d)}>{d.label}</span> ↓</a>)}
        </div>
      </details>
    </section>

    <section class="exam-section">
      <h2 data-i18n="lid.fk.testFormat">Testformat</h2>
      <div class="format-table-wrap">
        <table class="format-table">
          <thead><tr><th data-i18n="format.th.part">Teil</th><th data-i18n="format.th.scope">Umfang</th></tr></thead>
          <tbody>
            <tr><td data-i18n="lid.fmt.federal.part">Bundesweiter Teil</td><td data-i18n="lid.fk.nOfQ" data-i18n-vars={JSON.stringify({ n: meta.federalQuestions, t: meta.totalQuestions })}>{meta.federalQuestions} von {meta.totalQuestions} Fragen</td></tr>
            <tr><td data-i18n="lid.fmt.state.part">Landesspezifischer Teil</td><td data-i18n="lid.fk.nOfQ" data-i18n-vars={JSON.stringify({ n: meta.stateQuestions, t: meta.totalQuestions })}>{meta.stateQuestions} von {meta.totalQuestions} Fragen</td></tr>
            <tr><td data-i18n="format.th.time">Zeit</td><td data-i18n="lid.fk.minutes" data-i18n-vars={JSON.stringify({ n: meta.minutes })}>{meta.minutes} Minuten</td></tr>
            <tr><td data-i18n="lid.fk.passFrom">Bestehen ab</td><td data-i18n="lid.fk.nCorrect" data-i18n-vars={JSON.stringify({ n: meta.passScore })}>{meta.passScore} richtigen Antworten</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <div class="mock-cta">
      <h2 data-i18n="lid.fk.cta.title">Jetzt testen</h2>
      <p data-i18n="lid.fk.cta.text">Multiple-Choice-Fragen aus genau diesen Fakten, mit sofortiger Auswertung — wähle dein Bundesland auf der Testseite.</p>
      <a class="quiz-btn quiz-btn--primary" href="/pruefungen/leben-in-deutschland/test" data-i18n="lid.cta.test">Zum Übungstest →</a>
    </div>
  </main>
  </div>

  <script type="application/json" id="laender-data" set:html={JSON.stringify(bundeslaender)}></script>
  <script type="application/json" id="meta-data" set:html={JSON.stringify(meta)}></script>
  <script type="module">
    import { readyExamI18n, tx } from "../../../lib/exam/i18n.js";
    import { onLangChange } from "../../../lib/i18n.js";

    const laender = JSON.parse(document.getElementById("laender-data").textContent);
    const meta = JSON.parse(document.getElementById("meta-data").textContent);

    function esc(s) {
      const div = document.createElement("div");
      div.textContent = s;
      return div.innerHTML;
    }

    const pageRoot = document.getElementById("fk-page");
    function currentLang() {
      return pageRoot.dataset.lang === "easy" ? "easy" : "standard";
    }

    function renderLand(container, id) {
      const l = laender.find((x) => x.id === id) || laender[0];
      const easy = currentLang() === "easy";
      const borders = l.borderCountries.length ? l.borderCountries.join(", ") : tx("lid.fk.land.noBorder", "keine Auslandsgrenze");
      const stateNote = easy ? meta.stateFactsNoteEasy : meta.stateFactsNote;
      const sourceFacts = (easy ? l.sourceFactsEasy : l.sourceFacts) || null;
      container.innerHTML = `
        <div class="topic-intro" style="margin:14px 0;">
          ${l.sourced
            ? esc(tx("lid.fk.land.sourced", "Aus echtem DeutschAcademy-Unterrichtsmaterial."))
            : esc(tx("lid.fk.land.public", "Allgemein bekannte, öffentliche Fakten — keine DeutschAcademy-Quelle.")) + " " + esc(stateNote)}
        </div>
        <ul class="fact-list">
          <li><strong>${esc(tx("lid.fk.land.capital", "Hauptstadt:"))}</strong> ${esc(l.capital)}</li>
          <li><strong>${esc(tx("lid.fk.land.type", "Typ:"))}</strong> ${esc(l.type)}</li>
          <li><strong>${esc(tx("lid.fk.land.population", "Einwohner:"))}</strong> ${esc(l.population)}</li>
          <li><strong>${esc(tx("lid.fk.land.borders", "Grenzt an (Ausland):"))}</strong> ${esc(borders)}</li>
          <li><strong>${esc(tx("lid.fk.land.parliament", "Landesparlament:"))}</strong> ${esc(l.parliamentName)}</li>
          <li><strong>${esc(tx("lid.fk.land.head", "Spitze der Landesregierung:"))}</strong> ${esc(l.executiveTitle)}</li>
        </ul>
        ${sourceFacts ? `<h4 style="margin:18px 0 8px;">${esc(tx("lid.fk.land.more", "Vertiefung aus dem Unterrichtsmaterial"))}</h4><ul class="fact-list">${sourceFacts.map((f) => `<li>${esc(f)}</li>`).join("")}</ul>` : ""}
      `;
    }

    const paintLands = () => document.querySelectorAll("[data-land-wrap]").forEach((wrap) => {
      renderLand(wrap.querySelector(".fk-land-detail"), wrap.querySelector(".fk-land-select").value);
    });
    document.querySelectorAll("[data-land-wrap]").forEach((wrap) => {
      const select = wrap.querySelector(".fk-land-select");
      const detail = wrap.querySelector(".fk-land-detail");
      renderLand(detail, select.value);
      select.addEventListener("change", () => renderLand(detail, select.value));
    });
    // The Bundesland panel is built here, not in the static DOM: its labels (Hauptstadt,
    // Einwohner …) are repainted once the dictionary lands and on every language switch.
    // The facts themselves (capital, parliament name) stay German.
    readyExamI18n().then(paintLands);
    onLangChange(() => setTimeout(paintLands));

    // Sprache (Standard / In einfachem Deutsch) — content-level toggle. .fk-std/.fk-easy spans
    // are shown/hidden purely via CSS on [data-lang]; only the JS-built Bundesland panel needs
    // an explicit re-render since its text isn't in the static DOM.
    const langBtns = [...document.querySelectorAll(".fk-lang-btn")];
    function setLang(key) {
      pageRoot.dataset.lang = key;
      langBtns.forEach((b) => b.classList.toggle("active", b.dataset.lang === key));
      document.querySelectorAll("[data-land-wrap]").forEach((wrap) => {
        const select = wrap.querySelector(".fk-land-select");
        const detail = wrap.querySelector(".fk-land-detail");
        renderLand(detail, select.value);
      });
      try { localStorage.setItem("fakten-lang", key); } catch {}
    }
    langBtns.forEach((b) => b.addEventListener("click", () => setLang(b.dataset.lang)));

    let initialLang = "standard";
    try { initialLang = localStorage.getItem("fakten-lang") || "standard"; } catch {}
    setLang(initialLang);

    // Layout 1: tabs
    const tabsRoot = document.getElementById("fk-tabs");
    if (tabsRoot) {
      const tabBtns = [...tabsRoot.querySelectorAll(".fk-tab")];
      const panels = [...tabsRoot.querySelectorAll(".fk-tab-panel")];
      tabBtns[0].classList.add("active");
      tabBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
          tabBtns.forEach((b) => b.classList.toggle("active", b === btn));
          panels.forEach((p) => p.classList.toggle("active", p.id === btn.dataset.target));
        });
      });
    }

    // Ansicht (structural layout) switcher — Tabs is the default. Switching crossfades the old
    // section out and the new one in (instead of an instant [hidden] swap) and slides a pill
    // indicator behind the active icon, so the change reads as a transition rather than a snap.
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const ANIM_MS = 180;
    const layoutBtns = [...document.querySelectorAll(".fk-view-btn")];
    const track = document.querySelector(".fk-view-switcher-track");
    const indicator = document.querySelector(".fk-view-switcher-indicator");
    const layoutSections = {
      tabs: document.getElementById("fk-tabs"),
      sidebar: document.getElementById("fk-sidebar"),
      cards: document.getElementById("fk-cards"),
    };
    let currentLayout = null;
    let animating = false;

    function moveIndicator(key) {
      const btn = layoutBtns.find((b) => b.dataset.layout === key);
      if (!btn || !indicator || !track) return;
      indicator.style.transform = `translateX(${btn.offsetLeft}px)`;
      indicator.style.width = `${btn.offsetWidth}px`;
    }

    function setLayout(key) {
      if (animating || key === currentLayout) return;
      const target = layoutSections[key];
      if (!target) return;

      layoutBtns.forEach((b) => b.classList.toggle("active", b.dataset.layout === key));
      moveIndicator(key);
      try { localStorage.setItem("fakten-layout", key); } catch {}

      const outgoing = currentLayout ? layoutSections[currentLayout] : null;
      currentLayout = key;

      if (!outgoing || reduceMotion) {
        Object.entries(layoutSections).forEach(([k, el]) => { if (el) el.hidden = k !== key; });
        return;
      }

      animating = true;
      outgoing.classList.add("fk-anim-out");
      window.setTimeout(() => {
        outgoing.hidden = true;
        outgoing.classList.remove("fk-anim-out");
        target.hidden = false;
        target.classList.add("fk-anim-in");
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            target.classList.remove("fk-anim-in");
            animating = false;
          });
        });
      }, ANIM_MS);
    }
    layoutBtns.forEach((b) => b.addEventListener("click", () => setLayout(b.dataset.layout)));
    window.addEventListener("resize", () => currentLayout && moveIndicator(currentLayout));

    let initialLayout = "tabs";
    try { initialLayout = localStorage.getItem("fakten-layout") || "tabs"; } catch {}
    setLayout(initialLayout);
  </script>
</Layout>
