---
// Sketch: /uebungen/wortschatz/a1 with room to breathe.
//
// The same deck, the same picker, the same four tabs — nothing is cut and nothing is
// shortened. Only the padding changes (src/styles/wortschatz-luft.css), because the
// complaint is not that there are too many words on the page, it is that they are all
// touching. Everything else on this route comes from the live page's own components, so
// a change there shows up here and the comparison cannot go stale.
//
// Open it beside /uebungen/wortschatz/a1. Not linked from the nav; noindex.
import Layout from "../layouts/Layout.astro";
import VokabelTrainer from "../components/VokabelTrainer.astro";
import { asVokabelCards, langsOf } from "../lib/lexicon.js";
import "../styles/wortschatz-luft.css";

const LEVEL = "A1";
const cards = asVokabelCards({ level: LEVEL });
const langs = langsOf(cards);
const sub = `${LEVEL} · ${Math.ceil(cards.length / 25)} Runden · je 25 Wörter`;
---
<Layout
  title="Wortliste A1 · Luft – DeutschAcademy"
  description="Skizze: dieselbe Wortliste mit mehr Weißraum."
>
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow" />
  </Fragment>
  <div class="luft">
    <VokabelTrainer cards={cards} heading={`Wortschatz ${LEVEL}`} sub={sub} deck={LEVEL.toLowerCase()} langs={langs} />
  </div>
</Layout>
