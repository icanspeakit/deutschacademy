---
import { LANGUAGES } from "../lib/i18n.js";
---
<div class="lang-switcher" data-lang-switcher>
  <button type="button" class="lang-switcher-btn" data-lang-btn aria-haspopup="true" aria-expanded="false">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 4 6 4 9s-1.5 6.4-4 9c-2.5-2.6-4-6-4-9s1.5-6.4 4-9Z"/></svg>
    <span data-lang-code>DE</span>
    <svg width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>
  <div class="lang-switcher-menu" data-lang-menu role="menu" hidden>
    {LANGUAGES.map((l) => (
      <button type="button" class="lang-switcher-option" role="menuitem" data-lang-option={l.code}>
        {l.label}
      </button>
    ))}
  </div>
</div>

<style>
  .lang-switcher { position: relative; }
  .lang-switcher-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--surface-card);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 8px 12px;
    font-size: .85rem;
    font-weight: 600;
    color: var(--ink);
    cursor: pointer;
  }
  .lang-switcher-btn:hover { border-color: var(--brand-blue); }
  /* Opens downward by default, which is right in a header. In the nav drawer the switcher
     sits in the footer, pinned to the bottom of the screen, and the menu dropped 168px
     past the viewport — completely unreachable. The script measures on open and sets
     data-drop="up" when there is no room below; it also nudges the menu back inside the
     left/right edges with an inline transform, which at 390px it needs (right: 0 anchors
     to the button, and the button is 7px from the edge). */
  .lang-switcher-menu {
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    background: var(--surface-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    box-shadow: 0 12px 28px rgba(28,43,63,.14);
    padding: 6px;
    min-width: 160px;
    z-index: 50;
    max-height: calc(100vh - 24px);
    overflow-y: auto;
  }
  .lang-switcher-menu[data-drop="up"] { top: auto; bottom: calc(100% + 6px); }
  .lang-switcher-option {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
    background: none;
    border: none;
    text-align: left;
    padding: 8px 10px;
    border-radius: 8px;
    font-size: .9rem;
    color: var(--ink);
    cursor: pointer;
  }
  .lang-switcher-option:hover { background: var(--surface); }
  .lang-switcher-option[aria-current="true"] { font-weight: 700; color: var(--brand-blue-dark); background: var(--blue-50); }
</style>

<script>
  import { LANGUAGES, getLang, setLang, onLangChange } from "../lib/i18n.js";

  document.querySelectorAll("[data-lang-switcher]").forEach((root) => {
    const btn = root.querySelector("[data-lang-btn]");
    const menu = root.querySelector("[data-lang-menu]");
    const codeEl = root.querySelector("[data-lang-code]");

    function reflect(code) {
      const lang = LANGUAGES.find((l) => l.code === code) || LANGUAGES[0];
      codeEl.textContent = lang.code.toUpperCase();
      root.querySelectorAll("[data-lang-option]").forEach((opt) => {
        opt.setAttribute("aria-current", String(opt.dataset.langOption === lang.code));
      });
    }

    reflect(getLang());
    onLangChange((code) => reflect(code));

    function closeMenu() {
      menu.hidden = true;
      btn.setAttribute("aria-expanded", "false");
    }

    /* Where the menu can actually go, measured rather than assumed: this component sits in
       the top-right of a header on one page and in the bottom-left of the drawer footer on
       a phone, and a fixed "downward, right-aligned" is wrong in the second. Runs while the
       menu is visible but before the browser paints, so the learner never sees it move.
       The horizontal nudge is an inline transform on purpose — postcss-rtlcss rewrites
       transforms in the stylesheet, and this offset is already in viewport pixels and must
       not be flipped again for Arabic. */
    function place() {
      menu.removeAttribute("data-drop");
      menu.style.transform = "";
      const b = btn.getBoundingClientRect();
      const room = window.innerHeight - b.bottom;
      if (menu.offsetHeight + 12 > room && b.top > room) menu.setAttribute("data-drop", "up");

      const m = menu.getBoundingClientRect();
      const pad = 8;
      let shift = 0;
      if (m.left < pad) shift = pad - m.left;
      else if (m.right > window.innerWidth - pad) shift = window.innerWidth - pad - m.right;
      if (shift) menu.style.transform = `translateX(${Math.round(shift)}px)`;
    }

    btn.addEventListener("click", (e) => {
      e.stopPropagation();
      const isOpen = !menu.hidden;
      document.querySelectorAll("[data-lang-menu]").forEach((m) => (m.hidden = true));
      menu.hidden = isOpen;
      btn.setAttribute("aria-expanded", String(!isOpen));
      if (!menu.hidden) place();
    });

    root.querySelectorAll("[data-lang-option]").forEach((opt) => {
      opt.addEventListener("click", () => {
        setLang(opt.dataset.langOption);
        closeMenu();
      });
    });

    document.addEventListener("click", (e) => {
      if (!root.contains(e.target)) closeMenu();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closeMenu();
    });
    // A rotate or a resize invalidates the measurement; closing beats re-placing for a
    // five-item list the learner has to reopen anyway.
    window.addEventListener("resize", closeMenu);
  });
</script>
