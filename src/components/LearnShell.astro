    focus: ["Konjunktiv II: höflich und hypothetisch", "Feinere Satzstrukturen"],
    items: grammarAt("B2"),
  },
  {
    id: "alle",
    label: "Alle Stufen",
    badge: "A1–B1",
    icon: "folder",
    kind: "stufe",
    blurb: "Übungen, deren Inhalt echt über mehrere Stufen läuft — die Karteikarten reichen von „Wie geht's dir?“ bis „Ich bin der Meinung, dass …“.",
    focus: ["Redemittel A1 bis B1", "Aussprache im Langsam-Modus"],
    items: [
      { id: "wortschatz", label: "Wortschatz & Redemittel", icon: "folder", href: "/uebungen/wortschatz", level: "A1–B1", levelSource: "abgeleitet", eyebrow: "Übung · A1–B1", lead: `${wortschatz.length} Karteikarten, von „Wie geht's dir?“ (A1) bis „Ich bin der Meinung, dass …“ (B1).`, tasks: wortschatz.length, done: 0, minutes: 15, practice: "cards" },
      { id: "aussprache", label: "Aussprache-Training", icon: "volume", href: "/uebungen/aussprache", level: "A1–B1", levelSource: "abgeleitet", eyebrow: "Übung · A1–B1", lead: `Alle ${ausspracheWordCount} Wörter aus Wortschatz und Artikel-Trainer anhören und im Langsam-Modus nachsprechen.`, tasks: ausspracheWordCount, done: 0, minutes: 12, practice: "audio" },
    ],
  },
  {
    id: "pruefungen",
    label: "Prüfungen",
