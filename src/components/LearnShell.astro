  },
  cards: wortschatz.map((c) => ({ front: c.front, note: c.note ?? "", back: c.translations?.en ?? Object.values(c.translations ?? {})[0] ?? "" })),
  audio: [...wortschatz.map((c) => c.front), ...artikel.map((a) => `${a.gender} ${a.word}`)],
  speak: sprechen,
