---
// /wissen — the Wissensdatenbank: everything on this site that is worth having on paper.
//
// Two halves, and the split between them is a rights decision, not a design one. Above:
// files we wrote and therefore may give away, generated from the same data the trainers
// load. Below: links to the official Modellsätze at telc, Goethe and BAMF, which are free
// to use but not ours to host — so they are linked where they are published, where they
// also stay current.
//
// Publisher material (Hueber, Klett, Cornelsen) appears in neither list. See `rightsNote`
// in src/data/downloads.json.
import Layout from "../layouts/Layout.astro";
import PracticeHeader from "../components/PracticeHeader.astro";
import Icon from "../components/Icon.astro";
import { categories, featured, files, links, rightsNote, totals } from "../lib/downloads.js";
import "../styles/practice.css";
import "../styles/wissen.css";

const mb = (totals.bytes / 1024 / 1024).toFixed(1).replace(".", ",");
---
<Layout
  title="Wissensdatenbank – DeutschAcademy"
  description="Grammatikbücher, Wortlisten und Prüfungsmaterial als PDF — kostenlos herunterladen, ausdrucken und im Unterricht weitergeben. Ohne Konto."
>
  <PracticeHeader title="Wissen" />
  <main class="practice-main practice-main--wide">
    <div class="practice-hero">
      <p class="eyebrow">Wissensdatenbank</p>
      <h1 data-i18n="wissen.h1">Bücher und Listen zum Herunterladen</h1>
      <p>
        {totals.files} PDFs, {totals.pages} Seiten, alles kostenlos und ohne Konto. Zum Ausdrucken,
        Mitnehmen und im Unterricht Weitergeben.
      </p>
    </div>

    {/* Two lines, not two banners. These are the entry points into the two big
        collections, and they used to be 190px each — half the first screen for
        two files that were also listed again below. */}
    {featured.length > 0 && (
      <div class="wi-featured">
        {featured.map((f) => (
          <button class="wi-feature" type="button" data-file={f.id}>
            <span class="wi-badge">{f.level}</span>
            <b>{f.title}</b>
            <span class="wi-meta">PDF{f.pages ? ` · ${f.pages} Seiten` : ""} · {f.size}</span>
            <span class="wi-dl" aria-hidden="true">↓</span>
          </button>
        ))}
      </div>
    )}

    {categories.map((cat) => (
      <section class="wi-group" id={cat.id}>
        <h2 class="wi-group-title">
          <span class="wi-group-ic"><Icon name={cat.icon} size={20} /></span>
          <span>{cat.name}</span>
          <span class="wi-group-n">{cat.items.length}</span>
        </h2>
        <p class="wi-group-blurb" data-i18n={`wissen.cat.${cat.id}.blurb`}>{cat.blurb}</p>
        <div class="wi-grid">
          {/* A button, not a link: the card opens the sheet that says what is in
              the file, and the download happens from there. A 210 KB PDF that
              turns out to be the wrong level is a wasted download on a phone
              plan, and nothing here said which one it was. */}
          {cat.items.map((f) => (
            <button class="wi-card" type="button" data-file={f.id}>
              <span class="wi-badge">{f.level}</span>
              <b>{f.title}</b>
              {/* File titles stay German — they name a German-language PDF. The line
                  under each says what is inside it, which is the part worth translating. */}
              <i data-i18n={`wissen.file.${f.id}.desc`}>{f.desc}</i>
              <span class="wi-card-foot">
                <span class="wi-meta">
                  PDF{f.pages ? ` · ${f.pages} Seiten` : ""} · {f.size}
                  {f.editions.length > 0 && <span class="wi-meta-eds"> · +{f.editions.map((e) => e.lang.toUpperCase()).join("/")}</span>}
                </span>
                <span class="wi-dl" aria-hidden="true">↓</span>
              </span>
            </button>
          ))}
        </div>
      </section>
    ))}

    <section class="wi-group" id="offiziell">
      <h2 class="wi-group-title">
        <span class="wi-group-ic"><Icon name="landmark" size={20} /></span>
        <span>Offizielle Materialien</span>
        <span class="wi-group-n">{links.length}</span>
      </h2>
      <p class="wi-group-blurb" data-i18n="wissen.official.blurb">
        Modellsätze und Fragenkataloge der Prüfungsstellen. Die sind kostenlos, aber nicht unsere —
        deshalb verlinken wir sie dort, wo sie herausgegeben werden. Dort sind sie auch immer aktuell.
      </p>
      <ul class="wi-links">
        {links.map((l, i) => (
          <li>
            <a href={l.href} target="_blank" rel="noopener noreferrer">
              <b>{l.title}</b>
              <i data-i18n={`wissen.link.${i}.note`}>{l.note}</i>
              <span class="wi-source">{l.source} ↗</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="wi-rights">
      <h2 data-i18n="wissen.h2.sources">Woher das alles kommt</h2>
      {rightsNote.split("\n\n").map((p, i) => <p data-i18n={`wissen.rights.p${i + 1}`}>{p}</p>)}
      <p class="wi-rights-meta">
        Zusammen {totals.files} Dateien, {mb} MB. Erzeugt aus den Daten dieser Seite mit
        <code>pnpm generate:pdfs</code>.
      </p>
    </section>

    <!-- The sheet. Rendered here for all files rather than built by JS, so every
         title and table of contents is in the HTML for crawlers, and so a reader
         with no JS still gets the plain download links in the <noscript> below. -->
    <div class="wi-sheet-scrim" data-sheet-scrim hidden></div>
    <div class="wi-sheet" data-sheet hidden role="dialog" aria-modal="true" aria-labelledby="wi-sheet-title">
      {files.map((f) => (
        <div class="wi-sheet-body" data-sheet-for={f.id} hidden>
          <div class="wi-sheet-head">
            <span class="wi-badge">{f.level}</span>
            <button class="wi-sheet-x" type="button" data-sheet-close aria-label="Schließen">✕</button>
          </div>
          <h2 id="wi-sheet-title">{f.title}</h2>
          <p class="wi-meta">PDF{f.pages ? ` · ${f.pages} Seiten` : ""} · {f.size}</p>
          <p class="wi-sheet-desc">{f.desc}</p>

          {f.contents && f.contents.items.length > 0 && (
            <div class="wi-sheet-toc">
              <p class="wi-sheet-toclabel">{f.contents.label}</p>
              <ul>{f.contents.items.map((line) => <li>{line}</li>)}</ul>
            </div>
          )}

          <a class="wi-sheet-dl" href={f.href} download>
            <span aria-hidden="true">↓</span>
            <span>Jetzt herunterladen</span>
          </a>
          {/* The same list with the learner's language in the translation column. Each
              language is named in itself — that is the word its reader will spot. */}
          {f.editions.length > 0 && (
            <div class="wi-sheet-eds">
              <p class="wi-sheet-toclabel" data-i18n="wissen.editions.label">Mit Übersetzung in deine Sprache</p>
              <div class="wi-sheet-eds-row">
                {f.editions.map((e) => (
                  <a class="wi-sheet-ed" href={e.href} download lang={e.lang} dir={e.rtl ? "rtl" : undefined}>
                    <span>{e.label}</span>
                    <small dir="ltr">{e.size}</small>
                  </a>
                ))}
              </div>
            </div>
          )}
          <p class="wi-sheet-foot">Kostenlos, ohne Konto. Zum Ausdrucken und Weitergeben.</p>
        </div>
      ))}
    </div>
  </main>

  <noscript>
    <style>
      /* No JS: the cards cannot open anything, so the sheets are simply the list. */
      .wi-featured, .wi-grid { display: none; }
      .wi-sheet-scrim { display: none; }
      .wi-sheet, .wi-sheet-body { display: block !important; position: static; }
      .wi-sheet-body[hidden] { display: block !important; }
      .wi-sheet-x { display: none; }
    </style>
  </noscript>

  <script>
    // The download sheet. Every card is a button; the sheet it opens is already in
    // the page, one body per file, and only the matching one is shown.
    const sheet = document.querySelector<HTMLElement>("[data-sheet]");
    const scrim = document.querySelector<HTMLElement>("[data-sheet-scrim]");
    const bodies = Array.from(document.querySelectorAll<HTMLElement>("[data-sheet-for]"));
    let opener: HTMLElement | null = null;

    function closeSheet() {
      if (!sheet || sheet.hidden) return;
      sheet.hidden = true;
      if (scrim) scrim.hidden = true;
      document.body.classList.remove("wi-sheet-open");
      for (const b of bodies) b.hidden = true;
      // Back to the card it came from, so a keyboard reader does not land at the
      // top of the page after every look.
      opener?.focus();
      opener = null;
    }

    function openSheet(id: string, from: HTMLElement) {
      if (!sheet) return;
      let found = false;
      for (const b of bodies) {
        const on = b.dataset.sheetFor === id;
        b.hidden = !on;
        found ||= on;
      }
      if (!found) return;
      opener = from;
      sheet.hidden = false;
      if (scrim) scrim.hidden = false;
      document.body.classList.add("wi-sheet-open");
      sheet.scrollTop = 0;
      sheet.querySelector<HTMLElement>("[data-sheet-close]:not([hidden])")?.focus();
    }

    for (const card of Array.from(document.querySelectorAll<HTMLElement>("[data-file]"))) {
      card.addEventListener("click", () => openSheet(card.dataset.file!, card));
    }
    for (const x of Array.from(document.querySelectorAll<HTMLElement>("[data-sheet-close]"))) {
      x.addEventListener("click", closeSheet);
    }
    scrim?.addEventListener("click", closeSheet);
    document.addEventListener("keydown", (e) => { if (e.key === "Escape") closeSheet(); });
    // The download is the end of the errand: take the sheet away with it.
    for (const dl of Array.from(document.querySelectorAll<HTMLElement>(".wi-sheet-dl, .wi-sheet-ed"))) {
      dl.addEventListener("click", () => window.setTimeout(closeSheet, 150));
    }
  </script>
</Layout>
