---
// /uebungen/fertigkeiten — the Fertigkeiten hub.
//
// The nav's Fertigkeiten menu used to lead to /uebungen/sprechen: clicking the subject
// dropped the learner into the Bildbeschreibung trainer, one of four skills, with no way
// to see the other three except by reopening the menu. The subject now has a page of its
// own, and it answers the question the menu label asks — what is here for Hören, Lesen,
// Schreiben and Sprechen.
//
// The four cards are the page's navigation, not a preview of it: picking one swaps the
// list below instead of scrolling to it. Written out end to end the page was 23 rows in a
// single column — a screen and a half of scrolling on a desktop, with the right half of
// the page empty — and the cards at the top repeated every count in it. One skill at a
// time, its levels side by side, is the same shape the nav panel uses for this subject.
//
// Built from the same `skills` the nav panel reads (src/lib/catalog.js), so the counts and
// the level coverage here cannot drift from the menu: both are measured from the material.
import Layout from "../../layouts/Layout.astro";
import SiteNav from "../../components/SiteNav.astro";
import Icon from "../../components/Icon.astro";
import { skills } from "../../lib/catalog.js";
import "../../styles/practice.css";

// What each skill is, in one line. Not in catalog.js: the nav shows these as tabs with a
// count and has no room for a sentence, so this is the only place that needs them.
const LEAD = {
  hoeren: "Durchsagen, Telefonate, Gespräche und Radiobeiträge — mit Fragen, Transkript und langsamer Wiedergabe.",
  lesen: "Schilder, Anzeigen, E-Mails, Zeitungsartikel und Forumsbeiträge — mit Fragen und Erklärungen.",
  schreiben: "Formulare, Nachrichten und Briefe — mit Leitpunkten, Redemitteln und Modelltext.",
  sprechen: "Sich vorstellen, Bilder beschreiben, planen, Kurzvortrag und Diskussion — mit Timer.",
};

// The DTZ parts, folded into one row each.
//
// Lesen's B1 column listed "DTZ Aufgabe 1" through "DTZ Aufgabe 4" and Schreiben's listed
// two more: six of the eleven rows on this page were one exam, itemised, which made B1
// look like the level with the most choice when it is really the level with one long
// simulation. They are one row here and stay four and two on the skill's own page, where
// picking a single Aufgabe is the point. The row opens the first part; every task page
// carries prev/next, so the sequence still walks end to end.
const DTZ_ROW = { lesen: "DTZ Leseverstehen", schreiben: "DTZ Schreiben" };

/** Minutes out of a count line like "Anzeigen · ca. 8 Min." — null if it does not say. */
const minutesIn = (count) => {
  const m = /ca\.\s*(\d+)\s*Min/.exec(count ?? "");
  return m ? Number(m[1]) : null;
};

function foldDtz(items, skillId) {
  const dtz = items.filter((i) => i.title.startsWith("DTZ"));
  // Sprechen's "Bildbeschreibung (DTZ)" is a standalone trainer, not part of a run, and
  // it does not start with the word — which is exactly why the test is a prefix.
  if (dtz.length < 2) return items;

  const minutes = dtz.map((i) => minutesIn(i.count));
  const total = minutes.every((n) => n !== null) ? minutes.reduce((a, b) => a + b, 0) : null;
  const folded = {
    ...dtz[0],
    title: DTZ_ROW[skillId] ?? "DTZ-Aufgaben",
    count: `${dtz.length} Aufgaben${total ? ` · ca. ${total} Min.` : ""}`,
  };
  const rest = items.filter((i) => !i.title.startsWith("DTZ"));
  // Where the run stood, not appended: B1 reads "Kurztext, dann die Prüfung".
  const at = items.indexOf(dtz[0]);
  return [...rest.slice(0, at), folded, ...rest.slice(at)];
}

const views = skills.map((skill) => {
  const items = skill.levels.flatMap((lv) => lv.items);
  // All four skills own a hub with a route per exercise now. Lesen and Schreiben used to
  // share one B1 page between them, which is why this used to have to pick an anchor
  // instead of a link — and why the counts here used to say "2" and "16" while meaning
  // "two sections" and "sixteen exercises".
  const href = skill.href;
  return {
    ...skill,
    lead: LEAD[skill.id],
    leadKey: `fertigkeiten.lead.${skill.id}`,
    href,
    linkLabel: `Alle ${skill.total} ansehen`,
    linkLabelVars: { n: skill.total },
    cols: skill.levels
      .filter((lv) => lv.items.length > 0)
      .map((lv) => ({ ...lv, items: foldDtz(lv.items, skill.id) })),
    levels: skill.levels.map((lv) => ({ ...lv, has: lv.items.length > 0 })),
    items,
  };
});

const exerciseCount = views.reduce((n, s) => n + s.total, 0);
// Open on the skill with the most behind it rather than on the first in the list: an empty
// or two-row panel under four cards reads as a page that failed to load.
const opening = views.reduce((best, s) => (s.total > best.total ? s : best), views[0]);
---
<Layout
  title="Fertigkeiten üben: Hören, Lesen, Schreiben, Sprechen – DeutschAcademy"
  description="Die vier Fertigkeiten an einem Ort: Hörverstehen von A1 bis B2, DTZ-Leseverstehen, die Schreibteile des DTZ und Sprechen mit echten Prüferfragen — mit Niveau zu jeder Übung."
>
  <SiteNav active="fertigkeiten" />
  <main class="practice-main practice-main--wide">
    <div class="practice-hero practice-hero--tight">
      <p class="eyebrow" data-i18n="nav.subject.fertigkeiten">Fertigkeiten</p>
      <h1 data-i18n="fertigkeiten.hero.title">Hören, Lesen, Schreiben, Sprechen</h1>
      <p data-i18n="fertigkeiten.hero.lead" data-i18n-vars={JSON.stringify({ n: exerciseCount })}>
        Die vier Fertigkeiten, die DTZ und telc einzeln prüfen — {exerciseCount} Übungen im Prüfungsformat.
      </p>
    </div>

    <div class="fk-grid" role="tablist" aria-label="Fertigkeiten" data-i18n-attr="aria-label:nav.subject.fertigkeiten">
      {views.map((skill) => (
        <button
          class:list={["fk-card", skill.id === opening.id && "is-on"]}
          type="button"
          role="tab"
          id={`fk-tab-${skill.id}`}
          aria-selected={skill.id === opening.id ? "true" : "false"}
          aria-controls={`fk-panel-${skill.id}`}
          data-fk-tab={skill.id}
        >
          <span class="fk-card-head">
            <span class="fk-card-ic"><Icon name={skill.icon} size={20} /></span>
            <b data-i18n={skill.nameKey}>{skill.name}</b>
            <span class="fk-card-count" data-i18n="nav.skill.count" data-i18n-vars={JSON.stringify({ n: skill.total })}>{skill.total}&nbsp;Übungen</span>
          </span>
          <span class="fk-card-lead" data-i18n={skill.leadKey}>{skill.lead}</span>
          <!-- Coverage, not navigation: a level with nothing behind it stays visible and
               greyed rather than disappearing, because "B2 kommt noch" is the honest
               answer to "was gibt es hier für mich". -->
          <span class="fk-levels" aria-hidden="true">
            {skill.levels.map((lv) => (
              <span class:list={["fk-level", lv.has && "is-on"]}>{lv.level}</span>
            ))}
          </span>
        </button>
      ))}
    </div>

    <!-- Aussprache is not one of the four — no exam tests it as its own Teil, so it has
         no level-indexed task list and would render as four empty columns if it were a
         tab here. It is still the other half of "listen to German", which is how the
         landing grid now offers it, so it gets a line of its own rather than a tab. -->
    <p class="fk-aside">
      <span data-i18n="fertigkeiten.aside">Einzelne Wörter statt ganzer Texte?</span>
      <a href="/uebungen/aussprache" data-i18n="fertigkeiten.toAussprache">Zum Aussprache-Training →</a>
    </p>

    {views.map((skill) => (
      <section
        class="fk-panel"
        id={`fk-panel-${skill.id}`}
        role="tabpanel"
        aria-labelledby={`fk-tab-${skill.id}`}
        data-fk-panel={skill.id}
        hidden={skill.id !== opening.id}
      >
        <div class="fk-panel-head">
          <h2>
            <span data-i18n={skill.nameKey}>{skill.name}</span>
            <span class="fk-panel-count" data-i18n="nav.skill.count" data-i18n-vars={JSON.stringify({ n: skill.total })}>{skill.total} Übungen</span>
          </h2>
          <a class="fk-panel-all" href={skill.href}>
            <span data-i18n="fertigkeiten.seeAll" data-i18n-vars={JSON.stringify(skill.linkLabelVars)}>{skill.linkLabel}</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>

        {/* One column per level, not one list under four headings: Hören's sixteen rows
            were a column as tall as the screen with the other half of the page blank. */}
        {skill.cols.length > 0 ? (
          <div class="fk-cols">
            {skill.cols.map((lv) => (
              <div class="fk-col">
                <p class="fk-col-head">
                  <span class="fk-col-level">{lv.level}</span>
                  <span class="fk-col-blurb" data-i18n={lv.blurbKey}>{lv.blurb}</span>
                </p>
                <ul class="fk-list">
                  {lv.items.map((item) => (
                    <li>
                      <a href={item.href}>
                        <b>{item.title}</b>
                        {item.count && (
                          <i>
                            {item.meta
                              ? <>
                                  <span data-i18n={item.meta.typeKey}>{item.meta.typeText}</span>
                                  {" · "}
                                  <span data-i18n={item.meta.countKey} data-i18n-vars={JSON.stringify(item.meta.countVars)}>{item.meta.countText}</span>
                                </>
                              : item.count}
                          </i>
                        )}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        ) : (
          <p class="fk-empty" data-i18n="fertigkeiten.empty">Übungen für diese Fertigkeit folgen.</p>
        )}
      </section>
    ))}
  </main>
</Layout>

<style>
/* The Aussprache line. Quiet: it is an aside to the four, not a fifth of them, and a
   card here would say otherwise. */
.fk-aside {
  margin: -6px 0 26px;
  font-size: var(--text-sm);
  color: var(--muted);
}
.fk-aside a { color: var(--brand-blue-dark); font-weight: var(--fw-semibold); text-decoration: none; }
.fk-aside a:hover { text-decoration: underline; }

  /* The hero on a hub is a signpost, not a chapter opening: left-aligned and small enough
     that the first card is on the screen at 390px. Both classes on every selector — the
     shared .practice-hero rules in practice.css centre the same three elements at the same
     specificity, and they are loaded after this. */
  .practice-hero.practice-hero--tight { text-align: left; margin-bottom: 22px; }
  .practice-hero.practice-hero--tight .eyebrow { text-align: left; }
  .practice-hero.practice-hero--tight h1 { margin: 2px 0 6px; font-size: clamp(1.5rem, 4vw, 2.1rem); }
  .practice-hero.practice-hero--tight p { margin: 0; max-width: 62ch; font-size: .95rem; }

  .fk-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    margin-bottom: 26px;
  }
  @media (max-width: 1100px) { .fk-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .fk-grid { grid-template-columns: 1fr; gap: 8px; } }

  /* A card is a tab: it swaps the list below rather than leaving the page, so it carries a
     selected state and no arrow. The link out lives in the panel's head, where it can say
     where it goes. */
  .fk-card {
    display: grid;
    gap: 8px;
    align-content: start;
    padding: 16px;
    text-align: left;
    font: inherit;
    color: var(--ink);
    background: var(--surface-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    cursor: pointer;
    transition: border-color .15s ease, background-color .15s ease, box-shadow .15s ease;
  }
  .fk-card:hover { border-color: var(--blue-200); }
  .fk-card:focus-visible { outline: 2px solid var(--brand-blue); outline-offset: 2px; }
  .fk-card.is-on {
    border-color: var(--brand-blue);
    background: var(--blue-50);
    box-shadow: 0 6px 18px rgba(13, 148, 136, .10);
  }

  .fk-card-head { display: flex; align-items: center; gap: 9px; }
  .fk-card-head b { font-size: .975rem; font-weight: var(--fw-semibold); }
  .fk-card-ic {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    flex-shrink: 0;
    border-radius: 10px;
    background: var(--gradient-brand-soft);
    color: var(--brand-blue-dark);
  }
  .fk-card.is-on .fk-card-ic { background: var(--brand-blue); color: #fff; }
  .fk-card-count {
    margin-left: auto;
    font-size: .72rem;
    font-weight: var(--fw-semibold);
    color: var(--brand-blue-dark);
    white-space: nowrap;
  }
  /* The sentence is for choosing between the four; once chosen, the panel below says the
     same thing with its actual rows. On a phone, four of them push the first exercise off
     the screen, so only the selected card keeps its line. */
  .fk-card-lead { font-size: .8125rem; line-height: 1.45; color: var(--muted); }
  @media (max-width: 560px) {
    .fk-card:not(.is-on) .fk-card-lead { display: none; }
  }

  .fk-levels { display: flex; gap: 5px; }
  .fk-level {
    padding: 1px 7px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border);
    font-size: .68rem;
    font-weight: var(--fw-semibold);
    letter-spacing: .04em;
    color: var(--muted);
  }
  .fk-level.is-on { background: var(--gradient-brand-soft); border-color: transparent; color: var(--brand-blue-dark); }
  .fk-card.is-on .fk-level { border-color: var(--blue-200); }
  .fk-card.is-on .fk-level.is-on { background: #fff; border-color: transparent; }

  /* --- the selected skill ---------------------------------------------------- */

  .fk-panel { animation: fkIn .22s cubic-bezier(.2,.8,.25,1) both; }
  @keyframes fkIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }

  .fk-panel-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 14px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--border);
  }
  .fk-panel-head h2 {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 0;
    font-size: 1.05rem;
    font-weight: var(--fw-semibold);
  }
  .fk-panel-count { font-size: .78rem; font-weight: var(--fw-regular); color: var(--muted); }
  .fk-panel-all {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: .8rem;
    color: var(--brand-blue);
    text-decoration: none;
    white-space: nowrap;
  }
  .fk-panel-all:hover { text-decoration: underline; }

  .fk-cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 8px 26px;
  }
  .fk-col-head {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 6px;
    padding-bottom: 6px;
    border-bottom: 1px solid var(--border);
  }
  .fk-col-level {
    padding: 2px 9px;
    border-radius: var(--radius-pill);
    background: var(--gradient-brand-soft);
    color: var(--brand-blue-dark);
    font-size: .72rem;
    font-weight: var(--fw-semibold);
  }
  .fk-col-blurb {
    font-size: .7rem;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: var(--muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .fk-list { list-style: none; margin: 0 0 18px; padding: 0; display: grid; gap: 2px; }
  .fk-list a {
    display: block;
    padding: 7px 10px;
    margin-inline: -10px;
    border-radius: 10px;
    text-decoration: none;
    color: var(--ink);
    transition: background-color .15s ease;
  }
  .fk-list a:hover { background: var(--surface-sunken, rgba(0, 0, 0, .04)); }
  .fk-list b { display: block; font-size: .9rem; font-weight: var(--fw-regular); line-height: 1.35; }
  .fk-list i { display: block; font-style: normal; font-size: .75rem; color: var(--muted); }

  .fk-empty { margin: 0; font-size: .875rem; color: var(--muted); }

  @media (prefers-reduced-motion: reduce) {
    .fk-card { transition: none; }
    .fk-panel { animation: none; }
  }
</style>

<script>
  // Tabs, keyed like the nav's own sub-section tabs (NavMenubar.astro): click switches,
  // hover does not — a pointer crossing the row on its way to the card it wants would
  // otherwise swap the list underneath it twice. Arrow keys move between the four, because
  // a tablist that only answers the mouse is a tablist a keyboard cannot use.
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-fk-tab]"));
  const panels = Array.from(document.querySelectorAll<HTMLElement>("[data-fk-panel]"));

  function show(id: string, focus = false) {
    for (const tab of tabs) {
      const on = tab.dataset.fkTab === id;
      tab.classList.toggle("is-on", on);
      tab.setAttribute("aria-selected", String(on));
      tab.tabIndex = on ? 0 : -1;
      if (on && focus) tab.focus();
    }
    for (const panel of panels) {
      if (panel.dataset.fkPanel === id) panel.removeAttribute("hidden");
      else panel.setAttribute("hidden", "");
    }
    // The chosen skill survives a trip into an exercise and back, so returning from
    // "Ansage am Bahnhof" does not land on Hören-by-default all over again.
    try { sessionStorage.setItem("da-fertigkeiten-tab", id); } catch {}
  }

  tabs.forEach((tab, i) => {
    tab.tabIndex = tab.getAttribute("aria-selected") === "true" ? 0 : -1;
    tab.addEventListener("click", () => show(tab.dataset.fkTab!));
    tab.addEventListener("keydown", (e) => {
      const step = e.key === "ArrowRight" || e.key === "ArrowDown" ? 1
        : e.key === "ArrowLeft" || e.key === "ArrowUp" ? -1
        : e.key === "Home" ? -i
        : e.key === "End" ? tabs.length - 1 - i
        : 0;
      if (!step) return;
      e.preventDefault();
      show(tabs[(i + step + tabs.length) % tabs.length].dataset.fkTab!, true);
    });
  });

  const known = (id: string) => tabs.some((t) => t.dataset.fkTab === id);

  // A #hoeren style link (or the remembered choice) opens that skill rather than the
  // default one. hashchange as well as load: a link to #sprechen from elsewhere on this
  // page never reloads it, so without this the hash would change and nothing would move.
  function fromHash() {
    const id = location.hash.slice(1);
    if (known(id)) show(id);
  }
  addEventListener("hashchange", fromHash);

  if (known(location.hash.slice(1))) {
    fromHash();
  } else {
    let saved = "";
    try { saved = sessionStorage.getItem("da-fertigkeiten-tab") ?? ""; } catch {}
    if (known(saved)) show(saved);
  }
</script>
