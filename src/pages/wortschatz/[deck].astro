---
// Every Wortschatz deck that comes out of the lexicon, at one URL shape.
//
// Two kinds share the segment, which is why this is `[deck]` and not `[level]`:
//   /wortschatz/a1                the whole level — what the nav's Niveaus menu
//                                          means by "Wortliste A1"
//   /wortschatz/a1-04             one Lernset — ~25 words, one sitting, the unit
//                                          the picker and program.json are built around
//   /wortschatz/a1-teil-03        one Portion — the level's own list cut every 20
//                                          words, for someone working a level in order
//                                          rather than picking a topic
//   /wortschatz/haeufigkeit-001   one frequency cohort — the 25 most common words
//                                          in the lexicon, then the next 20, and so on
//
// A route per deck rather than ?set= on one page: A1+A2+B1+B2 is 2750 cards between them,
// and on the phones most of these learners use, shipping the other decks as dead JSON is
// the difference between a fast page and a slow one. A Lernset page carries 25 cards.
//
// Only decks the lexicon has actually filled get a page. A unit that program.json plans
// but has no words for gets no route at all — the picker names it as planned instead.
import Layout from "../../layouts/Layout.astro";
import VokabelTrainer from "../../components/VokabelTrainer.astro";
import { LEVELS, asVokabelCards, langsOf, units } from "../../lib/lexicon.js";
import {
  lernsets, lernset, lernsetCards,
  cohorts, cohort, cohortCards,
  portions, portion, portionCards,
} from "../../lib/lernsets.js";

export function getStaticPaths() {
  const levels = LEVELS.map((level) => ({
    params: { deck: level.toLowerCase() },
    props: { kind: "level", level },
  }));

  const sets = lernsets({ status: "built" }).map((set) => ({
    params: { deck: set.id },
    props: { kind: "set", setId: set.id },
  }));

  // A cohort is 25 words with a translation by construction, so there is nothing to
  // filter out the way a half-written Lernset needs.
  const freq = cohorts().map((c) => ({
    params: { deck: c.id },
    props: { kind: "cohort", cohortId: c.id },
  }));

  // A Portion is 25 words that already passed the `has: "en"` filter, so like a cohort it
  // cannot be empty by construction.
  const teile = portions().map((p) => ({
    params: { deck: p.id },
    props: { kind: "portion", portionId: p.id },
  }));

  return [
    ...levels.filter((p) => asVokabelCards({ level: p.props.level }).length > 0),
    ...teile,
    ...sets.filter((p) => lernsetCards(p.props.setId).length > 0),
    ...freq,
  ];
}

const { kind, level, setId, cohortId, portionId } = Astro.props;

const set = kind === "set" ? lernset(setId) : null;
const freq = kind === "cohort" ? cohort(cohortId) : null;
const teil = kind === "portion" ? portion(portionId) : null;
const cards =
  kind === "set" ? lernsetCards(setId)
  : kind === "cohort" ? cohortCards(cohortId)
  : kind === "portion" ? portionCards(portionId)
  : asVokabelCards({ level });

// Which language tabs this deck earns. Not hard-coded: the ar/ru/tr sidecars
// (src/content/lexicon/i18n/) are filled level by level, and langsOf() only names a
// language once every card in *this* deck has it — so a deck gains its fourth tab the
// day its last word is translated and not one card sooner.
const langs = langsOf(cards);

// A round is named by a few of its own words ("Abend · Haus · Freund"), the same name it
// has in the picker — not "Wörter 76-100", a place in a list the learner has never seen.
// German words, so the heading carries no translation key.
const heading =
  set ? set.title
  : freq ? freq.lead.join(" · ")
  : teil ? teil.lead.join(" · ")
  : `Wortschatz ${level}`;
const deckId = set ? set.id : freq ? freq.id : teil ? teil.id : level.toLowerCase();

// A Lernset's name is a category label, not vocabulary, so it translates. The other three
// deck kinds are generated descriptions and get their own keys below.
const headingKey =
  set ? `ws.set.${set.id}`
  : freq || teil ? undefined
  : "ws.deck.level.title";
const headingVars = set || freq || teil ? undefined : { level };

// The line under the heading answers "what am I in". For a Lernset that is its module —
// "Haus & Räume" means something different inside "Wohnen" than it would on its own. For a
// cohort it is the level spread, because a frequency cut crosses levels by construction.
// A Portion has no name of its own — it is a window onto the level list — so the line
// under the heading carries the topics it happens to cross instead.
const words = (n) => ({ text: `${n} Wörter`, key: "sets.wordCount", vars: { n } });
const setKeyByTitle = Object.fromEntries(units().map((u) => [u.title, `ws.set.${u.id}`]));
const subParts =
  set ? [
    { text: set.level },
    ...(set.moduleTitle ? [{ text: set.moduleTitle, key: `ws.module.${set.moduleId ?? ""}` }] : []),
    words(set.words),
  ]
  : freq ? [
    { text: "Nach Häufigkeit", key: "sets.byFrequency" },
    { text: freq.levels.join("–") },
    words(freq.words),
  ]
  : teil ? [
    { text: teil.level },
    // teil.topics carries set titles; their keys are by set id (as in LernsetPicker).
    ...teil.topics.map((t) => ({ text: t, key: setKeyByTitle[t] })),
    words(teil.words),
  ]
  // The level deck runs in Runden of 25 (PART_SIZE in wortschatz-app.js), so the line says
  // what a sitting is rather than what the pile is: "26 Runden · je 25 Wörter", not "650
  // Wörter". The total is still one multiplication away and the picker below spells it out.
  : [
    { text: level },
    { text: `${Math.ceil(cards.length / 25)} Runden · je 25 Wörter`, key: "sets.rounds", vars: { n: Math.ceil(cards.length / 25), size: 25 } },
  ];
const sub = subParts.map((p) => p.text).join(" · ");

const title =
  set ? `${set.title} (${set.level}) – Wortschatz – DeutschAcademy`
  : freq ? `Die häufigsten deutschen Wörter ${freq.from}-${freq.to} – DeutschAcademy`
  : teil ? `${teil.level} Wortschatz Teil ${teil.index}: Wörter ${teil.from}-${teil.to} – DeutschAcademy`
  : `Wortliste ${level} – DeutschAcademy`;
const description =
  set ? `Lernset ${set.id}: ${set.words} Wörter zum Thema „${set.title}" als Karteikarten — umdrehen, lernen, testen.`
  : freq ? `Die Wörter ${freq.from} bis ${freq.to} der deutschen Häufigkeitsliste als Karteikarten — gemischt aus Verben, Nomen und Funktionswörtern, nach Korpushäufigkeit sortiert.`
  : teil ? `Wörter ${teil.from} bis ${teil.to} der Stufe ${teil.level} als Karteikarten — eine Portion zu ${teil.words} Wörtern, eine Sitzung.`
  : `Die ${cards.length} Wörter der Stufe ${level} als Karteikarten: umdrehen, lernen, testen.`;
---
<Layout title={title} description={description}>
  <VokabelTrainer
    cards={cards}
    heading={heading}
    headingKey={headingKey}
    headingVars={headingVars}
    sub={sub}
    subParts={subParts}
    deck={deckId}
    langs={langs}
  />
</Layout>
