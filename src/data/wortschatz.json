  { "front": "Wie viel Geld wollen wir ausgeben?", "note": "Budget-Frage beim Planen", "translations": { "en": "How much money do we want to spend?", "ar": "كم من المال نريد أن ننفق؟", "ru": "Сколько денег мы хотим потратить?", "tr": "Ne kadar para harcamak istiyoruz?" } }
