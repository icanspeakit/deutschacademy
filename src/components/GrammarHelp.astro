---
// The switch for a grammar topic's rule in the learner's own language — see
// mountGrammarHelp in src/lib/textHelp.js. The translations themselves are rendered next
// to each German block by GrammarHelpText.astro; this is only the control, and it binds to
// the page root so one switch drives every block on the page, in both Üben and Aktiv.
import { HELP_LANGS } from "../lib/textHelp.js";
import "../styles/help-langs.css";
import "../styles/grammar-help.css";

interface Props {
  level: string;
  /** False while the translation is a draft nobody has checked. */
  reviewed?: boolean;
}
const { level, reviewed = false } = Astro.props;
---
<div class="gx-bar" data-gx-bar data-level={level}>
  <button type="button" class="gx-toggle" data-gx-toggle aria-pressed="false">
    <span class="gx-toggle-dot" aria-hidden="true"></span>
    <span data-i18n="gx.toggle">Regel in meiner Sprache</span>
  </button>
  <div class="help-langs" role="group" aria-label="Sprache der Erklärung">
    {HELP_LANGS.map((l) => (
      <button type="button" class="help-lang" data-help-lang={l.code} lang={l.code} aria-pressed="false">{l.label}</button>
    ))}
  </div>
  {!reviewed && (
    <p class="help-draft gx-draft" data-i18n="gx.draft">Übersetzung: maschineller Entwurf, noch nicht von einer Lehrkraft geprüft.</p>
  )}
</div>

<script>
  import { mountGrammarHelp } from "../lib/textHelp.js";
  const bar = document.querySelector<HTMLElement>("[data-gx-bar]");
  const root = document.getElementById("vp-page");
  if (bar && root) mountGrammarHelp(root, bar, { level: bar.dataset.level });
</script>
