---
// The /uebungen hub doubles as a personal dashboard: streak, weekly goal, per-skill accuracy and
// a "today" checklist, all computed client-side from real activity recorded in localStorage by
// src/lib/progress.js (see recordAttempt/recordSession calls across the exercise tools below).
// There is no account system and no invented curriculum-completion percentage — every number
// shown here is either directly counted from real recorded activity, or absent until it exists.
import Layout from "../../layouts/Layout.astro";
import PracticeHeader from "../../components/PracticeHeader.astro";
import "../../styles/practice.css";
import "../../styles/dashboard.css";
import "../../styles/components.css";
import artikel from "../../data/artikel.json";
import grammatik from "../../data/grammatik.json";
import wortschatz from "../../data/wortschatz.json";
import sprechen from "../../data/sprechen.json";
import lesen from "../../data/lesen.json";
import kultur from "../../data/kultur.json";

const grammarQuestionCount = grammatik.reduce((sum, t) => sum + t.questions.length, 0);
const readingQuestionCount = lesen.groups.reduce((sum, g) => sum + g.questions.length, 0);

const tools = [
  {
    href: "/uebungen/artikel-trainer",
    icon: "🎯",
    title: "der/die/das-Trainer",
    desc: "Schnelles Artikel-Training: der, die oder das? Tippe die Antwort, sofortiges Feedback.",
    count: `${artikel.length} Nomen`,
  },
  {
    href: "/uebungen/grammatik",
    icon: "📚",
    title: "Grammatik-Quiz",
    desc: "Lückentext-Übungen zu Akkusativ, Dativ, Passiv, Konjunktiv II, Relativpronomen und trennbaren Verben.",
    count: `${grammatik.length} Themen · ${grammarQuestionCount} Fragen`,
  },
  {
    href: "/uebungen/wortschatz",
    icon: "🗂️",
    title: "Wortschatz & Redemittel",
    desc: "Karteikarten mit nützlichen Redemitteln und Alltagsvokabeln zum Umdrehen und Wiederholen.",
    count: `${wortschatz.length} Karten`,
  },
  {
    href: "/uebungen/aussprache",
    icon: "🔊",
    title: "Aussprache-Training",
    desc: "Wörter und Redemittel anhören und die Aussprache üben, mit Langsam-Modus für schwierige Laute.",
    count: `${wortschatz.length + artikel.length} Wörter & Phrasen`,
  },
  {
    href: "/uebungen/sprechen",
    icon: "🗣️",
    title: "Sprechen: Bildbeschreibung",
    desc: "Echte DTZ-Prüferfragen zur Bildbeschreibung, mit 90-Sekunden-Timer wie in der echten Prüfung.",
    count: `${sprechen.length} Bilder`,
  },
  {
    href: "/uebungen/lesen-schreiben",
    icon: "✍️",
    title: "Lesen & Schreiben",
    desc: "Eine vollständige DTZ-Leseverstehen-Simulation mit Lösungen, plus Schreibaufgaben zum Üben.",
    count: `${readingQuestionCount} Leseaufgaben`,
  },
  {
    href: "/uebungen/kultur",
    icon: "🗺️",
    title: "Kulturwissen",
    desc: "Kurze Einblicke in Gesellschaft und Alltag in Deutschland, aus echten Unterrichtsgesprächen.",
    count: `${kultur.length} Thema${kultur.length === 1 ? "" : "n"}`,
  },
];
---
<Layout title="Übungen – DeutschAcademy">
  <PracticeHeader title="Übungen" />
  <main class="practice-main">
    <div class="tabs dash-tabs" role="tablist" id="dash-tabs">
      <button class="tab-btn active" type="button" data-view="today" role="tab" aria-selected="true">Heute</button>
      <button class="tab-btn" type="button" data-view="skills" role="tab" aria-selected="false">Fähigkeiten</button>
      <button class="tab-btn" type="button" data-view="progress" role="tab" aria-selected="false">Fortschritt</button>
    </div>

    <section class="dash-view" id="view-today">
      <section class="dash-hero">
        <div class="dash-hero-main">
          <span class="dash-badge" id="dash-badge">Lade…</span>
          <h1 id="dash-headline">Willkommen zurück!</h1>
          <p class="dash-subtitle" id="dash-subtitle"></p>
          <div class="dash-progress-row">
            <div class="dash-progress-track"><span class="dash-progress-fill" id="dash-progress-fill" style="width:0%"></span></div>
            <span class="dash-progress-label" id="dash-progress-label"></span>
          </div>
          <div class="dash-hero-actions">
            <a class="quiz-btn quiz-btn--primary" id="dash-cta" href="/uebungen/wortschatz">Jetzt loslegen →</a>
            <span id="dash-goal-slot"><button class="dash-link-btn" id="dash-goal-btn" type="button">Wochenziel anpassen</button></span>
          </div>
          <span id="dash-name-slot"><button class="dash-link-btn" id="dash-name-btn" type="button">Namen hinzufügen</button></span>
        </div>
        <div class="dash-stat-grid">
          <div class="dash-stat-tile"><span class="dash-stat-label">Serie</span><span class="dash-stat-value" id="stat-streak">–</span></div>
          <div class="dash-stat-tile"><span class="dash-stat-label">Wörter gelernt</span><span class="dash-stat-value" id="stat-vocab">–</span></div>
          <div class="dash-stat-tile"><span class="dash-stat-label">Diese Woche</span><span class="dash-stat-value" id="stat-week">–</span></div>
          <div class="dash-stat-tile"><span class="dash-stat-label">Richtig</span><span class="dash-stat-value" id="stat-accuracy">–</span></div>
        </div>
      </section>

      <div class="dash-columns">
        <div class="dash-card">
          <h2>Heute für dich</h2>
          <div id="dash-today-list"></div>
        </div>
        <div class="dash-card">
          <h2>Fähigkeiten</h2>
          <div id="dash-skills-list" style="display:flex;flex-direction:column;gap:12px;"></div>
        </div>
        <div class="dash-card dash-card--exam">
          <div style="display:flex;flex-direction:column;gap:8px;">
            <h2>Prüfungsvorbereitung</h2>
            <p>DTZ-Simulation und der Einbürgerungstest „Leben in Deutschland“, mit echtem Prüfungsformat.</p>
          </div>
          <a class="quiz-btn quiz-btn--primary" href="/pruefungen">Zu den Prüfungen →</a>
        </div>
      </div>
    </section>

    <section class="dash-view" id="view-skills" hidden>
      <div class="dash-view-head">
        <h2>Deine Fähigkeiten im Überblick</h2>
        <p class="dash-view-note">Ring = aktueller Stand je Fähigkeit</p>
      </div>
      <div class="dash-skills-layout">
        <div class="dash-skills-left">
          <div class="dash-skill-grid" id="dash-skill-grid"></div>
          <div class="dash-card dash-radar-card">
            <div class="dash-radar-svg-wrap" id="dash-radar"></div>
            <div class="dash-radar-copy">
              <h3>Dein Fähigkeitsprofil</h3>
              <p id="dash-radar-text"></p>
            </div>
          </div>
        </div>
        <div class="dash-skills-right">
          <div class="dash-callout" id="dash-callout"></div>
          <div class="dash-card">
            <p class="dash-view-note" style="margin:0 0 14px;">Diese Woche</p>
            <div class="dash-week-bars" id="dash-week-bars"></div>
            <p id="dash-week-summary" class="dash-week-summary"></p>
          </div>
        </div>
      </div>
    </section>

    <section class="dash-view" id="view-progress" hidden>
      <div class="dash-console">
        <div class="dash-console-sidebar" id="dash-console-sidebar"></div>
        <div class="dash-console-main" id="dash-console-main"></div>
      </div>
    </section>

    <div class="practice-hero" style="margin-top:8px;">
      <p class="eyebrow">Alle Übungen</p>
      <h2>Jedes Werkzeug einzeln</h2>
    </div>
    <div class="tool-grid">
      {tools.map((t) => (
        <a class="tool-card" href={t.href}>
          <div class="tool-card-icon">{t.icon}</div>
          <h3>{t.title}</h3>
          <p>{t.desc}</p>
          <span class="tool-card-count">{t.count}</span>
        </a>
      ))}
    </div>
  </main>

  <script type="module">
    import { getProgress, getWeeklyCount, getWeeklyGoal, setWeeklyGoal, getDisplayName, setDisplayName, activeToday } from "../../lib/progress.js";

    const SKILLS = [
      { key: "wortschatz", icon: "🗂️", label: "Wortschatz", href: "/uebungen/wortschatz", type: "accuracy" },
      { key: "grammatik", icon: "📚", label: "Grammatik", href: "/uebungen/grammatik", type: "accuracy" },
      { key: "hoeren", icon: "🔊", label: "Hören", href: "/uebungen/aussprache", type: "sessions" },
      { key: "sprechen", icon: "🗣️", label: "Sprechen", href: "/uebungen/sprechen", type: "sessions" },
      { key: "schreiben", icon: "✍️", label: "Schreiben", href: "/uebungen/lesen-schreiben", type: "accuracy" },
    ];

    function esc(s) {
      const div = document.createElement("div");
      div.textContent = s;
      return div.innerHTML;
    }

    function greetingWord() {
      const h = new Date().getHours();
      if (h < 11) return "Guten Morgen";
      if (h < 18) return "Guten Tag";
      return "Guten Abend";
    }

    function todayStr(d = new Date()) {
      return d.toISOString().slice(0, 10);
    }

    function daysAgoStr(n) {
      const d = new Date();
      d.setDate(d.getDate() - n);
      return todayStr(d);
    }

    function relativeDate(dateStr) {
      if (!dateStr) return "Noch nie";
      if (dateStr === todayStr()) return "Heute";
      if (dateStr === daysAgoStr(1)) return "Gestern";
      const days = Math.round((new Date(todayStr()) - new Date(dateStr)) / 86400000);
      if (days > 0 && days < 60) return `Vor ${days} Tagen`;
      return "Vor Längerem";
    }

    // Same accuracy-or-session-count mastery proxy already used for the "Fähigkeiten" mini list
    // below — centralized here so the Fähigkeiten and Fortschritt tabs stay consistent with it.
    function skillStats(data) {
      return SKILLS.map((s) => {
        const st = data.skills[s.key];
        const hasData = s.type === "accuracy" ? !!(st && st.attempts > 0) : !!(st && st.sessions > 0);
        let mastery = 0;
        if (s.type === "accuracy" && st && st.attempts > 0) mastery = Math.round((st.correct / st.attempts) * 100);
        else if (s.type === "sessions" && st) mastery = Math.min(100, st.sessions * 10);
        return {
          ...s,
          attempts: st?.attempts || 0,
          correct: st?.correct || 0,
          sessions: st?.sessions || 0,
          lastActiveDate: st?.lastActiveDate || null,
          hasData,
          mastery,
        };
      });
    }

    function ringColor(hasData, mastery) {
      if (!hasData) return "var(--border-strong)";
      if (mastery < 55) return "var(--danger)";
      if (mastery < 75) return "var(--accent)";
      return "var(--success)";
    }

    function ringSvg(stat) {
      const r = 34;
      const circ = 2 * Math.PI * r;
      const offset = circ * (1 - stat.mastery / 100);
      const color = ringColor(stat.hasData, stat.mastery);
      return `<svg width="72" height="72" viewBox="0 0 84 84">
        <circle cx="42" cy="42" r="${r}" fill="none" stroke="var(--border)" stroke-width="9"></circle>
        <circle cx="42" cy="42" r="${r}" fill="none" stroke="${color}" stroke-width="9" stroke-linecap="round"
          transform="rotate(-90 42 42)" stroke-dasharray="${circ.toFixed(1)}" stroke-dashoffset="${offset.toFixed(1)}"></circle>
        <text x="42" y="47" text-anchor="middle" font-size="16" font-weight="800" fill="var(--ink)">${stat.hasData ? stat.mastery + "%" : "–"}</text>
      </svg>`;
    }

    // Five real mastery values plotted as a pentagon — no historical overlay, since we don't
    // keep past snapshots to compare against.
    function radarPolygon(values, r) {
      const cx = 100, cy = 100;
      return values.map((v, i) => {
        const angle = -Math.PI / 2 + i * ((2 * Math.PI) / values.length);
        const rad = r * (v / 100);
        return `${(cx + rad * Math.cos(angle)).toFixed(1)},${(cy + rad * Math.sin(angle)).toFixed(1)}`;
      }).join(" ");
    }

    const RADAR_LABEL_POS = [
      { left: "50%", top: "0%", transform: "translate(-50%,0)" },
      { left: "93%", top: "33%", transform: "translate(-50%,-50%)" },
      { left: "76%", top: "88%", transform: "translate(-50%,-50%)" },
      { left: "24%", top: "88%", transform: "translate(-50%,-50%)" },
      { left: "7%", top: "33%", transform: "translate(-50%,-50%)" },
    ];

    function renderRadar(stats) {
      const outer = radarPolygon(stats.map(() => 100), 88);
      const filled = radarPolygon(stats.map((s) => s.mastery), 88);
      const labels = stats.map((s, i) => {
        const pos = RADAR_LABEL_POS[i];
        return `<span class="dash-radar-label" style="left:${pos.left};top:${pos.top};transform:${pos.transform};">${esc(s.label)}</span>`;
      }).join("");
      return `<svg width="200" height="200" viewBox="0 0 200 200" style="position:absolute;inset:0;">
          <polygon points="${outer}" fill="none" stroke="var(--border)" stroke-width="1"></polygon>
          <polygon points="${filled}" fill="var(--blue-100)" fill-opacity="0.55" stroke="var(--brand-blue)" stroke-width="2"></polygon>
        </svg>${labels}`;
    }

    function weekBarsData(data) {
      const dayNames = ["So", "Mo", "Di", "Mi", "Do", "Fr", "Sa"];
      const labels = [];
      const vals = [];
      for (let i = 6; i >= 0; i--) {
        const ds = daysAgoStr(i);
        labels.push(dayNames[new Date(ds).getDay()]);
        vals.push(data.dailyActivity[ds] || 0);
      }
      const max = Math.max(1, ...vals);
      const thisWeekSum = vals.reduce((a, b) => a + b, 0);
      const prevWeekSum = Array.from({ length: 7 }, (_, i) => data.dailyActivity[daysAgoStr(i + 7)] || 0).reduce((a, b) => a + b, 0);
      return { labels, vals, max, thisWeekSum, prevWeekSum };
    }

    function renderWeekBars(data) {
      const { labels, vals, max, thisWeekSum, prevWeekSum } = weekBarsData(data);
      document.getElementById("dash-week-bars").innerHTML = vals.map((v, i) => `
        <div class="dash-week-bar-col">
          <div class="dash-week-bar" style="height:${Math.round((v / max) * 72)}px; background:${v > 0 ? "var(--brand-blue)" : "var(--border)"};"></div>
          <span>${labels[i]}</span>
        </div>`).join("");
      const delta = thisWeekSum - prevWeekSum;
      const deltaText = thisWeekSum === 0 && prevWeekSum === 0
        ? ""
        : ` · <span style="color:${delta >= 0 ? "var(--success)" : "var(--danger)"};font-weight:700;">${delta >= 0 ? "+" : ""}${delta} ggü. Vorwoche</span>`;
      document.getElementById("dash-week-summary").innerHTML = `<strong>${thisWeekSum}</strong> Übungen${deltaText}`;
    }

    function renderSkillsView() {
      const data = getProgress();
      const stats = skillStats(data);

      document.getElementById("dash-skill-grid").innerHTML = stats.map((s) => `
        <div class="dash-ring-card">
          ${ringSvg(s)}
          <div>
            <p class="dash-ring-label">${esc(s.label)}</p>
            <p class="dash-ring-sub">${s.type === "accuracy"
              ? (s.hasData ? `${s.attempts} Aufgabe${s.attempts === 1 ? "" : "n"}` : "Noch nicht geübt")
              : (s.hasData ? `${s.sessions} Sitzung${s.sessions === 1 ? "" : "en"}` : "Noch nicht geübt")}</p>
            <p class="dash-ring-sub2">${relativeDate(s.lastActiveDate)}</p>
          </div>
        </div>`).join("");

      document.getElementById("dash-radar").innerHTML = renderRadar(stats);
      const withData = stats.filter((s) => s.hasData);
      document.getElementById("dash-radar-text").textContent = withData.length
        ? "Die Fläche zeigt deinen aktuellen Stand über alle fünf Fähigkeiten — größer ist besser."
        : "Sobald du übst, füllt sich dein Profil hier.";

      const callout = document.getElementById("dash-callout");
      const weakest = withData.slice().sort((a, b) => a.mastery - b.mastery)[0];
      if (weakest) {
        callout.innerHTML = `
          <p class="dash-callout-eyebrow">Als Nächstes · ${esc(weakest.label)}</p>
          <h3>Hier bringt Üben aktuell am meisten.</h3>
          <p>${esc(weakest.label)} steht bei ${weakest.mastery}% ${weakest.type === "accuracy" ? "Genauigkeit" : "Aktivität"} — deine niedrigste Fähigkeit gerade.</p>
          <a class="quiz-btn quiz-btn--primary" href="${weakest.href}">Jetzt üben →</a>`;
      } else {
        callout.innerHTML = `
          <p class="dash-callout-eyebrow">Loslegen</p>
          <h3>Noch keine Übungsdaten.</h3>
          <p>Starte mit einer Fähigkeit — dein Profil füllt sich, sobald du übst.</p>
          <a class="quiz-btn quiz-btn--primary" href="/uebungen/wortschatz">Jetzt starten →</a>`;
      }

      renderWeekBars(data);
    }

    let selectedSkillKey = "grammatik";

    function renderProgressView() {
      const data = getProgress();
      const stats = skillStats(data);

      const sidebar = document.getElementById("dash-console-sidebar");
      sidebar.innerHTML = `<p class="dash-view-note" style="margin:0 0 12px;">Fähigkeiten</p>` + stats.map((s) => `
        <button type="button" class="dash-console-row ${s.key === selectedSkillKey ? "active" : ""}" data-key="${s.key}">
          <span class="dash-console-row-top">
            <span>${esc(s.label)}</span>
            <span class="dash-console-row-badge">${s.hasData ? relativeDate(s.lastActiveDate) : "–"}</span>
          </span>
          <span class="dash-console-track"><span class="dash-console-fill" style="width:${s.mastery}%; background:${ringColor(s.hasData, s.mastery)};"></span></span>
        </button>`).join("");
      sidebar.querySelectorAll(".dash-console-row").forEach((btn) => {
        btn.addEventListener("click", () => {
          selectedSkillKey = btn.dataset.key;
          renderProgressView();
        });
      });

      const sel = stats.find((s) => s.key === selectedSkillKey) || stats[0];
      const secondaryLabel = sel.type === "accuracy" ? "Genauigkeit" : "Sitzungen";
      const secondaryValue = sel.type === "accuracy" ? (sel.hasData ? `${sel.mastery}%` : "–") : `${sel.sessions}`;
      document.getElementById("dash-console-main").innerHTML = `
        <p class="dash-view-note" style="margin:0 0 6px;">Fähigkeit</p>
        <h2 style="margin:0 0 20px; text-align:left; font-family:var(--font-display);">${esc(sel.label)}</h2>
        <div class="dash-console-stats">
          <div class="dash-card dash-stat-card">
            <p class="dash-view-note">Beherrschung</p>
            <p class="dash-stat-big">${sel.hasData ? sel.mastery + "%" : "–"}</p>
            <p class="dash-stat-note">${sel.type === "accuracy" ? `${sel.correct}/${sel.attempts} richtig` : `${sel.sessions} Sitzung${sel.sessions === 1 ? "" : "en"}`}</p>
          </div>
          <div class="dash-card dash-stat-card">
            <p class="dash-view-note">${secondaryLabel}</p>
            <p class="dash-stat-big">${secondaryValue}</p>
            <p class="dash-stat-note">${sel.type === "accuracy" ? "Erster Versuch, alle Aufgaben" : "Insgesamt aufgezeichnet"}</p>
          </div>
          <div class="dash-card dash-stat-card">
            <p class="dash-view-note">Zuletzt geübt</p>
            <p class="dash-stat-big" style="font-size:1.3rem;">${relativeDate(sel.lastActiveDate)}</p>
            <p class="dash-stat-note">${activeToday(sel.key, data) ? "Heute schon erledigt" : "Heute noch nicht"}</p>
          </div>
          <div class="dash-card dash-stat-card">
            <p class="dash-view-note">Gesamt geübt</p>
            <p class="dash-stat-big">${sel.attempts + sel.sessions}</p>
            <p class="dash-stat-note">Aufgaben &amp; Sitzungen seit Start</p>
          </div>
        </div>
        <div class="dash-card dash-empty-note">
          <h3>Mehr Analysen folgen</h3>
          <p>Genauigkeitsverlauf, Fehlerverteilung und ein Sitzungsprotokoll bräuchten mehr aufgezeichnete Daten pro Aufgabe, als aktuell gespeichert wird. Diese Ansicht wächst mit zukünftigen Updates — erfundene Zahlen zeigen wir hier nie.</p>
          <a href="${sel.href}">Jetzt ${esc(sel.label)} üben →</a>
        </div>`;
    }

    function showView(view) {
      document.querySelectorAll(".dash-view").forEach((el) => { el.hidden = el.id !== `view-${view}`; });
      document.querySelectorAll("#dash-tabs .tab-btn").forEach((btn) => {
        const active = btn.dataset.view === view;
        btn.classList.toggle("active", active);
        btn.setAttribute("aria-selected", String(active));
      });
      if (view === "skills") renderSkillsView();
      if (view === "progress") renderProgressView();
    }

    document.querySelectorAll("#dash-tabs .tab-btn").forEach((btn) => {
      btn.addEventListener("click", () => showView(btn.dataset.view));
    });

    function renderAll() {
      const data = getProgress();
      const weeklyCount = getWeeklyCount(data);
      const weeklyGoal = getWeeklyGoal();
      const weeklyPct = weeklyGoal > 0 ? Math.min(100, Math.round((weeklyCount / weeklyGoal) * 100)) : 0;
      const name = getDisplayName();

      // Hero badge + headline + subtitle
      document.getElementById("dash-badge").textContent = data.streak > 0 ? `🔥 ${data.streak} Tag${data.streak === 1 ? "" : "e"} in Folge` : "Starte deine Serie";
      document.getElementById("dash-headline").textContent = `${greetingWord()}${name ? ", " + name : ""}!`;
      const subtitleEl = document.getElementById("dash-subtitle");
      if (weeklyCount === 0) {
        subtitleEl.textContent = "Noch keine Übung diese Woche — starte jetzt mit ein paar Minuten.";
      } else if (weeklyCount >= weeklyGoal) {
        subtitleEl.textContent = `Wochenziel erreicht — ${weeklyCount} Übungen diese Woche. Stark!`;
      } else {
        subtitleEl.textContent = `${weeklyCount} von ${weeklyGoal} Übungen diese Woche geschafft.`;
      }

      // Weekly progress bar
      document.getElementById("dash-progress-fill").style.width = `${weeklyPct}%`;
      document.getElementById("dash-progress-label").textContent = `${weeklyCount} / ${weeklyGoal}`;

      // CTA: continue with the last-touched skill, or a sensible default
      const lastSkill = SKILLS.find((s) => s.key === data.lastSkill);
      const cta = document.getElementById("dash-cta");
      cta.href = lastSkill ? lastSkill.href : "/uebungen/wortschatz";
      cta.textContent = lastSkill ? `Weiter mit ${lastSkill.label} →` : "Jetzt loslegen →";

      // Stat tiles
      document.getElementById("stat-streak").textContent = data.streak > 0 ? `${data.streak} Tage` : "–";
      document.getElementById("stat-vocab").textContent = String(data.vocabMastered.length);
      document.getElementById("stat-week").textContent = String(weeklyCount);
      const gradedKeys = ["wortschatz", "grammatik", "schreiben"];
      let attempts = 0, correct = 0;
      gradedKeys.forEach((k) => {
        const s = data.skills[k];
        if (s) { attempts += s.attempts; correct += s.correct; }
      });
      document.getElementById("stat-accuracy").textContent = attempts > 0 ? `${Math.round((correct / attempts) * 100)}%` : "–";

      // "Heute für dich"
      const todayList = document.getElementById("dash-today-list");
      todayList.innerHTML = SKILLS.map((s) => {
        const done = activeToday(s.key, data);
        return `<a class="dash-today-row" href="${s.href}">
          <span class="dash-today-icon">${s.icon}</span>
          <span class="dash-today-label">${esc(s.label)}</span>
          <span class="dash-today-status ${done ? "dash-today-status--done" : "dash-today-status--todo"}">${done ? "✓ heute geübt" : "starten →"}</span>
        </a>`;
      }).join("");

      // "Fähigkeiten"
      const skillsList = document.getElementById("dash-skills-list");
      skillsList.innerHTML = SKILLS.map((s) => {
        const st = data.skills[s.key];
        let pct = 0, valueText = "Noch nicht geübt";
        if (s.type === "accuracy") {
          if (st && st.attempts > 0) {
            pct = Math.round((st.correct / st.attempts) * 100);
            valueText = `${pct}% · ${st.attempts}`;
          }
        } else {
          const sessions = st?.sessions || 0;
          if (sessions > 0) {
            pct = Math.min(100, sessions * 10);
            valueText = `${sessions} Sitzung${sessions === 1 ? "" : "en"}`;
          }
        }
        return `<div class="dash-skill-row">
          <span class="dash-skill-icon">${s.icon}</span>
          <span class="dash-skill-name">${esc(s.label)}</span>
          <span class="dash-skill-track"><span class="dash-skill-fill" style="width:${pct}%"></span></span>
          <span class="dash-skill-value">${esc(valueText)}</span>
        </div>`;
      }).join("");

      wireNameEditor(name);
      wireGoalEditor(weeklyGoal);
    }

    function wireNameEditor(name) {
      const slot = document.getElementById("dash-name-slot");
      slot.innerHTML = name
        ? `<button class="dash-link-btn" id="dash-name-btn" type="button">✏️ „${esc(name)}“ ändern</button>`
        : `<button class="dash-link-btn" id="dash-name-btn" type="button">Namen hinzufügen</button>`;
      document.getElementById("dash-name-btn").addEventListener("click", () => {
        slot.innerHTML = `<span class="dash-inline-edit">
          <input type="text" id="dash-name-input" placeholder="Dein Name" value="${esc(name)}" maxlength="40" />
          <button type="button" id="dash-name-save">Speichern</button>
        </span>`;
        const input = document.getElementById("dash-name-input");
        input.focus();
        const save = () => { setDisplayName(input.value); renderAll(); };
        document.getElementById("dash-name-save").addEventListener("click", save);
        input.addEventListener("keydown", (e) => { if (e.key === "Enter") save(); });
      });
    }

    function wireGoalEditor(goal) {
      const slot = document.getElementById("dash-goal-slot");
      slot.innerHTML = `<button class="dash-link-btn" id="dash-goal-btn" type="button">Wochenziel: ${goal} Übungen · anpassen</button>`;
      document.getElementById("dash-goal-btn").addEventListener("click", () => {
        slot.innerHTML = `<span class="dash-inline-edit">
          <input type="number" id="dash-goal-input" value="${goal}" min="10" max="500" step="10" />
          <button type="button" id="dash-goal-save">Speichern</button>
        </span>`;
        const input = document.getElementById("dash-goal-input");
        input.focus();
        const save = () => { setWeeklyGoal(Number(input.value) || goal); renderAll(); };
        document.getElementById("dash-goal-save").addEventListener("click", save);
        input.addEventListener("keydown", (e) => { if (e.key === "Enter") save(); });
      });
    }

    renderAll();
  </script>
</Layout>
