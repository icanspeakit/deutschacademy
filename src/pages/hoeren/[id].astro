---
// One Hörtext: the clip, the questions, then the transcript.
//
// Order matters and is the whole didactic point. The transcript sits behind a closed
// <details> so the first pass is really listening; it opens by itself only when the mp3
// has not been rendered yet, because a silent page with a hidden text is no exercise at
// all. The speed control is not decoration either — at A1/A2 the second pass at 0.75×
// is where the words separate.
//
// The transcript carries a translation, turn by turn (src/data/uebersetzungen/hoeren.json),
// behind the same "in meiner Sprache" switch as the grammar rules. It lives inside the
// closed transcript on purpose: it is for after listening, like the transcript itself.
import Layout from "../../layouts/Layout.astro";
import SiteNav from "../../components/SiteNav.astro";
import Icon from "../../components/Icon.astro";
import GrammarHelp from "../../components/GrammarHelp.astro";
import GrammarHelpText from "../../components/GrammarHelpText.astro";
import hoeren from "../../data/hoeren.json";
import hoerenHelp from "../../data/uebersetzungen/hoeren.json";
import { item } from "../../lib/helpContent.js";
import { clipHref, clipSeconds, hasClip, TYPE_ICON } from "../../lib/hoeren.js";
import "../../styles/practice.css";
import "../../styles/hoeren.css";

export function getStaticPaths() {
  return hoeren.texts.map((text) => {
    // Previous/next stay inside the level: "weiter" should mean another A2 Hörtext, not a
    // jump from the last A1 clip into a B2 Diskussion.
    const sameLevel = hoeren.texts.filter((t) => t.level === text.level);
    const i = sameLevel.indexOf(text);
    return {
      params: { id: text.id },
      props: { text, prev: sameLevel[i - 1] ?? null, next: sameLevel[i + 1] ?? null },
    };
  });
}

const { text, prev, next } = Astro.props;
const { types, voices } = hoeren;
const ready = hasClip(text.id);
const seconds = clipSeconds(text);
const tx = (hoerenHelp.entries as Record<string, any>)[text.id] ?? null;
---
<Layout
  title={`${text.title} – Hörverstehen ${text.level} – DeutschAcademy`}
  description={text.blurb}
>
  <SiteNav active="fertigkeiten" />
  <main class="practice-main" id="ho-page" data-gx="off">
    <a href="/hoeren" class="vp-back-link" data-i18n="hoeren.back">← Alle Hörtexte</a>

    <article class="ho-text">
      <header class="ho-text-head">
        <span class="ho-card-ic"><Icon name={TYPE_ICON[text.type] ?? "volume"} size={22} /></span>
        <div>
          <p class="eyebrow" data-i18n={`type.hoeren.${text.type}`}>{types[text.type]}</p>
          <h1>{text.title}</h1>
        </div>
        <span class="ho-badge">{text.level}</span>
      </header>

      <p class="ho-blurb" data-i18n={`hoeren.${text.id}.blurb`}>{text.blurb}</p>

      {ready ? (
        <div class="ho-player">
          <audio id="ho-audio" controls preload="none" src={clipHref(text.id)}></audio>
          <div class="ho-speed" role="group" aria-label="Wiedergabegeschwindigkeit" data-i18n-attr="aria-label:hoeren.speed.aria">
            <span class="ho-speed-label" data-i18n="hoeren.speed">Tempo</span>
            <button class="ho-speed-btn" type="button" data-rate="0.75">0,75×</button>
            <button class="ho-speed-btn is-on" type="button" data-rate="1">1×</button>
            <button class="ho-speed-btn" type="button" data-rate="1.25">1,25×</button>
          </div>
          <p class="ho-player-hint" data-i18n="hoeren.playerHint" data-i18n-vars={JSON.stringify({ s: seconds })}>{seconds} Sekunden. Hör zuerst einmal ganz durch, ohne mitzulesen — danach kommen die Fragen.</p>
        </div>
      ) : (
        <p class="ho-pending" data-i18n-html="hoeren.pendingOne">Für diesen Hörtext ist noch keine Audiodatei gerendert (<code>pnpm generate:hoeren</code>). Solange kannst du das Transkript unten als Lesetext benutzen — die Fragen sind dieselben.</p>
      )}

      <section class="ho-block">
        <h2 data-i18n="hoeren.h2.questions">Fragen zum Hörtext</h2>
        <p class="ho-quiz-intro" data-i18n="skills.quizIntro" data-i18n-vars={JSON.stringify({ n: text.questions.length })}>{text.questions.length} Fragen. Antworte per Klick — die Erklärung steht danach dabei.</p>
        <div class="quiz-card" id="ho-quiz"></div>
      </section>

      <details class="ho-transcript" open={!ready}>
        <summary><span data-i18n="hoeren.transcript">Transkript</span> {ready && <span class="ho-transcript-warn" data-i18n="hoeren.transcriptWarn">— erst nach dem Hören öffnen</span>}</summary>
        {tx && <GrammarHelp level={text.level} root="ho-page" reviewed={tx.reviewed} />}
        <div class="ho-script">
          {text.script.map((turn, i) => (
            <>
              <p class="ho-turn">
                <b data-i18n={voices[turn.speaker] ? `hoeren.voice.${turn.speaker}` : undefined}>{voices[turn.speaker]?.label ?? turn.speaker}</b>
                <span>{turn.text}</span>
              </p>
              <GrammarHelpText text={item(tx?.script, i)} />
            </>
          ))}
        </div>
      </details>

      <nav class="ho-prevnext">
        {prev ? <a href={`/hoeren/${prev.id}`}>← {prev.title}</a> : <span />}
        {next ? <a href={`/hoeren/${next.id}`}>{next.title} →</a> : <span />}
      </nav>
    </article>
  </main>

  <script type="application/json" id="ho-quiz-data" set:html={JSON.stringify(text.questions)}></script>
  <script>
    import { mountQuiz } from "../../lib/quiz.js";
    import { recordAttempt } from "../../lib/progress.js";

    const questions = JSON.parse(document.getElementById("ho-quiz-data").textContent);
    mountQuiz(document.getElementById("ho-quiz"), questions, {
      mode: "choice",
      // Not shuffled, unlike the Landeskunde quiz: a Hörtext runs in time, and question 3
      // often asks about something said after question 1. Shuffling them would ask the
      // learner to hold the whole clip in their head at once.
      shuffle: false,
      showWrongCount: true,
      onAnswer: (ok) => recordAttempt({ skill: "hoeren", correct: ok }),
    });

    const audio = document.getElementById("ho-audio");
    if (audio) {
      for (const btn of document.querySelectorAll("[data-rate]")) {
        btn.addEventListener("click", () => {
          audio.playbackRate = Number(btn.dataset.rate);
          for (const b of document.querySelectorAll("[data-rate]")) b.classList.toggle("is-on", b === btn);
        });
      }
    }
  </script>
</Layout>
