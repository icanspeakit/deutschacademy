  <script type="module">
    const buttons = [...document.querySelectorAll('#tabs button[data-target]')];
    const panels = [...document.querySelectorAll('.concept-panel')];
    function show(id) {
      panels.forEach((p) => p.classList.toggle('active', p.id === id));
      buttons.forEach((b) => b.classList.toggle('active', b.dataset.target === id));
      window.scrollTo(0, 0);
      try { localStorage.setItem('concepts-active', id); } catch (e) {}
    }
    buttons.forEach((b) => b.addEventListener('click', () => show(b.dataset.target)));
    let saved = null;
    try { saved = localStorage.getItem('concepts-active'); } catch (e) {}
    show(saved && document.getElementById(saved) ? saved : 'concept-1');
  </script>
